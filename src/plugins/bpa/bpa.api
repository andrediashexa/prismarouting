/*
 * API binaria do plugin bpa.
 *
 * Existe porque a CLI do VPP devolve 0 mesmo quando o comando falha: quem
 * diz e o texto. O hexash detectava erro por padrao de texto, o que quebra
 * ao primeiro ajuste de mensagem. Aqui ha codigo de retorno de verdade.
 */

option version = "0.1.0";

import "vnet/interface_types.api";
import "vnet/ip/ip_types.api";

enum bpa_policy : u8
{
  BPA_API_POLICY_INTERLEAVED = 0,
  BPA_API_POLICY_BLOCKED = 1,
};

enum bpa_mode : u8
{
  BPA_API_MODE_DETERMINISTIC = 0,
  BPA_API_MODE_DYNAMIC = 1,
};

/** \brief Cria ou remove um pool de CGNAT BPA.
    @param is_add - 1 cria, 0 remove
    @param name - nome do pool
    @param block_size - portas por bloco, potencia de dois
    @param n_inside - quantos dos prefixos abaixo sao internos
    @param prefixes - os internos primeiro, depois os publicos
*/
autoreply define bpa_pool_add_del
{
  u32 client_index;
  u32 context;

  bool is_add;
  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  u8 n_inside;
  u8 n_prefixes;
  vl_api_prefix_t prefixes[n_prefixes];
};

/** \brief Liga ou desliga o CGNAT numa interface. */
autoreply define bpa_interface_add_del_feature
{
  u32 client_index;
  u32 context;

  bool is_add;
  bool is_inside;
  vl_api_interface_index_t sw_if_index;
};

/** \brief Lista os pools configurados. */
define bpa_pool_dump
{
  u32 client_index;
  u32 context;
};

define bpa_pool_details
{
  u32 context;

  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  u32 blocks_per_ip;
  u32 capacity;
  u32 inside_count;
  u32 outside_count;
};
