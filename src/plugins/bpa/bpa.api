/*
 * Binary API of the bpa plugin.
 *
 * It exists because VPP's CLI returns 0 even when the command failed: the text
 * is what says so. hexash detected errors by text pattern, which breaks at the
 * first reworded message. Here there are real return codes.
 */

option version = "0.1.0";

import "vnet/interface_types.api";
import "vnet/ip/ip_types.api";

enum bpa_policy : u8
{
  BPA_API_POLICY_INTERLEAVED = 0,
  BPA_API_POLICY_BLOCKED = 1,
};

enum bpa_mode : u8
{
  BPA_API_MODE_DETERMINISTIC = 0,
  BPA_API_MODE_DYNAMIC = 1,
};

/** \brief Creates or removes a BPA CGNAT pool.
    @param is_add - 1 creates, 0 removes
    @param name - pool name
    @param block_size - ports per block, a power of two
    @param n_inside - how many of the prefixes below are inside ones
    @param prefixes - the inside ones first, then the public ones
*/
autoreply define bpa_pool_add_del
{
  u32 client_index;
  u32 context;

  bool is_add;
  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  u8 n_inside;
  u8 n_prefixes;
  vl_api_prefix_t prefixes[n_prefixes];
};

/** \brief Enables or disables CGNAT on an interface. */
autoreply define bpa_interface_add_del_feature
{
  u32 client_index;
  u32 context;

  bool is_add;
  bool is_inside;
  vl_api_interface_index_t sw_if_index;
};

/** \brief Lists the configured pools. */
define bpa_pool_dump
{
  u32 client_index;
  u32 context;
};

define bpa_pool_details
{
  u32 context;

  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  u32 blocks_per_ip;
  u32 capacity;
  u32 inside_count;
  u32 outside_count;
};
