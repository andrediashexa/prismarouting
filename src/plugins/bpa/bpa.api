/*
 * Binary API of the bpa plugin.
 *
 * It exists because VPP's CLI returns 0 even when the command failed: the text
 * is what says so. prismash detected errors by text pattern, which breaks at the
 * first reworded message. Here there are real return codes.
 */

/*
 * 0.2.0 adds the per-pool settings that already existed on the CLI and had no
 * way to reach the dataplane through the API: filtering mode, max-blocks, the
 * ALG switches and the per-pool timeouts. Without them a VTY built on this API
 * could accept those lines and silently drop them, which is exactly what it
 * did (issue #47).
 */
/*
 * 0.3.0 adds bpa_forward_add_del: static port forwards. A separate message
 * rather than fields on bpa_pool_add_del, because that message already ends in
 * the variable-length prefix array and only one of those can be last - and
 * because a forward has to be addable to a pool that is carrying traffic,
 * which redefining the pool is not.
 */
/*
 * 0.4.0 adds the TCP MSS clamp to bpa_pool_add_del and bpa_pool_details: a
 * scalar pair, which is why it fits above the variable-length prefix array
 * where those messages already say later additions must go.
 *
 * It CHANGES THE LAYOUT of both messages, so a client built against 0.3.0
 * must be rebuilt - the CRC will not match. That is allowed while the project
 * is on 0.x and is called out here rather than discovered by a client that
 * silently stops working. lab/api.sh pins the JSON shape of the message and
 * is the thing that fails when this happens, which is how this one was
 * caught.
 */
/*
 * 0.5.0 adds bpa_limits_set: the per-subscriber bounds. A message of its own
 * and NOT fields on bpa_pool_add_del, for two reasons the 0.4.0 note above
 * makes concrete - adding scalars there changes the layout and every client
 * must be rebuilt, and a setting that only arrives with a pool definition can
 * only be changed by recreating the pool, which drops every session on it
 * (issue #69). An operator caps one infected subscriber; the neighbours do
 * not get disconnected for it.
 */
/*
 * 0.6.0 adds bpa_bypass_set: prefixes that leave untranslated. It carries the
 * WHOLE list, because the sets merge adjacent prefixes and "remove one of
 * them" from a merged range has no honest answer - and because a candidate
 * configuration produces the whole list anyway.
 */
/*
 * 0.7.0 adds bpa_pool_settings_set: every per-pool setting that can be changed
 * without recreating the pool. One message rather than five, because the list
 * of what is safe to change in place is a fact about the pool and belongs in
 * one place - and because a VTY that had to send five would have five chances
 * to leave a pool half-changed.
 */
/*
 * 0.8.0 adds the utilisation alarm to bpa_pool_settings_set - a threshold at
 * which a subscriber filling its block is reported, before natEvent 12 reports
 * that it has already run out.
 */
/*
 * 0.9.0 adds the VRF a pool serves, and the one its translated traffic leaves
 * by. On bpa_pool_add_del and not on the settings message, because changing
 * which VRF a pool serves changes which subscribers it maps - every session on
 * it is invalid at that instant, exactly like a change of prefix.
 *
 * ~0 means "every VRF", which is what every configuration written before this
 * existed means. Zero is VRF 0 and is a different answer.
 */
/*
 * 0.11.0 adds bpa_logging_set: the IPFIX export state and its TCP collector,
 * which were the last configuration changes prismash made over the VPP CLI
 * socket (issue #76). A new message, so no existing layout moves and no
 * client has to be rebuilt for it.
 *
 * The line said 0.9.0 until now. The 0.10.0 note below - the audit fields -
 * was written and this was not bumped with it, so the file described a
 * version of itself that the option had never reached.
 */
/*
 * 0.17.0 adds bpa_identity_radius_set: the identity table filled from the
 * accounting stream a BNG already sends (issue #21). A new message, so no
 * existing layout moves.
 */
/*
 * 0.16.0 adds bpa_identity_source_set: the same identity table, from an ISC
 * dhcpd lease file rather than a static map (issue #21). A new message, so no
 * existing layout moves.
 */
/*
 * 0.15.0 adds bpa_identity_set: where this box reads who held a private
 * address, for the log (issue #21). A new message, so no existing layout
 * moves.
 */
/*
 * 0.14.0 adds bpa_logging_syslog_set: the same block events as RFC 5424
 * syslog lines, for the collectors that speak nothing else (issue #20). A new
 * message, so no existing layout moves and no client has to be rebuilt for
 * it.
 */
/*
 * 0.13.0 adds block_reserve to bpa_pool_add_del and bpa_pool_details, and
 * blocks_mapped and reserve_count to bpa_pool_details: blocks held out of the
 * deterministic formula so a subscriber that fills its block can be given
 * another (issue #39).
 *
 * NOT on bpa_pool_settings_set, and that is the whole point of where it sits.
 * A reserve is taken out of capacity, which changes blocks_mapped, which is
 * the divisor under the blocked policy - so changing it re-maps subscribers
 * and rebuilds the pool, exactly like a prefix or a block size. A field that
 * re-maps subscribers on the message whose contract is "safe on a pool
 * carrying traffic" would be the worst possible place for it.
 *
 * It CHANGES THE LAYOUT of both messages, so a client built against 0.12.0
 * must be rebuilt.
 */
/*
 * 0.12.0 adds block_stride to bpa_pool_add_del, bpa_pool_settings_set and
 * bpa_pool_details: the distance between the blocks one subscriber holds
 * (issue #55). On the settings message as well as the add one, because it
 * changes where the NEXT extension goes and moves nothing already handed out
 * - so recreating the pool to change it would drop every session for a
 * preference about layout.
 *
 * It CHANGES THE LAYOUT of those three messages, so a client built against
 * 0.11.0 must be rebuilt - the CRC will not match. Called out here rather
 * than discovered by a client that silently stops working; lab/api.sh pins
 * the JSON shape and is what fails when this happens.
 */
/*
 * 0.18.0 adds initial_blocks to bpa_pool_add_del, bpa_pool_settings_set and
 * bpa_pool_details: how many blocks a new subscriber of a dynamic pool is
 * given at once, where max_blocks is the most it may grow to (#462). On the
 * settings message too, for block_stride's reason: it changes what the NEXT
 * subscriber gets and moves nothing already handed out.
 *
 * It CHANGES THE LAYOUT of those three messages, so a client built against
 * 0.17.0 must be rebuilt. lab/api.sh pins the JSON shape.
 */
/*
 * 0.19.0 adds bpa_nat64_pool_add: a pool whose inside is IPv6 (#485). A new
 * message, so no existing layout moves - and a NAT64 pool is deleted, like
 * any other, by bpa_pool_add_del with is_add false.
 */
/*
 * 0.20.0 adds bpa_pool_lists_set: a pool whose sides are prefix-lists
 * (#589) - the two names, the sources its inside list denies, which leave
 * untranslated, and the public addresses its outside list's denies took
 * out. A new message, so no existing layout moves: the effective sets
 * themselves still arrive as the pool's own prefixes on bpa_pool_add_del.
 */
option version = "0.20.0";

import "vnet/interface_types.api";
import "vnet/ip/ip_types.api";

enum bpa_policy : u8
{
  BPA_API_POLICY_INTERLEAVED = 0,
  BPA_API_POLICY_BLOCKED = 1,
};

enum bpa_mode : u8
{
  BPA_API_MODE_DETERMINISTIC = 0,
  BPA_API_MODE_DYNAMIC = 1,
};

enum bpa_filter : u8
{
  BPA_API_FILTER_ENDPOINT_INDEPENDENT = 0,
  BPA_API_FILTER_ADDRESS_DEPENDENT = 1,
};

/** \brief Per-pool session lifetimes. Zero in any field inherits the global
    value, which is why zero is not a legal setting rather than a short one. */
typedef bpa_timeouts
{
  u32 udp;
  u32 icmp;
  u32 tcp_syn;
  u32 tcp_transitory;
  u32 tcp_established;
  u32 gre;
  u32 port_holddown;
  u32 alg_expect;
};

/** \brief Creates or removes a BPA CGNAT pool.
    @param is_add - 1 creates, 0 removes
    @param name - pool name
    @param block_size - ports per block, a power of two
    @param filter - which inbound packets a mapping accepts (RFC 4787 REQ-8)
    @param max_blocks - how many blocks one subscriber may hold; 0 means one
    @param initial_blocks - how many a new subscriber of a dynamic pool is
                            given at once; 0 and 1 mean one
    @param block_stride - blocks of the subscriber's own public address
                          between the blocks it holds; 0 is whatever the
                          allocator has free, which is the historical
                          behaviour
    @param block_reserve - blocks per public address held out of the
                           deterministic formula, so a subscriber that fills
                           its block can be given another. Paid for in
                           capacity, and RE-MAPS SUBSCRIBERS: 0 is every
                           configuration written before this existed
    @param alg - bitmask of the ALGs enabled for this pool
    @param alg_set - which bits of alg the operator actually chose; the rest
                     take the shipped default, so a caller that does not care
                     sends zero for both and gets the documented behaviour
    @param timeouts - per-pool lifetimes; zero in a field inherits the global
    @param tcp_mss - clamp the MSS option of a handshake to this; 0 is off
    @param tcp_mss_auto - derive the clamp from the interface MTUs instead,
                          in which case tcp_mss is ignored
    @param vrf_id - the VRF whose subscribers this pool serves; ~0 is every
                    VRF, which is what a configuration that says nothing means
    @param out_vrf_id - the VRF translated traffic leaves by; ~0 leaves it
                        where it was
    @param n_inside - how many of the prefixes below are inside ones
    @param prefixes - the inside ones first, then the public ones
*/
/*
 * 0.10.0 adds audit_user and audit_uid to every message that CHANGES
 * something. The configuration trail recorded what changed and when, and
 * could not say who: bpa_audit.c had no getuid, no SUDO_USER, nothing
 * identifying a person (issue #34).
 *
 * Fields on each message rather than state on the connection, because prismash
 * reaches the dataplane through vat2 - one process per call - so there is no
 * connection to attach an identity to. Fixed-size and placed above the
 * variable-length arrays, where this file already says later additions must
 * go.
 *
 * What this is NOT: proof. The client asserts its own identity, and the
 * transport in use is shared memory, which carries no peer credentials for
 * the plugin to check it against. Anyone who can reach this API can already
 * reconfigure the box, so the trail is not a defence against them - it is the
 * record of which operator did what among operators who are trusted to be on
 * the box at all, which is what an audit trail is. Making it evidence against
 * its own author is issue #22, from the other side.
 *
 * It CHANGES THE LAYOUT of five messages, so a client built against 0.9.0
 * must be rebuilt. lab/api.sh pins the JSON shape and is what fails when this
 * happens.
 */
autoreply define bpa_pool_add_del
{
  u32 client_index;
  u32 context;

  bool is_add;
  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  vl_api_bpa_filter_t filter;
  u8 max_blocks;
  u8 initial_blocks;
  u16 block_stride;
  u16 block_reserve;
  u32 alg;
  u32 alg_set;
  vl_api_bpa_timeouts_t timeouts;
  u16 tcp_mss;
  bool tcp_mss_auto;
  u32 vrf_id;
  u32 out_vrf_id;
  /* The variable-length array is last, as the API requires: anything added
   * later goes above this line. */
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
  u8 n_inside;
  u8 n_prefixes;
  vl_api_prefix_t prefixes[n_prefixes];
};

/** \brief Creates a NAT64 pool: IPv6 subscribers, IPv4 public addresses (#485).
    Its own message rather than three more fields on bpa_pool_add_del, so
    that no client built against 0.18.0 has to be rebuilt for a feature it
    does not use. The ALGs are not here. The in-place settings - the MSS
    clamp, the utilisation alarm - reach a NAT64 pool by
    bpa_pool_settings_set, and forwards by their own message, as for any
    pool; the reserve re-maps subscribers and so is here.
    @param name - pool name
    @param subscriber_length - the prefix length one subscriber holds, 32-128
    @param nat64_prefix - RFC 6052's prefix; length 0 is 64:ff9b::/96
    @param vrf_id - the IPv6 table the subscribers arrive in; ~0 is every one
    @param out_vrf_id - the IPv4 table translated traffic leaves by; ~0
                        leaves it where it was
    @param n_inside - how many of the prefixes are inside ones, IPv6
    @param prefixes - the inside ones first, then the public IPv4 ones
*/
autoreply define bpa_nat64_pool_add
{
  u32 client_index;
  u32 context;

  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  vl_api_bpa_filter_t filter;
  u8 max_blocks;
  u8 initial_blocks;
  u16 block_stride;
  u16 block_reserve;
  vl_api_bpa_timeouts_t timeouts;
  u8 subscriber_length;
  vl_api_ip6_prefix_t nat64_prefix;
  u32 vrf_id;
  u32 out_vrf_id;
  string audit_user[64];
  u32 audit_uid;
  u8 n_inside;
  u8 n_prefixes;
  vl_api_prefix_t prefixes[n_prefixes];
};

/** \brief Changes a pool's settings without recreating it.
    Everything here is safe to change on a pool that is carrying traffic. What
    is deliberately absent - the prefixes, block size, port range, policy and
    mode - changes the mapping, and every session on the pool is invalid the
    moment it changes, so those still go through bpa_pool_add_del.
    @param name - the pool
    @param filter - which inbound packets a mapping accepts
    @param max_blocks - blocks one subscriber may hold; 0 means one
    @param initial_blocks - blocks a new subscriber is given at once
    @param block_stride - blocks between the ones a subscriber holds; 0 is
                          whatever the allocator has free
    @param alg - which ALGs are enabled
    @param alg_set - which of them the operator stated an opinion about
    @param tcp_mss - MSS clamp; 0 is off
    @param tcp_mss_auto - derive the clamp from the interface MTUs
    @param timeouts - per-pool lifetimes; zero in a field inherits the global
*/
autoreply define bpa_pool_settings_set
{
  u32 client_index;
  u32 context;

  string name[64];
  vl_api_bpa_filter_t filter;
  u8 max_blocks;
  u8 initial_blocks;
  u16 block_stride;
  u32 alg;
  u32 alg_set;
  u16 tcp_mss;
  bool tcp_mss_auto;
  u8 util_alarm;
  vl_api_bpa_timeouts_t timeouts;
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
};

/** \brief Replaces one of a pool's bypass lists, entire.
    @param name - the pool
    @param is_destination - true for the destination list, false for the source
    @param prefixes - the whole list; empty removes the bypass
*/
autoreply define bpa_bypass_set
{
  u32 client_index;
  u32 context;

  string name[64];
  bool is_destination;
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
  u8 n_prefixes;
  vl_api_prefix_t prefixes[n_prefixes];
};

/** \brief Replaces a pool's prefix-lists, entire (#589).
    @param name - the pool
    @param inside_list - the prefix-list its inside came from; "" if typed
    @param outside_list - the prefix-list its outside came from; "" if typed
    @param n_untranslated - how many of the prefixes are untranslated sources
    @param prefixes - the sources the inside list denies first, then the
      public addresses the outside list's denies took out of its permits
*/
autoreply define bpa_pool_lists_set
{
  u32 client_index;
  u32 context;

  string name[64];
  string inside_list[64];
  string outside_list[64];
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
  u8 n_untranslated;
  u8 n_prefixes;
  vl_api_prefix_t prefixes[n_prefixes];
};

/** \brief Sets a pool's per-subscriber bounds. Zero is unlimited in both, and
    both are always sent: a message that keeps whichever half was omitted has
    an effect that depends on what was there before.
    @param name - the pool
    @param max_sessions - concurrent sessions one subscriber may hold
    @param max_rate - new sessions per second, per subscriber
*/
autoreply define bpa_limits_set
{
  u32 client_index;
  u32 context;

  string name[64];
  u32 max_sessions;
  u32 max_rate;
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
};

/** \brief Which protocols have a port to pin. Values match bpa_proto_t. */
enum bpa_fwd_proto : u8
{
  BPA_API_FWD_TCP = 0,
  BPA_API_FWD_UDP = 1,
};

/** \brief Adds or removes a static port forward.
    @param is_add - 1 adds, 0 removes
    @param name - the pool the forward belongs to
    @param proto - tcp or udp; nothing else has a port to forward
    @param port_pub - the public port, which MUST be inside the block the pool
                      assigns to ip_priv. The public ADDRESS is not a
                      parameter: it is the subscriber's own, because a
                      subscriber that answered on an address it never sends
                      from would break paired address pooling (RFC 4787 REQ-2)
    @param ip_priv - the subscriber
    @param port_priv - the port on the subscriber; ignored when removing,
                       which is identified by the public port alone
*/
autoreply define bpa_forward_add_del
{
  u32 client_index;
  u32 context;

  bool is_add;
  string name[64];
  vl_api_bpa_fwd_proto_t proto;
  u16 port_pub;
  u16 port_priv;
  vl_api_ip4_address_t ip_priv;
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
};

/** \brief A forward on a NAT64 pool (#485): bpa_forward_add_del with an
    IPv6 host, one /128 of a subscriber's delegated prefix. A new message,
    as bpa_nat64_pool_add is. Removing names the public port and protocol
    alone, as on the IPv4 message.
*/
autoreply define bpa_nat64_forward_add_del
{
  u32 client_index;
  u32 context;

  bool is_add;
  string name[64];
  vl_api_bpa_fwd_proto_t proto;
  u16 port_pub;
  u16 port_priv;
  vl_api_ip6_address_t host;
  string audit_user[64];
  u32 audit_uid;
};

/** \brief Enables or disables CGNAT on an interface.

    Attaching is a change with the same consequence as a pool change and is
    recorded in the same trail: detaching stops translation for every
    subscriber behind the interface. It carried no identity until #124, which
    CHANGES THE LAYOUT of this message - a client built before that must be
    rebuilt.
*/
autoreply define bpa_interface_add_del_feature
{
  u32 client_index;
  u32 context;

  bool is_add;
  bool is_inside;
  vl_api_interface_index_t sw_if_index;
  /* Who asked. Not proof - see the 0.10.0 note above. */
  string audit_user[64];
  u32 audit_uid;
};

/** \brief The settings that are not per-pool.

    Timeouts, the block hold-down and the session table sizing. Every one of
    these was reachable only over the VPP CLI socket, and an account with that
    socket can do anything on the box - so the roles bound what the VTY would
    do and not what an account could reach.

    A zero in a timeout field means "leave it alone": zero is not a valid
    timeout, so it needs no separate flag. The other two DO get a flag,
    because zero is a value an operator may legitimately mean.

    @param timeouts - per-protocol idle timeouts; a zero field is unchanged
    @param set_block_holddown - whether block_holddown is being set
    @param block_holddown - seconds a block stays reserved once idle
    @param set_session_table - whether the session table sizing is being set
    @param session_buckets - hash buckets per table
    @param session_memory_mb - memory per table, in megabytes
*/
autoreply define bpa_global_set
{
  u32 client_index;
  u32 context;

  vl_api_bpa_timeouts_t timeouts;
  bool set_block_holddown;
  u32 block_holddown;
  bool set_session_table;
  u32 session_buckets;
  u32 session_memory_mb;
};

/** \brief IPFIX export of block events: whether it runs, and where it goes.

    One message for two statements - `cgnat logging enable|disable` and
    `cgnat logging tcp <collector> [port <n>]` - because they are one
    exporter, and a caller that had to send two would have two chances to
    leave it half configured. Each half carries its own flag: "off" is a value
    an operator means, not the absence of one, so it cannot be spelled as a
    zero the way a timeout can.

    Like bpa_global_set, this carries no audit_user. The trail in bpa_audit.c
    is per-pool and records nothing global at all, so a field here would name
    an operator on a line that is never written.

    @param set_enable - whether the export state is being set
    @param enable - export on or off
    @param set_tcp - whether the transport is being set
    @param tcp_enable - TCP transport on or off; off disconnects the collector
                        and stops that transport, and does NOT turn the UDP
                        export on - the two are separate paths in the plugin
    There is a THIRD statement in this hierarchy and it is deliberately not
    here: `cgnat logging udp <collector> src <source>` goes to VPP's own
    set_ipfix_exporter. The UDP exporter is core state shared with anything
    else that exports, and libvnet exports no setter a plugin could call - so
    carrying it on this message would mean copying the core handler's field
    assignments into this plugin, where the copy would drift with every VPP
    bump. The plugin READS it back, in `show bpa config`, because that is the
    one place the CGNAT running configuration is produced (#209).

    @param collector - the TCP collector, read only when tcp_enable is true
    @param port - its port; 0 means the IPFIX default, which the dataplane
                  applies rather than the caller, so every client agrees on it
*/
autoreply define bpa_logging_set
{
  u32 client_index;
  u32 context;

  bool set_enable;
  bool enable;
  bool set_tcp;
  bool tcp_enable;
  vl_api_ip4_address_t collector;
  u16 port;
};

/** \brief The same block events as RFC 5424 syslog lines (issue #20)

    A MESSAGE OF ITS OWN and not fields on bpa_logging_set, for the reason
    this file states at every version note: a new message moves no existing
    layout and no client has to be rebuilt for it. It is also the honest
    shape - a syslog collector is a different destination with different
    answers to give, not another flag on the IPFIX one, and the two run side
    by side.

    @param enable - the syslog transport on or off; off disconnects the
                    collector and stops that transport, and touches neither
                    IPFIX transport
    @param collector - the syslog collector, read only when enable is true
    @param port - its port; 0 means RFC 6587's 601, which the dataplane
                  applies rather than the caller, so every client agrees
    @param enterprise - the operator's IANA Private Enterprise Number, which
                        every line carries in its structured-data name. There
                        is NO default and 0 is refused: RFC 5424 reserves an
                        unsuffixed SD-ID for names IANA has registered, and
                        this product has none
    @param facility - syslog facility, 0-23; 16 (local0) is what a box that
                      says nothing gets, applied by the dataplane
    @param severity - syslog severity, 0-7; 6 (informational) likewise
*/
/** \brief Where this box reads who held a private address (issue #21)

    A PATH AND NOT THE TABLE. The file holds one line per subscriber and is
    written by a provisioning system; carrying its contents on this message
    would mean a configuration nobody can read and a rewrite of it on every
    commit. The dataplane reads the file, refuses it whole when a line is
    neither a comment nor an address and an identity, and names the line.

    An empty path means "no table", which is a state an operator can mean:
    every record then says `unknown`, and every record is still emitted.

    @param path - the file to read, or empty for none
*/
autoreply define bpa_identity_set
{
  u32 client_index;
  u32 context;

  string path[256];
};

/** \brief The same table, from a DHCP lease file (issue #21)

    A MESSAGE OF ITS OWN rather than a field on bpa_identity_set, which is
    already shipped: a new message moves no existing layout and no client has
    to be rebuilt for it. The kind is carried and not sniffed from the file's
    first line - a file's first line is a poor thing to bet a court record on.

    A lease that is not `active` yields nothing, whatever name it still
    carries: a lease file holds every lease the server ever wrote, and naming
    a subscriber from a freed one is the wrong answer with a straight face.
    An address renewed appears again, and the later lease is the one that
    counts - unlike the static map, where a repeated address is refused.

    @param kind - 0 for the static map, 1 for an ISC dhcpd lease file
    @param path - the file to read, or empty for none
*/
autoreply define bpa_identity_source_set
{
  u32 client_index;
  u32 context;

  u8 kind;
  string path[256];
};

/** \brief Listen for the accounting a BNG already sends (issue #21)

    The third source of identity, and the only one that is not a file: a
    provider running PPPoE has the answer in the accounting stream their BNG
    is already sending, and this box reads it for one thing - which subscriber
    is on which address.

    THE SECRET IS REQUIRED. Without it this box cannot tell an accounting
    packet from anybody's packet, and its compliance log would take dictation
    about who is on which address. It is carried here and NOT returned in
    `show bpa config`: what the dataplane gives back is the port and that the
    listener is on, and the secret lives in the VTY's own configuration the
    way an SNMP community does - written to the saved file, redacted on every
    screen.

    @param enable - the listener on or off
    @param port - UDP port; 0 means RFC 2866's 1813
    @param secret - the shared secret this box checks every packet against
*/
autoreply define bpa_identity_radius_set
{
  u32 client_index;
  u32 context;

  bool enable;
  u16 port;
  string secret[128];
};

autoreply define bpa_logging_syslog_set
{
  u32 client_index;
  u32 context;

  bool enable;
  vl_api_ip4_address_t collector;
  u16 port;
  u32 enterprise;
  u8 facility;
  u8 severity;
};

/** \brief Lists the configured pools. */
define bpa_pool_dump
{
  u32 client_index;
  u32 context;
};

define bpa_pool_details
{
  u32 context;

  string name[64];
  u16 block_size;
  u16 port_min;
  u16 port_max;
  vl_api_bpa_policy_t policy;
  vl_api_bpa_mode_t mode;
  vl_api_bpa_filter_t filter;
  u8 max_blocks;
  u8 initial_blocks;
  u16 block_stride;
  u16 block_reserve;
  u32 alg;
  vl_api_bpa_timeouts_t timeouts;
  u16 tcp_mss;
  bool tcp_mss_auto;
  u32 max_sessions;
  u32 max_rate;
  u32 blocks_per_ip;
  /* What the formula may hand out, and what is held back. blocks_per_ip is
   * what a public address HOLDS; the two differ by the reserve, and capacity
   * is computed from blocks_mapped. A caller that reports capacity from
   * blocks_per_ip would promise subscribers the pool will drop. */
  u32 blocks_mapped;
  u32 reserve_count;
  u32 capacity;
  u32 inside_count;
  u32 outside_count;
  /*
   * The number to size against, and the worker count it was computed on.
   *
   * `capacity` is a ceiling nobody is promised: a dynamic pool's blocks are
   * sharded per worker and a subscriber draws only from its own worker's
   * slice, so it can be refused with blocks free elsewhere (#210).
   * "show bpa pool" stopped claiming the ceiling alone; a provisioning system
   * reading this message went on doing it, which is the same false promise
   * over the interface that is read by a machine rather than by somebody who
   * might notice.
   *
   * `n_workers` travels with it because the floor is not a property of the
   * pool: the same configuration guarantees a different number on a box with
   * four workers, and a caller that stored the figure without it could not
   * tell a re-sized box from a changed pool.
   *
   * Both come from bpa_pool_guaranteed(), which is also what the CLI prints.
   * Equal to `capacity` capped by `inside_count` whenever there is no shard
   * to lose anything to - a deterministic pool, or a single-threaded box.
   */
  u32 guaranteed;
  u32 n_workers;
};
