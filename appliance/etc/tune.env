# Dataplane interface: the one carrying subscriber traffic. Names the device
# handed to VPP and chooses the NUMA node for the workers.
#
# EMPTY ON PURPOSE. It used to ship as "eth0", which does not exist on a Debian
# 12 box with predictable interface names - so the tuner could not resolve it,
# generated a DPDK stanza with no device allowlist, and VPP took whatever NIC
# it found. On a single-NIC box that is the management interface, and the box
# left the network the moment the dataplane started (#123).
#
# Left empty, no device is claimed and the box stays reachable. Set it and
# restart hexarouting-tune and vpp.
#
# The interface carrying the default route is refused even if named here.
HEXA_DATAPLANE_IF=

# Subscriber target: sizes the hugepages.
HEXA_SUBSCRIBERS=200000

# Low latency: disables deep C-states and transparent hugepages, and keeps
# the cpufreq governor on performance. Costs power, buys predictable bursts.
# Set to 0 only if the box must save energy more than it must forward.
HEXA_LOW_LATENCY=1
