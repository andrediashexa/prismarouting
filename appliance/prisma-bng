#!/bin/sh
# The prisma-bng container's lifecycle, on the host (#597).
#
#   prisma-bng apply                start it, or restart it on a new configuration
#   prisma-bng reload               accel-ppp reads its file again; no session drops
#   prisma-bng stop                 stop and remove it (PPPoE no longer configured)
#   prisma-bng boot                 start it when PPPoE is configured; nothing otherwise
#   prisma-bng status               running | stopped | not-configured | no-containers
#   prisma-bng sessions             the sessions, one per line, '|'-separated
#   prisma-bng summary              accel-ppp's own counters
#   prisma-bng limiters             what enforces each direction's plan
#   prisma-bng terminate sid <id>   end one session
#   prisma-bng terminate username <name>
#   prisma-bng terminate all
#
# THE VTY ASKS THROUGH THE DOORS (src/prismash/doors.py). It writes the
# configuration into /etc/prisma-routing/bng from the candidate; this script
# is the only thing that starts, stops or asks the container, so the
# container's lifecycle is its own: a VTY upgrade recreates `mgmt` and touches
# nothing here, and a restart here touches neither vpp, frr nor mgmt.
#
# NOT STARTED BY THE STACK. compose.yaml gives the service a profile, and
# docker-compose 1.29.2 (the medium's) leaves a service with a profile out of
# a plain `up` and starts it when it is named - measured on 2026-10-12, with
# `down` removing it either way. So a box with no PPPoE never runs it, and
# prisma-routing-containers.service calls `boot` after `up`.
#
# Every external is a variable, so test/test_prisma_bng.sh and lab/pppoe.sh
# can drive this with a stub docker and docker-compose.
set -u

COMPOSE=${PRISMA_COMPOSE:-/usr/bin/docker-compose}
DOCKER=${PRISMA_DOCKER:-docker}
ETC=${PRISMA_ETC:-/etc/prisma-routing}
RUN=${PRISMA_RUN:-/run/prisma-routing}
CONF_DIR=$ETC/bng
LOG=${PRISMA_LOG:-/var/log/prisma-routing}
SERVICE=bng
# The name compose gives it: the project is the directory compose.yaml is in.
CONTAINER=${PRISMA_BNG_CONTAINER:-prisma-routing_bng_1}

say() { echo "prisma-bng: $*" >&2; }

# stack_env - the stack's environment from compose.env, as
# prisma-routing-containers.service has it through EnvironmentFile=: the
# images' tag (PRISMA_VERSION) and the box's vpp group (PRISMA_VPP_GID), both
# written by load-the-images. A value already in the environment wins.
#
# MEASURED ON THE FIRST INSTALLED BOX (0.153.97, 2026-10-12): without it
# compose resolved `prisma-bng:${PRISMA_VERSION:-latest}` to :latest, which no
# installed box has - "pull access denied", the container never started - and
# it proposed recreating vpp, whose service then read differently from the
# one running. The GID is loaded for the same reason: the vpp service's
# environment must read as it did when the stack was started.
stack_env() {
  [ -f "$RUN/compose.env" ] || return 0
  for _k in PRISMA_VERSION PRISMA_VPP_GID; do
    eval "_have=\${$_k:-}"
    [ -n "$_have" ] && continue
    _v=$(sed -n "s/^$_k=//p" "$RUN/compose.env" | tail -1)
    [ -n "$_v" ] && eval "export $_k=\$_v"
  done
  return 0
}

# compose <args...> - docker-compose on the stack's files, bng's profile on
compose() {
  stack_env
  _dev=""
  [ -f "$RUN/compose-devices.yaml" ] && _dev="-f $RUN/compose-devices.yaml"
  # shellcheck disable=SC2086
  (cd "$ETC" && "$COMPOSE" -f "$ETC/compose.yaml" $_dev --profile bng "$@")
}

# configured - is there a generated configuration to run?
configured() {
  [ -f "$CONF_DIR/accel-ppp.conf" ] && [ -f "$CONF_DIR/access.env" ]
}

# containers - does this box run the stack at all? The units path has no
# compose, and PPPoE is not offered there.
containers() {
  [ -f "$ETC/compose.yaml" ] && command -v "$COMPOSE" > /dev/null 2>&1
}

# running - is the container up?
running() {
  [ "$("$DOCKER" inspect -f '{{.State.Running}}' "$CONTAINER" 2>/dev/null)" = true ]
}

# cli <accel-cmd words...> - asked of the accel-pppd in the container
cli() {
  "$DOCKER" exec "$CONTAINER" prisma-bng-cli "$@"
}

# terminate_ok <kind> [<value>] - 0 when the words are one this accepts
terminate_ok() {
  case "$1" in
    all) [ $# -eq 1 ] ;;
    sid) [ $# -eq 2 ] && printf '%s' "$2" | grep -Eq '^[0-9a-fA-F]{16}$' ;;
    username)
      [ $# -eq 2 ] && printf '%s' "$2" | grep -Eq '^[A-Za-z0-9._@-]{1,64}$' ;;
    *) return 1 ;;
  esac
}

# limiters - what enforces each direction's plan (#610): "download <l>" and
# "upload <l>", <l> shaper or policer, as the generated accel-ppp.conf's
# [shaper] says - which accel-pppd reads at its start and at each reload,
# so after a commit it is what runs. `shaper` only where the file says so,
# `policer` otherwise: the patch's own reading (build/accel-ppp-ng.patch,
# vpppolicer_load_config), so a file older than format 7 reads as the
# policers it ran. Asked through the doors by the SNMP agent
# (prBngShaperDownLimiter), which as Debian-snmp cannot read the file: it
# holds the RADIUS secret. 1 with no file; 2 when this account cannot tell
# - the directory is 2770 and the file 0660, so an account outside the
# group sees no file where there is one, and must not say "none".
limiters() {
  if [ ! -f "$CONF_DIR/accel-ppp.conf" ]; then
    [ -d "$CONF_DIR" ] && [ ! -x "$CONF_DIR" ] && return 2
    return 1
  fi
  [ -r "$CONF_DIR/accel-ppp.conf" ] || return 2
  for _d in down up; do
    _l=$(sed -n "s/^vpp-$_d-limiter=//p" "$CONF_DIR/accel-ppp.conf" | tail -1)
    [ "$_l" = shaper ] || _l=policer
    if [ "$_d" = down ]; then echo "download $_l"; else echo "upload $_l"; fi
  done
  return 0
}

# not a unit: the dispatcher, each branch driven by test/test_prisma_bng.sh
main() {
  verb=${1:-}
  [ $# -gt 0 ] && shift
  case "$verb" in
    apply)
      containers || {
        say "PPPoE runs in the prisma-bng container, and this box runs the"
        say "dataplane as systemd units; move it to the containers first"
        exit 4; }
      configured || { say "no generated configuration in $CONF_DIR"; exit 3; }
      # Where accel-ppp logs, on the log volume the container mounts; the
      # entrypoint makes it too, for a container started by `boot`.
      install -d -m 0750 "$LOG/bng" 2>/dev/null
      if running; then
        # A restart, not a recreate, when the image is the same: the
        # configuration is a bind mount, read again at start.
        compose up -d --no-deps --force-recreate "$SERVICE" > /dev/null 2>&1 \
          || { say "could not restart $SERVICE"; exit 1; }
        echo "restarted"
      else
        compose up -d --no-deps "$SERVICE" > /dev/null 2>&1 \
          || { say "could not start $SERVICE"; exit 1; }
        echo "started"
      fi ;;
    reload)
      # #607: a RADIUS change. accel-ppp reads [radius] (and [shaper])
      # again at `reload`, and every session stays up; the entrypoint, in
      # the container, rebuilds the file it runs on - the generated one and
      # the CLI section with ITS password - and asks. Not running is 3, and
      # the VTY starts it instead.
      running || { echo "not running"; exit 3; }
      out=$("$DOCKER" exec "$CONTAINER" prisma-bng-entrypoint reload 2>&1) \
        || { say "reload refused: $out"; exit 1; }
      echo "reloaded" ;;
    stop)
      containers || { echo "stopped"; exit 0; }
      compose stop -t 20 "$SERVICE" > /dev/null 2>&1
      compose rm -f "$SERVICE" > /dev/null 2>&1
      echo "stopped" ;;
    boot)
      containers || exit 0
      configured || exit 0
      compose up -d --no-deps "$SERVICE" > /dev/null 2>&1 \
        || { say "could not start $SERVICE"; exit 1; }
      echo "started" ;;
    status)
      if ! containers; then echo "no-containers"
      elif running; then echo "running"
      elif configured; then echo "stopped"
      else echo "not-configured"
      fi ;;
    sessions)
      running || { echo "not running"; exit 3; }
      cli show sessions sid,ifname,username,ip,calling-sid,state,uptime-raw,rx-bytes-raw,tx-bytes-raw,rate-limit,ip6,ip6-dp ;;
    summary)
      running || { echo "not running"; exit 3; }
      cli show stat ;;
    limiters)
      limiters; rc=$?
      [ $rc -eq 1 ] && { echo "not-configured"; exit 3; }
      [ $rc -eq 2 ] && { say "cannot read $CONF_DIR/accel-ppp.conf"; exit 1; }
      exit 0 ;;
    terminate)
      terminate_ok "$@" || { say "terminate sid <16 hex> | username <name> | all"; exit 2; }
      running || { echo "not running"; exit 3; }
      if [ "$1" = all ]; then
        cli terminate all hard
      else
        cli terminate "$1" "$2" hard
      fi ;;
    *)
      say "usage: prisma-bng apply|reload|stop|boot|status|sessions|summary|limiters|terminate"
      exit 2 ;;
  esac
}

[ "${PRISMA_BNG_SOURCE_ONLY:-0}" = 1 ] || main "$@"
