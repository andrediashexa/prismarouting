#!/bin/sh
# Bind the dataplane NIC to a driver DPDK can take it through.
#
# WITHOUT THIS THE APPLIANCE DOES NOT FORWARD. Nothing in this product ever
# bound a NIC or loaded vfio-pci, so an operator who did exactly what the
# self-test told them - name the interface in tune.env - got a startup.conf
# with the right PCI address, a NIC still held by its kernel driver, and a
# dataplane with no interfaces. On Intel and Broadcom parts DPDK cannot take a
# device through ixgbe, i40e, bnxt_en and the rest. Mellanox is the exception,
# because mlx5 is bifurcated and works while kernel-bound, which is why this
# looked like it worked on some hardware and not others (issue #283).
#
# WHAT IT BINDS IS WHAT startup.conf NAMES, and that is deliberate. The tuner
# has already decided which cards the dataplane gets - every card but a
# reserve, or the one the operator named - and whether the card this box is
# reached on may go at all: it reads that card's address, MAC and gateway on
# this boot and names no card whose way back it could not read (#378).
# Reading its output rather than tune.env means those decisions are inherited
# rather than reimplemented: a second copy of "which NIC may the dataplane
# have" is a second copy that can disagree with the first.
#
# It decides NOTHING about which card. It used to read the default route
# itself and refuse the card carrying it (#123), letting the last card through
# only beside a way back (#303, then #378). That went with #385, on the
# maintainer's decision: a box is configured at its console when it is new,
# so a guard on the card it is reached over guards a step nobody takes over
# the network, and the one fact the guard needed - is there a way back - is
# the tuner's to decide before it names the card, not this program's to
# second-guess after.
set -u

ROOT=${PRISMA_ROOT:-}
VPPCONF=${PRISMA_STARTUP_CONF:-$ROOT/etc/vpp/startup.conf}
SYSBUS=${PRISMA_PCI_BUS:-$ROOT/sys/bus/pci}
SYSNET=${PRISMA_SYS_NET:-$ROOT/sys/class/net}
IOMMU=${PRISMA_IOMMU_GROUPS:-$ROOT/sys/kernel/iommu_groups}

say() { echo "$@" >&2; }

# The drivers DPDK can use, best first. vfio-pci is the one to want: it takes
# the device through the IOMMU, so a bug in the dataplane cannot write to
# memory the device was never given. uio_pci_generic has no such protection
# and is the fallback for a box whose firmware has no IOMMU at all.
DPDK_DRIVERS="vfio-pci uio_pci_generic"

# ANSWERING THE QUESTION WITHOUT DOING THE WORK.
#
# `show hardware` tells an operator what will happen to each NIC when the box
# claims it, and the honest way to know is to ask the thing that decides. The
# alternative was a third copy of the IOMMU rule inside the VTY, and there are
# already two copies of the driver list - this file's and prismash.py's - which
# is how a screen comes to promise vfio-pci on a box that will fall back
# (#328).
#
# Binds nothing, needs no device named, and exits 0 so a caller can read the
# answer off stdout.
# ONE HOLDER of the IOMMU rule. Written twice, this file would answer the VTY
# from one copy and bind from the other, so the screen could promise vfio-pci
# on a box that binds uio_pci_generic - which is the exact thing the paragraph
# above says this mode exists to prevent. The bind below calls this too.
dpdk_driver() {
  if [ -d "$IOMMU" ] && [ -n "$(ls -A "$IOMMU" 2>/dev/null)" ]; then
    echo vfio-pci
  else
    echo uio_pci_generic
  fi
}

if [ "${1:-}" = "--which-driver" ]; then
  if [ "$(dpdk_driver)" = "vfio-pci" ]; then
    echo "vfio-pci through the IOMMU"
  else
    echo "uio_pci_generic without IOMMU protection, because this box has no"\
         "IOMMU groups"
  fi
  exit 0
fi

# The PCI address a netdev sits on, or nothing.
#
# The NEAREST PCI ancestor, not the basename of the link. A virtio NIC's
# `device` points at .../0000:00:12.0/virtio3, so the basename is `virtio3`
# and every comparison against a PCI address fails - which is #286 one
# directory short. Here it costs the bind line the one word an operator
# recognises, the interface name, on exactly the machines this product is
# first tried on.
pci_addr_of() {  # <netdev path>
  _p=$(readlink -f "$1/device" 2>/dev/null) || return 1
  while [ -n "$_p" ] && [ "$_p" != "/" ]; do
    case "$(basename "$_p")" in
      [0-9a-f]*:[0-9a-f]*:[0-9a-f]*.[0-9a-f]*) basename "$_p"; return 0 ;;
    esac
    _p=$(dirname "$_p")
  done
  return 1
}

# EVERY DEVICE THE TUNER NAMED, and this took the first of them (#378).
#
# `head -1` was right for exactly as long as the tuner could name one card.
# Since the box claims every card it has but a reserve, a three-card box gets
# three `dev` stanzas - and binding the first left the other two on their
# kernel drivers, which DPDK cannot take a device through. The dataplane would
# then come up holding one card out of three and the self-test would call it
# healthy, because a device named in a file is not a device the dataplane has
# (#283).
#
# Still what startup.conf NAMES and not what the box has, which is the
# argument in this file's header and is unchanged: the tuner has already
# applied every rule about which cards the dataplane may have, and a second
# copy of that decision here is one that can disagree.
ADDRS=$(sed -n 's/.*dev \(0000:[0-9a-fA-F:.]*\).*/\1/p' "$VPPCONF" 2>/dev/null)
if [ -z "$ADDRS" ]; then
  # No device named. That is the no-pci case, which the tuner and the
  # self-test both already explain, so this says nothing rather than adding a
  # third voice to one fact.
  #
  # EXCEPT IN --compose-devices, WHICH MUST PRINT A DOCUMENT. What it writes
  # is handed to `docker-compose -f`, and compose refuses an empty file with
  # "Top level object needs to be a mapping" - so a no-pci box would have a
  # container stack that will not start, for the one reason the rest of the
  # product treats as ordinary. An empty `devices` list is the right answer
  # and not a placeholder: measured on docker-compose 1.29.2, the version
  # the medium carries, `devices` MERGES BY APPENDING across -f files, so
  # [] adds nothing and leaves the base file's /dev/net/tun and
  # /dev/vhost-net exactly as they are.
  if [ "${1:-}" = "--compose-devices" ]; then
    echo "# Generated by appliance/bind-dataplane-nic --compose-devices."
    echo "# startup.conf names no PCI device on this boot, so there is no"
    echo "# card node to hand a container. The list is empty and appends"
    echo "# nothing to the devices the compose file already names."
    echo "services:"
    echo "  vpp:"
    echo "    devices: []"
  fi
  exit 0
fi

# THE DEVICE NODES A CONTAINER HAS TO BE HANDED, for the cards this box
# actually claims (#396). A dataplane in a container reaches its NIC through
# a device node and not through the PCI bus, and WHICH node follows from the
# driver this box can use - the rule this file is the one holder of. Written
# anywhere else it would be a second copy, and a compose file promising
# /dev/vfio on a box that binds uio_pci_generic is exactly the defect #328
# was about, wearing a container.
#
# It is a MODE and not a file: what it prints is a compose override fragment,
# and the piece that starts the containers merges it. Binds nothing, and runs
# after the bind rather than before it - on the uio path the node does not
# exist until the device is bound, which this says rather than guesses.
if [ "${1:-}" = "--compose-devices" ]; then
  _want=$(dpdk_driver)
  _nodes=""
  if [ "$_want" = "vfio-pci" ]; then
    # The container device itself, once, plus one group node per card. A
    # container given the groups and not /dev/vfio/vfio cannot open the
    # VFIO container at all, and the EAL fails with the cards in front of it.
    _nodes="/dev/vfio/vfio"
    for a in $ADDRS; do
      _g=$(readlink "$SYSBUS/devices/$a/iommu_group" 2>/dev/null)
      _g=${_g##*/}
      if [ -z "$_g" ]; then
        say "compose: $a is in no IOMMU group, so there is no /dev/vfio node"
        say "compose: to hand a container. The card is not bound to vfio-pci"
        say "compose: yet, or this box's firmware groups it elsewhere."
        exit 1
      fi
      _nodes="$_nodes /dev/vfio/$_g"
    done
  else
    for a in $ADDRS; do
      _u=$(ls "$SYSBUS/devices/$a/uio" 2>/dev/null | head -1)
      if [ -z "$_u" ]; then
        say "compose: $a has no uio node, so it is not bound to"
        say "compose: uio_pci_generic yet. This mode reads what the bind"
        say "compose: produced; run it after the bind, not before."
        exit 1
      fi
      _nodes="$_nodes /dev/$_u"
    done
  fi
  echo "# Generated by appliance/bind-dataplane-nic --compose-devices."
  echo "# The driver this box can use is $_want, and these are the nodes it"
  echo "# gives the dataplane. Do not edit: the cards and the driver are read"
  echo "# off this boot."
  echo "services:"
  echo "  vpp:"
  echo "    devices:"
  for n in $_nodes; do
    echo "      - $n"
  done
  exit 0
fi

# One device, start to finish. Everything box-wide - which driver this machine
# can use, whether it is loaded - is decided once, below, and handed in.
#
# ITS STATUS IS PER DEVICE and the caller keeps the worst. A box whose second
# card will not bind still wants its first one bound: stopping at the first
# failure would cost the operator the cards that were fine, and the reason the
# bind failed is printed either way.
# vfio-pci needs an IOMMU. Without one it loads and then refuses every device,
# which reads on the console as the bind failing for no reason - so the choice
# is made here, where it can be explained, rather than discovered there.
#
# ONCE FOR THE BOX AND NOT ONCE PER CARD (#378). Which driver this machine can
# use is a property of its firmware, so asking per device would print the same
# IOMMU sentence three times on a three-card box - and the operator reading a
# console would reasonably take three warnings for three faults.
want=$(dpdk_driver)
if [ "$want" != "vfio-pci" ]; then
  # Two lines, because one was 121 columns on the console this is printed to
  # (#346). `say` takes each argument and prints them space-joined on ONE
  # line, so a continuation in the source is not a line break in the output -
  # which is how this came to be the widest line the appliance prints.
  say "bind: no IOMMU groups on this box, so vfio-pci cannot take a device."
  say "      Using $want, which has no IOMMU protection."
fi

if [ ! -d "$SYSBUS/drivers/$want" ]; then
  modprobe "$want" 2>/dev/null || true
fi
if [ ! -d "$SYSBUS/drivers/$want" ]; then
  # The driver name comes first and uio_pci_generic is fifteen columns of it,
  # which put the address on the far side of the margin at 86 (#367). Moving
  # the address to the second row costs nothing: both are bounded, and the row
  # an operator reads first is the one that names what is missing.
  say "bind: $want is not available on this box, so the dataplane"
  say "      cannot be given any card. The kernel has no such driver."
  exit 1
fi

bind_one() {  # <pci address> <driver to use>
    ADDR=$1
    want=$2
    DEV="$SYSBUS/devices/$ADDR"
  # TWO ROWS, because one was 88 columns on the 80-column console this prints to
  # (#367). `say` joins its arguments with a space onto ONE row, so a
  # continuation in the source is not a break in the output - the same trap the
  # two-line message further down names. The address is twelve columns and the
  # file the tuner wrote is another twenty-one, and the verdict has to stay one
  # row: what moves off it is the path, onto the end of a row of its own where a
  # fold costs nothing.
  [ -d "$DEV" ] || { say "bind: no such PCI device as $ADDR on this box."
                     say "      It is the device named in $VPPCONF"; return 1; }

  current=$(basename "$(readlink -f "$DEV/driver" 2>/dev/null)" 2>/dev/null)
  [ "$current" = "." ] && current=""
  for d in $DPDK_DRIVERS igb_uio; do
    if [ "$current" = "$d" ]; then
      say "bind: $ADDR is already bound to $d"
      return 0
    fi
  done

  # The interface name, for the messages, while it still has one: once the
  # device is bound to vfio-pci the kernel netdev is gone.
  #
  # Through pci_addr_of() and not the basename of the link, for the reason that
  # function was written: on a virtio guest the basename is `virtio7` and never
  # equals a PCI address, so every bind message on every VM lost the interface
  # name, which is the one word in it an operator recognises.
  ifname=""
  for n in "$SYSNET"/*; do
    [ -e "$n/device" ] || continue
    if [ "$(pci_addr_of "$n")" = "$ADDR" ]; then
      ifname=$(basename "$n")
      break
    fi
  done

  say "bind: $ADDR${ifname:+ ($ifname)} from ${current:-no driver} to $want"

  # driver_override rather than new_id: new_id matches by vendor and device, so
  # it claims EVERY card of that model in the box - including the management
  # one when both ports are the same part, which is the ordinary case on a
  # two-port card. driver_override names this one device and nothing else.
  echo "$want" > "$DEV/driver_override" 2>/dev/null || {
    say "bind: cannot write driver_override for $ADDR"; exit 1; }
  if [ -n "$current" ]; then
    echo "$ADDR" > "$DEV/driver/unbind" 2>/dev/null || {
      say "bind: cannot unbind $ADDR from $current"; exit 1; }
  fi
  echo "$ADDR" > "$SYSBUS/drivers_probe" 2>/dev/null || true

  now=$(basename "$(readlink -f "$DEV/driver" 2>/dev/null)" 2>/dev/null)
  [ "$now" = "." ] && now=""
  if [ "$now" = "$want" ]; then
    say "bind: $ADDR is now on $want"
    exit 0
  fi

  # Said as a failure, because it is one, and with the state it ended in. A
  # device left with no driver at all is the worst outcome to be quiet about:
  # the kernel no longer has the NIC and neither does the dataplane.
  say "bind: $ADDR did NOT bind to $want; it is on ${now:-no driver at all} now."
  say "      The dataplane will start without it. 'dmesg' says why $want"
  say "      refused the device."
  #
  # AND THE ADVICE ASKS WHICH BOX IT IS ON. This was one sentence for both
  # drivers: "on a box with an IOMMU the usual cause is intel_iommu=on or
  # amd_iommu=on missing from the kernel command line". It is false of each of
  # the two boxes that can reach it, in opposite directions.
  #
  # With vfio-pci the box HAS IOMMU groups - that is the only way dpdk_driver()
  # returns it - so the parameter cannot be the missing thing. The operator is
  # sent to check a kernel command line that is already right, on the one
  # message they get when the appliance comes up not forwarding.
  #
  # With uio_pci_generic the box has NO IOMMU, so a sentence opening "on a box
  # with an IOMMU" is about a different machine, and the parameter it names
  # would not have helped: that driver does not use an IOMMU at all.
  if [ "$want" = "vfio-pci" ]; then
    say "      This box has IOMMU groups, so the kernel command line is not the"
    say "      cause: vfio-pci is being offered a device it will not take."
    say "      Read this, on the box:"
    say "        $SYSBUS/devices/$ADDR/iommu_group"
    say "      A device with no group of its own cannot go, and a group whose"
    say "      other members are still held by host drivers cannot either."
  else
    say "      This box has no IOMMU groups, which is why vfio-pci was not"
    say "      tried. uio_pci_generic needs a legacy INTx interrupt, and a"
    say "      device that has only MSI-X is refused. Enabling an IOMMU in the"
    say "      firmware and on the kernel command line is what makes vfio-pci"
    say "      available instead."
  fi
    return 1
}

# EVERY NAMED DEVICE, and the worst answer is the one that is reported.
#
# A card that fails to bind does not stop the ones after it: on a box claiming
# three, two that bind and one that does not is a box that forwards on two -
# strictly better than one that gave up at the first and forwards on none. The
# status is kept so apply-tuning still learns that something went wrong, and
# each failure has already printed its own reason above.
rc=0
for a in $ADDRS; do
  bind_one "$a" "$want" || rc=1
done
exit "$rc"
