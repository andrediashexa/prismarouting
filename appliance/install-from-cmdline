#!/bin/sh
# Runs the installer when the kernel command line asks for it.
#
# The keys are still spelled prisma-routing.* after the rename to Prisma Routing
# (#202): they are an interface a PXE server or a prepared medium already
# carries, and a key is a name a machine reads, not one a person does.
#
#   prisma-routing.install             prompt for everything on the console
#   prisma-routing.install=/dev/vda    that disk, still asking for the rest
#   prisma-routing.hostname=<name>     answer the hostname question
#   prisma-routing.timezone=<zone>     answer the timezone question
#   prisma-routing.password=<pw>       answer the root password question
#   prisma-routing.log-gb=<n>          gigabytes for the connection records
#   prisma-routing.mirror=<disk>       mirror the records onto a second disk
#   prisma-routing.mgmt-interface=<if> the card this box is managed on
#   prisma-routing.mgmt-address=<a>    dhcp, or a.b.c.d/nn, or none
#   prisma-routing.mgmt-gateway=<ip>   with a static address only
#   prisma-routing.mgmt-dns=<ip>[,..]  with a static address only
#   prisma-routing.answers[=<file>]    read the answers from a file on the medium
#   prisma-routing.yes                 skip the confirmations
#
# The kernel command line is the hook rather than typing into the console,
# because a test that drives an installer by sending keystrokes at the right
# moment tests the timing of the keystrokes.
#
# prisma-routing.password is a real feature for automated and PXE installs, and it
# has a real cost: the kernel command line is world-readable in /proc/cmdline
# for the life of the booted system. On the INSTALLED system that does not
# apply - the installer's own command line does not survive the reboot - but
# anyone logged into the live medium while it installs can read it. For a
# hands-on install, leave it out and answer the prompt.
#
# prisma-routing.answers is the unattended path that does not do that: the same
# answers, the password among them, read from a file instead of published to
# every process on the box (#83). It moves the secret rather than removing it -
# whoever can read the medium can read the file - but a medium is a thing that
# can be locked in a drawer, and /proc/cmdline is not.
set -u
cmdline=$(cat /proc/cmdline 2>/dev/null || echo "")

case " $cmdline " in
  *" prisma-routing.install"*) ;;
  *) exit 0 ;;
esac

disk=""
for tok in $cmdline; do
  case "$tok" in
    prisma-routing.install=*)  disk=${tok#prisma-routing.install=} ;;
    prisma-routing.hostname=*) PRISMA_HOSTNAME=${tok#prisma-routing.hostname=};      export PRISMA_HOSTNAME ;;
    prisma-routing.timezone=*) PRISMA_TIMEZONE=${tok#prisma-routing.timezone=};      export PRISMA_TIMEZONE ;;
    prisma-routing.password=*) PRISMA_ROOT_PASSWORD=${tok#prisma-routing.password=}; export PRISMA_ROOT_PASSWORD ;;
    prisma-routing.log-gb=*)   PRISMA_LOG_GB=${tok#prisma-routing.log-gb=};          export PRISMA_LOG_GB ;;
    prisma-routing.mirror=*)   PRISMA_MIRROR=${tok#prisma-routing.mirror=};            export PRISMA_MIRROR ;;
    # The management network (#303). Four tokens and not one, because an
    # address, the card it goes on, the gateway and the resolver are four
    # answers - and a single packed token would be a format to get wrong on a
    # kernel command line nobody can edit once the box is booting.
    prisma-routing.mgmt-interface=*)
      PRISMA_MGMT_INTERFACE=${tok#prisma-routing.mgmt-interface=}; export PRISMA_MGMT_INTERFACE ;;
    prisma-routing.mgmt-address=*)
      PRISMA_MGMT_ADDRESS=${tok#prisma-routing.mgmt-address=};     export PRISMA_MGMT_ADDRESS ;;
    prisma-routing.mgmt-gateway=*)
      PRISMA_MGMT_GATEWAY=${tok#prisma-routing.mgmt-gateway=};     export PRISMA_MGMT_GATEWAY ;;
    prisma-routing.mgmt-dns=*)
      PRISMA_MGMT_DNS=${tok#prisma-routing.mgmt-dns=};             export PRISMA_MGMT_DNS ;;
    prisma-routing.answers=*)  PRISMA_ANSWERS=${tok#prisma-routing.answers=};          export PRISMA_ANSWERS ;;
    # Bare, it means the file the medium is expected to carry. A default path
    # so that the operator writing the medium and the operator booting it do
    # not have to agree on one by memory.
    prisma-routing.answers)    PRISMA_ANSWERS=/run/live/medium/prisma-routing.answers; export PRISMA_ANSWERS ;;
    prisma-routing.yes)        PRISMA_INSTALL_YES=1; export PRISMA_INSTALL_YES ;;
  esac
done

exec >/dev/console 2>&1 </dev/console

# The answer file is read HERE as well as inside the installer, because THIS
# script decides whether the install is unattended - and "unattended" is one of
# the answers. Read through the installer's own parser, sourced at its library
# seam: two parsers disagreeing about which answers a file gave is worse than
# one, and the answer they would disagree about is the password.
#
# After the exec above, so that a complaint about the file lands on the console
# with the rest of the install rather than in a journal the operator standing
# there cannot reach yet.
#
# The command line was parsed first, above, and the parser leaves an answer that
# is already given alone: what somebody typed for this boot beats what travels
# with the medium for every install it does.
answers_rc=0
if [ -n "${PRISMA_ANSWERS:-}" ]; then
  PRISMA_INSTALL_LIB=1 . /usr/sbin/prisma-routing-install
  answers_rc=$?
  # Unset, never left set. Exported into the installer's environment it would
  # make the installer return at that same seam and do nothing at all - an
  # install that writes not one byte and exits zero, which every caller below
  # would report as a finished install.
  unset PRISMA_INSTALL_LIB
  # And the file itself, once it has been read: every answer it gave is in the
  # environment now, so leaving it set only makes the installer read it and
  # announce it a second time. A console that says the same thing twice invites
  # whoever is reading it to work out which of the two acted.
  [ "$answers_rc" = 0 ] && unset PRISMA_ANSWERS
fi

# This path reports its own outcome and powers off, so it takes the reboot into
# its own hands.
PRISMA_INSTALL_NO_REBOOT=1; export PRISMA_INSTALL_NO_REBOOT

# An unusable answer file does not become an install attempt. The answers are
# the thing this boot was given instead of a console, and running the installer
# without them is how an unattended install arrives at a question and hangs.
if [ "$answers_rc" = 0 ]; then
  /usr/sbin/prisma-routing-install ${disk:+"$disk"}
  rc=$?
else
  echo "the answers were not usable; nothing was written to any disk"
  rc=$answers_rc
fi

if [ "${PRISMA_INSTALL_YES:-0}" != 1 ]; then
  # A hands-on install from the command line: the installer already said what
  # happened, and the operator is sitting there.
  exit $rc
fi

# Unattended: say so and power off.
#
# Both halves matter. The marker is printed only on success, so a failed
# install cannot be mistaken for a finished one. The poweroff is what makes the
# marker reliable at all: without it the machine sits at a login prompt until
# the harness times out and kills it mid-line - which is exactly how this was
# first seen, with the console reading "Prisma Routing inst".
if [ "$rc" = 0 ]; then
  echo "Prisma Routing installed to ${disk:-the chosen disk}"
else
  echo "Prisma Routing install FAILED on ${disk:-the chosen disk} (status $rc)"
fi
sync
sleep 1
systemctl poweroff --no-block 2>/dev/null || poweroff -f 2>/dev/null || true
exit $rc
