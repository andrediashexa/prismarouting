# Sourced by dhclient-script from /etc/dhcp/dhclient-enter-hooks.d/, before it
# writes /etc/resolv.conf (#437).
#
# While `dns server` in the VTY owns that file - its first line says so - a
# lease must not rewrite it: dhclient-script calls make_resolv_conf() on every
# lease and every renewal, and would put the DHCP server's resolvers back in
# silence. This replaces that one function with nothing, for as long as the
# line is there. When the last `dns server` is removed the VTY puts the old
# file back, the line is gone, and DHCP writes the file again.
#
# Measured on isc-dhcp-client 4.4.3-P1-2, the version the image carries:
# make_resolv_conf() is defined at the top of the script and the enter hooks
# are sourced (`. $script`) after it and before it is called, so a function
# defined here replaces it. No dot in this file's name: run-parts, which
# lists the hooks, skips a name with one.
# PRISMA_RESOLV_CONF is set by test/test_prismash_system.py and by nothing on
# a box, where dhclient-script's environment does not carry it.
if [ "$(head -n 1 "${PRISMA_RESOLV_CONF:-/etc/resolv.conf}" 2>/dev/null)" = \
     "# Written by Prisma Routing: 'dns server' in the VTY owns this file." ]; then
    make_resolv_conf() { :; }
fi
