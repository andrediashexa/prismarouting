#!/bin/sh
# The prisma-bng container's main process (#597): the PPPoE control plane.
# compose.yaml runs it under docker's init, which forwards SIGTERM to it.
#
# WHAT IT DOES, in order, and why each step is here and not in the VTY:
#
#   1. waits for the dataplane to answer;
#   2. lays the plumbing VPP's pppoe plugin needs - the control-plane TAP
#      (`pppoe-cp`, tap1863), its Linux MAC set to the access card's, one
#      Linux VLAN device per tagged access interface, and `create pppoe cp`;
#   3. removes the session policers a control plane that died left
#      (clean_policers); its sessions, and their routes before them, are
#      removed by accel-pppd at its own start (#607, the patch's
#      vppiputils.c) - nothing else would take them down, and their client
#      MACs would be refused a new session;
#   4. runs accel-pppd on the configuration the VTY GENERATED from the
#      candidate (/etc/prisma-routing/bng/accel-ppp.conf, never edited by
#      hand), with a CLI password of its own made here;
#   5. watches both: accel-pppd exiting, or the dataplane losing the
#      plumbing (a VPP restart takes the TAP with it), ends the container
#      with a failure, and the restart policy starts it again from step 1.
#
# EVERY START AND EVERY EXIT IT CAN SEE IS WRITTEN DOWN (run_note), with
# accel-pppd's exit code or signal, in $RUN_DIR/runs - the host's /run, so
# it outlives the container and not the boot. The host's watcher reads it
# into `show log` (src/prismash/eventwatch.py, bng_changes): docker brings
# the container back within a second, so two readings 10 s apart of
# "is it running" see nothing of a crash, and docker's own State.ExitCode is
# reset to 0 by the start that follows (measured with docker 27.1.1: the
# exit code readable for under 0.1 s, the restart 35-86 ms after the exit).
#
# The plumbing lives here because it belongs to the container's lifetime, not
# to a commit: a dataplane restart removes it, and the only process that is
# guaranteed to notice is the one using it. The VTY writes WHAT is wanted
# (access.env); this script makes it so every time it starts.
#
# ON SIGTERM (docker stop, the container's own restart, `no pppoe`): accel-
# pppd is stopped first - it sends PADT and Accounting-Stop for every session
# and deletes them from VPP - then any session it left is deleted. The TAP and
# the plugin's cp are LEFT IN PLACE: taking them out crashes VPP at the next
# discovery frame (measured; unplumb() has the trace).
#
# Every path is a variable so test/test_prisma_bng.sh can drive this with
# stubs; on the box they are the defaults.
set -u

CONF_DIR=${PRISMA_BNG_CONF:-/etc/prisma-routing/bng}
RUN_DIR=${PRISMA_BNG_RUN:-/run/prisma-routing/bng}
LOG_DIR=${PRISMA_BNG_LOG:-/var/log/prisma-routing/bng}
VPPCTL=${PRISMA_VPPCTL:-vppctl}
ACCEL=${PRISMA_ACCEL:-/usr/sbin/accel-pppd}
IP=${PRISMA_IP:-ip}
WAIT_VPP=${PRISMA_BNG_WAIT_VPP:-120}
WATCH_EVERY=${PRISMA_BNG_WATCH_EVERY:-2}
# The TAP's id, and so its VPP name: tap1863, for the discovery ethertype.
# Not 4096 and up, which linux_cp takes for its pairs.
TAP_ID=1863
TAP=tap$TAP_ID
CP=pppoe-cp

say() { echo "prisma-bng: $*" >&2; }

vc() { "$VPPCTL" "$@" 2>/dev/null | tr -d '\r'; }

# wait_vpp - 0 once the dataplane answers, 1 after WAIT_VPP seconds
wait_vpp() {
  _n=0
  until vc show version | grep -q '^vpp'; do
    _n=$((_n + 1))
    [ "$_n" -ge "$WAIT_VPP" ] && return 1
    sleep 1
  done
  return 0
}

# hw_mac <vpp interface> - its Ethernet address, or nothing
hw_mac() {
  vc show hardware-interfaces "$1" | sed -n 's/.*Ethernet address \([0-9a-f:]*\).*/\1/p' \
    | head -1
}

# sw_index <vpp interface> - its sw_if_index, or nothing
sw_index() {
  vc show interface "$1" | awk -v n="$1" '$1 == n {print $2; exit}'
}

# plumb - the TAP, its MAC, its VLAN devices and the plugin's cp; 0 or 1
plumb() {
  # shellcheck disable=SC1091
  . "$CONF_DIR/access.env" || { say "no $CONF_DIR/access.env"; return 1; }
  mac=$(hw_mac "$PARENT")
  [ -n "$mac" ] || { say "the dataplane has no card '$PARENT'"; return 1; }
  if [ -z "$(sw_index "$TAP")" ]; then
    vc create tap id "$TAP_ID" host-if-name "$CP" > /dev/null
  fi
  idx=$(sw_index "$TAP")
  [ -n "$idx" ] || { say "could not create $TAP"; return 1; }
  vc set interface state "$TAP" up > /dev/null
  # THE ACCESS CARD'S MAC ON THE LINUX SIDE, and it is not cosmetic: the
  # plugin rewrites every frame it sends from the cp to come from the access
  # card, so the PADR comes back addressed to it - and accel-ppp drops a
  # discovery frame not addressed to the interface it is bound to (measured
  # in #170's lab/bng.sh: discovery dies after PADO with nothing logged).
  "$IP" link set "$CP" down
  "$IP" link set "$CP" address "$mac" || return 1
  "$IP" link set "$CP" up
  for v in $VLANS; do
    [ "$v" = 0 ] && continue
    "$IP" link show "$CP.$v" > /dev/null 2>&1 ||
      "$IP" link add link "$CP" name "$CP.$v" type vlan id "$v" || return 1
    "$IP" link set "$CP.$v" up
  done
  # ONCE PER TAP. `create pppoe cp` enables a device-input feature on the
  # TAP, and VPP adds a feature as often as it is asked; a container restart
  # finds the TAP it laid last time and must not stack a second one.
  case "$(vc show interface features "$TAP")" in
    *pppoe-input*) ;;
    *) vc create pppoe cp cp-if-index "$idx" > /dev/null ;;
  esac
  guard "$(access_names)" || return 1
  return 0
}

# access_names - the access interfaces' dataplane names, from access.env:
# ACCESS since format 5; an older file's PARENT and VLANS otherwise, named
# as the VTY names a VLAN's sub-interface (<card>.<vlan>)
access_names() {
  if [ -n "${ACCESS:-}" ]; then
    echo "$ACCESS"
    return 0
  fi
  _names=""
  for v in ${VLANS:-0}; do
    if [ "$v" = 0 ]; then _names="$_names $PARENT"
    else _names="$_names $PARENT.$v"; fi
  done
  echo $_names
}

# guard <names> - PPPoE taken by the dataplane only on these interfaces, and
# a subscriber's MAC held by the one its session is on (the plugin's
# bpa_pppoe_guard.c, docs/bng.md 0.3 item 7): `set bpa pppoe-access`, which
# replaces the whole set. Empty refuses every PPPoE frame. 0 or 1.
#
# MEASURED BEFORE IT (lab/pppoe.sh, 0.155.3): a PADI from the upstream was
# answered with a PADO, and sub1's MAC on VLAN 100 took sub1's session down
# again and again. VPP's plugin takes PPPoE from every interface and keys
# its control plane's way back by the MAC alone.
guard() {
  # shellcheck disable=SC2086
  _out=$(vc set bpa pppoe-access $1)
  case "$_out" in
    "") return 0 ;;
    # A plugin older than the guard: PPPoE works as it did, from every
    # interface, and that is said rather than the container ending.
    *"unknown input"*|*"parse error"*)
      say "the dataplane's plugin has no 'set bpa pppoe-access': PPPoE is taken from every interface"
      return 0 ;;
  esac
  say "the dataplane refused the access interfaces '$1': $_out"
  return 1
}

# oom_kills - the container's cgroup's count of OOM kills, or 0
oom_kills() {
  sed -n 's/^oom_kill //p' "${PRISMA_BNG_MEMEVENTS:-/sys/fs/cgroup/memory.events}" 2>/dev/null \
    | head -1 | grep -E '^[0-9]+$' || echo 0
}

# exit_reason <status> <oom kills at start> - why accel-pppd ended, in words
exit_reason() {
  if [ "$1" -gt 128 ]; then
    _sig=$(kill -l "$(($1 - 128))" 2>/dev/null)
    if [ "$(oom_kills)" -gt "$2" ]; then
      echo "accel-pppd was killed by the OOM killer (signal $(($1 - 128)), the container's memory limit)"
    else
      echo "accel-pppd was killed by signal $(($1 - 128))${_sig:+ ($_sig)}"
    fi
  else
    echo "accel-pppd exited with code $1"
  fi
}

# run_note start | exit <code> <reason...> - one line of this container's
# record of its runs, "<n> <epoch> <words>", the newest RUNS_KEPT kept. The
# host's watcher reads every line past the last <n> it saw; <n> going back
# is a new boot's record (/run is a tmpfs). Through a rename, so a reader
# never sees half a line.
RUNS_KEPT=32
run_note() {
  _f="$RUN_DIR/runs"
  _n=$(tail -n 1 "$_f" 2>/dev/null | awk '{print $1 + 0}')
  _n=$(( ${_n:-0} + 1 ))
  { tail -n $((RUNS_KEPT - 1)) "$_f" 2>/dev/null
    echo "$_n $(date +%s) $*"; } > "$_f.new" && mv -f "$_f.new" "$_f"
}

# die <reason> - said, written down as this run's exit, and the container ends
die() {
  say "$1"
  run_note exit 1 "$1"
  exit 1
}

# clean_sessions - every PPPoE session VPP holds, deleted; prints how many
clean_sessions() {
  vc show pppoe session | awk '
    /sw-if-index/ { for (i = 1; i <= NF; i++) {
        if ($i == "client-ip") ip = $(i + 1)
        if ($i == "session-id") sid = $(i + 1) } }
    /client-mac/ { for (i = 1; i <= NF; i++)
        if ($i == "client-mac") print ip, sid, $(i + 1) }' > "$RUN_DIR/stale"
  _n=0
  while read -r ip sid mac; do
    vc create pppoe session client-ip "$ip" session-id "$sid" \
       client-mac "$mac" del > /dev/null
    _n=$((_n + 1))
  done < "$RUN_DIR/stale"
  echo "$_n"
}

# clean_policers - every session policer a dead control plane left (#607),
# unapplied and deleted; prints how many. accel-ppp-ng names them
# vyos_<sw_if_index>_<kbit>_<burst>_down|up and removes them when a session
# ends - but not when it is killed, and the session's interface is then
# recycled for the next subscriber WITH the old policer on it: measured in
# lab/pppoe.sh after `kill -9`. Run BEFORE clean_sessions, while the session
# interfaces are still listed by name.
clean_policers() {
  vc show policer < /dev/null \
    | sed -n 's/^Name "\(vyos_[0-9]*_[0-9]*_[0-9]*_\(up\|down\)\)".*/\1/p' \
    > "$RUN_DIR/stale-policers"
  vc show interface < /dev/null | awk '$1 ~ /^pppoe_session[0-9]+$/ {print $1, $2}' \
    > "$RUN_DIR/session-ifs"
  _n=0
  # Every vppctl in here reads /dev/null, not the loop's input: vppctl hands
  # what it reads on stdin to the dataplane, and the first one in the loop
  # took the rest of the list with it - measured on 0.155.0's lab, a
  # session's policers deleted and never unapplied (0.155.1).
  while read -r name; do
    idx=$(echo "$name" | cut -d_ -f2)
    ifn=$(awk -v i="$idx" '$2 == i {print $1; exit}' "$RUN_DIR/session-ifs")
    case "$name" in
      *_up) dir=input ;;
      *) dir=output ;;
    esac
    [ -n "$ifn" ] && vc policer "$dir" unapply name "$name" "$ifn" < /dev/null > /dev/null
    vc policer del name "$name" < /dev/null > /dev/null
    _n=$((_n + 1))
  done < "$RUN_DIR/stale-policers"
  _n=$((_n + $(unpoison)))
  echo "$_n"
}

# unpoison - every session interface that still carries a policer feature
# with no control plane running, cleared; prints how many interfaces.
#
# VPP COUNTS AN ENABLE, AND A POLICER DELETED WHILE APPLIED LEAVES ITS COUNT.
# The next session on the recycled interface then enables it again, the node
# runs twice, and every packet is metered twice: measured in 0.155.0's lab,
# a session at half its plan, and one with no plan metered by another
# session's policer (VPP reused the freed policer's index). With accel-pppd
# not running nothing may have a policer on a session interface, so each
# feature is disabled until none is left, through a policer made for it -
# policer_input(apply=0) disables the feature whatever the interface was
# bound to (plugins/policer/policer_op.c).
unpoison() {
  _u=0
  while read -r ifn _idx; do
    _f=$(vc show interface features "$ifn" < /dev/null | grep -c 'policer-')
    [ "$_f" -gt 0 ] || continue
    vc policer add name prisma_unpoison type 1r2c cir 1000 cb 15000 rate kbps \
      conform-action transmit exceed-action drop < /dev/null > /dev/null
    _k=0
    while [ "$_k" -lt 16 ] && vc show interface features "$ifn" < /dev/null | grep -q 'policer-'; do
      vc policer input unapply name prisma_unpoison "$ifn" < /dev/null > /dev/null
      vc policer output unapply name prisma_unpoison "$ifn" < /dev/null > /dev/null
      _k=$((_k + 1))
    done
    vc policer del name prisma_unpoison < /dev/null > /dev/null
    _u=$((_u + 1))
  done < "$RUN_DIR/session-ifs"
  echo "$_u"
}

# stale_state - what a dead control plane left, for the next accel-pppd to
# remove in the graceful order (#607): `route <prefix> <sw_if_index>` for each
# route through a session interface (VPP's own 0.0.0.0/32 aside), then
# `session <client-mac> <session-id>` for each session; prints how many lines.
# accel-pppd reads it ($PRISMA_BNG_STALE, the patch's vppiputils.c) before
# its first session: deleting the sessions here, before their routes, left
# their adjacencies behind and crossed subscribers' downloads.
stale_state() {
  vc show interface | awk '$1 ~ /^pppoe_session[0-9]+$/ {print $1, $2}' \
    > "$RUN_DIR/session-ifs"
  vc show ip fib | awk -v f="$RUN_DIR/session-ifs" '
    BEGIN { while ((getline l < f) > 0) { split(l, w, " "); idx[w[1]] = w[2] } }
    /^[0-9]+\.[0-9.]+\/[0-9]+( |$)/ { pfx = $1; next }
    pfx != "0.0.0.0/32" && match($0, /pppoe_session[0-9]+/) {
      n = substr($0, RSTART, RLENGTH)
      if ((n in idx) && !seen[pfx " " n]++) print "route", pfx, idx[n] }' \
    > "$RUN_DIR/stale-state"
  vc show pppoe session | awk '
    /session-id/ { for (i = 1; i <= NF; i++) if ($i == "session-id") sid = $(i + 1) }
    /client-mac/ { for (i = 1; i <= NF; i++) if ($i == "client-mac") print "session", $(i + 1), sid }' \
    >> "$RUN_DIR/stale-state"
  wc -l < "$RUN_DIR/stale-state" | tr -d ' '
}

# unplumb - the Linux VLAN devices out, and no interface the dataplane
# takes PPPoE from; the TAP and the cp STAY.
#
# MEASURED, AND IT TAKES THE DATAPLANE DOWN: `create pppoe cp ... del` sets
# the plugin's control-plane interface to ~0 and the plugin goes on punting
# every discovery frame to it - so the first PADI from any CPE after it is a
# frame sent out of interface ~0, and VPP 26.06 dies in
# vnet_per_buffer_interface_output (SIGSEGV), the whole box with it. lab/
# pppoe.sh did exactly that at a container restart while its CPEs redialled.
# Deleting the TAP the cp names is the same crash by another index. So the
# plumbing outlives the container: with nothing reading the TAP, the kernel
# drops what VPP punts to it, and the next start finds it laid. A dataplane
# restart is the only thing that removes it, and the entrypoint lays it again.
unplumb() {
  for v in ${VLANS:-}; do
    [ "$v" = 0 ] || "$IP" link del "$CP.$v" 2>/dev/null
  done
  # With nothing reading the TAP, a PADI the dataplane punted would be
  # dropped by the kernel; refused here, it is counted where it arrives.
  guard "" > /dev/null 2>&1
  return 0
}

# run_conf [keep] - accel-ppp.conf as generated, plus the CLI on loopback
# with a password made for this start (prisma-bng-cli reads it back); with
# `keep`, the password the running accel-pppd already has - its CLI listener
# is not reopened at a reload, so a new one would lock the host out of it.
run_conf() {
  if [ "${1:-}" = keep ] && [ -s "$RUN_DIR/cli.password" ]; then
    pw=$(cat "$RUN_DIR/cli.password")
  else
    pw=$(od -An -N12 -tx1 /dev/urandom | tr -d ' \n')
  fi
  umask 077
  printf '%s\n' "$pw" > "$RUN_DIR/cli.password"
  { cat "$CONF_DIR/accel-ppp.conf"
    printf '\n[cli]\ntcp=127.0.0.1:2001\npassword=%s\n' "$pw"; } \
    > "$RUN_DIR/accel-ppp.conf"
}

stop_all() {
  say "stopping: accel-pppd first, then the sessions it left"
  if [ -n "${APID:-}" ]; then
    kill -TERM "$APID" 2>/dev/null
    wait "$APID" 2>/dev/null
  fi
  _n=$(clean_policers)
  [ "$_n" -gt 0 ] && say "removed $_n policer(s) accel-pppd left in the dataplane"
  _n=$(clean_sessions)
  [ "$_n" -gt 0 ] && say "removed $_n session(s) accel-pppd left in the dataplane"
  unplumb
  rm -f "$RUN_DIR/cli.password" "$RUN_DIR/accel-ppp.conf"
  run_note exit 0 "stopped (SIGTERM): a restart, an upgrade or no pppoe"
  exit 0
}

# log_dir - accel-ppp's log directory, made when it is missing; 0 or 1
#
# MEASURED ON THE FIRST INSTALLED BOX (0.153.97, 2026-10-12): nothing made
# /var/log/prisma-routing/bng, accel-pppd exited at start on
# "log:log_error:open: No such file or directory", and the container
# restarted for ever without answering a PADI. The labs had the directory
# because they made it. 0750 root, as the log volume's own directory is: the
# log names subscribers.
log_dir() {
  [ -d "$LOG_DIR" ] || install -d -m 0750 "$LOG_DIR" || {
    say "could not make $LOG_DIR"; return 1; }
  return 0
}

# reload - accel-ppp's file rebuilt from the generated one and read again by
# the accel-pppd running (#607): what `prisma-bng reload` runs in here. accel-
# cmd prints "failed" and exits 0 when the file is refused, so that is read.
reload() {
  [ -s "$RUN_DIR/cli.password" ] || { say "accel-pppd is not running"; return 3; }
  run_conf keep
  _out=$(prisma-bng-cli reload 2>&1) || { say "reload: $_out"; return 1; }
  case "$_out" in *failed*) say "reload: accel-pppd refused the file"; return 1 ;; esac
  return 0
}

# not a unit: the container's main loop, driven end to end by lab/pppoe.sh
main() {
  mkdir -p "$RUN_DIR"
  run_note start
  log_dir || die "could not make $LOG_DIR"
  [ -f "$CONF_DIR/accel-ppp.conf" ] || \
    die "no $CONF_DIR/accel-ppp.conf: PPPoE is not configured"
  wait_vpp || die "the dataplane did not answer in ${WAIT_VPP}s"
  plumb || die "could not lay the plumbing"
  _n=$(clean_policers)
  [ "$_n" -gt 0 ] && say "removed $_n stale policer(s) from the dataplane"
  # NOT clean_sessions here (#607): a dead control plane's sessions are
  # accel-pppd's to remove, at its start, AFTER their routes - deleted
  # first, they left each session interface's adjacency behind, and the
  # recycled interface sent the next subscriber's downloads to the old one
  # (vppiputils.c in build/accel-ppp-ng.patch has the measurement).
  _n=$(stale_state)
  [ "$_n" -gt 0 ] && say "$_n route(s) and session(s) a dead control plane left, for accel-pppd to remove"
  export PRISMA_BNG_STALE="$RUN_DIR/stale-state"
  run_conf
  trap stop_all TERM INT
  # accel-pppd in the FOREGROUND (no -d), as this script's child, so that
  # its death is this script's to see.
  oom0=$(oom_kills)
  "$ACCEL" -c "$RUN_DIR/accel-ppp.conf" -p "$RUN_DIR/accel-pppd.pid" &
  APID=$!
  say "accel-pppd started (pid $APID)"
  while :; do
    sleep "$WATCH_EVERY" &
    wait $!
    if ! kill -0 "$APID" 2>/dev/null; then
      # Its status is the shell's still: the sleep's `wait` reaped it, and
      # dash keeps a job's status until it is waited for (measured).
      wait "$APID"
      why=$(exit_reason $? "$oom0")
      say "$why; the container ends so it is restarted"
      unset APID
      # Its policers; its sessions and their routes are the next accel-
      # pppd's to remove, in that order (see main's start).
      clean_policers > /dev/null
      run_note exit 1 "$why"
      exit 1
    fi
    if [ -z "$(sw_index "$TAP")" ]; then
      say "the dataplane lost $TAP (restarted?); starting again"
      kill -TERM "$APID" 2>/dev/null
      wait "$APID" 2>/dev/null
      run_note exit 1 "the dataplane lost $TAP (restarted?)"
      exit 1
    fi
  done
}

if [ "${PRISMA_BNG_SOURCE_ONLY:-0}" != 1 ]; then
  if [ "${1:-}" = reload ]; then reload; exit $?; fi
  main "$@"
fi
