#!/bin/sh
# The container that gave up, and the card it is still holding (#426).
#
# WHY A BOX NEEDS THIS, AND WHY THE UNIT PATH ALREADY HAS IT. The card is
# bound to a DPDK driver before the dataplane starts, so between the bind and
# a working dataplane there is a window in which it belongs to neither Linux
# nor VPP. A box left in that window has no interface at all and the only way
# in is a console somebody walks to - the state an operator reported on
# 0.75.0, which is #379. On vpp.service the answer is OnFailure=: systemd
# raises it when the unit reaches `failed`, after the restart limit, and
# prisma-routing-give-card-back.service hands the card back.
#
# A CONTAINER REACHES NO SUCH STATE. prisma-routing-containers.service is a
# oneshot that has already exited successfully by the time the dataplane
# matters, so its OnFailure never fires whatever the container does. The
# compose file asks for `on-failure:5` rather than `unless-stopped` so that a
# dataplane which cannot start STOPS TRYING - and this is what notices that
# it stopped, because Docker tells nobody.
#
# WHAT IT IS NOT. It is not a health check and it does not restart anything:
# Docker's own restart policy has already tried five times, and a sixth from
# here would be a second opinion about the same failure. It answers one
# question - is the box stranded - and undoes the bind if it is.
#
# ONCE PER BOOT. The stamp is in /run, so a reboot clears it: after the card
# is back, this must not keep firing ifup at a box an operator may now be
# working on.
#
# AND A CONTAINER THAT CAME BACK, WHICH IS THE OTHER HALF (#548). Docker's
# restart policy starts a crashed dataplane again - and that VPP comes up
# with no interface configured, no pool, no route: the configuration is put
# on it by prisma-routing.service, which ran once at boot, stays `active
# (exited)` and runs nothing when a container restarts under it. The X520's
# older sibling, the virtio bench, stayed dead that way after an
# out-of-memory abort until somebody restarted the unit by hand. So the
# boot's apply records which dataplane and routing containers it configured
# (`watch-the-dataplane --applied`, its ExecStartPost), and every tick here
# compares that with the containers running now: one that started again
# since gets the configuration in effect put back (`prismash --reapply`),
# and what the dead one printed last is kept, like a container that gave up.
# This restarts nothing either; it puts back what a restart took away.
#
# WITH ONE EXCEPTION: A CLEAN EXIT NOBODY ASKED FOR (#552). Docker's
# `on-failure` policy restarts a dataplane that failed and leaves alone one
# that exited with status 0, because to Docker status 0 means somebody wanted
# it stopped. On the legacy bench at 0.149.7 nobody did: `logging syslog
# disable` had closed VPP's stdin (#551) and VPP exited 0 at the next vppctl.
# This script then read the exited container as "Docker has stopped
# restarting it" and gave the card back, and the box had no dataplane until
# a reboot. A clean exit counts as unasked when ALL of these hold, and only
# then is the container started again (the #548 path above then puts the
# configuration back on the next tick):
#   * the container exited with status 0 and was not OOM-killed;
#   * the box is not shutting down (`systemctl is-system-running` is not
#     `stopping`);
#   * prisma-routing-containers.service is active - checked below for every
#     branch; `system dataplane restart` and an upgrade stop that unit first;
#   * Docker logged no `kill` for the container in the 30 seconds before it
#     died. `docker stop`, `docker kill`, compose's stop and down, and the
#     daemon stopping its containers all send one; a process that exits by
#     itself does not. If Docker cannot be asked, it is NOT unasked: the card
#     goes back as before, rather than restarting something an operator
#     stopped.
# Bounded per boot (PRISMA_CLEAN_EXIT_RESTARTS, 5 - the same budget the
# compose file gives Docker), after which the card goes back as before.
set -u

ROOT=${PRISMA_ROOT:-}
STAMP=${PRISMA_CARD_STAMP:-$ROOT/run/prisma-routing/card-given-back}
DOCKER=${PRISMA_DOCKER:-docker}
SYSTEMCTL=${PRISMA_SYSTEMCTL:-systemctl}
GIVEBACK=${PRISMA_GIVEBACK:-$ROOT/usr/lib/prisma-routing/give-the-card-back}
IFUP=${PRISMA_IFUP:-/sbin/ifup}
# The name compose gives the dataplane container. Project `prisma-routing`
# comes from the directory the unit runs in, which is /etc/prisma-routing.
CONTAINER=${PRISMA_VPP_CONTAINER:-prisma-routing_vpp_1}
# WHERE THE REASON IS KEPT, AND WHY IT IS NOT IN /run. The stamp above is in
# /run because it must not survive a reboot; this must. An operator who finds
# a box with no dataplane reboots it - that is the first thing anybody does -
# and a reason written in /run is a reason the reboot deletes. The container
# is `exited` by now, and `docker logs` on a box that has since restarted
# Docker has nothing either: the only copy of why the dataplane died is the
# one taken here.
#
# THE DIRECTORY IS ONE THE BOX ALREADY HAS. compose.yaml mounts
# /var/log/prisma-routing into the dataplane, install.sh creates it, and the
# installer gives it the log volume. Nothing new to provision.
REPORT=${PRISMA_DATAPLANE_REPORT:-$ROOT/var/log/prisma-routing/why-the-dataplane-stopped}
#: How many lines of the dataplane's log to keep. The EAL says why it failed
#: in its last handful of lines and VPP's startup banner is about forty, so
#: 80 carries both: the failure AND the configuration it was reading when it
#: failed, which is the pair that identifies the defect.
REPORT_LINES=${PRISMA_DATAPLANE_REPORT_LINES:-80}
FRR_CONTAINER=${PRISMA_FRR_CONTAINER:-prisma-routing_frr_1}
APPLIED=${PRISMA_APPLIED_STAMP:-$ROOT/run/prisma-routing/dataplane-applied}
PRISMASH=${PRISMA_PRISMASH:-/usr/bin/prismash}
WAITVPP=${PRISMA_WAIT_FOR_VPP:-$ROOT/usr/lib/prisma-routing/wait-for-vpp}
# Attempts at putting one restart's configuration back before this stops
# trying and says so: a configuration the new dataplane refuses would be
# refused again every tick otherwise.
REAPPLY_TRIES=${PRISMA_REAPPLY_TRIES:-3}
CLEAN_EXIT_RESTARTS=${PRISMA_CLEAN_EXIT_RESTARTS:-5}
CLEAN_EXITS=${PRISMA_CLEAN_EXIT_STAMP:-$ROOT/run/prisma-routing/clean-exit-restarts}
say() { echo "watch-dataplane: $*" >&2; }

record_why() { # <state> [<until>] - keep what the dataplane said before it died
  mkdir -p "$(dirname "$REPORT")" 2>/dev/null || true
  {
    echo "# Why this box's dataplane stopped, written by watch-the-dataplane."
    echo "# Read it with: prismash -c 'show version', or cat this file."
    echo "when:      $(date -u '+%Y-%m-%dT%H:%M:%SZ' 2>/dev/null)"
    echo "container: $CONTAINER"
    echo "state:     $1"
    echo "inspect:   $("$DOCKER" inspect \
      -f 'exit={{.State.ExitCode}} oom={{.State.OOMKilled}} error={{.State.Error}}' \
      "$CONTAINER" 2>&1)"
    echo "--- the last $REPORT_LINES lines the dataplane printed ---"
    if [ -n "${2:-}" ]; then
      # A container Docker restarted keeps one log: the run that died ends
      # where the new one started.
      "$DOCKER" logs --until "$2" --tail "$REPORT_LINES" "$CONTAINER" 2>&1
    else
      "$DOCKER" logs --tail "$REPORT_LINES" "$CONTAINER" 2>&1
    fi
  } > "$REPORT" 2>/dev/null || say "could not write $REPORT"
}

# The containers the configuration is on: one line each, "<id> <started>",
# for the dataplane and the routing container, nothing for one not running.
# A container Docker restarted keeps its id and gets a new start time; one
# compose recreated gets a new id. Either is a dataplane nobody configured.
identity() {
  for _c in "$CONTAINER" "$FRR_CONTAINER"; do
    "$DOCKER" inspect -f '{{.State.Status}} {{.Id}} {{.State.StartedAt}}' "$_c" \
      2>/dev/null | awk '$1 == "running" { print $2, $3 }'
  done
}

write_applied() {
  mkdir -p "$(dirname "$APPLIED")" 2>/dev/null || true
  identity > "$APPLIED.tmp" 2>/dev/null && mv "$APPLIED.tmp" "$APPLIED"
  rm -f "$APPLIED.tries"
}

# The containers running now are not the ones the configuration was put on:
# put it back (#548). Quiet when nothing changed, which is every tick but one.
reapply_if_restarted() {
  # Not while the boot's apply - or anybody's restart of it - is running:
  # that one writes the record itself when it is done.
  "$SYSTEMCTL" is-active --quiet prisma-routing.service || return 0
  _now=$(identity)
  [ "$(printf '%s\n' "$_now" | grep -c .)" -eq 2 ] || return 0
  if [ ! -s "$APPLIED" ]; then
    # A box upgraded onto this release: its boot's apply wrote no record,
    # and what runs now is what it configured.
    write_applied
    return 0
  fi
  [ "$_now" = "$(cat "$APPLIED")" ] && return 0
  # Counted per restart: the tries file names the containers it counts for,
  # so a dataplane that restarts again later is tried afresh.
  _key=$(printf '%s' "$_now" | tr '\n' ' ')
  _tries=0
  if [ "$(sed -n 1p "$APPLIED.tries" 2>/dev/null)" = "$_key" ]; then
    _tries=$(sed -n 2p "$APPLIED.tries")
  fi
  [ "${_tries:-0}" -ge "$REAPPLY_TRIES" ] && return 0
  _tries=$((${_tries:-0} + 1))
  printf '%s\n%s\n' "$_key" "$_tries" > "$APPLIED.tries"
  _vpp_now=$(printf '%s\n' "$_now" | sed -n 1p)
  if [ "$_vpp_now" != "$(sed -n 1p "$APPLIED")" ]; then
    record_why "started again by Docker" "${_vpp_now#* }"
    say "the dataplane container started again at ${_vpp_now#* }, with no"
    say "configuration on it: the configuration in effect goes back (#548)."
    say "what the run before it printed last is kept in $REPORT"
  else
    say "the routing container started again: the configuration in effect"
    say "goes back on it (#548)."
  fi
  if "$WAITVPP" 60 && "$PRISMASH" --reapply; then
    write_applied
    say "the configuration is back on the dataplane."
    return 0
  fi
  say "putting the configuration back failed (attempt $_tries of $REAPPLY_TRIES)."
  if [ "$_tries" -ge "$REAPPLY_TRIES" ]; then
    say "not trying again for this restart: 'systemctl restart"
    say "prisma-routing.service' puts the saved configuration back by hand."
  fi
  return 0
}

# The dataplane exited with status 0 and nothing on the box stopped it (#552):
# see the header for each condition. 0 when that is so.
unasked_clean_exit() {
  _st=$("$DOCKER" inspect -f '{{.State.ExitCode}} {{.State.OOMKilled}} {{.State.FinishedAt}}' \
    "$CONTAINER" 2>/dev/null) || return 1
  set -- $_st
  [ "${1:-}" = 0 ] && [ "${2:-}" = false ] && [ -n "${3:-}" ] || return 1
  [ "$("$SYSTEMCTL" is-system-running 2>/dev/null)" = stopping ] && return 1
  _end=$(date -d "$3" +%s 2>/dev/null) || return 1
  _kills=$("$DOCKER" events --since "$((_end - 30))" --until "$((_end + 1))" \
    --filter "container=$CONTAINER" --filter event=kill \
    --format '{{.Action}}' 2>/dev/null) || return 1
  [ -z "$_kills" ]
}

# Start the dataplane again after an unasked clean exit, within the budget.
# 0 when it was started; the next tick's reapply_if_restarted() puts the
# configuration back on it.
restart_clean_exit() {
  unasked_clean_exit || return 1
  _n=$(cat "$CLEAN_EXITS" 2>/dev/null || echo 0)
  if [ "${_n:-0}" -ge "$CLEAN_EXIT_RESTARTS" ]; then
    say "the dataplane exited cleanly with nothing stopping it, again: it was"
    say "started $_n times this boot already, which is the budget (#552)."
    return 1
  fi
  record_why "exited 0 and nothing on the box stopped it"
  mkdir -p "$(dirname "$CLEAN_EXITS")" 2>/dev/null || true
  echo $((${_n:-0} + 1)) > "$CLEAN_EXITS"
  say "the dataplane container exited with status 0 and nothing on the box"
  say "stopped it, which Docker does not restart: starting it again (#552,"
  say "$((${_n:-0} + 1)) of $CLEAN_EXIT_RESTARTS this boot). The configuration"
  say "goes back on it next. what it printed last is kept in $REPORT"
  "$DOCKER" start "$CONTAINER" >/dev/null 2>&1 && return 0
  say "docker start failed; the card goes back instead."
  return 1
}

# What the boot's apply runs when it is done (#548).
if [ "${1:-}" = "--applied" ]; then
  write_applied
  exit 0
fi

# THE STACK HAS TO BE THE ONE THIS BOX IS RUNNING. On a box still booting
# vpp.service - which is every box until the default moves - the containers
# unit is inactive and its dataplane is not this box's dataplane. Handing the
# card back then would take the card off a dataplane that is forwarding.
if ! "$SYSTEMCTL" is-active --quiet prisma-routing-containers.service; then
  exit 0
fi

if [ -e "$STAMP" ]; then
  exit 0
fi

state=$("$DOCKER" inspect -f '{{.State.Status}}' "$CONTAINER" 2>/dev/null)
case "$state" in
  running)
    reapply_if_restarted
    exit 0 ;;
  restarting|created)
    # `restarting` is the policy still trying, and that is not giving up.
    exit 0 ;;
  "")
    # No such container. The stack is up and the dataplane is not there at
    # all - which is `up -d` having failed rather than a dataplane that died,
    # and the card was bound by the tuner before either happened.
    say "the stack is up and there is no $CONTAINER container at all." ;;
  exited)
    restart_clean_exit && exit 0
    say "the dataplane container is '$state': Docker has stopped restarting" ;;
  *)
    say "the dataplane container is '$state': Docker has stopped restarting" ;;
esac

# BEFORE THE BIND IS UNDONE, because `ifup -a` below can take the box's
# management address with it on a bad day and a reason written after that is
# a reason nobody gets. It is also before the reboot an operator does next.
record_why "${state:-none}"
say "it. The card was bound to a DPDK driver before it started, so the box"
say "has no interface until it is given back. Undoing the bind (#379)."
say "why it stopped is kept in $REPORT"
"$GIVEBACK" || say "give-the-card-back failed; see the journal above"
# Allowed to fail, exactly as prisma-routing-give-card-back.service allows it:
# a box whose card is back on its kernel driver is already better off than one
# with no card, and the addressing is a separate question.
"$IFUP" -a 2>/dev/null || true

mkdir -p "$(dirname "$STAMP")" 2>/dev/null || true
: > "$STAMP" 2>/dev/null || true
exit 0
