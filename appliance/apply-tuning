#!/bin/sh
# Applies the computed tuning and only touches GRUB when something changed.
#
# Running the calculation on every boot is cheap and makes the appliance
# honour changes in tune.env. Running update-grub on every boot is not: it
# writes to disk and costs seconds. So it always calculates, always writes,
# and regenerates GRUB only on a difference.
set -u

# PRISMA_ROOT is empty on every box and is set only by test/test_apply_tuning.sh.
# This script runs as root before VPP and writes the kernel command line, so
# the only way to read what it decides without rewriting the machine's own
# /etc, /proc and /sys is to point it at a tree shaped like them - the same
# reason appliance/bind-dataplane-nic takes one.
ROOT=${PRISMA_ROOT:-}
GRUBFILE=$ROOT/etc/default/grub.d/prisma-routing.cfg
PROCCMDLINE=$ROOT/proc/cmdline
CPUFREQ=$ROOT/sys/devices/system/cpu/cpufreq
HUGEPAGES=$ROOT/sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages
LIVEDIR=$ROOT/run/live
: "${PRISMA_DATAPLANE_IF:=}"
: "${PRISMA_SUBSCRIBERS:=200000}"
: "${PRISMA_LOW_LATENCY:=1}"
: "${PRISMA_MAX_WORKERS:=}"
: "${PRISMA_CGNAT_MEMORY_GB:=}"
: "${PRISMA_CONTROL_PLANE_CORES:=}"
: "${PRISMA_MAIN_THREAD:=}"
: "${PRISMA_CONTROL_PLANE_MEMORY_GB:=}"
: "${PRISMA_BUFFERS_PER_NUMA:=}"
: "${PRISMA_CGNAT_WORKERS:=}"
: "${PRISMA_ALLOW_UNSUPPORTED_SFP:=}"
: "${PRISMA_MANAGEMENT_VRF:=}"
: "${PRISMA_MANAGEMENT_TABLE:=}"
IP=${PRISMA_IP:-ip}
SYSCTL=${PRISMA_SYSCTL:-sysctl}

# tune.env is a file an operator edits by hand, and every value in it used to
# be believed. A value that is neither 0 nor 1 took the "not 1" branch, so
# PRISMA_LOW_LATENCY=true silently produced a kernel command line with the
# C-state and THP parameters REMOVED - the opposite of what it says - and the
# journal reported "PRISMA_LOW_LATENCY=0", naming a value the operator never
# wrote. PRISMA_SUBSCRIBERS='200k' was worse: the tuner's own argument parser
# refused it, this script exited non-zero, and the unit failed with no tuning
# written at all.
#
# So each value is checked here, and a value this script does not accept is
# REFUSED OUT LOUD and replaced by the shipped default - never by the opposite
# of what it says, and never by failing the unit. A typo must not cost the box
# its tuning: the kernel command line would stay at whatever the previous boot
# wrote, disagreeing with the startup.conf beside it, which is far worse than
# an ignored setting. The refusal names what IS accepted, because "rejected"
# alone leaves the operator guessing at the spelling.
#
# The value is quoted and printed whole on a line of its own, and the prose
# around it is wrapped by hand to 79 columns: this comes out of the journal
# onto an 80-column serial console, where a wrapped value cannot be grepped
# for and a value that pushes the sentence off the edge takes the reason with
# it.
say_refused() {  # <variable> <value>
  # THE VALUE ON A ROW OF ITS OWN, which is what the paragraph above says and
  # what this did not do: written as one sentence, the file an operator has to
  # open came AFTER the value, so a long typo pushed the path off an
  # 80-column console and took the only actionable thing on the screen with it
  # (#367). The first row now fits whatever is in the file - it holds a
  # variable name and nothing else that varies - and the value is the whole of
  # the second, quoted, where a fold costs a closing quote and no words.
  # The PATH moved down a row when the product was renamed (#202): the name
  # is two characters longer, and the widest variable this reads pushed the
  # old single row to 80 columns on a console of 79. The variable name stays
  # on the verdict, because that is what the operator has to find in the file.
  echo "REFUSED $1, in tune.env. The file is:" >&2
  echo "  /etc/prisma-routing/tune.env" >&2
  echo "The value there is:" >&2
  echo "  '$2'" >&2
}
say_using() {    # <what is used instead>
  echo "  Using $1." >&2
  echo "  Fix the file and restart prisma-routing-tune.service." >&2
}

case "$PRISMA_LOW_LATENCY" in
  0|1) ;;
  *) say_refused PRISMA_LOW_LATENCY "$PRISMA_LOW_LATENCY"
     echo "  Two values are accepted, and nothing else:" >&2
     echo "    1  deep C-states off, transparent hugepages off, and the" >&2
     echo "       cpufreq governor held on performance" >&2
     echo "    0  leave all three alone, for a box that must save power" >&2
     say_using "1, the shipped default, because this is a router"
     PRISMA_LOW_LATENCY=1 ;;
esac

case "$PRISMA_SUBSCRIBERS" in
  *[!0-9]*|"")
    say_refused PRISMA_SUBSCRIBERS "$PRISMA_SUBSCRIBERS"
    echo "  It is the subscriber count that sizes the 1G hugepage pool, so" >&2
    echo "  it is digits only: 200000, not 200k and not 200.000." >&2
    say_using "200000, the shipped default"
    PRISMA_SUBSCRIBERS=200000 ;;
esac

# The memory given to the CGNAT (#454): GB, digits only, or empty for the
# estimate from PRISMA_SUBSCRIBERS. Refused out loud like the others, and a
# refusal falls back to the estimate - the box's behaviour before the setting
# existed - rather than failing the unit.
case "$PRISMA_CGNAT_MEMORY_GB" in
  "") ;;
  *[!0-9]*|0)
    say_refused PRISMA_CGNAT_MEMORY_GB "$PRISMA_CGNAT_MEMORY_GB"
    echo "  It is the memory given to the CGNAT's sessions, in whole GB:" >&2
    echo "  8, not 8G and not 8.5. Empty sizes it from PRISMA_SUBSCRIBERS." >&2
    say_using "the estimate from PRISMA_SUBSCRIBERS"
    PRISMA_CGNAT_MEMORY_GB= ;;
esac

# SFP+ MODULES IXGBE DOES NOT LIST (#574): `system` > `hardware` >
# `unsupported-sfp allow`, written here by the VTY. allow or refuse - or empty,
# which is refuse - and a typo costs the box the setting, never its tuning.
case "$PRISMA_ALLOW_UNSUPPORTED_SFP" in
  ""|allow|refuse) ;;
  *)
    say_refused PRISMA_ALLOW_UNSUPPORTED_SFP "$PRISMA_ALLOW_UNSUPPORTED_SFP"
    echo "  It is allow or refuse - or empty, which is refuse." >&2
    say_using "refuse: ixgbe takes only the modules it lists"
    PRISMA_ALLOW_UNSUPPORTED_SFP= ;;
esac

# MANAGEMENT IN A VRF OF ITS OWN (#580): `system` > `management` > `vrf
# <name>`, whose table the VTY writes beside the name. A table that is not one
# - empty, a word, the kernel's own 253-255 - costs the box the setting, never
# its tuning, and never a rule pointing the box's own traffic nowhere.
case "$PRISMA_MANAGEMENT_TABLE" in
  "") ;;
  *[!0-9]*|253|254|255)
    say_refused PRISMA_MANAGEMENT_TABLE "$PRISMA_MANAGEMENT_TABLE"
    echo "  It is a VRF's table, 1 to 4294967295 and not 253-255." >&2
    say_using "management in the main table"
    PRISMA_MANAGEMENT_TABLE= ;;
esac

# The governor is runtime state, not a kernel parameter: asking for it in
# GRUB does nothing, and it does not survive a reboot on its own. On
# ondemand/schedutil the OS core drops in frequency while the box is quiet,
# and the first burst arrives before it has ramped up - loss that shows up as
# an unexplained micro-burst.
# `(0 changed)` WAS THREE DIFFERENT BOXES WEARING ONE SENTENCE (#163).
#
# This used to print `cpufreq governor: performance (N changed)`, and a zero
# there could mean any of:
#
#   * every policy was already on performance - nothing to do, all is well;
#   * every write FAILED, because `2>/dev/null` swallows the error;
#   * no policy offers a performance governor at all, because the loop's
#     `continue` skipped them before any write was attempted.
#
# The first is a tuned box and the second is an untuned one, and the line
# an operator reads was the same. That is the shape this repository refuses
# everywhere else: a claim the box cannot support. So each outcome is
# counted and only the ones that happened are named.
governor_performance() {
  found=0 changed=0 already=0 refused=0 absent=0
  for g in "$CPUFREQ"/policy*/scaling_governor; do
    # -e AND NOT -w, and the suite found this one. An unwritable policy was
    # skipped before `found` was set, so a box that HAS cpufreq and cannot be
    # written said `no cpufreq policy exposed` - a sentence about a box with
    # no cpufreq at all. Two different machines, one line, and the one being
    # described was the broken one. The write below is what answers whether
    # it can be written; asking twice is what let the answer go missing.
    [ -e "$g" ] || continue
    found=1
    avail=$(cat "$(dirname "$g")/scaling_available_governors" 2>/dev/null || echo "")
    case " $avail " in
      *" performance "*) ;;
      *) absent=$((absent + 1)); continue ;;
    esac
    if [ "$(cat "$g")" = performance ]; then
      already=$((already + 1)); continue
    fi
    if echo performance > "$g" 2>/dev/null; then
      changed=$((changed + 1))
    else
      refused=$((refused + 1))
    fi
  done
  if [ "$found" = 0 ]; then
    # Common in a VM: with no cpufreq exposed there is nothing to set, and
    # that is not an error.
    echo "no cpufreq policy exposed: skipping governor"
    return 0
  fi
  # ONLY WHAT HAPPENED. A line listing four counts of which three are zero
  # is a line nobody finishes reading, and the one number that matters -
  # refused - is then the easiest to miss.
  _say=""
  [ "$changed" -gt 0 ] && _say="$changed set to performance"
  [ "$already" -gt 0 ] && _say="${_say:+$_say, }$already already there"
  [ "$refused" -gt 0 ] && _say="${_say:+$_say, }$refused REFUSED the write"
  [ "$absent" -gt 0 ] && _say="${_say:+$_say, }$absent have no such governor"
  echo "cpufreq governor: $_say"
  # AND THE REFUSAL SAYS WHAT IT COSTS, because a count on its own is a
  # number an operator skims past.
  if [ "$refused" -gt 0 ]; then
    echo "  the kernel refused $refused of them: those cores keep scaling" >&2
    echo "  their frequency, which is jitter on a worker that never sleeps" >&2
  fi
}

if [ "$PRISMA_LOW_LATENCY" = 1 ]; then
  governor_performance
else
  echo "PRISMA_LOW_LATENCY=0: leaving the cpufreq governor alone"
fi

before=$(cat "$GRUBFILE" 2>/dev/null || true)

set -- --write --subscribers "$PRISMA_SUBSCRIBERS"
[ -n "$PRISMA_DATAPLANE_IF" ] && set -- "$@" --interface "$PRISMA_DATAPLANE_IF"
[ -n "$PRISMA_CGNAT_MEMORY_GB" ] && set -- "$@" --cgnat-memory-gb "$PRISMA_CGNAT_MEMORY_GB"
[ "$PRISMA_LOW_LATENCY" = 1 ] || set -- "$@" --no-low-latency
# The tuner has always accepted --max-workers; nothing ever passed it, so the
# only reachable behaviour was "every core but one is a worker" and the cap
# existed on paper (#172). Empty stays uncapped, so a box that sets nothing
# boots identically to before.
#
# A typo must not cost the box its tuning. The tuner takes an integer and
# argparse exits non-zero on anything else, which would fail this unit and
# leave the kernel command line at whatever the previous boot wrote - a
# mismatch between isolcpus and startup.conf that is far worse than an ignored
# setting.
case "$PRISMA_MAX_WORKERS" in
  "") ;;
  *[!0-9]*)
    say_refused PRISMA_MAX_WORKERS "$PRISMA_MAX_WORKERS"
    echo "  It is a number of physical cores, so it is digits only - or" >&2
    echo "  empty, which is the shipped value and means no cap." >&2
    say_using "no cap: every physical core on the dataplane node but the first" ;;
  *) set -- "$@" --max-workers "$PRISMA_MAX_WORKERS" ;;
esac
# THE CORES BY ROLE (#466), refused the way PRISMA_MAX_WORKERS is and for the
# same reason: a typo must cost the box the setting, not its tuning.
case "$PRISMA_CONTROL_PLANE_CORES" in
  "") ;;
  0|*[!0-9]*)
    say_refused PRISMA_CONTROL_PLANE_CORES "$PRISMA_CONTROL_PLANE_CORES"
    echo "  It is a number of physical cores, 1 or more - or empty, which" >&2
    echo "  is the shipped value and means one." >&2
    say_using "one control-plane core" ;;
  *) set -- "$@" --control-plane-cores "$PRISMA_CONTROL_PLANE_CORES" ;;
esac
case "$PRISMA_MAIN_THREAD" in
  ""|shared) ;;
  dedicated) set -- "$@" --main-thread dedicated ;;
  *)
    say_refused PRISMA_MAIN_THREAD "$PRISMA_MAIN_THREAD"
    echo "  It is shared or dedicated - or empty, which is shared." >&2
    say_using "VPP's main thread on the control plane's first core" ;;
esac
# THE MEMORY BY ROLE (#466), refused the same way: a typo costs the box the
# setting and keeps the computed figure.
case "$PRISMA_CONTROL_PLANE_MEMORY_GB" in
  "") ;;
  0|*[!0-9]*)
    say_refused PRISMA_CONTROL_PLANE_MEMORY_GB "$PRISMA_CONTROL_PLANE_MEMORY_GB"
    echo "  It is whole GB, 1 or more - or empty, which keeps a quarter of" >&2
    echo "  the RAM, at least 2 GB." >&2
    say_using "a quarter of the RAM for the control plane" ;;
  *) set -- "$@" --control-plane-memory-gb "$PRISMA_CONTROL_PLANE_MEMORY_GB" ;;
esac
case "$PRISMA_BUFFERS_PER_NUMA" in
  "") ;;
  *[!0-9]*)
    say_refused PRISMA_BUFFERS_PER_NUMA "$PRISMA_BUFFERS_PER_NUMA"
    echo "  It is a number of packet buffers - or empty, which is 16384 per" >&2
    echo "  worker." >&2
    say_using "16384 packet buffers per worker" ;;
  *) set -- "$@" --buffers-per-numa "$PRISMA_BUFFERS_PER_NUMA" ;;
esac
# RX AND CGNAT WORKERS (#466): how many workers translate; the rest take
# packets off the cards and hand them over. Refused the same way.
case "$PRISMA_CGNAT_WORKERS" in
  "") ;;
  0|*[!0-9]*)
    say_refused PRISMA_CGNAT_WORKERS "$PRISMA_CGNAT_WORKERS"
    echo "  It is a number of workers, 1 or more - or empty, which has every" >&2
    echo "  worker both receive and translate." >&2
    say_using "every worker receiving and translating" ;;
  *) set -- "$@" --cgnat-workers "$PRISMA_CGNAT_WORKERS" ;;
esac
# The decision goes to the journal. Diagnosing a box whose profile did not
# match its hardware meant guessing across whole build cycles, because the one
# component that knew why was throwing its reasoning away.
report=$(prisma-routing-tune "$@" 2>&1) || { printf '%s\n' "$report" >&2; exit 1; }
printf '%s\n' "$report" | grep -E "^# |WARNING" >&2
# THE OPTION ON THE KERNEL COMMAND LINE, AFTER THE TUNER (#574). ixgbe loads
# from the initramfs, before this unit runs, and reads allow_unsupported_sfp
# then; modprobe takes a module's options from the kernel command line
# (modprobe.d(5)), the initramfs's modprobe included, so the line below is
# all it needs and the initramfs is not rebuilt. Appended to the file the
# tuner has just written, which it writes whole on every run: `refuse` leaves
# the line out, the file differs, and update-grub below takes it off. A line
# of its own because the tuner writes no command line on a machine with no
# core to isolate, and this one must not depend on the cores.
if [ "$PRISMA_ALLOW_UNSUPPORTED_SFP" = allow ]; then
  {
    echo "# system > hardware > unsupported-sfp allow (#574)"
    echo 'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT ixgbe.allow_unsupported_sfp=1"'
  } >> "$GRUBFILE"
  echo "unsupported SFP+ modules: allowed on ixgbe cards from the next boot" >&2
fi
printf 'kernel cmdline hugepages: %s\n' \
  "$(tr ' ' '\n' < "$PROCCMDLINE" | grep '^hugepages=' || echo '(none)')" >&2
# THE CONTROL PLANE HELD OFF THE ISOLATED CPUS (#466), by cgroup and not
# only by inheritance. isolcpus keeps the scheduler from PLACING anything on a
# worker's CPU, but a process may still ask for one and get it: measured on a
# 4-CPU guest with 1-3 isolated, zebra, bgpd, sshd and dockerd were allowed
# 0-3, and a shell asking for CPU 3 was given it. AllowedCPUs on the three
# units the control plane runs in makes that a fence.
#
# From the kernel's isolation on THIS boot, every boot, and --runtime: a
# fence left from a boot whose isolation has since changed would hold the
# control plane to the wrong CPUs.
#
# ONLY WITH THE DATAPLANE OUT OF system.slice, which compose.yaml and the
# vpp.service drop-in both arrange. A fence on system.slice with VPP still
# inside it would hold VPP's workers to the control plane's CPUs.
fence=$(prisma-routing-tune --fence --sysfs-root "${ROOT:-/}" 2>/dev/null) \
  || fence=""
if [ -n "$fence" ]; then
  if grep -q 'cgroup_parent: prisma-dataplane.slice' \
       "$ROOT/etc/prisma-routing/compose.yaml" 2>/dev/null \
     && [ -f "$ROOT/etc/systemd/system/vpp.service.d/prisma-routing-slice.conf" ]
  then
    for u in system.slice user.slice init.scope; do
      systemctl set-property --runtime "$u" "AllowedCPUs=$fence" \
        || echo "control plane: $u could not be held to CPUs $fence" >&2
    done
    echo "control plane held to CPUs $fence" >&2
  else
    echo "control plane NOT held to CPUs $fence: the dataplane is not in" >&2
    echo "prisma-dataplane.slice, and a fence would hold it too" >&2
  fi
fi
# THE NIC ITSELF, once the tuner has said which one. Naming a device in
# startup.conf is not the same as the dataplane having it: DPDK cannot take a
# device through ixgbe, i40e or bnxt_en, and nothing in this product ever bound
# one. An operator who did what the self-test asked still forwarded nothing
# (#283).
#
# HERE and not in a unit of its own, because it must happen after the tuner has
# chosen the device and before VPP starts, and this script is already exactly
# that window. A second unit would be a second thing to order correctly.
#
# Its failure does not fail the tuning. A box that could not bind its NIC still
# wants its hugepages, its isolcpus and its governor - and it wants to come up
# far enough for somebody to log in and read why. The reason goes to the
# journal, and the self-test says it again on the console.
#
# AND ONLY WHEN THE DATAPLANE HAS NOT STARTED YET, which is the question this
# path never asked (#336). The window above is the boot: the tuner has chosen
# the device and VPP is ordered after this unit, so the bind hands the card
# straight to the process that is about to take it.
#
# A `commit` that names the card restarts this unit too, and there the same
# two lines mean something else entirely: the card comes off its kernel driver
# with VPP already running and not about to be restarted, so it belongs to
# neither stack. On a box whose only card carries the management address, that
# is the operator losing the box - while the VTY is printing, in the same
# breath, "NOT IN EFFECT YET: the dataplane claims its card when it starts,
# and this commit does not restart it". Measured on a booted guest: the driver
# read uio_pci_generic and the netdev was gone three lines under that sentence.
#
# THE DIRECTION TO BE WRONG IN, when this cannot be told. Skipping a bind that
# should have happened leaves a box that forwards nothing and is reachable, and
# the self-test says so on the console. Performing one that should not leaves a
# box nobody can reach. That is the trade #123 named: a box with no dataplane
# card is fixed over the network, and a box that ate its own management is
# fixed by walking to it. So the bind runs only when the dataplane is
# positively known NOT to be up.
# Three answers, not two, because "the dataplane is not up" and "nobody here
# can be asked" are different boxes and only one of them is the boot. Without
# systemd this is not an appliance starting: it is a chroot during the install
# or a container, and a bind there takes a card off whichever machine is
# really running.
# PRISMA_SYSTEMCTL is the same kind of seam as PRISMA_ROOT above and as PRISMA_IP and
# PRISMA_MEMINFO in prisma-routing-tune: the one external command whose answer
# changes the decision, named so a synthetic box can give it. Without it the
# answer would come from whatever machine is running the suite, and a developer
# box with a vpp.service would measure something the build runner does not.
: "${PRISMA_SYSTEMCTL:=systemctl}"
may_bind() {  # 0 only when the dataplane is positively known NOT to be up
  command -v "$PRISMA_SYSTEMCTL" >/dev/null 2>&1 || return 2
  "$PRISMA_SYSTEMCTL" is-active --quiet vpp.service 2>/dev/null && return 1
  return 0
}
may_bind; bind_verdict=$?
if [ "$bind_verdict" = 1 ]; then
  echo "bind: the dataplane is already running, so the card is not taken" >&2
  echo "      now: it would come off the kernel with nothing to pick it up." >&2
  echo "      It is claimed at the next start of the dataplane, which is what" >&2
  echo "      the VTY says when the card is named." >&2
elif [ "$bind_verdict" = 2 ]; then
  echo "bind: nothing here can say whether the dataplane is running, so the" >&2
  echo "      card is left where it is. This is not a box starting up." >&2
elif command -v prisma-routing-bind-nic >/dev/null 2>&1; then
  prisma-routing-bind-nic || true
elif [ -x "$ROOT/usr/lib/prisma-routing/bind-dataplane-nic" ]; then
  "$ROOT/usr/lib/prisma-routing/bind-dataplane-nic" || true
fi

printf 'reserved 1G pages now: %s\n' \
  "$(cat "$HUGEPAGES" 2>/dev/null \
     || echo '(no 1G support)')" >&2

# MANAGEMENT'S RULES AND SYSCTLS (#580), runtime state like the governor: put
# in at every boot, before the dataplane, the containers and FRR, so the box's
# own traffic and its listeners are on the management VRF from the first
# packet. The rules name the table, not the device: `prismash --load` makes
# the VRF device later in the boot, and the rules wait for it. The same
# commands the VTY runs at a commit (doors.management_argvs).
for fam in "" -6; do
  for pref in 31000 31001; do
    # shellcheck disable=SC2086
    $IP $fam rule del pref $pref 2>/dev/null
  done
done
if [ -n "$PRISMA_MANAGEMENT_TABLE" ]; then
  on=1
else
  on=0
fi
# l3mdev accept, so the listeners answer on the VRF; nonlocal bind, so one
# that names the management address can bind it once that address is the
# VRF's (snmpd's agentAddress, sshd's ListenAddress); and IPv6 keeping its
# addresses when the VTY moves the card into the VRF, which cycles it. The
# reasons, measured, are at doors.MGMT_SYSCTLS; the last is only turned on.
for key in net.ipv4.tcp_l3mdev_accept net.ipv4.udp_l3mdev_accept \
           net.ipv4.ip_nonlocal_bind net.ipv6.ip_nonlocal_bind; do
  $SYSCTL -q -w "$key=$on" >/dev/null 2>&1
done
if [ -n "$PRISMA_MANAGEMENT_TABLE" ]; then
  $SYSCTL -q -w net.ipv6.conf.all.keep_addr_on_down=1 >/dev/null 2>&1
  for fam in "" -6; do
    # shellcheck disable=SC2086
    $IP $fam rule add pref 31000 iif lo lookup main suppress_prefixlength 0
    # shellcheck disable=SC2086
    $IP $fam rule add pref 31001 iif lo lookup "$PRISMA_MANAGEMENT_TABLE"
  done
  echo "management: in VRF ${PRISMA_MANAGEMENT_VRF:-?}," \
       "table $PRISMA_MANAGEMENT_TABLE" >&2
fi

after=$(cat "$GRUBFILE" 2>/dev/null || true)

if [ "$before" = "$after" ]; then
  echo "tuning unchanged"
  exit 0
fi

# On a live system GRUB is not installed to disk: running update-grub there
# changes nothing and can take minutes scanning devices. The tuning starts to
# apply once the box is installed.
if [ -d "$LIVEDIR/medium" ] || [ -f "$LIVEDIR/overlay" ]; then
  echo "live system: skipping update-grub (tuning applies once installed)" >&2
  exit 0
fi

if command -v update-grub >/dev/null 2>&1; then
  update-grub
  echo "kernel command line changed (isolcpus/hugepages);" \
       "reboot for it to take effect" >&2
else
  # THE FILE ON A ROW OF ITS OWN. `echo` joins its arguments with a space onto
  # ONE row, so the continuation in the source was not a break in the output
  # and this was 114 columns on an 80-column console (#367) - on the one
  # message an operator gets when the tuning cannot be applied, and with the
  # path they have to type broken across the fold. The path is last on its row
  # now, which is where a fold costs nothing.
  echo "update-grub missing: apply the kernel command line by hand and" >&2
  echo "reboot. It is in $GRUBFILE" >&2
  exit 1
fi
