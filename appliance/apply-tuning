#!/bin/sh
# Applies the computed tuning and only touches GRUB when something changed.
#
# Running the calculation on every boot is cheap and makes the appliance
# honour changes in tune.env. Running update-grub on every boot is not: it
# writes to disk and costs seconds. So it always calculates, always writes,
# and regenerates GRUB only on a difference.
set -u

GRUBFILE=/etc/default/grub.d/hexarouting.cfg
VPPCONF=/etc/vpp/startup.conf
: "${HEXA_DATAPLANE_IF:=}"
: "${HEXA_SUBSCRIBERS:=200000}"
: "${HEXA_LOW_LATENCY:=1}"

# The governor is runtime state, not a kernel parameter: asking for it in
# GRUB does nothing, and it does not survive a reboot on its own. On
# ondemand/schedutil the OS core drops in frequency while the box is quiet,
# and the first burst arrives before it has ramped up - loss that shows up as
# an unexplained micro-burst.
governor_performance() {
  found=0
  changed=0
  for g in /sys/devices/system/cpu/cpufreq/policy*/scaling_governor; do
    [ -w "$g" ] || continue
    found=1
    avail=$(cat "$(dirname "$g")/scaling_available_governors" 2>/dev/null || echo "")
    case " $avail " in
      *" performance "*) ;;
      *) continue ;;
    esac
    [ "$(cat "$g")" = performance ] && continue
    echo performance > "$g" 2>/dev/null && changed=$((changed + 1))
  done
  if [ "$found" = 0 ]; then
    # Common in a VM: with no cpufreq exposed there is nothing to set, and
    # that is not an error.
    echo "no cpufreq policy exposed: skipping governor"
  else
    echo "cpufreq governor: performance ($changed changed)"
  fi
}

if [ "$HEXA_LOW_LATENCY" = 1 ]; then
  governor_performance
else
  echo "HEXA_LOW_LATENCY=0: leaving the cpufreq governor alone"
fi

before=$(cat "$GRUBFILE" 2>/dev/null || true)

set -- --write --subscribers "$HEXA_SUBSCRIBERS"
[ -n "$HEXA_DATAPLANE_IF" ] && set -- "$@" --interface "$HEXA_DATAPLANE_IF"
[ "$HEXA_LOW_LATENCY" = 1 ] || set -- "$@" --no-low-latency
# The decision goes to the journal. Diagnosing a box whose profile did not
# match its hardware meant guessing across whole build cycles, because the one
# component that knew why was throwing its reasoning away.
report=$(hexarouting-tune "$@" 2>&1) || { printf '%s\n' "$report" >&2; exit 1; }
printf '%s\n' "$report" | grep -E "^# |WARNING" >&2
printf 'kernel cmdline hugepages: %s\n' \
  "$(tr ' ' '\n' < /proc/cmdline | grep '^hugepages=' || echo '(none)')" >&2
printf 'reserved 1G pages now: %s\n' \
  "$(cat /sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages 2>/dev/null \
     || echo '(no 1G support)')" >&2

after=$(cat "$GRUBFILE" 2>/dev/null || true)

if [ "$before" = "$after" ]; then
  echo "tuning unchanged"
  exit 0
fi

# On a live system GRUB is not installed to disk: running update-grub there
# changes nothing and can take minutes scanning devices. The tuning starts to
# apply once the box is installed.
if [ -d /run/live/medium ] || [ -f /run/live/overlay ]; then
  echo "live system: skipping update-grub (tuning applies once installed)" >&2
  exit 0
fi

if command -v update-grub >/dev/null 2>&1; then
  update-grub
  echo "kernel command line changed (isolcpus/hugepages);" \
       "reboot for it to take effect" >&2
else
  echo "update-grub missing: apply the command line from $GRUBFILE" \
       "in your bootloader and reboot" >&2
  exit 1
fi
