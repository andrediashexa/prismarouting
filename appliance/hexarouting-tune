#!/usr/bin/env python3
"""
hexarouting-tune - computes boot tuning from the hardware.

Decides which CPUs to isolate, how many hugepages to reserve and how to pin
the VPP workers. Getting this wrong breaks nothing visibly: the box boots,
forwards, and delivers half the throughput. So the calculation is explicit
and testable, rather than a handful of values copied from a blog post.

Rules applied:

  - CPU 0 and its SMT sibling stay with the operating system and VPP's main
    thread. Isolating everything leaves the kernel nowhere to run.
  - workers only on the NIC's NUMA node. Crossing NUMA on the packet path
    costs more than the extra worker earns.
  - with SMT, one worker per physical core. The sibling is isolated too, so
    that system load does not compete for the same core.
  - nohz_full and rcu_nocbs follow isolcpus: isolating without removing the
    tick and the RCU callbacks leaves jitter, which shows up as burst loss.
  - deep C-states are turned off. A poll-mode worker never goes idle enough
    for its core to sleep on its own, but the OS core does - and waking it
    costs tens of microseconds in the middle of a burst. Worth the extra
    power.
  - one RX queue per worker on the dataplane NIC. Without it DPDK opens its
    default, and either a worker has no queue or a queue piles up flows.
  - system IRQs are banned from the isolated cores. Isolating from the
    scheduler while still taking interrupts isolates nothing.
"""

import argparse
import os
import sys


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def parse_list(spec):
    """'0-3,8' -> [0,1,2,3,8]"""
    out = []
    for part in (spec or "").split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return sorted(set(out))


def fmt_list(cpus):
    """[0,1,2,3,8] -> '0-3,8'"""
    if not cpus:
        return ""
    cpus = sorted(cpus)
    runs, start, prev = [], cpus[0], cpus[0]
    for c in cpus[1:]:
        if c == prev + 1:
            prev = c
            continue
        runs.append((start, prev))
        start = prev = c
    runs.append((start, prev))
    return ",".join(str(a) if a == b else f"{a}-{b}" for a, b in runs)


def hugepages_1g_reserved(root):
    """1G hugepages actually reserved RIGHT NOW."""
    v = read(os.path.join(
        root, "sys/kernel/mm/hugepages/hugepages-1048576kB/nr_hugepages"), "0")
    try:
        return int(v)
    except (TypeError, ValueError):
        return 0


def total_ram_gb(root):
    """
    Physical RAM in GB. Read through the sysfs root so the synthetic
    topologies in the tests can set it.
    """
    txt = read(os.path.join(root, "proc/meminfo"), "")
    for line in (txt or "").splitlines():
        if line.startswith("MemTotal:"):
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                return max(1, int(parts[1]) // (1024 * 1024))
    return 0


def isolated_now(root):
    """CPUs the kernel is isolating RIGHT NOW."""
    return parse_list(read(os.path.join(
        root, "sys/devices/system/cpu/isolated"), ""))


def is_pci_addr(name):
    """
    Is `name` a PCI address as sysfs spells it: 0000:3b:00.0

    Domain, bus, then device.function. Checked by SHAPE and not by a looser
    pattern, because what this decides is which directory gets handed to DPDK.
    """
    parts = name.split(":")
    if len(parts) != 3 or "." not in parts[2]:
        return False
    dev, _, func = parts[2].partition(".")
    hexd = "0123456789abcdefABCDEF"
    # The WIDTHS sysfs uses: a four-digit domain (wider on a box with many),
    # two-digit bus, two-digit device, one-digit function. Without them
    # 'a:b:c.d' is accepted as an address, and what this decides is which
    # directory is handed to DPDK.
    return bool(len(parts[0]) >= 4 and len(parts[1]) == 2
                and len(dev) == 2 and len(func) == 1
                and all(c in hexd for c in parts[0] + parts[1] + dev + func))


class Topology:
    def __init__(self, root="/"):
        self.root = root
        self.cpus = {}      # cpu -> (package, core, siblings)
        self.nodes = {}     # node -> [cpus]
        self._load()

    def p(self, *parts):
        return os.path.join(self.root, *parts)

    def _load(self):
        base = self.p("sys/devices/system/cpu")
        if not os.path.isdir(base):
            raise SystemExit(f"topology not found in {base}")
        for name in sorted(os.listdir(base)):
            if not name.startswith("cpu") or not name[3:].isdigit():
                continue
            n = int(name[3:])
            t = os.path.join(base, name, "topology")
            pkg = read(os.path.join(t, "physical_package_id"))
            core = read(os.path.join(t, "core_id"))
            sib = parse_list(read(os.path.join(t, "thread_siblings_list"), str(n)))
            if pkg is None or core is None:
                continue
            self.cpus[n] = (int(pkg), int(core), sib)

        nbase = self.p("sys/devices/system/node")
        if os.path.isdir(nbase):
            for name in sorted(os.listdir(nbase)):
                if name.startswith("node") and name[4:].isdigit():
                    self.nodes[int(name[4:])] = parse_list(
                        read(os.path.join(nbase, name, "cpulist"), ""))
        if not self.nodes:
            self.nodes = {0: sorted(self.cpus)}

    def nic_pci(self, ifname):
        """
        PCI address of the NIC, to name the device in the dpdk stanza.

        WALKED UP, not taken from the first component. `device` points at the
        device that OWNS the netdev, and on a virtio guest that is the virtio
        bus device, whose parent is the PCI one:

            /sys/class/net/ens18/device -> ../../../virtio3
            realpath: /sys/devices/pci0000:00/0000:00:12.0/virtio3

        Taking the basename gives `virtio3`, so this returned None and the
        tuner wrote `no-pci` - on every VM, with the interface named correctly
        (#286). DPDK drives virtio through its own poll-mode driver, so the
        card was always eligible; the resolution stopped one directory short.

        Bare metal is why it went unnoticed for so long: an Intel NIC's
        `device` link points straight at the PCI device, and there the
        basename IS the address.
        """
        link = self.p("sys/class/net", ifname, "device")
        try:
            path = os.path.realpath(link)
        except OSError:
            return None
        # Nearest PCI ancestor first. A device can sit several buses below the
        # PCI one, and it is the nearest that DPDK is handed.
        while path and path != "/":
            base = os.path.basename(path)
            if is_pci_addr(base):
                return base
            path = os.path.dirname(path)
        # Genuinely not PCI: virtio-mmio, a platform device, a veth. DPDK has
        # nothing it could be given, which is a different answer from "this
        # box has no card".
        return None

    def default_route_if(self):
        """
        The interface carrying the default route, from /proc/net/route.

        Read so that the box can refuse to hand VPP the path the operator is
        reaching it over. Handing that NIC to the dataplane does not degrade
        the box, it removes it: no SSH, no ping, nothing but a console
        somebody has to walk to. https://github.com/andrediashexa/hexarouting/issues/123
        """
        try:
            with open(self.p("proc/net/route")) as f:
                for line in f.readlines()[1:]:
                    w = line.split()
                    # Iface Destination Gateway Flags ... - destination
                    # 00000000 is the default route.
                    if len(w) > 2 and w[1] == "00000000":
                        return w[0]
        except OSError:
            pass
        return None

    def nic_node(self, ifname):
        v = read(self.p("sys/class/net", ifname, "device/numa_node"))
        try:
            n = int(v)
        except (TypeError, ValueError):
            return None
        # -1 means "no affinity declared"
        return n if n >= 0 else None

    def physical_cores(self, cpus):
        """Groups by physical core, returning (leader, siblings)."""
        seen, out = set(), []
        for c in sorted(cpus):
            if c in seen:
                continue
            _, _, sib = self.cpus[c]
            group = [s for s in sib if s in self.cpus]
            seen.update(group)
            out.append((min(group), sorted(group)))
        return out


def plan(topo, ifname, subscribers, max_workers=None, low_latency=True):
    # Never the management path, even when it was named on purpose.
    #
    # Handing VPP the interface carrying the default route does not degrade
    # the box, it removes it: the operator loses SSH the instant the dataplane
    # starts and gets it back by walking to a console. A refusal that keeps
    # the box reachable is recoverable in a sentence; the alternative is a
    # site visit. So this overrides the setting rather than warning about it.
    #
    # It is not a guess about intent: an interface can carry subscriber
    # traffic AND the default route only on a box that has one NIC, and such
    # a box cannot run this product anyway.
    # https://github.com/andrediashexa/hexarouting/issues/123
    mgmt = topo.default_route_if()
    refused = None
    if ifname and mgmt and ifname == mgmt:
        refused, ifname = ifname, None

    node = topo.nic_node(ifname) if ifname else None
    if node is None or node not in topo.nodes:
        node = sorted(topo.nodes)[0]
        nic_note = (f"NIC '{ifname}' declares no NUMA affinity; using node {node}"
                    if ifname else f"no NIC given; using node {node}")
    else:
        nic_note = f"NIC '{ifname}' on NUMA node {node}"
    # After the note above is decided, not inside it: the refusal is about
    # which device is claimed, and the NUMA choice still has to happen.
    if refused:
        nic_note = (f"REFUSED to give '{refused}' to the dataplane: it carries "
                    f"the default route, and the box would lose management. "
                    f"No device is claimed; using node {node}")

    node_cpus = [c for c in topo.nodes[node] if c in topo.cpus]
    cores = topo.physical_cores(node_cpus)

    # the node's first physical core stays with the OS and VPP's main thread
    os_core, os_cpus = cores[0]
    worker_cores = cores[1:]
    if max_workers:
        worker_cores = worker_cores[:max_workers]

    workers = [lead for lead, _ in worker_cores]
    isolated = sorted(c for _, sibs in worker_cores for c in sibs)

    # 1G hugepages. The per-subscriber budget comes from docs/architecture.md:
    # ~13 MB of bitmap and ~2.6 GB of session table for 200k subscribers,
    # plus buffers per worker.
    session_gb = max(1, round(subscribers * 13.5e-6 * 1024 / 1024))
    buffers_gb = max(1, (len(workers) + 3) // 4)
    want_gb = session_gb + buffers_gb + 1  # +1 of slack for the main heap

    # Bounded by the RAM the machine actually has.
    #
    # Sizing hugepages from the subscriber target alone asks a 3 GB box for
    # 5 GB of 1G pages. The kernel grants what it can, VPP starts against a
    # heap that is not there, and dies with SIGSEGV in a restart loop - which
    # is what an installed box did, having passed every other check. The
    # tuner exists to stop the quiet half-throughput failures; producing a
    # dataplane that does not run at all is the loud version of the same bug.
    total_gb = total_ram_gb(topo.root)
    if total_gb:
        # The operating system, VPP's own non-huge memory and the page cache
        # all live outside the hugepage pool.
        for_os = max(2, total_gb // 4)
        cap_gb = max(0, total_gb - for_os)
    else:
        cap_gb = want_gb          # unknown RAM: do not silently shrink
    hugepages_1g = min(want_gb, cap_gb)

    # Below two pages there is no room for buffers and a heap both. Asking for
    # one page would produce a tuned profile that cannot start, so ask for
    # none - which keeps tuned_now false and leaves the box on the
    # conservative profile, where it runs.
    if hugepages_1g < 2:
        hugepages_1g = 0
    capped = bool(total_gb) and hugepages_1g < want_gb

    reserved = hugepages_1g_reserved(topo.root)
    isolated_active = isolated_now(topo.root)

    # The tuning only takes effect on the next boot: isolcpus and hugepages
    # come from the kernel command line. Emitting a startup.conf now that
    # demands a hugepage which does not yet exist puts VPP in a restart loop
    # - and that breaks every first boot after an install. While the kernel
    # is not tuned, the config comes out conservative: no pinning and no
    # hugepages. It runs anywhere, it just does not perform.
    # hugepages_1g == 0 means this machine was judged too small for a hugepage
    # pool. Emitting the tuned profile anyway - because some pages happen to be
    # reserved right now - produces a startup.conf that asks for memory the
    # tuner just decided not to ask the kernel for. Pages can be reserved for
    # reasons this run knows nothing about: a previous configuration, or VPP
    # itself pre-allocating during a crash loop. The decision has to be
    # self-consistent, or the tuner argues with itself across boots.
    tuned_now = (hugepages_1g >= 1 and reserved >= 1
                 and set(isolated) <= set(isolated_active) and bool(isolated))

    return {
        "total_gb": total_gb,
        "hugepages_wanted": want_gb,
        "hugepages_capped": capped,
        "low_latency": low_latency,
        "nic_pci": topo.nic_pci(ifname) if ifname else None,
        "tuned_now": tuned_now,
        "hugepages_reserved": reserved,
        "isolated_active": isolated_active,
        "node": node,
        "nic_note": nic_note,
        "os_cpus": os_cpus,
        "main_core": os_core,
        "workers": workers,
        "isolated": isolated,
        "hugepages_1g": hugepages_1g,
        "subscribers": subscribers,
        "total_cpus": len(topo.cpus),
    }


# A core in C6 takes tens of microseconds to come back. The poll-mode worker
# never sleeps, but the OS core does - and it is the one that wakes up to
# handle the interrupt or the timer in the middle of a burst.
# transparent_hugepage=never comes along because khugepaged compacts memory
# in the background, and compaction stalls whichever CPU holds the page.
LOW_LATENCY_CMDLINE = ("intel_idle.max_cstate=0 processor.max_cstate=1 "
                       "transparent_hugepage=never")


def render_grub(p):
    if not p["isolated"]:
        return "# no core to isolate: machine too small for dedicated workers"
    iso = fmt_list(p["isolated"])
    latency = (" " + LOW_LATENCY_CMDLINE) if p["low_latency"] else ""
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT '
        f"isolcpus={iso} nohz_full={iso} rcu_nocbs={iso} "
        f"default_hugepagesz=1G hugepagesz=1G hugepages={p['hugepages_1g']} "
        f'intel_iommu=on iommu=pt{latency}"\n'
        # os-prober scans every block device looking for other systems. On
        # an appliance there is nothing to find, and the scan can take
        # minutes - stalling the boot inside the tuning service.
        "GRUB_DISABLE_OS_PROBER=true\n"
    )


def render_irqbalance(p):
    """
    Isolating from the scheduler while still taking interrupts on the same
    core isolates nothing: the IRQ preempts the worker just the same.
    irqbalance only honours the ban if it is in the service's environment.
    """
    if not p["isolated"]:
        return "# no isolated core: nothing to ban from irqbalance\n"
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        "# Keep interrupts off the cores that run VPP workers.\n"
        f"IRQBALANCE_BANNED_CPULIST={fmt_list(p['isolated'])}\n"
    )


PLUGINS_TUNED = """plugins {
  plugin default { enable }
  plugin bpa_plugin.so { enable }
  plugin linux_cp_plugin.so { enable }
  plugin linux_nl_plugin.so { enable }
}
"""

# Without hugepages the DPDK EAL fails and VPP exits. Since vpp.service has
# Restart=always, the result is a restart loop that points at nothing.
PLUGINS_FIRSTBOOT = """plugins {
  plugin default { enable }
  # DPDK disabled until hugepages exist: without them the EAL fails and VPP exits.
  plugin dpdk_plugin.so { disable }
  plugin bpa_plugin.so { enable }
  plugin linux_cp_plugin.so { enable }
  plugin linux_nl_plugin.so { enable }
}
"""


def render_vpp(p):
    if not p["tuned_now"]:
        # First boot: the kernel has not reserved hugepages or isolated CPUs yet.
        return (
            "# Generated by hexarouting-tune. Do not edit by hand.\n"
            "#\n"
            "# FIRST BOOT MODE. The kernel is not tuned yet:\n"
            f"#   1G hugepages reserved: {p['hugepages_reserved']}\n"
            f"#   isolated CPUs: {fmt_list(p['isolated_active']) or '(none)'}\n"
            "#\n"
            "# Conservative configuration, no pinning and no hugepages: it runs\n"
            "# anywhere and does not put VPP in a restart loop. Reboot so that\n"
            "# isolcpus and hugepages take effect; on the next boot this file\n"
            "# is written with the full tuning.\n"
            + PLUGINS_FIRSTBOOT + "\n"
            "cpu {\n"
            "  # no workers until the kernel isolates CPUs\n"
            "}\n\n"
            "buffers {\n"
            "  buffers-per-numa 8192\n"
            "  default data-size 2048\n"
            "  page-size 4k\n"
            "}\n\n"
            "memory {\n"
            "  main-heap-size 256M\n"
            "  main-heap-page-size 4k\n"
            "}\n"
        )

    if not p["workers"]:
        cpu = "  # no workers: small box, everything on the main thread\n"
    else:
        cpu = (f"  main-core {p['main_core']}\n"
               f"  corelist-workers {fmt_list(p['workers'])}\n")
    # One RX queue per worker. Left unsaid, DPDK opens its default (1) and
    # all traffic enters through a single worker - the others poll an empty
    # queue, and the CPU graph does not give it away, because poll mode reads
    # 100% either way.
    # The main heap comes out of the hugepage pool, so it is sized from the
    # pages the kernel ACTUALLY reserved rather than from a constant. A fixed
    # 2G against a smaller pool starts VPP on a heap that is not there, and it
    # dies with SIGSEGV - which is what a box did after its RAM was reduced
    # between one boot and the next. Reserved pages are ground truth; the
    # request is only an intention.
    pool_gb = p["hugepages_reserved"] or p["hugepages_1g"]
    heap_gb = max(1, min(2, pool_gb - max(1, (len(p["workers"]) + 3) // 4)))

    nq = max(1, len(p["workers"]))
    if p["nic_pci"]:
        dpdk = ("dpdk {\n"
                f"  dev {p['nic_pci']} {{\n"
                f"    num-rx-queues {nq}\n"
                f"    num-tx-queues {nq}\n"
                "  }\n"
                f"  dev default {{\n    num-rx-queues {nq}\n  }}\n"
                "}\n\n")
    else:
        # Unknown means take NOTHING.
        #
        # This used to emit "dev default" with no allowlist, which is not a
        # neutral statement: VPP's DPDK plugin then probes and takes whatever
        # NIC it can bind. On a single-NIC box that is the management
        # interface, and the box drops off the network the moment the
        # dataplane starts - silently, because by then nobody is reading
        # anything over anything.
        #
        # The shipped default was HEXA_DATAPLANE_IF=eth0, which does not exist
        # on a Debian 12 box with predictable interface names, so this branch
        # was the ordinary case rather than the exception (#123).
        #
        # A box with no dataplane interface is inconvenient and recoverable
        # over the network. A box that ate its own management is recoverable
        # only by walking to it.
        dpdk = ("dpdk {\n"
                "  # No dataplane interface identified, so no device is\n"
                "  # claimed. Set HEXA_DATAPLANE_IF in /etc/hexarouting/tune.env\n"
                "  # to the interface carrying subscriber traffic.\n"
                "  no-pci\n"
                "}\n\n")
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        + PLUGINS_TUNED + "\n"
        "cpu {\n" + cpu + "}\n\n"
        + dpdk +
        "buffers {\n"
        f"  buffers-per-numa {max(16384, len(p['workers']) * 16384)}\n"
        "  default data-size 2048\n"
        "  page-size default-hugepage\n"
        "}\n\n"
        "memory {\n"
        f"  main-heap-size {heap_gb}G\n"
        "  main-heap-page-size default-hugepage\n"
        "}\n"
    )


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interface", help="dataplane NIC, to choose the NUMA node")
    ap.add_argument("--subscribers", type=int, default=200000)
    ap.add_argument("--max-workers", type=int)
    ap.add_argument("--no-low-latency", action="store_true",
                    help="do not disable C-states or THP on the kernel line")
    ap.add_argument("--sysfs-root", default="/")
    ap.add_argument("--vpp-base", default="/etc/hexarouting/vpp-base.conf",
                    help="startup.conf base, concatenated with the tuning")
    ap.add_argument("--write", action="store_true",
                    help="write to /etc/default/grub.d and /etc/vpp")
    a = ap.parse_args()

    topo = Topology(a.sysfs_root)
    p = plan(topo, a.interface, a.subscribers, a.max_workers,
             low_latency=not a.no_low_latency)

    grub = render_grub(p)
    vpp = render_vpp(p)
    irq = render_irqbalance(p)

    print(f"# {p['nic_note']}")
    print(f"# {p['total_cpus']} CPUs total; chosen NUMA node: {p['node']}")
    print(f"# operating system and VPP main: {fmt_list(p['os_cpus'])}")
    print(f"# workers ({len(p['workers'])}): {fmt_list(p['workers'])}")
    print(f"# isolated: {fmt_list(p['isolated']) or '(none)'}")
    print(f"# 1G hugepages: {p['hugepages_1g']} requested "
          f"(sized for {p['subscribers']} subscribers), "
          f"{p['hugepages_reserved']} reserved right now")
    if p["hugepages_capped"]:
        # Said plainly, because the operator's real problem is that the box is
        # too small for the subscriber target - not that a number was adjusted.
        print(f"# WARNING: {p['hugepages_wanted']} GB of hugepages were needed "
              f"for {p['subscribers']} subscribers, but this machine has "
              f"{p['total_gb']} GB of RAM.")
        if p["hugepages_1g"] == 0:
            print("#          Hugepages disabled: the box stays on the "
                  "conservative profile, where it runs but does not perform.")
        else:
            print(f"#          Capped at {p['hugepages_1g']} GB. Expect fewer "
                  "subscribers than configured, or add RAM.")
    print(f"# dataplane NIC PCI address: {p['nic_pci'] or '(not a PCI device)'}")
    print(f"# low latency (C-states off, THP off): {'yes' if p['low_latency'] else 'no'}")
    print(f"# state: {'kernel tuned, full configuration' if p['tuned_now'] else 'FIRST BOOT, conservative configuration until reboot'}")
    print()
    print("### /etc/default/grub.d/hexarouting.cfg")
    print(grub)
    print("### /etc/default/irqbalance")
    print(irq)
    print("### stanzas appended to /etc/vpp/startup.conf")
    print(vpp)

    if a.write:
        os.makedirs("/etc/default/grub.d", exist_ok=True)
        with open("/etc/default/grub.d/hexarouting.cfg", "w") as f:
            f.write(grub)
        print("wrote /etc/default/grub.d/hexarouting.cfg", file=sys.stderr)

        # Always written: if irqbalance is installed later, the ban is
        # already there and starts applying on its own.
        os.makedirs("/etc/default", exist_ok=True)
        with open("/etc/default/irqbalance", "w") as f:
            f.write(irq)
        print("wrote /etc/default/irqbalance", file=sys.stderr)

        # VPP's startup.conf has no include directive: writing into a
        # startup.conf.d does nothing, and the whole tuning sits inert with no
        # signal at all - the box boots, forwards, and delivers half. So we
        # generate the file VPP actually reads, concatenating the base the
        # operator may edit.
        base = ""
        if os.path.exists(a.vpp_base):
            with open(a.vpp_base) as f:
                base = f.read().rstrip() + "\n\n"
        else:
            print(f"warning: base {a.vpp_base} does not exist; generating tuning only",
                  file=sys.stderr)
        os.makedirs("/etc/vpp", exist_ok=True)
        with open("/etc/vpp/startup.conf", "w") as f:
            f.write("# GENERATED by hexarouting-tune from "
