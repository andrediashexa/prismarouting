#!/usr/bin/env python3
"""
hexarouting-tune - computes boot tuning from the hardware.

Decides which CPUs to isolate, how many hugepages to reserve and how to pin
the VPP workers. Getting this wrong breaks nothing visibly: the box boots,
forwards, and delivers half the throughput. So the calculation is explicit
and testable, rather than a handful of values copied from a blog post.

Rules applied:

  - CPU 0 and its SMT sibling stay with the operating system and VPP's main
    thread. Isolating everything leaves the kernel nowhere to run.
  - workers only on the NIC's NUMA node. Crossing NUMA on the packet path
    costs more than the extra worker earns.
  - with SMT, one worker per physical core. The sibling is isolated too, so
    that system load does not compete for the same core.
  - nohz_full and rcu_nocbs follow isolcpus: isolating without removing the
    tick and the RCU callbacks leaves jitter, which shows up as burst loss.
  - deep C-states are turned off. A poll-mode worker never goes idle enough
    for its core to sleep on its own, but the OS core does - and waking it
    costs tens of microseconds in the middle of a burst. Worth the extra
    power.
  - one RX queue per worker on the dataplane NIC. Without it DPDK opens its
    default, and either a worker has no queue or a queue piles up flows.
  - system IRQs are banned from the isolated cores. Isolating from the
    scheduler while still taking interrupts isolates nothing.
  - the statistics segment is sized from the interfaces the box is CONFIGURED
    for, read from its own saved configuration. VPP's built-in 32 MB was
    measured holding 7,000 and aborting before 8,000, and an abort is the
    whole dataplane rather than a refused interface.
"""

import argparse
import os
import re
import subprocess
import sys


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def parse_list(spec):
    """'0-3,8' -> [0,1,2,3,8]"""
    out = []
    for part in (spec or "").split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return sorted(set(out))


def fmt_list(cpus):
    """[0,1,2,3,8] -> '0-3,8'"""
    if not cpus:
        return ""
    cpus = sorted(cpus)
    runs, start, prev = [], cpus[0], cpus[0]
    for c in cpus[1:]:
        if c == prev + 1:
            prev = c
            continue
        runs.append((start, prev))
        start = prev = c
    runs.append((start, prev))
    return ",".join(str(a) if a == b else f"{a}-{b}" for a, b in runs)


#: The hugepage sizes this tuner will use, largest first. 1G is preferred
#: because a 1G page is one TLB entry where 2M pages are five hundred and
#: twelve, and the dataplane's whole working set wants to stay resident in it.
HUGEPAGE_KB = (1048576, 2048)


def hugepage_supported(root, kb):
    """Does this kernel have a pool of `kb` pages at all?

    The directory exists only when the CPU and the kernel can do that size.
    A virtual machine whose CPU does not advertise `pdpe1gb` has no 1G pool,
    and asking for one on the kernel command line is silently ignored.
    """
    return os.path.isdir(os.path.join(
        root, "sys/kernel/mm/hugepages", f"hugepages-{kb}kB"))


def hugepages_reserved_for(root, kb=1048576):
    """Pages of size `kb` actually reserved RIGHT NOW."""
    v = read(os.path.join(
        root, "sys/kernel/mm/hugepages", f"hugepages-{kb}kB",
        "nr_hugepages"), "0")
    try:
        return int(v)
    except (TypeError, ValueError):
        return 0


def p_gb_to_pages(gb, kb):
    """How many pages of `kb` make `gb` gigabytes."""
    return gb * (1048576 // kb)


def hugepage_choice(root):
    """
    (page size in kB, GB already reserved of it) for the size this box can use.

    THE BOX MUST NOT WAIT FOREVER FOR A PAGE SIZE IT CANNOT HAVE. The tuner
    used to read the 1G pool and nothing else, so on a CPU without `pdpe1gb`
    the reserved count was 0 on every boot, `tuned_now` was never true, and
    the dataplane stayed in the first-boot profile with DPDK disabled - for
    the life of the box, however many times it was rebooted. Measured on a
    customer VM: the kernel command line carried `hugepagesz=1G hugepages=5`,
    the kernel ignored it, `/sys/kernel/mm/hugepages/` held only the 2048kB
    pool, and the box reported "1G hugepages reserved: 0" and told the
    operator to reboot (issue #290).

    2M is not a fallback in the sense of a degraded mode: VPP runs on 2M pages
    perfectly well, and the box on which this was measured already had 2 GB of
    them reserved by VPP's own shipped sysctl, sitting unused. 1G is a
    preference about TLB entries, not a requirement.
    """
    for kb in HUGEPAGE_KB:
        if hugepage_supported(root, kb):
            per_gb = 1048576 // kb
            return kb, hugepages_reserved_for(root, kb) // per_gb
    return HUGEPAGE_KB[0], 0


def total_ram_gb(root):
    """
    Physical RAM in GB. Read through the sysfs root so the synthetic
    topologies in the tests can set it.
    """
    txt = read(os.path.join(root, "proc/meminfo"), "")
    for line in (txt or "").splitlines():
        if line.startswith("MemTotal:"):
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                return max(1, int(parts[1]) // (1024 * 1024))
    return 0


def isolated_now(root):
    """CPUs the kernel is isolating RIGHT NOW."""
    return parse_list(read(os.path.join(
        root, "sys/devices/system/cpu/isolated"), ""))


def is_pci_addr(name):
    """
    Is `name` a PCI address as sysfs spells it: 0000:3b:00.0

    Domain, bus, then device.function. Checked by SHAPE and not by a looser
    pattern, because what this decides is which directory gets handed to DPDK.
    """
    parts = name.split(":")
    if len(parts) != 3 or "." not in parts[2]:
        return False
    dev, _, func = parts[2].partition(".")
    hexd = "0123456789abcdefABCDEF"
    # The WIDTHS sysfs uses: a four-digit domain (wider on a box with many),
    # two-digit bus, two-digit device, one-digit function. Without them
    # 'a:b:c.d' is accepted as an address, and what this decides is which
    # directory is handed to DPDK.
    return bool(len(parts[0]) >= 4 and len(parts[1]) == 2
                and len(dev) == 2 and len(func) == 1
                and all(c in hexd for c in parts[0] + parts[1] + dev + func))


class Topology:
    def __init__(self, root="/"):
        self.root = root
        self.cpus = {}      # cpu -> (package, core, siblings)
        self.nodes = {}     # node -> [cpus]
        self._load()

    def p(self, *parts):
        return os.path.join(self.root, *parts)

    def _load(self):
        base = self.p("sys/devices/system/cpu")
        if not os.path.isdir(base):
            raise SystemExit(f"topology not found in {base}")
        for name in sorted(os.listdir(base)):
            if not name.startswith("cpu") or not name[3:].isdigit():
                continue
            n = int(name[3:])
            t = os.path.join(base, name, "topology")
            pkg = read(os.path.join(t, "physical_package_id"))
            core = read(os.path.join(t, "core_id"))
            sib = parse_list(read(os.path.join(t, "thread_siblings_list"), str(n)))
            if pkg is None or core is None:
                continue
            self.cpus[n] = (int(pkg), int(core), sib)

        nbase = self.p("sys/devices/system/node")
        if os.path.isdir(nbase):
            for name in sorted(os.listdir(nbase)):
                if name.startswith("node") and name[4:].isdigit():
                    self.nodes[int(name[4:])] = parse_list(
                        read(os.path.join(nbase, name, "cpulist"), ""))
        if not self.nodes:
            self.nodes = {0: sorted(self.cpus)}

    def nic_pci(self, ifname):
        """
        PCI address of the NIC, to name the device in the dpdk stanza.

        WALKED UP, not taken from the first component. `device` points at the
        device that OWNS the netdev, and on a virtio guest that is the virtio
        bus device, whose parent is the PCI one:

            /sys/class/net/ens18/device -> ../../../virtio3
            realpath: /sys/devices/pci0000:00/0000:00:12.0/virtio3

        Taking the basename gives `virtio3`, so this returned None and the
        tuner wrote `no-pci` - on every VM, with the interface named correctly
        (#286). DPDK drives virtio through its own poll-mode driver, so the
        card was always eligible; the resolution stopped one directory short.

        Bare metal is why it went unnoticed for so long: an Intel NIC's
        `device` link points straight at the PCI device, and there the
        basename IS the address.
        """
        link = self.p("sys/class/net", ifname, "device")
        try:
            path = os.path.realpath(link)
        except OSError:
            return None
        # Nearest PCI ancestor first. A device can sit several buses below the
        # PCI one, and it is the nearest that DPDK is handed.
        while path and path != "/":
            base = os.path.basename(path)
            if is_pci_addr(base):
                return base
            path = os.path.dirname(path)
        # Genuinely not PCI: virtio-mmio, a platform device, a veth. DPDK has
        # nothing it could be given, which is a different answer from "this
        # box has no card".
        return None

    def pci_nics(self):
        """
        Every netdev on this box that resolves to a PCI address.

        The cards DPDK could be given, which is not the same as the netdevs
        Linux has: `lo`, a bridge, a bond and a veth have no PCI address, so
        the dataplane could not be handed any of them. Used to tell a box with
        a spare card from one with none, which is the difference between the
        refusal below standing and its advice naming a card that does not
        exist (#303).
        """
        out = []
        try:
            names = sorted(os.listdir(self.p("sys/class/net")))
        except OSError:
            return out
        for name in names:
            if self.nic_pci(name):
                out.append(name)
        return out

    def default_route_if(self):
        """
        The interface carrying the default route, from /proc/net/route.

        Read so that the box can refuse to hand VPP the path the operator is
        reaching it over. Handing that NIC to the dataplane does not degrade
        the box, it removes it: no SSH, no ping, nothing but a console
        somebody has to walk to. https://github.com/andrediashexa/hexarouting/issues/123
        """
        try:
            with open(self.p("proc/net/route")) as f:
                for line in f.readlines()[1:]:
                    w = line.split()
                    # Iface Destination Gateway Flags ... - destination
                    # 00000000 is the default route.
                    if len(w) > 2 and w[1] == "00000000":
                        return w[0]
        except OSError:
            pass
        return None

    def nic_tx_queues(self, ifname):
        """
        How many transmit queues this card has, or None if it cannot be read.

        THE CARD IS GROUND TRUTH AND THIS PROGRAM WAS NOT READING IT (#330).
        Every other figure in the generated configuration comes from something
        measured - the CPUs, the NUMA node, the pages the kernel actually
        reserved - and the queue count came from the worker count, which is a
        fact about the processor and not about the card. On a virtio guest,
        which is how most smaller deployments run, that asked for seven queues
        on a card with one, and DPDK refused the device with -22: the box
        owned the NIC and forwarded nothing.

        /sys/class/net/<if>/queues/ is what the kernel driver exposes, and it
        is readable BEFORE the card is handed over, which is the only moment
        this program runs.
        """
        try:
            qs = os.listdir(self.p("sys/class/net", ifname, "queues"))
        except OSError:
            return None
        n = len([q for q in qs if q.startswith("tx-")])
        return n or None

    def nic_max_mtu(self, ifname):
        """
        The largest MTU this card accepts, or None if it cannot be read.

        VPP defaults a DPDK interface to 9000 and a virtio card's maxmtu is
        1500, so `rte_eth_dev_set_mtu failed (mtu 8996)` and the device never
        came up (#330). Same shape as the queues above: a number true of the
        hardware this was developed on and never asked of the hardware in
        front of it.

        NOT in sysfs. `/sys/class/net/<if>/mtu` is the CURRENT one; the
        maximum is IFLA_MAX_MTU, a netlink attribute, and `ip -d link` is what
        reads it. So this shells out, which nothing else in this file does.
        The alternative was to assume, and assuming is what produced the
        defect.

        HEXA_IP is why there is a seam here at all. Everything else this class
        reads comes from `self.root`, so a test builds a directory and drives
        the real code; netlink has no root to point at, and the first version
        of this could only ever return None under a synthetic root - which
        means the MTU half of the fix shipped with a check that could not
        fail. Same reason HEXA_MEMINFO exists two functions down.
        """
        try:
            out = subprocess.run([os.environ.get("HEXA_IP", "ip"),
                                  "-d", "link", "show", ifname],
                                 capture_output=True, text=True,
                                 timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return None
        m = re.search(r"\bmaxmtu (\d+)", out)
        return int(m.group(1)) if m else None

    def nic_node(self, ifname):
        v = read(self.p("sys/class/net", ifname, "device/numa_node"))
        try:
            n = int(v)
        except (TypeError, ValueError):
            return None
        # -1 means "no affinity declared"
        return n if n >= 0 else None

    def physical_cores(self, cpus):
        """Groups by physical core, returning (leader, siblings)."""
        seen, out = set(), []
        for c in sorted(cpus):
            if c in seen:
                continue
            _, _, sib = self.cpus[c]
            group = [s for s in sib if s in self.cpus]
            seen.update(group)
            out.append((min(group), sorted(group)))
        return out


# VPP's own STAT_SEGMENT_DEFAULT_SIZE, in MB: the segment a box gets when no
# statseg stanza names one. Kept as a constant rather than read from the
# running dataplane because the tuner runs before VPP does, and the image pins
# the VPP version on purpose.
STATSEG_DEFAULT_MB = 32

#: The interface count that default was MEASURED holding, and the abort is the
#: whole dataplane rather than a refused interface. docs/bng.md 2.1 created
#: subscriber interfaces in batches of a thousand against a VPP booted with no
#: statseg stanza - `total: 32.00M` - and printed
#:
#:     after 7000: 7000 live, RSS 429916 kB
#:     VPP DIED while creating sessions 7000..8000
#:     os_panic() called, aborting.
#:
#: with _vec_realloc_internal under vlib_stats_create_counter on the stack.
#: Reproduced twice, at the same step.
STATSEG_MEASURED_INTERFACES = 7000

#: What one interface may therefore claim: 4793 bytes, which is the segment
#: that box had divided by the interfaces it carried on it.
#:
#: NOT the 2.9 kB of counter content measured at 40,000 interfaces on a 1 GB
#: segment (docs/appliance.md). That figure is what the entries WEIGH; this one
#: is what they COST, and the 1.65x between them is the counter directory:
#: ONE contiguous vector, grown by copying, so a growth needs the old vector
#: and the new one inside the segment at the same time. Sizing on 2.9 kB
#: predicts about 12,000 interfaces on a segment that aborted below 8,000 -
#: the arithmetic issue #288 itself noticed does not add up - and a segment
#: sized from it would abort at two thirds of the interfaces it promised.
#:
#: The box's own interfaces are inside this figure rather than added on top of
#: it: the 4.2 MB that segment holds with no subscriber on it at all is part
#: of the 32 MB being divided, amortised over the 7,000. That makes the budget
#: conservative for every box big enough to be given a stanza, which is the
#: direction to be wrong in when the alternative is SIGABRT.
STATSEG_BYTES_PER_INTERFACE = ((STATSEG_DEFAULT_MB << 20)
                               // STATSEG_MEASURED_INTERFACES)


def statseg_mb_for(count):
    """
    MB of statistics segment for `count` interfaces, or None for "nothing".

    None where VPP's own default already holds that many, which is the answer
    on every CGNAT box this product ships to: a segment stanza sized for three
    interfaces would be SMALLER than what VPP gives away, and a box that does
    not need this does not want a number in its startup.conf about it.
    """
    mb = -(-(count * STATSEG_BYTES_PER_INTERFACE) // (1 << 20))   # whole MB, up
    return mb if mb > STATSEG_DEFAULT_MB else None


#: Where hexash's own configuration parser lives, installed first: the box
#: keeps the modules in /usr/lib/hexarouting and this script in /usr/bin, and
#: the source tree keeps them in src/hexash beside appliance/.
HEXASH_DIRS = ("/usr/lib/hexarouting",
               os.path.join(os.path.dirname(os.path.realpath(__file__)),
                            "..", "src", "hexash"))


def configured_interfaces(path):
    """
    (interfaces this box is configured for, why not) from its saved config.

    THE COUNT IS READ FROM THE BOX, like the queue count and the maximum MTU
    beside it (#330), and for the same reason: everything else in the
    generated configuration comes from something measured, and an interface
    count inferred from the subscriber target would be a fact about a CGNAT
    translation rather than about an interface. The saved configuration is what
    hexarouting.service hands to `hexash --load` at every boot, so the
    interfaces named in it are the interfaces this box will create - before
    VPP starts, which is the only moment this program runs.

    hexash's OWN parser does the counting. A second reader of that grammar -
    a grep for `^interface ` here - would answer the same today and stop
    answering the same the first time the VTY learns another way to name one,
    and the box that would find out is the box with twenty thousand of them.
    The routing half of the file names interfaces too, in FRR's own blocks,
    and `Config.interface_names()` already returns the union by name rather
    than a line count.

    What it does NOT count is an interface created while the box runs: a PPPoE
    session, a linux_cp pair made from the VTY. Said out loud in the report
    rather than guessed at with a multiplier.

    Never raises. This runs as root before VPP on every boot, and a
    configuration this program could not read is a reason to leave the segment
    at VPP's default and SAY so - not a reason to fail the unit and leave the
    kernel command line disagreeing with the startup.conf beside it.
    """
    if not os.path.exists(path):
        return None, "missing"
    try:
        with open(path, encoding="utf-8") as f:
            text = f.read()
    except (OSError, UnicodeDecodeError):
        return None, "unreadable"
    found = False
    for d in HEXASH_DIRS:
        if os.path.exists(os.path.join(d, "config.py")):
            if d not in sys.path:
                sys.path.insert(0, d)
            found = True
            break
    # ITS OWN ANSWER, not "this file is broken". A box whose install put the
    # VTY's modules somewhere this program cannot see has a perfectly good
    # configuration and no way to count it, and telling the operator their
    # file could not be parsed would send them to edit the one thing that is
    # right.
    if not found:
        return None, "noparser"
    try:
        import config as hexash_config
        return len(hexash_config.Config.parse(text).interface_names()), None
    except Exception:            # noqa: BLE001 - see the docstring
        return None, "unparsed"


def operator_statseg(path):
    """
    Has somebody already put a statseg stanza in the base file?

    The base is concatenated AHEAD of the generated stanzas, so a generated
    one would be the last word on every boot and would silently replace a
    number an operator chose. This is the same `^\\s*statseg` the boot
    self-test greps for, and a STANZA and not the word: the shipped base file
    explains where a statseg goes in a comment block, and a box that reads its
    own documentation as somebody's decision would never size anything.
    """
    try:
        with open(path, encoding="utf-8") as f:
            return any(re.match(r"\s*statseg", line) for line in f)
    except (OSError, UnicodeDecodeError):
        return False


def plan(topo, ifname, subscribers, max_workers=None, low_latency=True,
         keep_management=False, config_path=None, vpp_base=None):
    # Never the management path, even when it was named on purpose.
    #
    # Handing VPP the interface carrying the default route does not degrade
    # the box, it removes it: the operator loses SSH the instant the dataplane
    # starts and gets it back by walking to a console. A refusal that keeps
    # the box reachable is recoverable in a sentence; the alternative is a
    # site visit. So this overrides the setting rather than warning about it.
    #
    # It is not a guess about intent: an interface can carry subscriber
    # traffic AND the default route only on a box that has one NIC.
    # https://github.com/andrediashexa/hexarouting/issues/123
    #
    # And a box with one NIC is exactly the box that could then never forward,
    # which is the dead end #303 was filed for. So the refusal keeps its
    # ground wherever the advice behind it can be followed - another card
    # means there is one to name instead - and steps aside only when there is
    # no other card AND the box has written down how to stay reachable
    # without it. `keep_management` is that record: apply-tuning passes it
    # when HEXA_DATAPLANE_MGMT is set, which the VTY writes beside the card's
    # own name and never without the address and MAC to put back.
    # https://github.com/andrediashexa/hexarouting/issues/303
    mgmt = topo.default_route_if()
    refused = None
    handover = False
    if ifname and mgmt and ifname == mgmt:
        others = [n for n in topo.pci_nics() if n != ifname]
        if others or not keep_management:
            refused, ifname = ifname, None
        else:
            handover = True

    node = topo.nic_node(ifname) if ifname else None
    if node is None or node not in topo.nodes:
        node = sorted(topo.nodes)[0]
        nic_note = (f"NIC '{ifname}' declares no NUMA affinity; using node {node}"
                    if ifname else f"no NIC given; using node {node}")
    else:
        nic_note = f"NIC '{ifname}' on NUMA node {node}"
    # After the note above is decided, not inside it: the refusal is about
    # which device is claimed, and the NUMA choice still has to happen.
    if refused:
        nic_note = (f"REFUSED to give '{refused}' to the dataplane: it carries "
                    f"the default route, and the box would lose management. "
                    f"No device is claimed; using node {node}")
    elif handover:
        # Said as plainly as the refusal, and for the same reason: this is the
        # line in the journal that explains a box which came back on a
        # different path than it left on.
        nic_note = (f"'{ifname}' carries the default route and is the only "
                    f"card this box has, so it is being handed over with its "
                    f"management path kept on its linux_cp pair; node {node}")

    node_cpus = [c for c in topo.nodes[node] if c in topo.cpus]
    cores = topo.physical_cores(node_cpus)

    # the node's first physical core stays with the OS and VPP's main thread
    os_core, os_cpus = cores[0]
    worker_cores = cores[1:]
    if max_workers:
        worker_cores = worker_cores[:max_workers]

    workers = [lead for lead, _ in worker_cores]
    isolated = sorted(c for _, sibs in worker_cores for c in sibs)

    # 1G hugepages. The per-subscriber budget comes from docs/architecture.md:
    # ~13 MB of bitmap and ~2.6 GB of session table for 200k subscribers,
    # plus buffers per worker.
    session_gb = max(1, round(subscribers * 13.5e-6 * 1024 / 1024))
    buffers_gb = max(1, (len(workers) + 3) // 4)
    want_gb = session_gb + buffers_gb + 1  # +1 of slack for the main heap

    # Bounded by the RAM the machine actually has.
    #
    # Sizing hugepages from the subscriber target alone asks a 3 GB box for
    # 5 GB of 1G pages. The kernel grants what it can, VPP starts against a
    # heap that is not there, and dies with SIGSEGV in a restart loop - which
    # is what an installed box did, having passed every other check. The
    # tuner exists to stop the quiet half-throughput failures; producing a
    # dataplane that does not run at all is the loud version of the same bug.
    total_gb = total_ram_gb(topo.root)
    if total_gb:
        # The operating system, VPP's own non-huge memory and the page cache
        # all live outside the hugepage pool.
        for_os = max(2, total_gb // 4)
        cap_gb = max(0, total_gb - for_os)
    else:
        cap_gb = want_gb          # unknown RAM: do not silently shrink
    hugepages_gb = min(want_gb, cap_gb)

    # Below two pages there is no room for buffers and a heap both. Asking for
    # one page would produce a tuned profile that cannot start, so ask for
    # none - which keeps tuned_now false and leaves the box on the
    # conservative profile, where it runs.
    if hugepages_gb < 2:
        hugepages_gb = 0
    capped = bool(total_gb) and hugepages_gb < want_gb

    # The page size this box can actually have, and how many GB of it are
    # reserved now. Both come from the pools that exist rather than from the
    # size this tuner would prefer, so a box that cannot do 1G is tuned on 2M
    # instead of waiting for a page size it will never get (#290).
    hugepage_kb, reserved = hugepage_choice(topo.root)
    isolated_active = isolated_now(topo.root)

    # The tuning only takes effect on the next boot: isolcpus and hugepages
    # come from the kernel command line. Emitting a startup.conf now that
    # demands a hugepage which does not yet exist puts VPP in a restart loop
    # - and that breaks every first boot after an install. While the kernel
    # is not tuned, the config comes out conservative: no pinning and no
    # hugepages. It runs anywhere, it just does not perform.
    # hugepages_gb == 0 means this machine was judged too small for a hugepage
    # pool. Emitting the tuned profile anyway - because some pages happen to be
    # reserved right now - produces a startup.conf that asks for memory the
    # tuner just decided not to ask the kernel for. Pages can be reserved for
    # reasons this run knows nothing about: a previous configuration, or VPP
    # itself pre-allocating during a crash loop. The decision has to be
    # self-consistent, or the tuner argues with itself across boots.
    tuned_now = (hugepages_gb >= 1 and reserved >= 1
                 and set(isolated) <= set(isolated_active) and bool(isolated))

    # The statistics segment, sized from the interfaces this box is
    # CONFIGURED for and from nothing else. A box whose configuration names
    # more interfaces than VPP's default segment was measured holding meets
    # that limit as SIGABRT, and it is the only resource on the box whose
    # limit is an abort rather than a refusal (#288).
    n_ifaces, why_not = configured_interfaces(config_path) if config_path \
        else (None, "missing")
    operator_sized = operator_statseg(vpp_base) if vpp_base else False
    statseg_mb = statseg_mb_for(n_ifaces) if n_ifaces else None

    return {
        "total_gb": total_gb,
        "hugepages_wanted": want_gb,
        "hugepages_capped": capped,
        "low_latency": low_latency,
        # The name, carried so the report can ask whether there is a card at
        # all before it says anything about one.
        "nic_name": ifname,
        "nic_pci": topo.nic_pci(ifname) if ifname else None,
        # Read off the card, not derived from the processor (#330).
        "nic_tx_queues": topo.nic_tx_queues(ifname) if ifname else None,
        "nic_max_mtu": topo.nic_max_mtu(ifname) if ifname else None,
        "tuned_now": tuned_now,
        "hugepages_reserved": reserved,
        # The page size in kB, the name the kernel command line uses for it,
        # and how many of them make up hugepages_gb. Carried rather than
        # recomputed, so the grub line and the report cannot disagree about
        # what was asked for.
        "hugepage_kb": hugepage_kb,
        "hugepage_name": "1G" if hugepage_kb == 1048576 else "2M",
        "hugepage_count": p_gb_to_pages(hugepages_gb, hugepage_kb),
        "isolated_active": isolated_active,
        "node": node,
        "nic_note": nic_note,
        "os_cpus": os_cpus,
        "main_core": os_core,
        "workers": workers,
        "isolated": isolated,
        "hugepages_gb": hugepages_gb,
        "subscribers": subscribers,
        "total_cpus": len(topo.cpus),
        # Read off the box's own configuration, not derived from the
        # subscriber target (#288). None means there was no count to be had,
        # and `statseg_why` says which of the three reasons it was, because
        # "this box is configured for nothing yet" and "this box has a
        # configuration I could not read" must not look the same.
        "configured_interfaces": n_ifaces,
        "statseg_why": why_not,
        "config_path": config_path,
        # The size to write, or None for "VPP's own default holds this box".
        "statseg_mb": statseg_mb,
        # Somebody's own stanza in the base file, which is never overridden.
        "statseg_operator": operator_sized,
        "vpp_base": vpp_base,
    }


# A core in C6 takes tens of microseconds to come back. The poll-mode worker
# never sleeps, but the OS core does - and it is the one that wakes up to
# handle the interrupt or the timer in the middle of a burst.
# transparent_hugepage=never comes along because khugepaged compacts memory
# in the background, and compaction stalls whichever CPU holds the page.
LOW_LATENCY_CMDLINE = ("intel_idle.max_cstate=0 processor.max_cstate=1 "
                       "transparent_hugepage=never")


def render_grub(p):
    if not p["isolated"]:
        return "# no core to isolate: machine too small for dedicated workers"
    iso = fmt_list(p["isolated"])
    latency = (" " + LOW_LATENCY_CMDLINE) if p["low_latency"] else ""
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT '
        f"isolcpus={iso} nohz_full={iso} rcu_nocbs={iso} "
        f"default_hugepagesz={p['hugepage_name']} "
        f"hugepagesz={p['hugepage_name']} hugepages={p['hugepage_count']} "
        f'intel_iommu=on iommu=pt{latency}"\n'
        # os-prober scans every block device looking for other systems. On
        # an appliance there is nothing to find, and the scan can take
        # minutes - stalling the boot inside the tuning service.
        "GRUB_DISABLE_OS_PROBER=true\n"
    )


def render_irqbalance(p):
    """
    Isolating from the scheduler while still taking interrupts on the same
    core isolates nothing: the IRQ preempts the worker just the same.
    irqbalance only honours the ban if it is in the service's environment.
    """
    if not p["isolated"]:
        return "# no isolated core: nothing to ban from irqbalance\n"
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        "# Keep interrupts off the cores that run VPP workers.\n"
        f"IRQBALANCE_BANNED_CPULIST={fmt_list(p['isolated'])}\n"
    )


PLUGINS_TUNED = """plugins {
  plugin default { enable }
  plugin bpa_plugin.so { enable }
  plugin linux_cp_plugin.so { enable }
  plugin linux_nl_plugin.so { enable }
}
"""

# Without hugepages the DPDK EAL fails and VPP exits. Since vpp.service has
# Restart=always, the result is a restart loop that points at nothing.
PLUGINS_FIRSTBOOT = """plugins {
  plugin default { enable }
  # DPDK disabled until hugepages exist: without them the EAL fails and VPP exits.
  plugin dpdk_plugin.so { disable }
  plugin bpa_plugin.so { enable }
  plugin linux_cp_plugin.so { enable }
  plugin linux_nl_plugin.so { enable }
}
"""


def render_statseg(p):
    """
    The statseg stanza, or "" on a box that is not the one that needs it.

    WRITTEN IN BOTH PROFILES below, conservative and tuned, because unlike
    every other stanza this one has nothing to do with the kernel: the
    hugepages and the pinning wait for a reboot, and `hexash --load` creates
    the interfaces in the saved configuration on the FIRST boot too. A box
    that aborts on its configuration aborts on it the first time.
    """
    if not p["statseg_mb"] or p["statseg_operator"]:
        return ""
    return ("statseg {\n"
            f"  # sized for the {p['configured_interfaces']} interface(s) in "
            f"{p['config_path']}, at\n"
            f"  # {STATSEG_BYTES_PER_INTERFACE} bytes each. Put your own "
            f"statseg in {p['vpp_base']}\n"
            "  # to choose the size yourself: this one steps aside for it.\n"
            f"  size {p['statseg_mb']}M\n"
            "}\n")


def render_vpp(p):
    statseg = render_statseg(p)
    if not p["tuned_now"]:
        # First boot: the kernel has not reserved hugepages or isolated CPUs yet.
        return (
            "# Generated by hexarouting-tune. Do not edit by hand.\n"
            "#\n"
            "# FIRST BOOT MODE. The kernel is not tuned yet:\n"
            f"#   {p['hugepage_name']} hugepages reserved: "
            f"{p['hugepages_reserved']} GB worth\n"
            f"#   isolated CPUs: {fmt_list(p['isolated_active']) or '(none)'}\n"
            "#\n"
            "# Conservative configuration, no pinning and no hugepages: it runs\n"
            "# anywhere and does not put VPP in a restart loop. Reboot so that\n"
            "# isolcpus and hugepages take effect; on the next boot this file\n"
            "# is written with the full tuning.\n"
            + PLUGINS_FIRSTBOOT + "\n"
            "cpu {\n"
            "  # no workers until the kernel isolates CPUs\n"
            "}\n\n"
            "buffers {\n"
            "  buffers-per-numa 8192\n"
            "  default data-size 2048\n"
            "  page-size 4k\n"
            "}\n\n"
            "memory {\n"
            "  main-heap-size 256M\n"
            "  main-heap-page-size 4k\n"
            "}\n"
            + ("\n" + statseg if statseg else "")
        )

    if not p["workers"]:
        cpu = "  # no workers: small box, everything on the main thread\n"
    else:
        cpu = (f"  main-core {p['main_core']}\n"
               f"  corelist-workers {fmt_list(p['workers'])}\n")
    # One RX queue per worker. Left unsaid, DPDK opens its default (1) and
    # all traffic enters through a single worker - the others poll an empty
    # queue, and the CPU graph does not give it away, because poll mode reads
    # 100% either way.
    # The main heap comes out of the hugepage pool, so it is sized from the
    # pages the kernel ACTUALLY reserved rather than from a constant. A fixed
    # 2G against a smaller pool starts VPP on a heap that is not there, and it
    # dies with SIGSEGV - which is what a box did after its RAM was reduced
    # between one boot and the next. Reserved pages are ground truth; the
    # request is only an intention.
    pool_gb = p["hugepages_reserved"] or p["hugepages_gb"]
    heap_gb = max(1, min(2, pool_gb - max(1, (len(p["workers"]) + 3) // 4)))

    # ONE QUEUE PER WORKER, OR AS MANY AS THE CARD HAS - whichever is fewer.
    #
    # This asked for one per worker and never read the card (#330). A virtio
    # guest has ONE transmit queue; an eight-CPU box gives seven workers; DPDK
    # answered `Configured number of TX queues (7) is bigger than maximum
    # supported (1)`, refused the device with -22, and the box owned the NIC
    # and forwarded nothing. Every other number in this stanza is measured and
    # this one was inferred from the processor.
    #
    # CAPPED AND SAID OUT LOUD, not capped quietly. With fewer queues than
    # workers only that many workers receive packets, which is a capacity fact
    # an operator has to be told - the same reason the hugepage cap above
    # announces itself instead of just applying.
    want_q = max(1, len(p["workers"]))
    have_q = p["nic_tx_queues"]
    nq = min(want_q, have_q) if have_q else want_q
    if p["nic_pci"]:
        # NO MTU LINE, BECAUSE THIS VPP HAS NO SUCH KNOB.
        #
        # #330 wrote `mtu <n>` into the dev stanza to stop VPP asking a
        # virtio card for a 9000-byte MTU it has not got. The keyword does
        # not exist. VPP does not ignore it either - it refuses the whole
        # file and exits, and vpp.service carries Restart=always, so the box
        # loops until systemd gives up:
        #
        #   vpp[3322]: dpdk_device_config: unknown input `mtu 1500'
        #   vpp.service: Start request repeated too quickly.
        #   vpp.service: Failed with result 'start-limit-hit'.
        #
        # That shipped in v0.75.0 and it stops the dataplane starting on
        # every box whose card reports a maximum below 9000, which is every
        # virtio guest. Reported from an installed box; the journal above is
        # that box's.
        #
        # Measured against the real VPP in hexarouting-dev:26.06, by feeding
        # it one keyword at a time, because the question "what does VPP
        # accept" has exactly one authority and it is not this file:
        #
        #   dev { mtu 1500 }           unknown input
        #   dev { max-frame-size ... } unknown input
        #   dev { default-mtu ... }    unknown input
        #   dpdk { max-frame-size ... }unknown input
        #   dev { num-rx-desc 512 }    accepted
        #   dev { tag x } dev { name eth0 }  accepted
        #
        # There is no MTU setting anywhere in this VPP's dpdk configuration,
        # so there is nothing to write here.
        #
        # AND THE PRODUCT ALREADY SETS IT, somewhere else, which is where the
        # next person reaching for a startup.conf knob should be sent:
        # src/hexash/hexash.py sends sw_interface_set_mtu over the binary API
        # with the L3 MTU array, on the dataplane interface AND its TAP, and
        # reads it back. Its own comment there explains why the array and not
        # the CLI keyword: plain `set interface mtu` changes the hardware max
        # frame size, which most drivers refuse, and refused while vppctl still
        # exited 0. So the MTU is a runtime interface property in this product
        # and not a boot-time one, and that is not an oversight. What #330 was actually seeing is
        # a log line from rte_eth_dev_set_mtu, which is a complaint and not a
        # refusal: the device still comes up. A dataplane that starts and
        # logs about an MTU is strictly better than one that does not start.
        #
        # The other half of #330 - the TX queue count - was a real -22 that
        # DID refuse the device, and it stays. That one is measured from the
        # card, and it works.
        dpdk = ("dpdk {\n"
                f"  dev {p['nic_pci']} {{\n"
                f"    num-rx-queues {nq}\n"
                f"    num-tx-queues {nq}\n"
                "  }\n"
                f"  dev default {{\n    num-rx-queues {nq}\n  }}\n"
                "}\n\n")
    else:
        # Unknown means take NOTHING.
        #
        # This used to emit "dev default" with no allowlist, which is not a
        # neutral statement: VPP's DPDK plugin then probes and takes whatever
        # NIC it can bind. On a single-NIC box that is the management
        # interface, and the box drops off the network the moment the
        # dataplane starts - silently, because by then nobody is reading
        # anything over anything.
        #
        # The shipped default was HEXA_DATAPLANE_IF=eth0, which does not exist
        # on a Debian 12 box with predictable interface names, so this branch
        # was the ordinary case rather than the exception (#123).
        #
        # A box with no dataplane interface is inconvenient and recoverable
        # over the network. A box that ate its own management is recoverable
        # only by walking to it.
        dpdk = ("dpdk {\n"
                "  # No dataplane interface identified, so no device is\n"
                "  # claimed. Set HEXA_DATAPLANE_IF in /etc/hexarouting/tune.env\n"
                "  # to the interface carrying subscriber traffic.\n"
                "  no-pci\n"
                "}\n\n")
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        + PLUGINS_TUNED + "\n"
        "cpu {\n" + cpu + "}\n\n"
        + dpdk +
        "buffers {\n"
        f"  buffers-per-numa {max(16384, len(p['workers']) * 16384)}\n"
        "  default data-size 2048\n"
        "  page-size default-hugepage\n"
        "}\n\n"
        "memory {\n"
        f"  main-heap-size {heap_gb}G\n"
        "  main-heap-page-size default-hugepage\n"
        "}\n"
        + ("\n" + statseg if statseg else "")
    )


def render_report(p, vpp_base):
    """The commented report the tuner prints above the files it generates.

    A FUNCTION so that it can be rendered without running the tuner, which is
    what render_grub(), render_vpp() and render_irqbalance() beside it are
    for. It was inline in main(), and docs/appliance.md quotes it: the page
    said the box prints `1G hugepages: 6 requested` where it prints
    `6 GB requested`, and nothing could compare the two because there was
    nothing to call (#326). The commit that changed that line landed three
    hours after the one that quoted it correctly.

    `vpp_base` is passed rather than read off the argument parser, because the
    only thing the report needs from it is the path it names.
    """
    out = []
    out.append(f"# {p['nic_note']}")
    out.append(f"# {p['total_cpus']} CPUs total; chosen NUMA node: {p['node']}")
    out.append(f"# operating system and VPP main: {fmt_list(p['os_cpus'])}")
    out.append(f"# workers ({len(p['workers'])}): {fmt_list(p['workers'])}")
    out.append(f"# isolated: {fmt_list(p['isolated']) or '(none)'}")
    # The card's own limits, beside the figures read off the machine, because
    # they are the same kind of fact and one of them silently disagreeing with
    # the hardware is what #330 was.
    _w = max(1, len(p["workers"]))
    if not p["nic_name"]:
        # Nothing: there is no card, and nic_note above already said so. A
        # sentence about queues here would be true of one box and false of
        # this one, which is the shape of every defect in this file's history.
        pass
    elif not p["nic_tx_queues"]:
        # SAYING SO, because this is the state the defect lives in. Unread
        # falls back to one queue per worker, which is exactly what asked a
        # one-queue card for seven and left the box owning a NIC it could not
        # start (#330). "Could not read the card" and "read it and it is fine"
        # must not look the same on this screen.
        out.append(f"# NIC queues: could not be read, so this asks for "
                   f"{_w}, one per worker. A card with fewer will refuse the "
                   f"device: 'show hardware' says what the box can see.")
    elif p["nic_tx_queues"] < _w:
        out.append(f"# NIC queues: {p['nic_tx_queues']}, and this box has "
                   f"{_w} worker(s). Capped at {p['nic_tx_queues']}: only "
                   f"that many workers receive packets, so expect a "
                   f"fraction of the forwarding this CPU could do.")
    else:
        out.append(f"# NIC queues: {p['nic_tx_queues']}, enough for "
                   f"{_w} worker(s)")
    if p["nic_max_mtu"] and p["nic_max_mtu"] < 9000:
        # SAID, AND NOT ACTED ON, which is the honest report of what this
        # tuner can do. It wrote `mtu <n>` into the dev stanza until that
        # keyword turned out not to exist and to stop VPP starting at all.
        # There is no MTU setting in this VPP's dpdk configuration, so the
        # operator is told what the card is and what VPP will try, and the
        # log line from rte_eth_dev_set_mtu that follows is a complaint about
        # a device that still comes up.
        out.append(f"# NIC max MTU: {p['nic_max_mtu']}, below VPP's default "
                   f"of 9000. VPP has no MTU setting in its dpdk stanza, so "
                   f"it will ask for 9000, be refused by the card and log it")
    out.append(f"# {p['hugepage_name']} hugepages: {p['hugepages_gb']} GB requested "
          f"(sized for {p['subscribers']} subscribers), "
          f"{p['hugepages_reserved']} reserved right now")
    if p["hugepages_capped"]:
        # Said plainly, because the operator's real problem is that the box is
        # too small for the subscriber target - not that a number was adjusted.
        out.append(f"# WARNING: {p['hugepages_wanted']} GB of hugepages were needed "
              f"for {p['subscribers']} subscribers, but this machine has "
              f"{p['total_gb']} GB of RAM.")
        if p["hugepages_gb"] == 0:
            out.append("#          Hugepages disabled: the box stays on the "
                  "conservative profile, where it runs but does not perform.")
        else:
            out.append(f"#          Capped at {p['hugepages_gb']} GB. Expect fewer "
                  "subscribers than configured, or add RAM.")
    # The statistics segment, and it is the only resource on this box whose
    # limit is an ABORT rather than a refusal. VPP exports every counter
    # through a segment of fixed size; each interface adds entries to it;
    # filling it reaches os_panic and SIGABRT instead of refusing the
    # interface, so the box loses its whole dataplane and says nothing about
    # why. It is sized from the interfaces the box is CONFIGURED for, read
    # from the file that creates them, exactly as the queue count above is
    # read from the card that has to carry it (#330).
    #
    # FOUR BOXES, four different true sentences. A box nobody has configured
    # yet must not be told about a size it does not need, and a box carrying
    # somebody's own stanza must not be told this one chose anything: a line
    # true of one box and false of another, printed by a path that never
    # asked which box it was on, is the defect this file keeps having.
    _n = p["configured_interfaces"]
    if p["statseg_operator"]:
        out.append("# statistics segment: left to the stanza somebody already "
                   "put in")
        out.append(f"#          {vpp_base},")
        out.append("#          which is never overridden: the base is "
                   "concatenated ahead of")
        out.append("#          these stanzas, so anything written here would "
                   "be the last word.")
        if _n:
            out.append(f"#          For the record: {_n} interface(s) "
                       f"configured, which need")
            out.append(f"#          {statseg_mb_for(_n) or STATSEG_DEFAULT_MB}"
                       f" MB at {STATSEG_BYTES_PER_INTERFACE} bytes each.")
    elif p["statseg_mb"]:
        out.append(f"# statistics segment: {p['statseg_mb']}M, for the {_n} "
                   f"interface(s) configured in")
        out.append(f"#          {p['config_path']}, at "
                   f"{STATSEG_BYTES_PER_INTERFACE} bytes each.")
        out.append(f"#          That is the density a box on VPP's "
                   f"{STATSEG_DEFAULT_MB} MB default was measured")
        out.append(f"#          surviving: {STATSEG_MEASURED_INTERFACES:,} "
                   f"interfaces live, aborting before 8,000.")
        out.append("#          Interfaces created while the box runs - a PPPoE "
                   "session, a pair")
        out.append("#          made from the VTY - are not in that file nor in "
                   "this number.")
        out.append(f"#          Put your own statseg in {vpp_base}")
        out.append("#          to choose the size instead.")
    elif _n:
        out.append(f"# statistics segment: VPP's built-in "
                   f"{STATSEG_DEFAULT_MB} MB, which was measured holding")
        out.append(f"#          {STATSEG_MEASURED_INTERFACES:,} interfaces. "
                   f"This box is configured for {_n}, in")
        out.append(f"#          {p['config_path']}: nothing is written, "
                   f"because a")
        out.append("#          stanza smaller than what VPP gives away would "
                   "buy the box")
        out.append("#          nothing and cost it the counters.")
    else:
        # No count to size from, and the two reasons are not the same
        # sentence. "Nothing configured yet" is every fresh box; "there is a
        # configuration and I could not read it" is the state where a box with
        # twenty thousand interfaces in a file keeps the segment that was
        # measured aborting at seven thousand - which is #288 itself, still
        # happening, and it must not read like a healthy box.
        _why = {"unreadable": "could not be read",
                "unparsed": "could not be parsed"}.get(p["statseg_why"])
        if p["statseg_why"] == "noparser":
            out.append("# statistics segment: no interface count to size it "
                       "from: hexash's")
            out.append("#          configuration parser is not installed "
                       "beside this program.")
            out.append(f"#          VPP's built-in {STATSEG_DEFAULT_MB} MB "
                       f"applies.")
        elif _why:
            out.append("# statistics segment: no interface count to size it "
                       "from, because")
            out.append(f"#          {p['config_path']} {_why}.")
            out.append(f"#          VPP's built-in {STATSEG_DEFAULT_MB} MB "
                       f"applies.")
        else:
            out.append(f"# statistics segment: NOT sized, because this box has "
                       f"no configured")
            out.append(f"#          interface yet, so VPP's built-in "
                       f"{STATSEG_DEFAULT_MB} MB applies.")
        out.append("#          Measured: a box on that default aborted between "
                   "7,000 and 8,000")
        out.append("#          interfaces. It is per INTERFACE, not per "
                   "subscriber.")
        out.append("#          To set it by hand, put a statseg stanza in "
                   "the base file")
        out.append(f"#          ({vpp_base}):")
        out.append("#          it is concatenated ahead of these stanzas.")
    # THREE STATES, not two. `nic_pci` is None both when no card was named
    # and when a named card's address could not be resolved, and those are
    # nothing alike: the first is every fresh install, where there is no
    # device for the sentence to be about. Printing "(not a PCI device)" there
    # sent an operator looking for why their card was not PCI, which is the
    # #286 dead end - and the line two above already says no NIC was given, so
    # the report contradicted itself on the same screen (#331).
    if p["nic_pci"]:
        out.append(f"# dataplane NIC PCI address: {p['nic_pci']}")
    elif p["nic_name"]:
        out.append(f"# dataplane NIC PCI address: '{p['nic_name']}' was named "
                   f"and no PCI address could be read for it, so DPDK has no "
                   f"device to be given")
    else:
        out.append("# dataplane NIC PCI address: none, because no card has "
                   "been given to the dataplane on this box")
    out.append(f"# low latency (C-states off, THP off): {'yes' if p['low_latency'] else 'no'}")
    out.append(f"# state: {'kernel tuned, full configuration' if p['tuned_now'] else 'FIRST BOOT, conservative configuration until reboot'}")
    return "\n".join(out)


# --------------------------------------------------------------------------
# What the kernel DID with what it was asked for.
#
# Everything above this line decides what to REQUEST, and writes the request
# into three files: /etc/default/grub.d/hexarouting.cfg, /etc/default/
# irqbalance and (through appliance/install.sh) /etc/sysctl.d/99-hexarouting.
# conf. A file is not a machine, and between the two sit four ways for the
# request to stop:
#
#   update-grub was never run, so the bootloader never saw it
#   the box has not rebooted since, so THIS kernel never saw it
#   the kernel saw it and refused it, because the hardware cannot do it
#   the knob is runtime state and something else set it back
#
# The third is not a hypothesis. It is the customer VM of #290: the command
# line carried `hugepagesz=1G hugepages=5`, the CPU does not advertise
# `pdpe1gb`, /sys held only the 2048kB pool, and /proc/cmdline went on
# carrying the parameter for the life of the box.
#
# So a report on the tuning that reads the request and stops is a sentence
# true of one box and false of another, printed by a path that never asked
# which box it was on. These functions ask.
#
# FOUR ANSWERS AND NOT TWO. "in effect" and "never requested" are the two a
# reader expects. "requested, and NOT in effect" has to stay distinct from
# both: collapsed into the first it is an appliance claiming tuning it does
# not have, collapsed into the second it is a box that looks deliberately
# untuned when it is broken, and the operator's next move differs. And a
# parameter whose effect THIS box exposes no way to read is a fourth -
# rcu_nocbs on a kernel that names no offload thread, C-states on a virtual
# machine with no idle driver. Reporting that as either taken or refused is a
# guess, and a guess printed on a console is indistinguishable from a
# measurement.
#
# WHAT IS NOT HERE, because something already reads it back: the cpufreq
# governor and the worker pinning. appliance/selftest reads the governor out
# of scaling_governor and compares the dataplane's own threads against
# /sys/devices/system/cpu/isolated. A second answer to a question that
# already has one is two components disagreeing about one box, which is worse
# than either being wrong.
# --------------------------------------------------------------------------

#: The request reached the kernel and the kernel is doing it.
EFFECT_TAKEN = "in-effect"
#: The request was made and the machine is not doing it. The third state.
EFFECT_REFUSED = "not-in-effect"
#: Nothing on this box can say either way. The fourth state.
EFFECT_UNREADABLE = "cannot-tell"
#: Never asked for, so there is nothing to have taken.
EFFECT_UNASKED = "not-requested"
#: A parameter the tuner emits with no entry in READBACK below. On a box it
#: is an honest fourth-state answer and a useless one; appliance/test_tune.py
#: refuses it against the line the tuner really generates, so the only way to
#: see one is to add a knob and forget its reader.
EFFECT_NOREADER = "no-reader"


def cpuset(spec):
    """'1-3,8' -> {1,2,3,8}, and anything that is not a cpu list -> set().

    Not parse_list() above, which raises: /sys/devices/system/cpu/nohz_full
    reads the six characters `(null)` padded with spaces when the mask is
    empty - measured on the Debian 6.1 kernel this appliance ships - and a
    readback that raises is a readback that reports nothing at all.
    """
    out = set()
    for part in (spec or "").replace(",", " ").split():
        if "-" in part:
            a, _, b = part.partition("-")
            if a.isdigit() and b.isdigit():
                out.update(range(int(a), int(b) + 1))
        elif part.isdigit():
            out.add(int(part))
    return out


def cmdline_params(text):
    """{name: value} for a kernel command line; a bare flag maps to ''."""
    out = {}
    for tok in (text or "").split():
        # Shell in the GRUB file, not a kernel parameter.
        if tok.startswith("$"):
            continue
        k, sep, v = tok.partition("=")
        out[k] = v if sep else ""
    return out


def requested_params(root):
    """What the generated GRUB file asks the NEXT boot for."""
    txt = read(os.path.join(root, "etc/default/grub.d/hexarouting.cfg"), "")
    for line in (txt or "").splitlines():
        if line.startswith("GRUB_CMDLINE_LINUX_DEFAULT="):
            return cmdline_params(line.split("=", 1)[1].strip().strip('"'))
    return {}


def _rb_cpu_mask(sysfile, doing):
    """The readback for a parameter whose effect is a cpu mask in /sys."""
    def rb(root, want, booted):
        path = os.path.join(root, sysfile)
        if not os.path.exists(path):
            return EFFECT_UNREADABLE, (
                f"/{sysfile} is not there, so this kernel says nothing about "
                f"which cpus it is {doing}")
        missing = cpuset(want) - cpuset(read(path, ""))
        if not missing:
            return EFFECT_TAKEN, f"the kernel is {doing} cpu(s) {want}"
        return EFFECT_REFUSED, (
            f"cpu(s) {fmt_list(sorted(missing))} were asked for and the "
            f"kernel is not {doing} them")
    return rb


def _rb_rcu_nocbs(root, want, booted):
    """The offload threads, because nothing in /sys answers for rcu_nocbs.

    Measured on the Debian 6.1 kernel this appliance ships: there is no
    /sys/kernel/rcu_nocbs, and nothing under /sys/devices/system/cpu names the
    offload mask. The only readback outside debugfs - which is root-only and
    often not mounted - is that the kernel starts one callback thread per
    offloaded cpu, named `rcuop/<cpu>`. That kernel has CONFIG_RCU_NOCB_CPU=y,
    so their absence means the parameter did not take rather than that the
    feature was compiled out.

    A machine with no kernel thread visible at all is a container or a
    synthetic tree, not a box that booted: there the answer is that nothing
    here can look, which is not the same as the threads being absent.
    """
    procdir = os.path.join(root, "proc")
    try:
        pids = [p for p in os.listdir(procdir) if p.isdigit()]
    except OSError:
        pids = []
    offloaded, saw_rcu = set(), False
    for pid in pids:
        comm = read(os.path.join(procdir, pid, "comm"), "") or ""
        if comm.startswith(("rcu_gp", "rcu_preempt", "rcu_sched")):
            saw_rcu = True
        if comm.startswith(("rcuop/", "rcuos/")):
            n = comm.split("/", 1)[1]
            if n.isdigit():
                offloaded.add(int(n))
    if not saw_rcu:
        return EFFECT_UNREADABLE, (
            "no kernel thread is visible here, so the offload threads that "
            "are the only readback for this cannot be counted")
    missing = cpuset(want) - offloaded
    if not missing:
        return EFFECT_TAKEN, f"the kernel offloads callbacks off cpu(s) {want}"
    return EFFECT_REFUSED, (
        f"cpu(s) {fmt_list(sorted(missing))} were asked for and the kernel "
        f"runs no offload thread for them, so RCU callbacks still land there")


def _hugepage_kb(name):
    """'1G' -> 1048576, '2M' -> 2048, anything else -> None."""
    return {"1G": 1048576, "2M": 2048}.get(name)


def _rb_hugepagesz(root, want, booted):
    kb = _hugepage_kb(want)
    if kb is None:
        return EFFECT_UNREADABLE, f"'{want}' is not a page size this reads"
    if hugepage_supported(root, kb):
        return EFFECT_TAKEN, f"the kernel has a {want} pool"
    return EFFECT_REFUSED, (
        f"the kernel has no {want} pool at all, so this parameter was "
        f"ignored: the cpu does not do that page size (#290)")


def _rb_default_hugepagesz(root, want, booted):
    have = None
    _mem = read(os.path.join(root, "proc/meminfo"), "") or ""
    for line in _mem.splitlines():
        if line.startswith("Hugepagesize:"):
            f = line.split()
            if len(f) >= 2 and f[1].isdigit():
                have = int(f[1])
    if have is None:
        return EFFECT_UNREADABLE, "/proc/meminfo names no Hugepagesize"
    if have == _hugepage_kb(want):
        return EFFECT_TAKEN, f"the default hugepage is {want}"
    return EFFECT_REFUSED, (
        f"{want} was asked for and /proc/meminfo reports a default hugepage "
        f"of {have} kB")


def _rb_hugepages(root, want, booted):
    """How many pages of the size asked for on the SAME line are reserved.

    The count means nothing without the size beside it, so this reads the
    request rather than assuming 1G: a box that fell back to 2M asks for 512
    times as many pages, and comparing that count against the 1G pool would
    call a correctly tuned box broken.
    """
    size = booted.get("hugepagesz") or booted.get("default_hugepagesz") or "1G"
    kb = _hugepage_kb(size)
    if not want.isdigit():
        return EFFECT_UNREADABLE, f"'{want}' is not a page count this reads"
    if kb is None or not hugepage_supported(root, kb):
        return EFFECT_REFUSED, (
            f"{want} page(s) of {size} were asked for and this kernel has no "
            f"{size} pool to put them in")
    have = hugepages_reserved_for(root, kb)
    if have >= int(want):
        return EFFECT_TAKEN, f"{have} page(s) of {size} reserved"
    return EFFECT_REFUSED, (
        f"{want} page(s) of {size} were asked for and the kernel reserved "
        f"{have}: without them the dataplane stays on the first-boot profile")


def _rb_intel_iommu(root, want, booted):
    try:
        names = sorted(os.listdir(os.path.join(root, "sys/class/iommu")))
    except OSError:
        names = []
    if names:
        return EFFECT_TAKEN, f"the kernel exposes {', '.join(names)}"
    return EFFECT_REFUSED, (
        "the kernel exposes no IOMMU, so either this platform has none or "
        "VT-d is off in firmware: the card can then only be bound through "
        "uio_pci_generic, with no DMA protection behind it")


def _rb_iommu_pt(root, want, booted):
    """`iommu=pt` is the groups' type, and only groups can answer for it."""
    d = os.path.join(root, "sys/kernel/iommu_groups")
    try:
        groups = sorted(os.listdir(d))
    except OSError:
        groups = []
    types = set()
    for g in groups:
        t = read(os.path.join(d, g, "type"), "")
        if t:
            types.add(t)
    if not types:
        return EFFECT_UNREADABLE, (
            "there is no IOMMU group here to carry a type, which the line "
            "for intel_iommu has already said and this must not say twice")
    if want != "pt":
        return EFFECT_UNREADABLE, f"'{want}' is not a mode this reads back"
    if types == {"identity"}:
        return EFFECT_TAKEN, "every IOMMU group is in passthrough"
    return EFFECT_REFUSED, (
        f"passthrough was asked for and the groups are "
        f"{', '.join(sorted(types))}: translation is still on the DMA path")


def _rb_intel_idle(root, want, booted):
    drv = read(os.path.join(
        root, "sys/devices/system/cpu/cpuidle/current_driver"), "")
    if not drv or drv == "none":
        return EFFECT_UNREADABLE, (
            "this kernel drives no idle state at all, so nothing here sleeps "
            "and the parameter has nothing to act on. Usual on a VM")
    if drv == "intel_idle":
        return EFFECT_REFUSED, (
            "intel_idle is still the idle driver, so the deep states it owns "
            "are still reachable and a wake costs tens of microseconds")
    return EFFECT_TAKEN, f"the idle driver is {drv}, not intel_idle"


def _rb_max_cstate(root, want, booted):
    """How many idle states cpu0 is left with.

    state0 is POLL and is not a C-state, so `processor.max_cstate=N` leaves
    N+1 directories. Counting them is the readback: the parameter caps what
    the driver registers, and what it registered is what is there.
    """
    d = os.path.join(root, "sys/devices/system/cpu/cpu0/cpuidle")
    try:
        states = sorted(n for n in os.listdir(d) if n.startswith("state"))
    except OSError:
        return EFFECT_UNREADABLE, (
            "cpu0 exposes no idle states, so there is nothing here to count")
    names = ", ".join(read(os.path.join(d, s, "name"), "?") for s in states)
    if want.isdigit() and len(states) <= int(want) + 1:
        return EFFECT_TAKEN, f"cpu0 exposes {names} and nothing deeper"
    return EFFECT_REFUSED, (
        f"max_cstate={want} was asked for and cpu0 still exposes "
        f"{len(states)} idle states: {names}")


def _rb_thp(root, want, booted):
    v = read(os.path.join(
        root, "sys/kernel/mm/transparent_hugepage/enabled"), None)
    if v is None:
        return EFFECT_UNREADABLE, (
            "this kernel exposes no transparent-hugepage control, so there "
            "is nothing here to read the setting off")
    m = re.search(r"\[(\w+)\]", v)
    have = m.group(1) if m else v.strip()
    if have == want:
        return EFFECT_TAKEN, f"transparent hugepages are '{have}'"
    return EFFECT_REFUSED, (
        f"'{want}' was asked for and transparent hugepages are '{have}': "
        f"khugepaged compacts in the background and stalls whichever cpu "
        f"holds the page. It is runtime state, so something may have set it")


#: How each parameter the tuner can put on the kernel command line is read
#: back off a running box. Keyed on the parameter name exactly as render_grub
#: above emits it, so that renaming one there and not here goes red rather
#: than quiet.
READBACK = {
    "isolcpus": _rb_cpu_mask("sys/devices/system/cpu/isolated", "isolating"),
    "nohz_full": _rb_cpu_mask("sys/devices/system/cpu/nohz_full",
                              "running tickless on"),
    "rcu_nocbs": _rb_rcu_nocbs,
    "default_hugepagesz": _rb_default_hugepagesz,
    "hugepagesz": _rb_hugepagesz,
    "hugepages": _rb_hugepages,
    "intel_iommu": _rb_intel_iommu,
    "iommu": _rb_iommu_pt,
    "intel_idle.max_cstate": _rb_intel_idle,
    "processor.max_cstate": _rb_max_cstate,
    "transparent_hugepage": _rb_thp,
}

#: The knobs that are not boot parameters, under the name install.sh gives
#: appliance/etc/sysctl.conf on the box.
SYSCTL_FILE = "etc/sysctl.d/99-hexarouting.conf"


def sysctl_rules(root):
    """The sysctls, as requested by the shipped file and as /proc/sys has them.

    THE FILE IS NOT THE KNOB, twice over: it is applied once at boot and
    anything may write /proc/sys afterwards, and a file in /etc/sysctl.d that
    sorts after 99-hexarouting.conf overrides every line in it silently. The
    only place either shows is /proc/sys.
    """
    txt = read(os.path.join(root, SYSCTL_FILE), None)
    if txt is None:
        return [(SYSCTL_FILE.rsplit("/", 1)[-1], EFFECT_UNASKED,
                 f"/{SYSCTL_FILE} is not on this box, so none of the knobs "
                 f"it carries was ever asked for")]
    out = []
    for line in txt.splitlines():
        line = line.split("#", 1)[0].strip()
        if "=" not in line:
            continue
        key, _, want = line.partition("=")
        key, want = key.strip(), want.strip()
        knob = os.path.join(root, "proc/sys", key.replace(".", "/"))
        have = read(knob, None)
        if have is None:
            out.append((key, EFFECT_UNREADABLE,
                        f"/proc/sys/{key.replace('.', '/')} is not there, so "
                        f"this kernel has no such knob to answer for"))
        elif have.split() == want.split():
            out.append((key, EFFECT_TAKEN, f"the kernel reports {have}"))
        else:
            out.append((key, EFFECT_REFUSED,
                        f"the file asks for {want} and the kernel reports "
                        f"{have}: a file in /etc/sysctl.d sorts after it, or "
                        f"sysctl has not been re-read since it changed"))
    return out


def irqbalance_rule(root):
    """The IRQ ban, which is a file until a daemon has read it.

    render_irqbalance() above writes /etc/default/irqbalance on every boot,
    on the argument that the ban is then already there if irqbalance is
    installed later. That is right, and it is also exactly the shape this
    section is about: the ban does nothing until a RUNNING irqbalance has read
    it, and the one that is running read whatever the file said when it
    started. A daemon started before the tuner first wrote that file is
    balancing interrupts onto the worker cores while the file beside it says
    it is not.
    """
    txt = read(os.path.join(root, "etc/default/irqbalance"), None)
    want = ""
    for line in (txt or "").splitlines():
        line = line.split("#", 1)[0].strip()
        if line.startswith("IRQBALANCE_BANNED_CPULIST="):
            want = line.split("=", 1)[1].strip().strip('"')
    if not want:
        return ("IRQBALANCE_BANNED_CPULIST", EFFECT_UNASKED,
                "/etc/default/irqbalance bans no cpu, which is what a box "
                "with no core to isolate is meant to look like")
    procdir = os.path.join(root, "proc")
    try:
        pids = [p for p in os.listdir(procdir) if p.isdigit()]
    except OSError:
        pids = []
    pid = None
    for p in pids:
        if (read(os.path.join(procdir, p, "comm"), "") or "") == "irqbalance":
            pid = p
            break
    if pid is None:
        return ("IRQBALANCE_BANNED_CPULIST", EFFECT_UNREADABLE,
                "no irqbalance is running here, so the ban has nothing to act "
                "on - and nothing is moving interrupts onto those cores "
                "either. The file is there for the day one is installed")
    # Binary, and not through read() above: an environment is NUL-separated
    # and carries whatever the service manager put in it, so a byte that is
    # not valid in this locale would raise out of a text-mode read and take
    # the whole report with it.
    try:
        with open(os.path.join(procdir, pid, "environ"), "rb") as f:
            env = f.read().decode("utf-8", "replace")
    except OSError:
        env = None
    if env is None:
        return ("IRQBALANCE_BANNED_CPULIST", EFFECT_UNREADABLE,
                f"the environment of irqbalance (pid {pid}) cannot be read "
                f"here, and it is the only place the ban it took can be seen")
    got = ""
    for entry in env.replace("\0", "\n").splitlines():
        if entry.startswith("IRQBALANCE_BANNED_CPULIST="):
            got = entry.split("=", 1)[1]
    missing = cpuset(want) - cpuset(got)
    if not missing:
        return ("IRQBALANCE_BANNED_CPULIST", EFFECT_TAKEN,
                f"the running irqbalance is banned from cpu(s) {want}")
    return ("IRQBALANCE_BANNED_CPULIST", EFFECT_REFUSED,
            f"the file bans cpu(s) {want} and the running irqbalance took "
            f"'{got}': it started before that file was written, so restart "
            f"irqbalance.service")


def effective_tuning(root="/"):
    """[(rule, state, detail)] for every rule this box has asked for.

    Ordered as the tuner writes them - the kernel command line, then the
    sysctls, then the IRQ ban - because that is the order an operator undoes
    them in, and reading a console means reading a list top to bottom.
    """
    cmdline = read(os.path.join(root, "proc/cmdline"), None)
    if cmdline is None:
        return [("the kernel command line", EFFECT_UNREADABLE,
                 "/proc/cmdline cannot be read here, so what this boot was "
                 "given is unknown and nothing could be compared against it")]
    want = requested_params(root)
    booted = cmdline_params(cmdline)
    rules = []
    # ONE LINE AND NOT ELEVEN when the whole command line missed this boot.
    # update-grub not having run, and the box not having rebooted since, are
    # one fact about the box rather than one fact per parameter - and eleven
    # copies of the same sentence on an 80-column console is twenty-two lines
    # that push everything else off the screen, which is how a console stops
    # being read.
    if want and not any(n in booted for n in want):
        return ([("the kernel command line", EFFECT_REFUSED,
                  f"the generated file asks this boot for {len(want)} "
                  f"parameter(s) and it carries none of them: update-grub "
                  f"has not run since that file was written, or the box has "
                  f"not rebooted since. Run update-grub and reboot")]
                + sysctl_rules(root) + [irqbalance_rule(root)])
    if not want:
        rules.append((
            "the kernel command line", EFFECT_UNASKED,
            "/etc/default/grub.d/hexarouting.cfg asks the bootloader for "
            "nothing, so no boot parameter of this product's is in effect. "
            "It is written by hexarouting-tune.service on every boot"))
    for name in sorted(want):
        value = want[name]
        if name not in booted:
            rules.append((name, EFFECT_REFUSED,
                          "the generated file asks for it and THIS boot's "
                          "command line does not carry it: run update-grub "
                          "and reboot"))
        elif booted[name] != value:
            rules.append((name, EFFECT_REFUSED,
                          f"the generated file asks for {value} and this "
                          f"boot got {booted[name]}: the box booted a "
                          f"command line older than that file. Reboot"))
        elif name not in READBACK:
            rules.append((name, EFFECT_NOREADER,
                          "this build has no way to read back what the "
                          "kernel did with it, so whether it took cannot be "
                          "said here"))
        else:
            state, detail = READBACK[name](root, value, booted)
            rules.append((name, state, detail))
    rules.extend(sysctl_rules(root))
    rules.append(irqbalance_rule(root))
    return rules


def render_effective(rules):
    """One rule per line, `<state> <rule>: <detail>`.

    A FORMAT rather than prose, because appliance/selftest renders it onto an
    80-column console and has to fold the detail without folding the verdict.
    """
    return "\n".join(f"{s} {name}: {d}" for name, s, d in rules)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interface", help="dataplane NIC, to choose the NUMA node")
    ap.add_argument("--subscribers", type=int, default=200000)
    ap.add_argument("--max-workers", type=int)
    ap.add_argument("--keep-management", action="store_true",
                    help="the box has recorded the management path of the "
                         "card being handed over, so a single-NIC box may "
                         "give up the card carrying its default route")
    ap.add_argument("--no-low-latency", action="store_true",
                    help="do not disable C-states or THP on the kernel line")
    ap.add_argument("--sysfs-root", default="/")
    ap.add_argument("--vpp-base", default="/etc/hexarouting/vpp-base.conf",
                    help="startup.conf base, concatenated with the tuning")
    ap.add_argument("--config", default="/etc/hexarouting/hexarouting.conf",
                    help="the box's saved configuration, read for the number "
                         "of interfaces the statistics segment has to hold")
    ap.add_argument("--write", action="store_true",
                    help="write to /etc/default/grub.d and /etc/vpp")
    # The other direction entirely: everything else here computes what to
    # ASK the box for, and this reports what the box DID with what it was
    # asked. appliance/selftest runs it on every boot and renders it onto the
    # console, because an appliance that says it is tuned when the kernel
    # refused the parameter is worse than one that says nothing (#163).
    ap.add_argument("--report-effective", action="store_true",
                    help="report the tuning in effect on this box, rather "
                         "than computing the tuning to request")
    a = ap.parse_args()

    # BEFORE the topology is read. The report is about a box that has already
    # booted, and a machine too small for a worker makes plan() produce
    # nothing to report - while still having a command line, sysctls and an
    # IRQ ban that either took or did not.
    if a.report_effective:
        print(render_effective(effective_tuning(a.sysfs_root)))
        return 0

    topo = Topology(a.sysfs_root)
    p = plan(topo, a.interface, a.subscribers, a.max_workers,
             low_latency=not a.no_low_latency,
             keep_management=a.keep_management,
             config_path=a.config, vpp_base=a.vpp_base)

    grub = render_grub(p)
    vpp = render_vpp(p)
    irq = render_irqbalance(p)

    print(render_report(p, a.vpp_base))
    print()
    print("### /etc/default/grub.d/hexarouting.cfg")
    print(grub)
    print("### /etc/default/irqbalance")
    print(irq)
    print("### stanzas appended to /etc/vpp/startup.conf")
    print(vpp)

    if a.write:
        os.makedirs("/etc/default/grub.d", exist_ok=True)
        with open("/etc/default/grub.d/hexarouting.cfg", "w") as f:
            f.write(grub)
        print("wrote /etc/default/grub.d/hexarouting.cfg", file=sys.stderr)

        # Always written: if irqbalance is installed later, the ban is
        # already there and starts applying on its own.
        os.makedirs("/etc/default", exist_ok=True)
        with open("/etc/default/irqbalance", "w") as f:
            f.write(irq)
        print("wrote /etc/default/irqbalance", file=sys.stderr)

        # VPP's startup.conf has no include directive: writing into a
        # startup.conf.d does nothing, and the whole tuning sits inert with no
        # signal at all - the box boots, forwards, and delivers half. So we
        # generate the file VPP actually reads, concatenating the base the
        # operator may edit.
        base = ""
        if os.path.exists(a.vpp_base):
            with open(a.vpp_base) as f:
                base = f.read().rstrip() + "\n\n"
        else:
            print(f"warning: base {a.vpp_base} does not exist; generating tuning only",
                  file=sys.stderr)
        os.makedirs("/etc/vpp", exist_ok=True)
        with open("/etc/vpp/startup.conf", "w") as f:
            f.write("# GENERATED by hexarouting-tune from "
                    f"{a.vpp_base}. Do not edit by hand.\n\n")
            f.write(base)
            f.write(vpp)
        print("wrote /etc/vpp/startup.conf", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
