#!/usr/bin/env python3
"""
hexarouting-tune - computes boot tuning from the hardware.

Decides which CPUs to isolate, how many hugepages to reserve and how to pin
the VPP workers. Getting this wrong breaks nothing visibly: the box boots,
forwards, and delivers half the throughput. So the calculation is explicit
and testable, rather than a handful of values copied from a blog post.

Rules applied:

  - CPU 0 and its SMT sibling stay with the operating system and VPP's main
    thread. Isolating everything leaves the kernel nowhere to run.
  - workers only on the NIC's NUMA node. Crossing NUMA on the packet path
    costs more than the extra worker earns.
  - with SMT, one worker per physical core. The sibling is isolated too, so
    that system load does not compete for the same core.
  - nohz_full and rcu_nocbs follow isolcpus: isolating without removing the
    tick and the RCU callbacks leaves jitter, which shows up as burst loss.
  - deep C-states are turned off. A poll-mode worker never goes idle enough
    for its core to sleep on its own, but the OS core does - and waking it
    costs tens of microseconds in the middle of a burst. Worth the extra
    power.
  - one RX queue per worker on the dataplane NIC. Without it DPDK opens its
    default, and either a worker has no queue or a queue piles up flows.
  - system IRQs are banned from the isolated cores. Isolating from the
    scheduler while still taking interrupts isolates nothing.
"""

import argparse
import os
import re
import subprocess
import sys


def read(path, default=None):
    try:
        with open(path) as f:
            return f.read().strip()
    except OSError:
        return default


def parse_list(spec):
    """'0-3,8' -> [0,1,2,3,8]"""
    out = []
    for part in (spec or "").split(","):
        part = part.strip()
        if not part:
            continue
        if "-" in part:
            a, b = part.split("-")
            out.extend(range(int(a), int(b) + 1))
        else:
            out.append(int(part))
    return sorted(set(out))


def fmt_list(cpus):
    """[0,1,2,3,8] -> '0-3,8'"""
    if not cpus:
        return ""
    cpus = sorted(cpus)
    runs, start, prev = [], cpus[0], cpus[0]
    for c in cpus[1:]:
        if c == prev + 1:
            prev = c
            continue
        runs.append((start, prev))
        start = prev = c
    runs.append((start, prev))
    return ",".join(str(a) if a == b else f"{a}-{b}" for a, b in runs)


#: The hugepage sizes this tuner will use, largest first. 1G is preferred
#: because a 1G page is one TLB entry where 2M pages are five hundred and
#: twelve, and the dataplane's whole working set wants to stay resident in it.
HUGEPAGE_KB = (1048576, 2048)


def hugepage_supported(root, kb):
    """Does this kernel have a pool of `kb` pages at all?

    The directory exists only when the CPU and the kernel can do that size.
    A virtual machine whose CPU does not advertise `pdpe1gb` has no 1G pool,
    and asking for one on the kernel command line is silently ignored.
    """
    return os.path.isdir(os.path.join(
        root, "sys/kernel/mm/hugepages", f"hugepages-{kb}kB"))


def hugepages_reserved_for(root, kb=1048576):
    """Pages of size `kb` actually reserved RIGHT NOW."""
    v = read(os.path.join(
        root, "sys/kernel/mm/hugepages", f"hugepages-{kb}kB",
        "nr_hugepages"), "0")
    try:
        return int(v)
    except (TypeError, ValueError):
        return 0


def p_gb_to_pages(gb, kb):
    """How many pages of `kb` make `gb` gigabytes."""
    return gb * (1048576 // kb)


def hugepage_choice(root):
    """
    (page size in kB, GB already reserved of it) for the size this box can use.

    THE BOX MUST NOT WAIT FOREVER FOR A PAGE SIZE IT CANNOT HAVE. The tuner
    used to read the 1G pool and nothing else, so on a CPU without `pdpe1gb`
    the reserved count was 0 on every boot, `tuned_now` was never true, and
    the dataplane stayed in the first-boot profile with DPDK disabled - for
    the life of the box, however many times it was rebooted. Measured on a
    customer VM: the kernel command line carried `hugepagesz=1G hugepages=5`,
    the kernel ignored it, `/sys/kernel/mm/hugepages/` held only the 2048kB
    pool, and the box reported "1G hugepages reserved: 0" and told the
    operator to reboot (issue #290).

    2M is not a fallback in the sense of a degraded mode: VPP runs on 2M pages
    perfectly well, and the box on which this was measured already had 2 GB of
    them reserved by VPP's own shipped sysctl, sitting unused. 1G is a
    preference about TLB entries, not a requirement.
    """
    for kb in HUGEPAGE_KB:
        if hugepage_supported(root, kb):
            per_gb = 1048576 // kb
            return kb, hugepages_reserved_for(root, kb) // per_gb
    return HUGEPAGE_KB[0], 0


def total_ram_gb(root):
    """
    Physical RAM in GB. Read through the sysfs root so the synthetic
    topologies in the tests can set it.
    """
    txt = read(os.path.join(root, "proc/meminfo"), "")
    for line in (txt or "").splitlines():
        if line.startswith("MemTotal:"):
            parts = line.split()
            if len(parts) >= 2 and parts[1].isdigit():
                return max(1, int(parts[1]) // (1024 * 1024))
    return 0


def isolated_now(root):
    """CPUs the kernel is isolating RIGHT NOW."""
    return parse_list(read(os.path.join(
        root, "sys/devices/system/cpu/isolated"), ""))


def is_pci_addr(name):
    """
    Is `name` a PCI address as sysfs spells it: 0000:3b:00.0

    Domain, bus, then device.function. Checked by SHAPE and not by a looser
    pattern, because what this decides is which directory gets handed to DPDK.
    """
    parts = name.split(":")
    if len(parts) != 3 or "." not in parts[2]:
        return False
    dev, _, func = parts[2].partition(".")
    hexd = "0123456789abcdefABCDEF"
    # The WIDTHS sysfs uses: a four-digit domain (wider on a box with many),
    # two-digit bus, two-digit device, one-digit function. Without them
    # 'a:b:c.d' is accepted as an address, and what this decides is which
    # directory is handed to DPDK.
    return bool(len(parts[0]) >= 4 and len(parts[1]) == 2
                and len(dev) == 2 and len(func) == 1
                and all(c in hexd for c in parts[0] + parts[1] + dev + func))


class Topology:
    def __init__(self, root="/"):
        self.root = root
        self.cpus = {}      # cpu -> (package, core, siblings)
        self.nodes = {}     # node -> [cpus]
        self._load()

    def p(self, *parts):
        return os.path.join(self.root, *parts)

    def _load(self):
        base = self.p("sys/devices/system/cpu")
        if not os.path.isdir(base):
            raise SystemExit(f"topology not found in {base}")
        for name in sorted(os.listdir(base)):
            if not name.startswith("cpu") or not name[3:].isdigit():
                continue
            n = int(name[3:])
            t = os.path.join(base, name, "topology")
            pkg = read(os.path.join(t, "physical_package_id"))
            core = read(os.path.join(t, "core_id"))
            sib = parse_list(read(os.path.join(t, "thread_siblings_list"), str(n)))
            if pkg is None or core is None:
                continue
            self.cpus[n] = (int(pkg), int(core), sib)

        nbase = self.p("sys/devices/system/node")
        if os.path.isdir(nbase):
            for name in sorted(os.listdir(nbase)):
                if name.startswith("node") and name[4:].isdigit():
                    self.nodes[int(name[4:])] = parse_list(
                        read(os.path.join(nbase, name, "cpulist"), ""))
        if not self.nodes:
            self.nodes = {0: sorted(self.cpus)}

    def nic_pci(self, ifname):
        """
        PCI address of the NIC, to name the device in the dpdk stanza.

        WALKED UP, not taken from the first component. `device` points at the
        device that OWNS the netdev, and on a virtio guest that is the virtio
        bus device, whose parent is the PCI one:

            /sys/class/net/ens18/device -> ../../../virtio3
            realpath: /sys/devices/pci0000:00/0000:00:12.0/virtio3

        Taking the basename gives `virtio3`, so this returned None and the
        tuner wrote `no-pci` - on every VM, with the interface named correctly
        (#286). DPDK drives virtio through its own poll-mode driver, so the
        card was always eligible; the resolution stopped one directory short.

        Bare metal is why it went unnoticed for so long: an Intel NIC's
        `device` link points straight at the PCI device, and there the
        basename IS the address.
        """
        link = self.p("sys/class/net", ifname, "device")
        try:
            path = os.path.realpath(link)
        except OSError:
            return None
        # Nearest PCI ancestor first. A device can sit several buses below the
        # PCI one, and it is the nearest that DPDK is handed.
        while path and path != "/":
            base = os.path.basename(path)
            if is_pci_addr(base):
                return base
            path = os.path.dirname(path)
        # Genuinely not PCI: virtio-mmio, a platform device, a veth. DPDK has
        # nothing it could be given, which is a different answer from "this
        # box has no card".
        return None

    def pci_nics(self):
        """
        Every netdev on this box that resolves to a PCI address.

        The cards DPDK could be given, which is not the same as the netdevs
        Linux has: `lo`, a bridge, a bond and a veth have no PCI address, so
        the dataplane could not be handed any of them. Used to tell a box with
        a spare card from one with none, which is the difference between the
        refusal below standing and its advice naming a card that does not
        exist (#303).
        """
        out = []
        try:
            names = sorted(os.listdir(self.p("sys/class/net")))
        except OSError:
            return out
        for name in names:
            if self.nic_pci(name):
                out.append(name)
        return out

    def default_route_if(self):
        """
        The interface carrying the default route, from /proc/net/route.

        Read so that the box can refuse to hand VPP the path the operator is
        reaching it over. Handing that NIC to the dataplane does not degrade
        the box, it removes it: no SSH, no ping, nothing but a console
        somebody has to walk to. https://github.com/andrediashexa/hexarouting/issues/123
        """
        try:
            with open(self.p("proc/net/route")) as f:
                for line in f.readlines()[1:]:
                    w = line.split()
                    # Iface Destination Gateway Flags ... - destination
                    # 00000000 is the default route.
                    if len(w) > 2 and w[1] == "00000000":
                        return w[0]
        except OSError:
            pass
        return None

    def nic_tx_queues(self, ifname):
        """
        How many transmit queues this card has, or None if it cannot be read.

        THE CARD IS GROUND TRUTH AND THIS PROGRAM WAS NOT READING IT (#330).
        Every other figure in the generated configuration comes from something
        measured - the CPUs, the NUMA node, the pages the kernel actually
        reserved - and the queue count came from the worker count, which is a
        fact about the processor and not about the card. On a virtio guest,
        which is how most smaller deployments run, that asked for seven queues
        on a card with one, and DPDK refused the device with -22: the box
        owned the NIC and forwarded nothing.

        /sys/class/net/<if>/queues/ is what the kernel driver exposes, and it
        is readable BEFORE the card is handed over, which is the only moment
        this program runs.
        """
        try:
            qs = os.listdir(self.p("sys/class/net", ifname, "queues"))
        except OSError:
            return None
        n = len([q for q in qs if q.startswith("tx-")])
        return n or None

    def nic_max_mtu(self, ifname):
        """
        The largest MTU this card accepts, or None if it cannot be read.

        VPP defaults a DPDK interface to 9000 and a virtio card's maxmtu is
        1500, so `rte_eth_dev_set_mtu failed (mtu 8996)` and the device never
        came up (#330). Same shape as the queues above: a number true of the
        hardware this was developed on and never asked of the hardware in
        front of it.

        NOT in sysfs. `/sys/class/net/<if>/mtu` is the CURRENT one; the
        maximum is IFLA_MAX_MTU, a netlink attribute, and `ip -d link` is what
        reads it. So this shells out, which nothing else in this file does.
        The alternative was to assume, and assuming is what produced the
        defect.

        HEXA_IP is why there is a seam here at all. Everything else this class
        reads comes from `self.root`, so a test builds a directory and drives
        the real code; netlink has no root to point at, and the first version
        of this could only ever return None under a synthetic root - which
        means the MTU half of the fix shipped with a check that could not
        fail. Same reason HEXA_MEMINFO exists two functions down.
        """
        try:
            out = subprocess.run([os.environ.get("HEXA_IP", "ip"),
                                  "-d", "link", "show", ifname],
                                 capture_output=True, text=True,
                                 timeout=5).stdout
        except (OSError, subprocess.SubprocessError):
            return None
        m = re.search(r"\bmaxmtu (\d+)", out)
        return int(m.group(1)) if m else None

    def nic_node(self, ifname):
        v = read(self.p("sys/class/net", ifname, "device/numa_node"))
        try:
            n = int(v)
        except (TypeError, ValueError):
            return None
        # -1 means "no affinity declared"
        return n if n >= 0 else None

    def physical_cores(self, cpus):
        """Groups by physical core, returning (leader, siblings)."""
        seen, out = set(), []
        for c in sorted(cpus):
            if c in seen:
                continue
            _, _, sib = self.cpus[c]
            group = [s for s in sib if s in self.cpus]
            seen.update(group)
            out.append((min(group), sorted(group)))
        return out


def plan(topo, ifname, subscribers, max_workers=None, low_latency=True,
         keep_management=False):
    # Never the management path, even when it was named on purpose.
    #
    # Handing VPP the interface carrying the default route does not degrade
    # the box, it removes it: the operator loses SSH the instant the dataplane
    # starts and gets it back by walking to a console. A refusal that keeps
    # the box reachable is recoverable in a sentence; the alternative is a
    # site visit. So this overrides the setting rather than warning about it.
    #
    # It is not a guess about intent: an interface can carry subscriber
    # traffic AND the default route only on a box that has one NIC.
    # https://github.com/andrediashexa/hexarouting/issues/123
    #
    # And a box with one NIC is exactly the box that could then never forward,
    # which is the dead end #303 was filed for. So the refusal keeps its
    # ground wherever the advice behind it can be followed - another card
    # means there is one to name instead - and steps aside only when there is
    # no other card AND the box has written down how to stay reachable
    # without it. `keep_management` is that record: apply-tuning passes it
    # when HEXA_DATAPLANE_MGMT is set, which the VTY writes beside the card's
    # own name and never without the address and MAC to put back.
    # https://github.com/andrediashexa/hexarouting/issues/303
    mgmt = topo.default_route_if()
    refused = None
    handover = False
    if ifname and mgmt and ifname == mgmt:
        others = [n for n in topo.pci_nics() if n != ifname]
        if others or not keep_management:
            refused, ifname = ifname, None
        else:
            handover = True

    node = topo.nic_node(ifname) if ifname else None
    if node is None or node not in topo.nodes:
        node = sorted(topo.nodes)[0]
        nic_note = (f"NIC '{ifname}' declares no NUMA affinity; using node {node}"
                    if ifname else f"no NIC given; using node {node}")
    else:
        nic_note = f"NIC '{ifname}' on NUMA node {node}"
    # After the note above is decided, not inside it: the refusal is about
    # which device is claimed, and the NUMA choice still has to happen.
    if refused:
        nic_note = (f"REFUSED to give '{refused}' to the dataplane: it carries "
                    f"the default route, and the box would lose management. "
                    f"No device is claimed; using node {node}")
    elif handover:
        # Said as plainly as the refusal, and for the same reason: this is the
        # line in the journal that explains a box which came back on a
        # different path than it left on.
        nic_note = (f"'{ifname}' carries the default route and is the only "
                    f"card this box has, so it is being handed over with its "
                    f"management path kept on its linux_cp pair; node {node}")

    node_cpus = [c for c in topo.nodes[node] if c in topo.cpus]
    cores = topo.physical_cores(node_cpus)

    # the node's first physical core stays with the OS and VPP's main thread
    os_core, os_cpus = cores[0]
    worker_cores = cores[1:]
    if max_workers:
        worker_cores = worker_cores[:max_workers]

    workers = [lead for lead, _ in worker_cores]
    isolated = sorted(c for _, sibs in worker_cores for c in sibs)

    # 1G hugepages. The per-subscriber budget comes from docs/architecture.md:
    # ~13 MB of bitmap and ~2.6 GB of session table for 200k subscribers,
    # plus buffers per worker.
    session_gb = max(1, round(subscribers * 13.5e-6 * 1024 / 1024))
    buffers_gb = max(1, (len(workers) + 3) // 4)
    want_gb = session_gb + buffers_gb + 1  # +1 of slack for the main heap

    # Bounded by the RAM the machine actually has.
    #
    # Sizing hugepages from the subscriber target alone asks a 3 GB box for
    # 5 GB of 1G pages. The kernel grants what it can, VPP starts against a
    # heap that is not there, and dies with SIGSEGV in a restart loop - which
    # is what an installed box did, having passed every other check. The
    # tuner exists to stop the quiet half-throughput failures; producing a
    # dataplane that does not run at all is the loud version of the same bug.
    total_gb = total_ram_gb(topo.root)
    if total_gb:
        # The operating system, VPP's own non-huge memory and the page cache
        # all live outside the hugepage pool.
        for_os = max(2, total_gb // 4)
        cap_gb = max(0, total_gb - for_os)
    else:
        cap_gb = want_gb          # unknown RAM: do not silently shrink
    hugepages_gb = min(want_gb, cap_gb)

    # Below two pages there is no room for buffers and a heap both. Asking for
    # one page would produce a tuned profile that cannot start, so ask for
    # none - which keeps tuned_now false and leaves the box on the
    # conservative profile, where it runs.
    if hugepages_gb < 2:
        hugepages_gb = 0
    capped = bool(total_gb) and hugepages_gb < want_gb

    # The page size this box can actually have, and how many GB of it are
    # reserved now. Both come from the pools that exist rather than from the
    # size this tuner would prefer, so a box that cannot do 1G is tuned on 2M
    # instead of waiting for a page size it will never get (#290).
    hugepage_kb, reserved = hugepage_choice(topo.root)
    isolated_active = isolated_now(topo.root)

    # The tuning only takes effect on the next boot: isolcpus and hugepages
    # come from the kernel command line. Emitting a startup.conf now that
    # demands a hugepage which does not yet exist puts VPP in a restart loop
    # - and that breaks every first boot after an install. While the kernel
    # is not tuned, the config comes out conservative: no pinning and no
    # hugepages. It runs anywhere, it just does not perform.
    # hugepages_gb == 0 means this machine was judged too small for a hugepage
    # pool. Emitting the tuned profile anyway - because some pages happen to be
    # reserved right now - produces a startup.conf that asks for memory the
    # tuner just decided not to ask the kernel for. Pages can be reserved for
    # reasons this run knows nothing about: a previous configuration, or VPP
    # itself pre-allocating during a crash loop. The decision has to be
    # self-consistent, or the tuner argues with itself across boots.
    tuned_now = (hugepages_gb >= 1 and reserved >= 1
                 and set(isolated) <= set(isolated_active) and bool(isolated))

    return {
        "total_gb": total_gb,
        "hugepages_wanted": want_gb,
        "hugepages_capped": capped,
        "low_latency": low_latency,
        # The name, carried so the report can ask whether there is a card at
        # all before it says anything about one.
        "nic_name": ifname,
        "nic_pci": topo.nic_pci(ifname) if ifname else None,
        # Read off the card, not derived from the processor (#330).
        "nic_tx_queues": topo.nic_tx_queues(ifname) if ifname else None,
        "nic_max_mtu": topo.nic_max_mtu(ifname) if ifname else None,
        "tuned_now": tuned_now,
        "hugepages_reserved": reserved,
        # The page size in kB, the name the kernel command line uses for it,
        # and how many of them make up hugepages_gb. Carried rather than
        # recomputed, so the grub line and the report cannot disagree about
        # what was asked for.
        "hugepage_kb": hugepage_kb,
        "hugepage_name": "1G" if hugepage_kb == 1048576 else "2M",
        "hugepage_count": p_gb_to_pages(hugepages_gb, hugepage_kb),
        "isolated_active": isolated_active,
        "node": node,
        "nic_note": nic_note,
        "os_cpus": os_cpus,
        "main_core": os_core,
        "workers": workers,
        "isolated": isolated,
        "hugepages_gb": hugepages_gb,
        "subscribers": subscribers,
        "total_cpus": len(topo.cpus),
    }


# A core in C6 takes tens of microseconds to come back. The poll-mode worker
# never sleeps, but the OS core does - and it is the one that wakes up to
# handle the interrupt or the timer in the middle of a burst.
# transparent_hugepage=never comes along because khugepaged compacts memory
# in the background, and compaction stalls whichever CPU holds the page.
LOW_LATENCY_CMDLINE = ("intel_idle.max_cstate=0 processor.max_cstate=1 "
                       "transparent_hugepage=never")


# VPP's own STAT_SEGMENT_DEFAULT_SIZE, in MB, and the only figure in this file
# that this product neither chooses nor writes.
#
# It is here so the report below can name it. Kept as a constant rather than
# read from the running dataplane because the tuner runs before VPP does, and
# the image pins the VPP version on purpose.
STATSEG_DEFAULT_MB = 32


def render_grub(p):
    if not p["isolated"]:
        return "# no core to isolate: machine too small for dedicated workers"
    iso = fmt_list(p["isolated"])
    latency = (" " + LOW_LATENCY_CMDLINE) if p["low_latency"] else ""
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        'GRUB_CMDLINE_LINUX_DEFAULT="$GRUB_CMDLINE_LINUX_DEFAULT '
        f"isolcpus={iso} nohz_full={iso} rcu_nocbs={iso} "
        f"default_hugepagesz={p['hugepage_name']} "
        f"hugepagesz={p['hugepage_name']} hugepages={p['hugepage_count']} "
        f'intel_iommu=on iommu=pt{latency}"\n'
        # os-prober scans every block device looking for other systems. On
        # an appliance there is nothing to find, and the scan can take
        # minutes - stalling the boot inside the tuning service.
        "GRUB_DISABLE_OS_PROBER=true\n"
    )


def render_irqbalance(p):
    """
    Isolating from the scheduler while still taking interrupts on the same
    core isolates nothing: the IRQ preempts the worker just the same.
    irqbalance only honours the ban if it is in the service's environment.
    """
    if not p["isolated"]:
        return "# no isolated core: nothing to ban from irqbalance\n"
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        "# Keep interrupts off the cores that run VPP workers.\n"
        f"IRQBALANCE_BANNED_CPULIST={fmt_list(p['isolated'])}\n"
    )


PLUGINS_TUNED = """plugins {
  plugin default { enable }
  plugin bpa_plugin.so { enable }
  plugin linux_cp_plugin.so { enable }
  plugin linux_nl_plugin.so { enable }
}
"""

# Without hugepages the DPDK EAL fails and VPP exits. Since vpp.service has
# Restart=always, the result is a restart loop that points at nothing.
PLUGINS_FIRSTBOOT = """plugins {
  plugin default { enable }
  # DPDK disabled until hugepages exist: without them the EAL fails and VPP exits.
  plugin dpdk_plugin.so { disable }
  plugin bpa_plugin.so { enable }
  plugin linux_cp_plugin.so { enable }
  plugin linux_nl_plugin.so { enable }
}
"""


def render_vpp(p):
    if not p["tuned_now"]:
        # First boot: the kernel has not reserved hugepages or isolated CPUs yet.
        return (
            "# Generated by hexarouting-tune. Do not edit by hand.\n"
            "#\n"
            "# FIRST BOOT MODE. The kernel is not tuned yet:\n"
            f"#   {p['hugepage_name']} hugepages reserved: "
            f"{p['hugepages_reserved']} GB worth\n"
            f"#   isolated CPUs: {fmt_list(p['isolated_active']) or '(none)'}\n"
            "#\n"
            "# Conservative configuration, no pinning and no hugepages: it runs\n"
            "# anywhere and does not put VPP in a restart loop. Reboot so that\n"
            "# isolcpus and hugepages take effect; on the next boot this file\n"
            "# is written with the full tuning.\n"
            + PLUGINS_FIRSTBOOT + "\n"
            "cpu {\n"
            "  # no workers until the kernel isolates CPUs\n"
            "}\n\n"
            "buffers {\n"
            "  buffers-per-numa 8192\n"
            "  default data-size 2048\n"
            "  page-size 4k\n"
            "}\n\n"
            "memory {\n"
            "  main-heap-size 256M\n"
            "  main-heap-page-size 4k\n"
            "}\n"
        )

    if not p["workers"]:
        cpu = "  # no workers: small box, everything on the main thread\n"
    else:
        cpu = (f"  main-core {p['main_core']}\n"
               f"  corelist-workers {fmt_list(p['workers'])}\n")
    # One RX queue per worker. Left unsaid, DPDK opens its default (1) and
    # all traffic enters through a single worker - the others poll an empty
    # queue, and the CPU graph does not give it away, because poll mode reads
    # 100% either way.
    # The main heap comes out of the hugepage pool, so it is sized from the
    # pages the kernel ACTUALLY reserved rather than from a constant. A fixed
    # 2G against a smaller pool starts VPP on a heap that is not there, and it
    # dies with SIGSEGV - which is what a box did after its RAM was reduced
    # between one boot and the next. Reserved pages are ground truth; the
    # request is only an intention.
    pool_gb = p["hugepages_reserved"] or p["hugepages_gb"]
    heap_gb = max(1, min(2, pool_gb - max(1, (len(p["workers"]) + 3) // 4)))

    # ONE QUEUE PER WORKER, OR AS MANY AS THE CARD HAS - whichever is fewer.
    #
    # This asked for one per worker and never read the card (#330). A virtio
    # guest has ONE transmit queue; an eight-CPU box gives seven workers; DPDK
    # answered `Configured number of TX queues (7) is bigger than maximum
    # supported (1)`, refused the device with -22, and the box owned the NIC
    # and forwarded nothing. Every other number in this stanza is measured and
    # this one was inferred from the processor.
    #
    # CAPPED AND SAID OUT LOUD, not capped quietly. With fewer queues than
    # workers only that many workers receive packets, which is a capacity fact
    # an operator has to be told - the same reason the hugepage cap above
    # announces itself instead of just applying.
    want_q = max(1, len(p["workers"]))
    have_q = p["nic_tx_queues"]
    nq = min(want_q, have_q) if have_q else want_q
    if p["nic_pci"]:
        # AND AN MTU THE CARD ACCEPTS. VPP defaults a DPDK interface to 9000,
        # a virtio card's maxmtu is 1500, and the mismatch is the other half
        # of the same -22: `rte_eth_dev_set_mtu failed (mtu 8996)`. Written
        # only when the card reports a maximum below VPP's default, so a
        # jumbo-capable NIC keeps the behaviour it has always had.
        mtu_line = ""
        if p["nic_max_mtu"] and p["nic_max_mtu"] < 9000:
            mtu_line = f"    mtu {p['nic_max_mtu']}\n"
        dpdk = ("dpdk {\n"
                f"  dev {p['nic_pci']} {{\n"
                f"    num-rx-queues {nq}\n"
                f"    num-tx-queues {nq}\n"
                f"{mtu_line}"
                "  }\n"
                f"  dev default {{\n    num-rx-queues {nq}\n  }}\n"
                "}\n\n")
    else:
        # Unknown means take NOTHING.
        #
        # This used to emit "dev default" with no allowlist, which is not a
        # neutral statement: VPP's DPDK plugin then probes and takes whatever
        # NIC it can bind. On a single-NIC box that is the management
        # interface, and the box drops off the network the moment the
        # dataplane starts - silently, because by then nobody is reading
        # anything over anything.
        #
        # The shipped default was HEXA_DATAPLANE_IF=eth0, which does not exist
        # on a Debian 12 box with predictable interface names, so this branch
        # was the ordinary case rather than the exception (#123).
        #
        # A box with no dataplane interface is inconvenient and recoverable
        # over the network. A box that ate its own management is recoverable
        # only by walking to it.
        dpdk = ("dpdk {\n"
                "  # No dataplane interface identified, so no device is\n"
                "  # claimed. Set HEXA_DATAPLANE_IF in /etc/hexarouting/tune.env\n"
                "  # to the interface carrying subscriber traffic.\n"
                "  no-pci\n"
                "}\n\n")
    return (
        "# Generated by hexarouting-tune. Do not edit by hand.\n"
        + PLUGINS_TUNED + "\n"
        "cpu {\n" + cpu + "}\n\n"
        + dpdk +
        "buffers {\n"
        f"  buffers-per-numa {max(16384, len(p['workers']) * 16384)}\n"
        "  default data-size 2048\n"
        "  page-size default-hugepage\n"
        "}\n\n"
        "memory {\n"
        f"  main-heap-size {heap_gb}G\n"
        "  main-heap-page-size default-hugepage\n"
        "}\n"
    )


def render_report(p, vpp_base):
    """The commented report the tuner prints above the files it generates.

    A FUNCTION so that it can be rendered without running the tuner, which is
    what render_grub(), render_vpp() and render_irqbalance() beside it are
    for. It was inline in main(), and docs/appliance.md quotes it: the page
    said the box prints `1G hugepages: 6 requested` where it prints
    `6 GB requested`, and nothing could compare the two because there was
    nothing to call (#326). The commit that changed that line landed three
    hours after the one that quoted it correctly.

    `vpp_base` is passed rather than read off the argument parser, because the
    only thing the report needs from it is the path it names.
    """
    out = []
    out.append(f"# {p['nic_note']}")
    out.append(f"# {p['total_cpus']} CPUs total; chosen NUMA node: {p['node']}")
    out.append(f"# operating system and VPP main: {fmt_list(p['os_cpus'])}")
    out.append(f"# workers ({len(p['workers'])}): {fmt_list(p['workers'])}")
    out.append(f"# isolated: {fmt_list(p['isolated']) or '(none)'}")
    # The card's own limits, beside the figures read off the machine, because
    # they are the same kind of fact and one of them silently disagreeing with
    # the hardware is what #330 was.
    _w = max(1, len(p["workers"]))
    if not p["nic_name"]:
        # Nothing: there is no card, and nic_note above already said so. A
        # sentence about queues here would be true of one box and false of
        # this one, which is the shape of every defect in this file's history.
        pass
    elif not p["nic_tx_queues"]:
        # SAYING SO, because this is the state the defect lives in. Unread
        # falls back to one queue per worker, which is exactly what asked a
        # one-queue card for seven and left the box owning a NIC it could not
        # start (#330). "Could not read the card" and "read it and it is fine"
        # must not look the same on this screen.
        out.append(f"# NIC queues: could not be read, so this asks for "
                   f"{_w}, one per worker. A card with fewer will refuse the "
                   f"device: 'show hardware' says what the box can see.")
    elif p["nic_tx_queues"] < _w:
        out.append(f"# NIC queues: {p['nic_tx_queues']}, and this box has "
                   f"{_w} worker(s). Capped at {p['nic_tx_queues']}: only "
                   f"that many workers receive packets, so expect a "
                   f"fraction of the forwarding this CPU could do.")
    else:
        out.append(f"# NIC queues: {p['nic_tx_queues']}, enough for "
                   f"{_w} worker(s)")
    if p["nic_max_mtu"] and p["nic_max_mtu"] < 9000:
        out.append(f"# NIC max MTU: {p['nic_max_mtu']}, below VPP's default "
                   f"of 9000, so the interface is set to {p['nic_max_mtu']}")
    out.append(f"# {p['hugepage_name']} hugepages: {p['hugepages_gb']} GB requested "
          f"(sized for {p['subscribers']} subscribers), "
          f"{p['hugepages_reserved']} reserved right now")
    if p["hugepages_capped"]:
        # Said plainly, because the operator's real problem is that the box is
        # too small for the subscriber target - not that a number was adjusted.
        out.append(f"# WARNING: {p['hugepages_wanted']} GB of hugepages were needed "
              f"for {p['subscribers']} subscribers, but this machine has "
              f"{p['total_gb']} GB of RAM.")
        if p["hugepages_gb"] == 0:
            out.append("#          Hugepages disabled: the box stays on the "
                  "conservative profile, where it runs but does not perform.")
        else:
            out.append(f"#          Capped at {p['hugepages_gb']} GB. Expect fewer "
                  "subscribers than configured, or add RAM.")
    # The statistics segment, said out loud precisely because it is the one
    # memory resource above that is NOT sized here - and the only one with a
    # hard abort behind it. VPP exports every counter through a segment of
    # fixed size; each dataplane interface adds entries to it; filling it
    # reaches os_panic and SIGABRT rather than refusing the interface. So the
    # box loses its whole dataplane and says nothing about why.
    #
    # It is not sized because nothing this program reads predicts how many
    # INTERFACES a box will carry. Every other figure above comes either from
    # ground truth - the topology, the RAM, the pages the kernel really
    # reserved - or from a subscriber target the operator set. A CGNAT
    # subscriber is not an interface: HEXA_SUBSCRIBERS=200000 describes
    # 200,000 translations sharing a handful of ports, so sizing the segment
    # from it would reserve hundreds of MB, on a box whose RAM floor is 4 GB,
    # for interfaces that never appear. A constant instead would be a number
    # nobody can justify, which is what main-heap-size stopped being when it
    # started reading the pages the kernel had actually reserved.
    #
    # What is left is to say where the box stands, here and at every boot in
    # the self-test, so the limit is met as a sentence rather than as a signal.
    out.append(f"# statistics segment: NOT sized here, so VPP's built-in "
          f"{STATSEG_DEFAULT_MB} MB applies.")
    out.append("#          Measured: a box on that default aborted between 7,000 "
          "and 8,000")
    out.append("#          interfaces. It is per INTERFACE, not per subscriber, "
          "which is why")
    out.append("#          nothing here sizes it. To raise it, put a statseg "
          "stanza in the")
    out.append(f"#          base file ({vpp_base}):")
    out.append("#          it is concatenated ahead of these stanzas.")
    # THREE STATES, not two. `nic_pci` is None both when no card was named
    # and when a named card's address could not be resolved, and those are
    # nothing alike: the first is every fresh install, where there is no
    # device for the sentence to be about. Printing "(not a PCI device)" there
    # sent an operator looking for why their card was not PCI, which is the
    # #286 dead end - and the line two above already says no NIC was given, so
    # the report contradicted itself on the same screen (#331).
    if p["nic_pci"]:
        out.append(f"# dataplane NIC PCI address: {p['nic_pci']}")
    elif p["nic_name"]:
        out.append(f"# dataplane NIC PCI address: '{p['nic_name']}' was named "
                   f"and no PCI address could be read for it, so DPDK has no "
                   f"device to be given")
    else:
        out.append("# dataplane NIC PCI address: none, because no card has "
                   "been given to the dataplane on this box")
    out.append(f"# low latency (C-states off, THP off): {'yes' if p['low_latency'] else 'no'}")
    out.append(f"# state: {'kernel tuned, full configuration' if p['tuned_now'] else 'FIRST BOOT, conservative configuration until reboot'}")
    return "\n".join(out)


def main():
    ap = argparse.ArgumentParser(description=__doc__,
                                 formatter_class=argparse.RawDescriptionHelpFormatter)
    ap.add_argument("--interface", help="dataplane NIC, to choose the NUMA node")
    ap.add_argument("--subscribers", type=int, default=200000)
    ap.add_argument("--max-workers", type=int)
    ap.add_argument("--keep-management", action="store_true",
                    help="the box has recorded the management path of the "
                         "card being handed over, so a single-NIC box may "
                         "give up the card carrying its default route")
    ap.add_argument("--no-low-latency", action="store_true",
                    help="do not disable C-states or THP on the kernel line")
    ap.add_argument("--sysfs-root", default="/")
    ap.add_argument("--vpp-base", default="/etc/hexarouting/vpp-base.conf",
                    help="startup.conf base, concatenated with the tuning")
    ap.add_argument("--write", action="store_true",
                    help="write to /etc/default/grub.d and /etc/vpp")
    a = ap.parse_args()

    topo = Topology(a.sysfs_root)
    p = plan(topo, a.interface, a.subscribers, a.max_workers,
             low_latency=not a.no_low_latency,
             keep_management=a.keep_management)

    grub = render_grub(p)
    vpp = render_vpp(p)
    irq = render_irqbalance(p)

    print(render_report(p, a.vpp_base))
    print()
    print("### /etc/default/grub.d/hexarouting.cfg")
    print(grub)
    print("### /etc/default/irqbalance")
    print(irq)
    print("### stanzas appended to /etc/vpp/startup.conf")
    print(vpp)

    if a.write:
        os.makedirs("/etc/default/grub.d", exist_ok=True)
        with open("/etc/default/grub.d/hexarouting.cfg", "w") as f:
            f.write(grub)
        print("wrote /etc/default/grub.d/hexarouting.cfg", file=sys.stderr)

        # Always written: if irqbalance is installed later, the ban is
        # already there and starts applying on its own.
        os.makedirs("/etc/default", exist_ok=True)
        with open("/etc/default/irqbalance", "w") as f:
            f.write(irq)
        print("wrote /etc/default/irqbalance", file=sys.stderr)

        # VPP's startup.conf has no include directive: writing into a
        # startup.conf.d does nothing, and the whole tuning sits inert with no
        # signal at all - the box boots, forwards, and delivers half. So we
        # generate the file VPP actually reads, concatenating the base the
        # operator may edit.
        base = ""
        if os.path.exists(a.vpp_base):
            with open(a.vpp_base) as f:
                base = f.read().rstrip() + "\n\n"
        else:
            print(f"warning: base {a.vpp_base} does not exist; generating tuning only",
                  file=sys.stderr)
        os.makedirs("/etc/vpp", exist_ok=True)
        with open("/etc/vpp/startup.conf", "w") as f:
            f.write("# GENERATED by hexarouting-tune from "
                    f"{a.vpp_base}. Do not edit by hand.\n\n")
            f.write(base)
            f.write(vpp)
        print("wrote /etc/vpp/startup.conf", file=sys.stderr)
    return 0


if __name__ == "__main__":
    sys.exit(main())
