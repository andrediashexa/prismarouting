#!/bin/sh
# Login shell of the appliance: lands the operator in the VTY.
#
# The lockout risk is the whole reason this wrapper exists instead of pointing
# the login shell straight at prismash. If prismash cannot start - a bad edit, a
# missing Python module, a half-finished upgrade - a login shell that is prismash
# leaves nobody able to get into the box, over console or SSH. Here the failure
# drops to a real shell and says why.
#
# There is a second escape that does not depend on this script working at all:
# "prismash=off" on the kernel command line, which the ISO offers as a boot menu
# entry.
set -u
SHELL_FALLBACK=${PRISMA_FALLBACK_SHELL:-/bin/bash}
[ -x "$SHELL_FALLBACK" ] || SHELL_FALLBACK=/bin/sh

# A login shell is invoked with "-c <command>" for scp, rsync, git and any
# non-interactive ssh. Those must reach a real shell, or file copies to the
# appliance break in a way that looks like a network problem.
if [ "$#" -gt 0 ]; then
  exec "$SHELL_FALLBACK" "$@"
fi

if grep -qw "prismash=off" /proc/cmdline 2>/dev/null; then
  echo "prismash=off on the kernel command line: starting $SHELL_FALLBACK" >&2
  exec "$SHELL_FALLBACK" -l
fi

# PRISMA_PRISMASH is the same kind of seam as PRISMA_FALLBACK_SHELL above, and the
# reason it exists is the whole of what this script is for. The path was
# written out here, so nothing could arrange a box that HAS a VTY: every check
# ran against the absence of /usr/bin/prismash on the machine running them, and
# the fallback below - the one that keeps an operator out of a box whose VTY
# died, which is the only reason this wrapper exists instead of pointing the
# login shell straight at prismash - had never been executed anywhere. It is set
# by nothing on a real box.
PRISMASH=${PRISMA_PRISMASH:-/usr/bin/prismash}

if [ ! -x "$PRISMASH" ]; then
  echo "prismash is not installed; starting $SHELL_FALLBACK" >&2
  exec "$SHELL_FALLBACK" -l
fi

"$PRISMASH"
rc=$?

# Exit code 0 means the operator typed "exit": log them out, as a VTY should.
# Anything else means the VTY failed, and the operator needs a shell rather
# than a closed session they cannot diagnose.
[ "$rc" -eq 0 ] && exit 0
echo "" >&2
echo "prismash exited with status $rc. Starting $SHELL_FALLBACK so the box stays" >&2
echo "reachable. Boot with 'prismash=off' to skip the VTY entirely." >&2
exec "$SHELL_FALLBACK" -l
