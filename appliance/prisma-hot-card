#!/bin/sh
# A card added to a running box forwards at once, through AF_XDP (#453).
#
#   prisma-hot-card add <netdev>       udev runs this, through
#                                      prisma-routing-hot-card@.service
#   prisma-hot-card list               the cards attached this way, one a line
#   prisma-hot-card restart-dataplane  hand them back and restart the dataplane,
#                                      so the next start claims them through
#                                      DPDK like any other card
#
# WHY NOT A RESTART ON HOTPLUG. VPP's DPDK driver takes cards only when it
# starts, so the obvious answer to "a card appeared" is to restart the
# dataplane. That stops forwarding and throws away the CGNAT's state - every
# subscriber's port block and open sessions - on a click in the hypervisor.
# The maintainer chose this instead (2026-09-25): the card is attached to the
# RUNNING dataplane through AF_XDP, which reads it through the kernel's
# driver, and moves to DPDK when the operator decides.
#
# WHAT THE ATTACH TAKES, each measured on 0.126.0 in a KVM guest with a
# virtio-net card added by `device_add` while VPP ran in its container (#453):
#
#   * The kernel netdev is RENAMED, because the dataplane's interface and its
#     Linux end must carry the name the operator knows (ens20), and the
#     kernel's card is holding it.
#   * Its ALTNAMES are dropped. udev gives a card `enp0s20` and `ens20` as
#     altnames, a rename keeps them, and `lcp create ... host-if ens20` then
#     failed with -13 while `ip addr add ... dev ens20` quietly landed on the
#     kernel's card. A veth has none, which is why the lab did not show it.
#   * VPP is given the card's OWN MAC. It invents one (02:fe:...) for an
#     af_xdp interface, and a virtio card filters unicast to any MAC but its
#     own: ARP, broadcast, got through and was answered, and every ping after
#     it was dropped by the card. With the card's MAC, 70 of 70 echo replies.
#
# WHAT IT NEVER TAKES:
#   * a card the boot's rule would not claim - asked of prisma-routing-tune
#     --would-claim, the same rule, so the reserve and PRISMA_DATAPLANE_IF
#     hold at a click exactly as they hold at boot;
#   * a card Linux is using: one carrying an IPv4 address or the default
#     route is somebody's way into this box;
#   * a card the running startup.conf already names: that is the boot's own
#     claim, and udev announces every card at boot too.
# And it does nothing while the dataplane is not answering: the next start
# claims the card through DPDK, which is the better answer anyway.
set -u

ROOT=${PRISMA_ROOT:-}
SYSNET=$ROOT/sys/class/net
IP=${PRISMA_IP:-ip}
VPPCTL=${PRISMA_VPPCTL:-vppctl}
TUNE=${PRISMA_TUNE:-/usr/bin/prisma-routing-tune}
TUNE_ENV=${PRISMA_TUNE_ENV:-$ROOT/etc/prisma-routing/tune.env}
MGMT_CONF=${PRISMA_MGMT_CONF:-$ROOT/etc/network/interfaces.d/prisma-routing}
STARTUP=${PRISMA_VPP_STARTUP:-$ROOT/etc/vpp/startup.conf}
STATE=${PRISMA_HOT_CARDS:-$ROOT/run/prisma-routing/hot-cards}
SYSTEMCTL=${PRISMA_SYSTEMCTL:-systemctl}
UDEVADM=${PRISMA_UDEVADM:-udevadm}
GIVE_BACK=${PRISMA_GIVE_BACK:-/usr/lib/prisma-routing/give-the-card-back}

say() { echo "prisma-hot-card: $*"; }

# The kernel's name for a card the dataplane has taken: short enough for the
# kernel's 15 characters whatever the card was called.
kernel_name() {  # <netdev>
  if [ ${#1} -le 11 ]; then
    echo "xdp-$1"
  else
    echo "x$(printf '%s' "$1" | tail -c 14)"
  fi
}

pci_of() {  # <netdev>
  basename "$(readlink -f "$SYSNET/$1/device" 2>/dev/null)" 2>/dev/null
}

# 0 when Linux is using the card: an IPv4 address, or the default route.
linux_uses() {  # <netdev>
  [ -n "$($IP -4 -o addr show dev "$1" 2>/dev/null)" ] && return 0
  $IP route show default 2>/dev/null | grep -q " dev $1\( \|$\)" && return 0
  return 1
}

add() {  # <netdev>
  n=$1
  if [ ! -e "$SYSNET/$n" ]; then
    # The ordinary answer at boot: udev announced the card, and by the time
    # this ran the dataplane had claimed it through DPDK and it left Linux.
    say "$n: no longer a Linux interface; nothing to attach"
    return 0
  fi
  if [ ! -e "$SYSNET/$n/device" ]; then
    say "$n: not a PCI card, left to Linux"
    return 0
  fi
  pci=$(pci_of "$n")
  if [ -n "$pci" ] && grep -q "dev $pci" "$STARTUP" 2>/dev/null; then
    say "$n: startup.conf already names $pci; the boot's claim, left to it"
    return 0
  fi
  if ! $VPPCTL show version >/dev/null 2>&1; then
    say "$n: the dataplane is not answering; its next start claims the card"
    return 0
  fi
  if $VPPCTL show hardware "$n" 2>/dev/null | grep -q "^$n "; then
    say "$n: already on the dataplane"
    return 0
  fi
  # The override is read the way apply-tuning reads it: one line of tune.env.
  over=$(sed -n 's/^PRISMA_DATAPLANE_IF=\(.*\)$/\1/p' "$TUNE_ENV" 2>/dev/null | tail -1)
  verdict=$("$TUNE" --sysfs-root "${ROOT:-/}" --mgmt-conf "$MGMT_CONF" \
              ${over:+--interface "$over"} --would-claim "$n" 2>/dev/null | tail -1)
  case "$verdict" in
    "claim: $n") ;;
    *) say "${verdict:-$n: the tuner gave no answer; left to Linux}"; return 0 ;;
  esac
  if linux_uses "$n"; then
    say "$n: Linux has an address or the default route on it; left to Linux"
    return 0
  fi

  mac=$(cat "$SYSNET/$n/address" 2>/dev/null)
  k=$(kernel_name "$n")
  $IP link set dev "$n" down || { say "$n: cannot take it down"; return 1; }
  $IP link set dev "$n" name "$k" || { say "$n: cannot rename it to $k"; return 1; }
  # AFTER udev has handled the rename. The rename is a `move` event, and udev
  # applies a card's altnames on it - so altnames dropped before it ran were
  # put back, and the VTY's `linux-name ens20` failed with -13 on a KVM guest
  # although the script had dropped them (#453). Settled first, then dropped,
  # then checked: the name must resolve to nothing before the dataplane is
  # given it.
  $UDEVADM settle -t 10 >/dev/null 2>&1
  for alt in $($IP -d link show dev "$k" 2>/dev/null | awk '$1 == "altname" {print $2}'); do
    $IP link property del dev "$k" altname "$alt" 2>/dev/null
  done
  if $IP link show dev "$n" >/dev/null 2>&1; then
    $IP link set dev "$k" name "$n" 2>/dev/null
    say "$n: the name is still held in Linux after the rename, so the"
    say "    dataplane's end could not carry it; the card stays with Linux"
    return 1
  fi
  $IP link set dev "$k" up
  if ! out=$($VPPCTL create interface af_xdp host-if "$k" name "$n" num-rx-queues all 2>&1) \
       || ! $VPPCTL show hardware "$n" 2>/dev/null | grep -q "^$n "; then
    # Put the card back exactly as it came: a card half-taken is one neither
    # Linux nor the dataplane can use.
    $IP link set dev "$k" down
    $IP link set dev "$k" name "$n"
    say "$n: the dataplane refused it through AF_XDP, so it stays with Linux:"
    say "    $out"
    return 1
  fi
  [ -n "$mac" ] && $VPPCTL set interface mac address "$n" "$mac" >/dev/null 2>&1
  mkdir -p "$(dirname "$STATE")"
  echo "$n ${pci:--} $k" >> "$STATE"
  say "$n: on the dataplane through AF_XDP (kernel name $k), forwarding now."
  say "    'system dataplane restart' moves it to DPDK when you choose."
  return 0
}

list() {
  [ -f "$STATE" ] && cat "$STATE"
  return 0
}

# Hand every card back to the kernel under its own name and restart the
# dataplane, so the tuner sees the cards as the next boot would and claims
# them through DPDK. The tuner reads the kernel's names: left as xdp-ens20,
# the card would come back named that.
#
# STOP, THEN START, and never `restart` of the containers unit. Measured on a
# KVM guest on the containers: `systemctl restart prisma-routing-containers`
# is refused - "Transaction contains conflicting jobs 'restart' and 'stop' for
# prisma-routing.service" - because that unit Conflicts=vpp.service and
# prisma-routing.service is PartOf both, so one transaction asks it to stop
# and to restart. And the order is the point: the cards are handed back only
# once the dataplane has let go of them. Renamed while VPP still held them
# through AF_XDP, the rename did not take, the tuner then bound the card to
# uio under the name xdp-ens20, and VPP was left on a card the kernel no
# longer had.
# THE NAMES THE DATAPLANE KNEW ITS CARDS BY (#564): "pci name", one per line,
# from the startup.conf the tuner wrote at boot - `dev <pci> { ... name <n> }`.
startup_names() {
  [ -f "$STARTUP" ] || return 0
  awk '
    $1 == "dev" && $2 ~ /^[0-9a-f]+:[0-9a-f]+:[0-9a-f]+\.[0-9a-f]+$/ { pci = $2 }
    pci != "" && $1 == "name" { print pci, $2; pci = "" }
    $1 == "}" { pci = "" }' "$STARTUP"
}

# The netdev a PCI address carries now, or nothing.
netdev_of() {
  for d in "$SYSNET"/*; do
    [ -e "$d/device" ] || continue
    case "$(readlink "$d/device")" in */"$1") echo "${d##*/}"; return 0 ;; esac
  done
  return 0
}

# THE DEAD DATAPLANE'S LINUX ENDS (#564). linux_cp's pairs are TAPs carrying
# the cards' names - enp1s0, and enp1s0.666 for a sub-interface. Left in the
# kernel past the stop, they hold those names: measured on 10.40.200.166
# (0.149.30), udev's rename of the given-back card failed - "Failed to rename
# network interface 18 from 'eth0' to 'enp1s0': File exists" - the tuner
# wrote eth0, eth1, eth2 into startup.conf, the saved configuration naming
# enp1s0 was refused on load, and the box, managed through enp6s18, was dark
# until a reset. Only TUN/TAP devices named for a card are removed: a real
# card never has tun_flags.
stale_ends() {
  startup_names | while read -r _pci n; do
    for d in "$SYSNET/$n" "$SYSNET/$n".*; do
      [ -e "$d/tun_flags" ] || continue
      if $IP link del dev "${d##*/}" 2>/dev/null; then
        say "${d##*/}: the stopped dataplane's Linux end, removed"
      fi
    done
  done
}

# EACH CARD UNDER THE NAME THE DATAPLANE KNEW IT BY (#564), whatever the
# kernel gave it back as, so the tuner writes the startup.conf a boot writes
# and the saved configuration finds its interfaces.
names_back() {
  while read -r pci n; do
    cur=$(netdev_of "$pci")
    [ -n "$cur" ] && [ "$cur" != "$n" ] || continue
    $IP link set dev "$cur" down 2>/dev/null
    if $IP link set dev "$cur" name "$n" 2>/dev/null; then
      say "$n: came back as $cur, given its name back"
    else
      say "$n: came back as $cur and could not be renamed; the tuner sees $cur"
    fi
  done < "$1"
}

restart_dataplane() {
  # What the cards were called, before anything changes (#564).
  names=$(mktemp)
  startup_names > "$names"
  # A STOP THAT DID NOT REPORT SUCCESS IS NOT A DATAPLANE STILL RUNNING (#564).
  # On 10.95.200.198 (0.149.26) the containers went down and this function
  # returned "could not be stopped; nothing was changed" - whatever made
  # `systemctl stop` return early (a job another client replaced, an
  # interrupted client), the unit was deactivating, and nothing started it
  # again: no dataplane, no containers, and on a box whose management is a
  # dataplane interface, no way in until a reboot. So the unit's own state
  # decides: still active is a refusal and nothing changed; anything else is
  # a dataplane on its way down, and it is brought back.
  #
  # THE DATAPLANE THIS BOX RUNS, and not always the containers. Measured in the
  # 0.150.0 install lab: on a box put back on vpp.service, the stop of the
  # containers unit was a no-op, the cards were given back while vpp.service
  # still held them through vfio-pci, the kernel waited on VPP to release the
  # device ("vfio-pci 0000:00:09.0: Relaying device request to user"), and the
  # box hung - journald blocked in uevent_show, no prompt, no way in.
  dp=prisma-routing-containers.service
  if ! $SYSTEMCTL is-active --quiet prisma-routing-containers.service \
     && $SYSTEMCTL is-active --quiet vpp.service; then
    dp=vpp.service
  fi
  # AND THE LOADER WITH IT, by name. Its PartOf=vpp.service is a drop-in
  # install.sh writes only on a box without images; a box that has them and
  # was put back on the units by hand has no drop-in, so the loader stayed
  # `active (exited)` through the stop, config_loaded found it active, and
  # the new VPP ran with nothing configured - every interface down (the
  # 0.150.0 install lab, second gate).
  if [ "$dp" = vpp.service ]; then
    $SYSTEMCTL stop prisma-routing.service
  fi
  if ! $SYSTEMCTL stop "$dp"; then
    if $SYSTEMCTL is-active --quiet "$dp"; then
      say "the dataplane could not be stopped; nothing was changed"
      rm -f "$names"
      return 1
    fi
    say "the stop did not report success and the dataplane is down;"
    say "    it is started again"
  fi
  # EVERY CLAIMED CARD BACK TO ITS KERNEL DRIVER, as at boot, before the tuner
  # runs. The tuner sees only the cards Linux holds: measured on a KVM guest,
  # a restart that left ens19 on uio_pci_generic came back "claiming 1 of this
  # box's 2 cards" - ens20 alone - and ens19 was gone from the dataplane, with
  # the saved configuration that named it refused on replay.
  stale_ends
  $GIVE_BACK restart 2>&1 | sed 's/^/    /'
  # udev names a card given back asynchronously; the tuner must see the
  # result, not a moment before it.
  $UDEVADM settle --timeout=10 2>/dev/null
  names_back "$names"
  rm -f "$names"
  # The dataplane that knew those interfaces is gone from here on.
  if [ -f "$STATE" ]; then
    while read -r n _pci k; do
      [ -n "$k" ] || continue
      $IP link set dev "$k" down 2>/dev/null
      if $IP link set dev "$k" name "$n" 2>/dev/null; then
        say "$n: handed back to the kernel under its own name"
      else
        say "$n: could not be renamed back from $k; the tuner sees it as $k"
      fi
    done < "$STATE"
    rm -f "$STATE"
  fi
  rc=0
  $SYSTEMCTL restart prisma-routing-tune.service || rc=1
  # Started whatever the tuner said: a box whose tuner failed still has the
  # startup.conf it had, and a dataplane on it beats none.
  $SYSTEMCTL start "$dp" || rc=1
  # PartOf stopped it with the containers and nothing starts it again: it is
  # what replays the saved configuration onto the dataplane.
  # The restart checks its own result (#564): the saved configuration has to
  # load onto the dataplane it started, or the box is up with nothing on it.
  if ! config_loaded; then
    rc=1
    say "error: the saved configuration did not load onto the restarted dataplane"
    say "    in ${LOAD_WAIT} s; 'journalctl -u prisma-routing' on the box says why"
  fi
  api_socket_back
  return $rc
}

# THE CONFIGURATION, LOADED - OR GIVEN UP ON (#564). A first refusal is not the
# answer: measured on 10.40.200.166 (0.149.32) the load failed while FRR was
# still starting - "1 static route(s) need mgmtd, which is not running" -
# twice, and loaded on a later try at 03:41:56; the restart had already
# reported "did not load" and the API answered apply_failed for a box that
# came back whole. So the start is tried again every LOAD_RETRY seconds (the
# unit has no Restart= of its own, and a few tries stay under its start
# limit), and the unit's state decides, for at most LOAD_WAIT seconds: active
# from any start - this one, or the watcher's (#548) - is loaded; still not
# active at the end is the real failure.
LOAD_WAIT=${PRISMA_LOAD_WAIT:-180}
LOAD_RETRY=${PRISMA_LOAD_RETRY:-10}
SLEEP=${PRISMA_SLEEP:-sleep}
config_loaded() {
  waited=0
  while :; do
    $SYSTEMCTL is-active --quiet prisma-routing.service && return 0
    $SYSTEMCTL start prisma-routing.service 2>/dev/null && return 0
    [ "$waited" -ge "$LOAD_WAIT" ] && return 1
    say "the saved configuration did not load yet; trying again in ${LOAD_RETRY} s"
    $SLEEP "$LOAD_RETRY"
    waited=$((waited + LOAD_RETRY))
  done
}

# THE API'S SOCKET, BACK (#564). While the containers are down every client
# connecting to the API triggers prisma-routing-api-proxy.socket, whose
# service needs the API, which needs the containers: each attempt fails, and
# systemd stops the socket for good once its trigger limit is hit - measured
# on 10.95.200.198, "Trigger limit hit, refusing further activation". The
# containers came back to an API nobody could reach. A box with the API off
# has no such socket, and this does nothing there.
api_socket_back() {
  $SYSTEMCTL cat prisma-routing-api-proxy.socket >/dev/null 2>&1 || return 0
  $SYSTEMCTL reset-failed prisma-routing-api-proxy.socket \
      prisma-routing-api-proxy.service prisma-routing-api.service 2>/dev/null
  $SYSTEMCTL start prisma-routing-api-proxy.socket 2>/dev/null || \
    say "the management API's socket could not be started again"
}

case "${1:-}" in
  add) [ -n "${2:-}" ] || { echo "usage: prisma-hot-card add <netdev>" >&2; exit 2; }
       add "$2" ;;
  list) list ;;
  restart-dataplane) restart_dataplane ;;
  *) echo "usage: prisma-hot-card add <netdev> | list | restart-dataplane" >&2; exit 2 ;;
esac
