#!/bin/sh
# Installs Prisma Routing onto a disk, asking first.
#
# The ISO is an installation medium that happens to run the product. It boots
# with NO credentials - the root account in the live image is locked - and this
# script is what turns it into a box somebody can log into. Everything it needs
# is asked BEFORE the first write, and the answers include the root password.
#
# Five rules this script exists to honour:
#
#   - it never touches a disk that was not named,
#   - it never runs without a confirmation that repeats the disk back, with
#     its size and model, and that a bare Enter does not answer,
#   - it never finishes without a root password the operator supplied,
#   - it never finishes without deciding how the box is reached after the
#     reboot it is about to do, and
#   - it asks everything before it writes anything.
#
# The password rule and the ordering rule came together. Before, /etc/shadow
# travelled from the live image onto the disk and "passwd root" ran at the very
# end, after GRUB: an install that was aborted, that failed late, or that ran
# unattended left a BOOTABLE disk carrying the image's published password. Now
# the image has no password to inherit, and an install with no answer for it
# stops before it partitions anything.
#
# The management network is the newest of the five and it is the same argument
# one step on (#303). This installer used to write nothing whatever under
# /etc/network, on an image that carries ifupdown with networking.service
# enabled and an /etc/network/interfaces holding one line - "source
# /etc/network/interfaces.d/*" - over an EMPTY directory. So the service came
# up with nothing to do, the card booted DOWN with no address, and the box was
# reachable at its console and nowhere else. What the operator then typed at
# that console did not survive the reboot, because nothing had written it
# down. An appliance that cannot be reached after a reboot is not an
# appliance, and "the address is arranged by other means before the box is
# installed" is not true of the case everybody meets this product in: a
# virtual machine with one virtual NIC, created from this ISO, with no other
# means in existence.
#
# Non-interactive answers, for automated installs and for the lab:
#
#   HEXA_DISK, HEXA_HOSTNAME, HEXA_TIMEZONE, HEXA_ROOT_PASSWORD, HEXA_LOG_GB
#   HEXA_MIRROR=<disk>        mirror the records onto a second disk
#   HEXA_MGMT_INTERFACE=<if>  the card this box is managed on
#   HEXA_MGMT_ADDRESS=dhcp    or <a.b.c.d/nn>, or "none" for no management
#                             network at all
#   HEXA_MGMT_GATEWAY=<ip>    with a static address only
#   HEXA_MGMT_DNS=<ip>[,<ip>] with a static address only
#   HEXA_ANSWERS=<file>       read those same answers from a file
#   HEXA_INSTALL_YES=1        skip the confirmations
#   HEXA_INSTALL_CHECK=1      collect and validate, write nothing, exit
#   HEXA_INSTALL_NO_REBOOT=1  finish without rebooting
#
# A test that drives an installer by sending keystrokes at the right moment
# tests the timing of the keystrokes. That is why these exist.
set -u

say()  { echo "==> $*"; }
die()  { echo "error: $*" >&2; exit 1; }

# Answers read from a FILE, so that an unattended install does not have to put
# the root password on the kernel command line, where /proc/cmdline publishes
# it to every process on the live system for as long as that system runs (#83).
# The command-line form stays for the cases with no medium to write to, and
# keeps its warning.
#
# Format: "key = value", one per line. Blank lines and whole-line "#" comments
# are ignored - "#" only starts a comment at the beginning of a line, because a
# password may contain one and a parser that truncated it there would install a
# box whose password is a PREFIX of the one in the file. Nobody would find that
# out before the first login. Spaces around the "=" are stripped, so a password
# whose first or last character is a space cannot be given here.
#
# An unknown key is REFUSED rather than ignored. A misspelt "password" is an
# install that arrives at the password question with no answer, and an
# unattended install has no console to answer from: the typo would present as a
# machine that hung.
#
# It never echoes a value, not even in an error. The point of the file is that
# the secret stays out of everything readable afterwards - a console log the
# lab keeps included - and an installer that prints it back undoes that.
#
# An answer already given WINS over the file: the command line is typed for
# this one boot, the file travels with the medium for every install it does.
read_answers() {   # <file>; exports HEXA_* for the questions still unanswered
  _f=$1
  [ -f "$_f" ] || { echo "error: no answer file at $_f" >&2; return 1; }
  [ -r "$_f" ] || { echo "error: the answer file $_f cannot be read" >&2; return 1; }
  _n=0
  _rc=0
  while IFS= read -r _line || [ -n "$_line" ]; do
    _n=$((_n + 1))
    _line=$(printf '%s' "$_line" | sed 's/^[[:space:]]*//; s/[[:space:]]*$//')
    case "$_line" in ''|'#'*) continue ;; esac
    # The offending line is NOT quoted back. The line that failed to parse may
    # be the password line, and an error message is the one place nobody
    # expects to have to redact.
    case "$_line" in
      *=*) ;;
      *) echo "error: $_f line $_n: expected 'key = value'" >&2
         _rc=1; continue ;;
    esac
    _k=$(printf '%s' "${_line%%=*}" | sed 's/[[:space:]]*$//')
    _v=$(printf '%s' "${_line#*=}" | sed 's/^[[:space:]]*//')
    case "$_k" in
      disk)     [ -n "${HEXA_DISK:-}" ]          || { HEXA_DISK=$_v;          export HEXA_DISK ; } ;;
      hostname) [ -n "${HEXA_HOSTNAME:-}" ]      || { HEXA_HOSTNAME=$_v;      export HEXA_HOSTNAME ; } ;;
      timezone) [ -n "${HEXA_TIMEZONE:-}" ]      || { HEXA_TIMEZONE=$_v;      export HEXA_TIMEZONE ; } ;;
      password) ANSWERS_PASSWORD=1
                [ -n "${HEXA_ROOT_PASSWORD:-}" ] || { HEXA_ROOT_PASSWORD=$_v; export HEXA_ROOT_PASSWORD ; } ;;
      log-gb)   [ -n "${HEXA_LOG_GB:-}" ]        || { HEXA_LOG_GB=$_v;        export HEXA_LOG_GB ; } ;;
      mirror)   [ -n "${HEXA_MIRROR:-}" ]        || { HEXA_MIRROR=$_v;        export HEXA_MIRROR ; } ;;
      mgmt-interface)
                [ -n "${HEXA_MGMT_INTERFACE:-}" ] || { HEXA_MGMT_INTERFACE=$_v; export HEXA_MGMT_INTERFACE ; } ;;
      mgmt-address)
                [ -n "${HEXA_MGMT_ADDRESS:-}" ]   || { HEXA_MGMT_ADDRESS=$_v;   export HEXA_MGMT_ADDRESS ; } ;;
      mgmt-gateway)
                [ -n "${HEXA_MGMT_GATEWAY:-}" ]   || { HEXA_MGMT_GATEWAY=$_v;   export HEXA_MGMT_GATEWAY ; } ;;
      mgmt-dns)
                [ -n "${HEXA_MGMT_DNS:-}" ]       || { HEXA_MGMT_DNS=$_v;       export HEXA_MGMT_DNS ; } ;;
      yes)
        case "$_v" in
          1|yes|true) _y=1 ;;
          0|no|false) _y=0 ;;
          *) echo "error: $_f line $_n: 'yes' takes yes or no, got '$_v'" >&2
             _rc=1; continue ;;
        esac
        [ -n "${HEXA_INSTALL_YES:-}" ] || { HEXA_INSTALL_YES=$_y; export HEXA_INSTALL_YES ; } ;;
      *) echo "error: $_f line $_n: '$_k' is not an answer this installer knows" >&2
         echo "  known: disk, hostname, timezone, password, log-gb, mirror," >&2
         echo "         mgmt-interface, mgmt-address, mgmt-gateway, mgmt-dns," >&2
         echo "         yes" >&2
         _rc=1 ;;
    esac
  done < "$_f"
  return $_rc
}

# Read here, before the first question, never during them. This script asks
# everything before it writes anything, and an answer that arrived halfway
# through would be exactly the ordering that rule exists to prevent.
if [ -n "${HEXA_ANSWERS:-}" ]; then
  ANSWERS_PASSWORD=0
  if read_answers "$HEXA_ANSWERS"; then
    say "answers from $HEXA_ANSWERS"
    if [ "$ANSWERS_PASSWORD" = 1 ]; then
      # Said out loud because it moves the secret rather than removing it: the
      # kernel command line stops carrying the password and the medium starts.
      # Whoever leaves that medium in a rack has left the root password in it.
      say "  it carries the root password, so the medium is itself a credential"
    fi
  else
    echo "error: the answer file was not usable; nothing has been written" >&2
    # Sourced (HEXA_INSTALL_LIB=1) this is a RETURN, because install-from-cmdline
    # reads the same file through this parser to learn whether the install is
    # unattended - and an exit there would take that script down before it could
    # say what happened or power the machine off, which is how an unattended
    # install becomes a machine sitting at a prompt until a harness kills it.
    [ "${HEXA_INSTALL_LIB:-0}" = 1 ] && return 1
    exit 1
  fi
fi

DISK=${HEXA_DISK:-${1:-}}
MIRROR=${HEXA_MIRROR:-}
MGMT_IF=${HEXA_MGMT_INTERFACE:-}
MGMT_ADDR=${HEXA_MGMT_ADDRESS:-}
MGMT_GW=${HEXA_MGMT_GATEWAY:-}
MGMT_DNS=${HEXA_MGMT_DNS:-}
HOSTNAME_NEW=${HEXA_HOSTNAME:-}
TIMEZONE=${HEXA_TIMEZONE:-}
ROOTPW=${HEXA_ROOT_PASSWORD:-}
ASSUME_YES=${HEXA_INSTALL_YES:-0}
CHECK_ONLY=${HEXA_INSTALL_CHECK:-0}
SRC=${HEXA_INSTALL_SRC:-/run/live/medium/live/filesystem.squashfs}
MNT=/tmp/hexa-install

ask() {   # <prompt> <default>; answer on stdout
  _d=$2
  if [ -n "$_d" ]; then printf '%s [%s]: ' "$1" "$_d" >&2
  else printf '%s: ' "$1" >&2; fi
  read -r _a || _a=""
  [ -n "$_a" ] || _a=$_d
  printf '%s' "$_a"
}

# Answer in SECRET, never echoed and never in argv.
#
# Returns non-zero at end of input. That matters: the retry loop below rejects
# an empty password and asks again, so a closed stdin - a script, a lab, a
# console that went away - would otherwise spin on "may not be empty" forever
# instead of failing.
ask_secret() {  # <prompt>
  printf '%s: ' "$1" >&2
  stty -echo 2>/dev/null || true
  if read -r SECRET; then _eof=0; else _eof=1; SECRET=""; fi
  stty echo 2>/dev/null || true
  printf '\n' >&2
  return $_eof
}

list_disks() {
  lsblk -dno NAME,SIZE,MODEL 2>/dev/null | sed 's|^|  /dev/|'
}

# The disk the system booted from, as a whole-disk path. Overwriting it fails
# halfway through and leaves neither system usable, so it is never offered.
boot_disk() {
  _src=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
  [ -n "$_src" ] || return 0
  # PKNAME is the parent of a partition, and EMPTY when the source is already
  # a whole disk - an ISO on /dev/sr0. One branch or the other, never both:
  # the first version printed the empty result too, so this returned two lines
  # and nothing ever matched it. The boot medium then appeared in the menu,
  # which is the one disk that must never be offered.
  _pk=$(lsblk -ndo PKNAME "$_src" 2>/dev/null | head -1)
  if [ -n "$_pk" ]; then
    printf '/dev/%s\n' "$_pk"
  else
    printf '%s\n' "$_src"
  fi
}

# Candidate disks, largest first, one per line: "<path> <bytes> <human> <model>"
#
# Largest first because the default is the largest, and the default is the
# largest because that is the disk somebody put in the machine to hold the
# system. The 32 GB stick they booted from is not it.
disk_table() {
  _boot=$(boot_disk)
  lsblk -dnbo NAME,SIZE,TYPE,MODEL 2>/dev/null | while read -r n b t rest; do
    [ "$t" = disk ] || continue
    # Block devices that are TYPE=disk and are not disks. A live kernel with
    # the brd module has /dev/ram0 to /dev/ram15, every one of them "disk" to
    # lsblk, and none of them a thing to install onto or to mirror records
    # onto: they are RAM, and they are empty again at the next boot.
    #
    # Measured: the one-disk run of lab/install-iso.sh installed a box whose
    # only disk was the target and the installer still said "records: not
    # mirrored (pass hexarouting.mirror=<disk>...)", which is a line about a
    # second disk on a machine that has none. The same table feeds the install
    # menu, so whatever it counted was also being OFFERED as somewhere to put
    # a router.
    case "$n" in
      ram*|zram*|loop*|sr*|fd*|dm-*|md*) continue ;;
    esac
    _p="/dev/$n"
    [ "$_p" = "$_boot" ] && continue
    _h=$(lsblk -dno SIZE "$_p" 2>/dev/null | tr -d ' ')
    printf '%s %s %s %s\n' "$_p" "$b" "${_h:-?}" "${rest:-unknown}"
  done | sort -k2 -rn
}

# a, b, c ... from an index. Twenty-six disks is more than anyone racks; past
# that the path still works.
letter_at() {
  printf '%s' "abcdefghijklmnopqrstuvwxyz" | cut -c"$1"
}

# Prints the menu and returns the chosen path on stdout.
choose_disk() {
  _table=$(disk_table)
  if [ -z "$_table" ]; then
    echo "No disk to install onto." >&2
    echo "  everything on this machine is either the medium you booted from" >&2
    echo "  or not a whole disk. Attach a disk and start again." >&2
    return 1
  fi

  echo "Disks on this machine:" >&2
  _i=1
  printf '%s\n' "$_table" | while read -r p b h m; do
    _l=$(letter_at "$_i")
    if [ "$_i" = 1 ]; then
      printf '  %s) %-14s %6s  %s   <- default, the largest\n' "$_l" "$p" "$h" "$m" >&2
    else
      printf '  %s) %-14s %6s  %s\n' "$_l" "$p" "$h" "$m" >&2
    fi
    _i=$((_i + 1))
  done
  echo >&2

  _default=$(printf '%s\n' "$_table" | head -1 | cut -d' ' -f1)

  while : ; do
    _a=$(ask "Install onto which disk (letter, or a device path)" "a")
    # A letter picks a line. A path is still accepted: scripts have them,
    # people have habits, and refusing one to enforce a menu would be a menu
    # getting in the way.
    case "$_a" in
      /dev/*)
        printf '%s\n' "$_a"
        return 0 ;;
      [a-z])
        _n=$(printf '%s' "abcdefghijklmnopqrstuvwxyz" | tr -d "\n" | \
             awk -v c="$_a" '{print index($0, c)}')
        _pick=$(printf '%s\n' "$_table" | sed -n "${_n}p" | cut -d' ' -f1)
        if [ -n "$_pick" ]; then
          printf '%s\n' "$_pick"
          return 0
        fi
        echo "  there is no disk '$_a' in that list." >&2 ;;
      "")
        printf '%s\n' "$_default"
        return 0 ;;
      *)
        echo "  answer with a letter from the list, or a device path." >&2 ;;
    esac
  done
}

# The second disk the records are mirrored onto, or nothing. (#83)
#
# Why the records and not the system: with one disk, a single failure on a box
# under a one-year retention obligation loses the RECORDS. Losing the system is
# downtime and downtime is recoverable - reinstall, restore the configuration,
# the box forwards again. The records are not recoverable by any means at all,
# and the box is still answerable for them. So this mirrors the one thing that
# cannot be rebuilt, and lab/records-mirror measures what that leaves uncovered:
# the survivor does NOT boot on its own, and the records on it are readable on
# another machine.
#
# Asked, never assumed. A second disk in a machine is not consent to destroy
# what is on it, and "the largest disk" reasoning that picks an install target
# is exactly wrong here: the operator may have put that disk there for
# something else.
#
# The DEFAULT IS NONE, and a bare Enter takes it. A box with one disk is never
# asked at all - there is nothing to ask about, and a question with no possible
# answer is noise on the one console where noise costs attention.
choose_mirror() {   # <target disk>; the chosen disk on stdout, or nothing
  _target=$1
  _table=$(disk_table | awk -v t="$_target" '$1 != t')
  [ -n "$_table" ] || return 0

  echo >&2
  echo "  This machine has another disk. The connection records can be kept on" >&2
  echo "  BOTH, so that one disk failing does not take the year of records with" >&2
  echo "  it - which is a loss no reinstall undoes." >&2
  echo "  The system is NOT mirrored: a dead system disk is a reinstall, and" >&2
  echo "  the records on the survivor can still be read on another machine." >&2
  echo "  EVERYTHING ON THE DISK YOU CHOOSE IS DESTROYED." >&2
  _i=1
  printf '%s\n' "$_table" | while read -r p b h m; do
    printf '  %s) %-14s %6s  %s\n' "$(letter_at "$_i")" "$p" "$h" "$m" >&2
    _i=$((_i + 1))
  done
  echo "  none) one disk, no mirror   <- default" >&2
  echo >&2

  while : ; do
    # "none" is the DEFAULT ask() substitutes for a bare Enter, and that is
    # where this question's answer to a held-down return key lives - the empty
    # string never reaches the case below. A default of the first disk here
    # would destroy a disk nobody chose.
    _a=$(ask "Mirror the connection records onto which disk" "none")
    case "$_a" in
      none|no|n)
        return 0 ;;
      /dev/*)
        printf '%s\n' "$_a"
        return 0 ;;
      [a-z])
        _n=$(printf '%s' "abcdefghijklmnopqrstuvwxyz" | tr -d "\n" | \
             awk -v c="$_a" '{print index($0, c)}')
        _pick=$(printf '%s\n' "$_table" | sed -n "${_n}p" | cut -d' ' -f1)
        if [ -n "$_pick" ]; then
          printf '%s\n' "$_pick"
          return 0
        fi
        echo "  there is no disk '$_a' in that list." >&2 ;;
      *)
        echo "  answer with a letter from the list, a device path, or 'none'." >&2 ;;
    esac
  done
}

# ===================================================================
# The management network (#303)
# ===================================================================
#
# WHAT THE BOX HAS, MEASURED BEFORE ANY OF THIS WAS DECIDED. The image is
# debootstrapped with "--include=...,iproute2,ifupdown,..." and nothing else
# that touches an interface: no NetworkManager, no systemd-networkd
# configuration, no netplan. A bookworm root with ifupdown on it carries
# /etc/network/interfaces holding "source /etc/network/interfaces.d/*" over an
# empty directory, and networking.service - "ifup -a" - enabled. So the
# mechanism that is already installed, already enabled and already running on
# every box this product has ever installed is ifupdown, and the one thing
# missing from it is a file. That is where this writes. Bringing a second
# mechanism onto the box to configure one card would leave two things that
# answer for the same interface and disagree at the worst moment.
#
# The same measurement found the trap underneath it: ifupdown Recommends a
# DHCP client and debootstrap installs no Recommends, so
#
#   # apt-get install -y --no-install-recommends ifupdown iproute2
#   dhclient: NONE
#   udhcpc: NONE
#   dhcpcd: NONE
#
# and "iface ens18 inet dhcp" on that root is a stanza with nothing to run it.
# appliance/build-iso.sh now installs isc-dhcp-client, and verify_installed()
# below REFUSES an install whose answer was dhcp on a disk with no client on
# it - because the default answer to this question is dhcp, and a default that
# quietly does nothing is worse than no question at all.
#
# The same measurement is why the DNS servers are written to /etc/resolv.conf
# directly rather than as "dns-nameservers" in the stanza: that option is
# implemented by resolvconf's if-up hook, the image has no resolvconf, and the
# line would be read by nothing. dhclient writes /etc/resolv.conf itself when
# resolvconf is absent, which is why the dhcp answer does not write one.
#
# HEXA_NET_SYS is empty on every box and is set only by test/test_installer.sh.
# A machine with two cards, one of them up and carrying the default route and
# one of them down, cannot be arranged on the machine running the tests - and
# the menu this feeds is the question whose wrong answer leaves a box nobody
# can reach. Same argument as HEXA_SELFTEST_ROOT, and the same shape.
NET_SYS=${HEXA_NET_SYS:-/sys/class/net}

# Where the answer is written, and the ONE file that decides the box's
# management network. appliance/selftest reads this same path back on every
# boot and says what became of it: the installer is the writer, the self-test
# is the reader, and neither of them keeps a second opinion about what the
# operator asked for.
#
# No dot in the name, deliberately. /etc/network/interfaces on this image says
# "source /etc/network/interfaces.d/*", which takes any name at all, but
# "source-directory" - which an operator may well move to, and which other
# Debian images ship - applies run-parts naming rules and SKIPS a file with a
# dot in it. A file that is silently skipped by an edit somebody made to a
# neighbouring line is exactly the failure this whole section exists to end.
MGMT_CONF=/etc/network/interfaces.d/hexarouting

# The cards this box could be managed on, one per line:
#   "<name> <operstate> <driver> <addresses or none>"
#
# A card, and not everything the kernel calls an interface. The test is
# /sys/class/net/<name>/device, which exists for a real NIC and for a virtio
# one and does NOT exist for lo, for a bridge, for a veth end, or for the TAP
# a linux_cp pair creates. A menu that offered those would be offering to
# configure the management address onto something that carries no cable.
nic_table() {
  for _d in "$NET_SYS"/*; do
    [ -e "$_d" ] || continue
    _n=${_d##*/}
    [ "$_n" = lo ] && continue
    [ -e "$_d/device" ] || continue
    _st=$(cat "$_d/operstate" 2>/dev/null || echo unknown)
    _drv=$(basename "$(readlink -f "$_d/device/driver" 2>/dev/null)" 2>/dev/null)
    case "$_drv" in ""|.|/) _drv=unknown ;; esac
    _a=$(ip -o -4 addr show dev "$_n" 2>/dev/null | awk '{printf "%s ", $4}')
    printf '%s %s %s %s\n' "$_n" "$_st" "$_drv" "${_a:-none}"
  done
}

# The card the LIVE system is reaching the network through, when there is one.
#
# Usually there is not, and that is worth saying rather than discovering: the
# medium has no management configuration either - it is the thing being fixed,
# one step earlier - so on an ordinary live boot no card has an address and
# this answers nothing. It answers when the medium was PXE-booted, or when
# somebody gave it an address by hand to install over the network, and in
# those cases it is the card they are using right now, which is the best
# answer anything here has.
#
# When it answers nothing the caller falls back to the first card, which on
# the one-NIC box this issue is about is the only card there is. Either way it
# is a DEFAULT and is never taken in silence: the summary repeats it back, the
# unattended path says it out loud, and the self-test names it at every boot
# afterwards.
default_route_nic() {
  ip -o -4 route list default 2>/dev/null \
    | awk '{ for (i = 1; i < NF; i++) if ($i == "dev") { print $(i + 1); exit } }' \
    | head -1
}

ipv4_ok() {  # <a.b.c.d>; true when it is four octets and each one fits
  [ -n "${1:-}" ] || return 1
  printf '%s' "$1" | awk -F. '
    NF != 4 { exit 1 }
    { for (i = 1; i <= 4; i++) {
        # The length test is not redundant with the range test: "0001" is 1
        # and is not an octet anybody typed on purpose, and leading zeroes
        # are read as octal by some of what reads this file back.
        if ($i !~ /^[0-9]+$/ || length($i) > 3 || $i + 0 > 255) exit 1
      }
      exit 0 }'
}

cidr_ok() {  # <a.b.c.d/nn>; true when the address and the prefix are both sane
  case "${1:-}" in
    */*) ;;
    *) return 1 ;;
  esac
  ipv4_ok "${1%%/*}" || return 1
  _p=${1#*/}
  case "$_p" in
    ""|*[!0-9]*) return 1 ;;
  esac
  [ "$_p" -ge 1 ] && [ "$_p" -le 32 ]
}

# Is the gateway on the subnet the address is on?
#
# THE ONE WRONG ANSWER THIS INSTALLER CAN CATCH BY ITSELF. A typo in the
# address puts the box on a subnet that exists somewhere and this machine
# cannot know which; a gateway outside the address's own subnet is wrong on
# the arithmetic alone, and what it produces is a box that boots with an
# address, refuses the default route - "Error: Nexthop has invalid gateway" -
# and is then reachable from its own subnet and from nowhere else. That is a
# box somebody drives to.
#
# Integer division rather than a bitwise mask: mawk has no and(), and the
# numbers involved are under 2^32, where a double is exact.
same_subnet() {  # <a.b.c.d/nn> <gateway>
  printf '%s %s\n' "$1" "$2" | awk '
    function n(a,   p) { split(a, p, "."); return ((p[1] * 256 + p[2]) * 256 + p[3]) * 256 + p[4] }
    { split($1, c, "/"); block = 2 ^ (32 - (c[2] + 0))
      exit (int(n(c[1]) / block) == int(n($2) / block)) ? 0 : 1 }'
}

# Prints the menu and returns the chosen interface on stdout.
#
# It cannot guess silently, and on a box with several cards it must not guess
# at all: the operator is shown what each card IS - whether it is up, what
# drives it, what address it is carrying this minute - because "ens18" and
# "ens19" tell nobody which cable is in which, and the card that is up with an
# address on it is the one the person standing there is already using.
choose_interface() {   # <default>; the chosen name on stdout
  _table=$(nic_table)
  _def=$1
  echo >&2
  echo "  A NEW BOX IS CONFIGURED AT ITS CONSOLE, and that is the default" >&2
  echo "  here: every card this machine has goes to the dataplane, and none" >&2
  echo "  of them is kept back to be managed on. Answer with a card only if" >&2
  echo "  this box is reached over the network after it reboots; that card" >&2
  echo "  is then the one card the dataplane will not claim." >&2
  echo >&2
  echo "Network cards on this machine:" >&2
  _i=1
  printf '%s\n' "$_table" | while read -r n st drv a; do
    _mark=""
    [ "$n" = "$_def" ] && _mark="   <- default"
    [ "$n" = "$MGMT_DEFAULT_IF" ] && [ "$_def" = none ] \
      && _mark="   <- this medium is reaching the network on this one"
    printf '  %s) %-10s %-6s %-12s %s%s\n' \
      "$(letter_at "$_i")" "$n" "$st" "$drv" "$a" "$_mark" >&2
    _i=$((_i + 1))
  done
  _nmark=""
  [ "$_def" = none ] && _nmark="   <- default"
  echo "  none) no management network   (this box is reached at its console)$_nmark" >&2
  echo >&2

  while : ; do
    _a=$(ask "Which card is this box managed on (letter, or a name)" "$_def")
    case "$_a" in
      none|no|n)
        printf 'none\n'
        return 0 ;;
      [a-z])
        # A letter picks a line. A NAME is still accepted, and on this
        # question a name is the likelier answer: predictable interface names
        # are what an operator has written down, and "ens18" is one character
        # longer than "a" to type.
        _n=$(printf '%s' "abcdefghijklmnopqrstuvwxyz" | tr -d "\n" | \
             awk -v c="$_a" '{print index($0, c)}')
        _pick=$(printf '%s\n' "$_table" | sed -n "${_n}p" | cut -d' ' -f1)
        if [ -n "$_pick" ]; then
          printf '%s\n' "$_pick"
          return 0
        fi
        # A single-letter interface name would land here and there is none on
        # any box this runs on; the message says both halves anyway.
        echo "  there is no card '$_a' in that list." >&2 ;;
      "")
        printf '%s\n' "$_def"
        return 0 ;;
      *)
        if [ -e "$NET_SYS/$_a" ]; then
          printf '%s\n' "$_a"
          return 0
        fi
        echo "  this box has no card called '$_a'." >&2 ;;
    esac
  done
}

# How that card is addressed. DHCP is the default, and the argument is the box
# this product is first met on.
#
# A virtual machine on a lab network has a DHCP server on it and no reserved
# address; a racked appliance has a reserved address and often no DHCP server
# at all. Only one of those can be the default, and it is the first: an
# operator who wants the box to work and presses Enter gets an address, and
# the self-test prints it on the console at every boot so they can ssh to it.
# The operator who is racking an appliance has an address written down in
# front of them and types it, which is one answer either way.
#
# The cost is stated rather than hidden: a box answering dhcp where no server
# replies waits for the client to give up before the boot finishes, and then
# says on the console that it has no address. That is slower than a static
# answer and it is still a box that says what is wrong with it, which is what
# the previous behaviour - up to 0.72.0, a card DOWN with nothing said at all -
# was not.
ask_address() {   # the answer on stdout: "dhcp" or "<a.b.c.d/nn>"
  while : ; do
    _a=$(ask "Address: 'dhcp', or one like 10.0.0.2/24" "dhcp")
    case "$_a" in
      dhcp|DHCP) printf 'dhcp\n'; return 0 ;;
      *)
        if cidr_ok "$_a"; then
          printf '%s\n' "$_a"
          return 0
        fi
        case "$_a" in
          */*) echo "  '$_a' is not an address and a prefix, like 10.0.0.2/24." >&2 ;;
          *)   echo "  an address needs its prefix: '$_a/24', not '$_a'." >&2 ;;
        esac ;;
    esac
  done
}

# The default gateway for a static address.
#
# Asked with no default and an empty answer accepted, because a management
# network with no way off it is a real arrangement - an out-of-band management
# LAN with a jump host on it is exactly that - and inventing ".1" would be a
# guess this installer writes into the box's routing table. What an empty
# answer COSTS is said out loud at the moment it is given, which is the only
# moment anybody can act on it.
ask_gateway() {   # <address/prefix>; the answer on stdout, possibly empty
  _addr=$1
  while : ; do
    _a=$(ask "Default gateway (empty: only this box's own subnet reaches it)" "")
    [ -n "$_a" ] || { printf '\n'; return 0; }
    if ! ipv4_ok "$_a"; then
      echo "  '$_a' is not an address." >&2
      continue
    fi
    if ! same_subnet "$_addr" "$_a"; then
      echo "  $_a is not on $_addr's subnet, so this box would come up with" >&2
      echo "  an address, refuse the default route, and be reachable from its" >&2
      echo "  own subnet only. Check which of the two is wrong." >&2
      continue
    fi
    printf '%s\n' "$_a"
    return 0
  done
}

# The file that decides the box's management network, written onto the target.
#
# A FUNCTION, above the library seam, for the reason verify_installed() is one:
# the alternative is proving this by installing a box, and what has to be
# proved is mostly what happens when the answers are unusual - a card that is
# named and absent, an address with no gateway, an operator who asked for no
# management network at all. Those are cases to enumerate in milliseconds, not
# boot cycles. test/test_installer.sh drives it against a directory.
#
# It writes the file EVEN WHEN THE ANSWER WAS NONE, and that is not
# bookkeeping. A box with no file at all is a box installed by something that
# never asked - every medium up to and including 0.72.0 - and the self-test
# must say so loudly, because that box is one reboot from being unreachable. A
# box whose operator answered "none" is a decision somebody made, and the
# self-test says so quietly. Without the file those two are the same box.
write_network_config() {   # <root> <interface|none> <address> <gateway> <dns>
  _r=$1; _wif=$2; _waddr=$3; _wgw=$4; _wdns=$5
  mkdir -p "$_r/etc/network/interfaces.d" || return 1
  {
    echo "# Generated by hexarouting-install. Do not edit by hand."
    echo "#"
    echo "# This file is the box's management network, answered at install"
    echo "# time. The boot self-test reads it back and reports what became of"
    echo "# it on every boot."
    if [ "$_wif" = none ] || [ -z "$_wif" ]; then
      echo "#"
      echo "# NO MANAGEMENT NETWORK was asked for: the answer to the interface"
      echo "# question was 'none'. This box is reached at its console. To give"
      echo "# it an address later, write the stanza here and run"
      echo "# 'ifup <interface>'."
    else
      echo ""
      # "auto" and not "allow-hotplug", which is what Debian's own installer
      # writes and is the wrong choice here. allow-hotplug configures the
      # interface from a udev event, so networking.service can finish with the
      # card still unconfigured and nothing downstream can wait for it - and
      # something downstream does: hexarouting-selftest.service is ordered
      # after networking.service precisely so that its report about the
      # management network is taken after the management network exists. With
      # "auto" the interface is brought up by "ifup -a" inside that unit, so
      # the unit finishing means the answer has been carried out. On an
      # appliance the card is in the machine at boot, every time, which is the
      # case allow-hotplug buys nothing for.
      echo "auto $_wif"
      if [ "$_waddr" = dhcp ]; then
        echo "iface $_wif inet dhcp"
      else
        echo "iface $_wif inet static"
        echo "    address $_waddr"
        [ -n "$_wgw" ] && echo "    gateway $_wgw"
      fi
    fi
  } > "$_r$MGMT_CONF" || return 1

  # And the file that has to READ it. /etc/network/interfaces on this image
  # already says "source /etc/network/interfaces.d/*", so this repairs nothing
  # on a box built from it - which is exactly why it is here: the stanza above
  # is inert without that line, the line is not this installer's to assume,
  # and an install that wrote a perfect file into a directory nobody sources
  # would produce the identical unreachable box with a file on it saying it
  # should not be.
  _main="$_r/etc/network/interfaces"
  if ! grep -qE '^[[:space:]]*source(-directory)?[[:space:]].*interfaces\.d' \
         "$_main" 2>/dev/null; then
    { echo "# Added by hexarouting-install: the management network is written"
      echo "# to interfaces.d and nothing here was reading it."
      echo "source /etc/network/interfaces.d/*"
    } >> "$_main" || return 1
  fi

  # The resolver, for a static answer that gave one. dhclient writes this file
  # itself, so the dhcp answer must not: two writers of /etc/resolv.conf is
  # one of them losing.
  if [ -n "$_wdns" ] && [ "$_waddr" != dhcp ]; then
    {
      echo "# Generated by hexarouting-install. Do not edit by hand."
      # Written here rather than as "dns-nameservers" in the stanza above,
      # because that option is resolvconf's and this image has no resolvconf:
      # the line would be read by nothing at all.
      printf '%s\n' "$_wdns" | tr ',' ' ' | tr -s ' ' '\n' \
        | while read -r _ns; do
            [ -n "$_ns" ] && echo "nameserver $_ns"
          done
    } > "$_r/etc/resolv.conf" || return 1
  fi
  return 0
}

# Check mode validates the ANSWERS and writes nothing, so it neither needs root
# nor a medium to run from - which is what lets the questions be tested without
# a virtual machine. Everything it cannot check it reports rather than passing
# over: a check that is more permissive than the real run is a check that
# agrees with itself.
blockers=""
note()  { blockers="$blockers
  - $*"; }
fatal() { if [ "$CHECK_ONLY" = 1 ]; then note "$*"; else die "$*"; fi }

# Does the disk that was just written actually work? (#83)
#
# hexarouting-selftest.service runs on the LIVE MEDIUM, before this installer,
# so until now NOTHING had ever looked at the result of an install. The failure
# mode is a box that reports success, has its medium taken out, and then boots
# to a "grub>" prompt in front of whoever is standing there - by which time the
# person who could have re-run the install has left the cage.
#
# Four checks, because four things stop a freshly written disk from being a
# box somebody owns, and each has been seen on this product:
#
#   - GRUB has an entry whose kernel is on the disk (the squashfs built without
#     /boot installed a bootloader with nothing to boot),
#   - every UUID in fstab resolves to a device that exists (a mistyped or stale
#     UUID drops the boot into an initramfs prompt),
#   - root has a password hash (a late failure leaves the LOCKED account the
#     live image carries, which is a disk nobody can log into), and
#   - the management network reached the disk, names a card this machine has,
#     and has something on the disk able to carry out the answer (#303). The
#     last of those is the one with teeth: "iface ens18 inet dhcp" on a root
#     with no DHCP client is a file that reads perfectly and does nothing, and
#     the medium carried no client at all until this was measured.
#
# Each failure NAMES its check. "Verification failed" tells the operator to
# reinstall and hope; naming it tells them what to look at.
#
# It reads only. A verification that repairs what it finds is a verification
# whose result is about itself.
verify_installed() {   # <mounted root>; non-zero if the disk is not usable
  _r=$1
  _bad=0
  _vok()  { echo "  [ ok ] $*"; }
  _vbad() { echo "  [FAIL] $*"; _bad=$((_bad + 1)); }

  _cfg="$_r/boot/grub/grub.cfg"
  if [ ! -f "$_cfg" ]; then
    _vbad "GRUB: no /boot/grub/grub.cfg, so there is no menu to boot from"
  else
    _kern=$(awk '$1 ~ /^linux(16|efi)?$/ { print $2; exit }' "$_cfg")
    if [ -z "$_kern" ]; then
      _vbad "GRUB: grub.cfg has no entry that loads a kernel"
    elif [ ! -f "$_r$_kern" ]; then
      _vbad "GRUB: grub.cfg boots $_kern and that file is not on the disk"
    else
      _vok "GRUB boots $_kern, which is on the disk"
    fi
  fi

  _fstab="$_r/etc/fstab"
  if [ ! -f "$_fstab" ]; then
    _vbad "fstab: /etc/fstab was not written"
  else
    _uuids=$(grep -v '^[[:space:]]*#' "$_fstab" \
             | grep -oE 'UUID=[-0-9A-Fa-f]+' | cut -d= -f2)
    if [ -z "$_uuids" ]; then
      # An fstab with no UUID in it passes a loop over its UUIDs. That is a
      # check agreeing with itself, and it would pass the one fstab that is
      # certainly wrong: the empty one.
      _vbad "fstab: names no UUID at all, so the root filesystem is unidentified"
    else
      _n=0
      for _u in $_uuids; do
        if [ -n "$(blkid -U "$_u" 2>/dev/null)" ]; then
          _n=$((_n + 1))
        else
          # THE UUID ON A ROW OF ITS OWN. It is 36 columns of the 97 this
          # sentence measured on an 80-column console (#367), and it is the
          # one thing here an operator copies out to go and look for.
          _vbad "fstab: a UUID is mounted at boot and no device has it:
         UUID=$_u"
        fi
      done
      [ "$_n" -gt 0 ] && _vok "fstab: $_n UUID(s), every one of them resolves"
    fi
  fi

  # The hash itself is never printed: this runs on a console and into the
  # install log, and a hash on either is an offline cracking target.
  _pw=$(grep '^root:' "$_r/etc/shadow" 2>/dev/null | cut -d: -f2)
  case "${_pw:-}" in
    '$'*) _vok "root has a password, so somebody can log into this box" ;;
    '')   _vbad "login: /etc/shadow has no root line at all" ;;
    *)    _vbad "login: the root account is still LOCKED - this is the live
         image's account, so the password answer never reached the disk" ;;
  esac

  # The management network, which is the whole of #303 and is checked here
  # because here is where the disk still exists to be looked at. Every one of
  # these leaves a box that boots perfectly and cannot be reached, which is
  # the failure this verification exists for: it is found while the operator
  # is still standing there with the medium in the drive.
  if [ ! -f "$_r$MGMT_CONF" ]; then
    _vbad "network: the management stanza was not written, so this box
         would boot with its card down and no address:
         $MGMT_CONF"
  else
    _mif=$(awk '$1 == "iface" { print $2; exit }' "$_r$MGMT_CONF")
    _mmethod=$(awk '$1 == "iface" { print $4; exit }' "$_r$MGMT_CONF")
    if [ -z "$_mif" ]; then
      # The operator answered "none". It is a decision and not a fault, and
      # saying it here is what makes the file's absence mean something else.
      _vok "no management network was asked for: this box is reached at its
         console"
    elif ! grep -qE '^[[:space:]]*source(-directory)?[[:space:]].*interfaces\.d' \
            "$_r/etc/network/interfaces" 2>/dev/null; then
      _vbad "network: /etc/network/interfaces does not read interfaces.d, so
         the stanza for $_mif was written where nothing looks"
    elif [ ! -e "$NET_SYS/$_mif" ]; then
      # This machine is the one being installed, so the card it has now is the
      # card the installed box has. A name that is not here is a name that
      # will not be there either.
      _vbad "network: the management card $_mif is not on this machine
         (it was named at install time and is not here now)"
    elif [ "$_mmethod" = dhcp ] && [ ! -x "$_r/sbin/dhclient" ] \
         && [ ! -x "$_r/usr/sbin/dhclient" ]; then
      _vbad "network: $_mif is configured by DHCP and this disk carries no
         DHCP client, so nothing on it can ask for an address"
    else
      _vok "management network: $_mif, $_mmethod"
    fi
  fi

  [ "$_bad" = 0 ]
}

# Did the array this installer just created come up with BOTH legs? (#83)
#
# "mdadm --create" exits zero having started a DEGRADED array - one leg
# rejected, one accepted - so its exit status answers "did mdadm run", not
# "are the records on two disks". The kernel's own account of the array is
# /proc/mdstat and that is what is read here.
#
# A mirror created degraded is the exact failure the mirror exists to prevent,
# arriving at the moment the operator is told the install worked. It has to be
# a refusal and not a warning, because the box would then spend a year
# reporting a mirror it never had.
#
# It reads only, like verify_installed: a verification that repairs what it
# finds is a verification whose result is about itself.
verify_mirror() {   # <mdstat> <md device>; non-zero unless both legs are there
  _f=$1
  _dev=$2
  _md=${2#/dev/}
  if [ ! -r "$_f" ]; then
    echo "  [FAIL] mirror: $_f cannot be read, so nothing here knows whether"
    echo "         the records reached two disks"
    return 1
  fi
  # The array's block line, which is the one carrying [n/m]. Anchored on the
  # array's own name at the start of a line: mdstat lists every array, and a
  # grep for "[2/2]" anywhere in it would be answered by a different one.
  _line=$(awk -v d="$_md" '$1 == d { f = 1 }
                           f && /\[[0-9]+\/[0-9]+\]/ { print; exit }' "$_f")
  if [ -z "$_line" ]; then
    echo "  [FAIL] mirror: the kernel has no array $_dev, so the records are on"
    echo "         ONE disk - which is what the second disk was given for"
    return 1
  fi
  _legs=$(printf '%s' "$_line" | grep -o '\[[0-9]*/[0-9]*\]' | head -1 | tr -d '[]')
  _want=${_legs%/*}
  _have=${_legs#*/}
  if [ "$_have" = "$_want" ]; then
    echo "  [ ok ] records mirrored on $_dev, $_have of $_want disks present"
    return 0
  fi
  echo "  [FAIL] mirror: $_dev has $_have of $_want disks. It was created"
  echo "         DEGRADED, so the records are on one disk and the box would"
  echo "         report a mirror it never had"
  return 1
}

# The ssh host keys, generated on the target and on nothing else.
#
# `ssh-keygen -A` GENERATES ONLY THE KEYS THAT ARE MISSING, so on a tree that
# already has a set it is a no-op that exits 0 and says nothing. Measured, on
# the published hexarouting-0.37.0-ab23bd7-dirty.iso rather than reasoned
# about: its squashfs carries ssh_host_{rsa,ecdsa,ed25519}_key stamped
# 2026-09-08 16:43 against a squashfs made at 16:46:15, unpacking it with the
# installer's own `unsquashfs -f -d` line puts them on the target, and
# `ssh-keygen -A` over that tree left all three fingerprints exactly as the
# medium had them - ed25519 SHA256:hwhc4Nfxh3lzwZNoIlON9ehRISKN1BBeo1wcEQi/DJg,
# comment root@a3bcac8dc76e, the build container. The installer would print
# "generating this box's own ssh host keys" and generate none.
#
# It did not reach a box only because build-iso.sh removes them from the image
# first (#245), which makes the whole guarantee a property of the medium: the
# install step had no opinion of its own and could not fail. So the removal is
# repeated here, against whatever /etc/ssh the medium handed over, and what
# this box answers with is what the next line makes.
#
# The public halves go too. Left behind they are a set of .pub files that do
# not match the private keys beside them, which is a puzzle for whoever next
# reads a fingerprint off the disk.
install_ssh_host_keys() {   # <mounted root>; non-zero if no keys could be made
  _r=${1:-}
  # An unset argument would make the rm below read /etc/ssh/ssh_host_*_key,
  # which on the live medium is nothing and on a developer box running this
  # sourced is that machine's own host keys. The install dies instead.
  [ -n "$_r" ] && [ -d "$_r/etc/ssh" ] || return 1
  # Named, not counted: an operator installing from a medium that carries host
  # keys is holding a medium every other box was installed from, and those
  # boxes are still answering with this key.
  _handed=""
  for _k in "$_r"/etc/ssh/ssh_host_*_key; do
    [ -f "$_k" ] || continue
    _handed="$_handed ${_k##*/}"
  done
  if [ -n "$_handed" ]; then
    say "  this medium carries ssh host keys; they are not going on the disk:"
    # FOLDED, because the list grows with the kinds of key a medium was built
    # with: three of them is 73 columns and four is 81, on an 80-column console
    # (#367). `say` puts four columns in front and the indent is three, so 72
    # is what is left. A list folds between its items and nothing is lost; the
    # verdict above it is one row and does not fold.
    printf '%s\n' "$_handed" | fold -s -w 72 | while IFS= read -r _r; do
      say "   $_r"
    done
    say "  every box installed from this medium answers with them"
  fi
  rm -f "$_r"/etc/ssh/ssh_host_*_key "$_r"/etc/ssh/ssh_host_*_key.pub
  say "  generating this box's own ssh host keys"
  chroot "$_r" ssh-keygen -A >/dev/null 2>&1 || return 1
  # THE EFFECT, not the exit status. This is the one line between an operator
  # and a racked box, and `ssh-keygen -A` reporting success is not the same
  # claim as the box having a key: it exits 0 having written nothing whenever
  # it thinks the keys are already there, which is exactly the mistake this
  # function exists to stop, and it would do it silently. The removal above
  # means there is nothing it may decline to make, so an empty /etc/ssh after
  # a successful run is a target that cannot run sshd and must not be reported
  # as installed.
  for _k in "$_r"/etc/ssh/ssh_host_*_key; do
    [ -f "$_k" ] && return 0
  done
  return 1
}

# A seam, so the disk menu and the verification can be tested without
# installing anything.
#
# Sourced with HEXA_INSTALL_LIB=1, this script stops here and the caller gets
# the functions above and nothing else. The alternative is testing the menu by
# running an install, which needs real block devices - so it would not be
# tested, and the one question in this program where a wrong answer destroys
# something would be the one part with no test.
[ "${HEXA_INSTALL_LIB:-0}" = 1 ] && return 0

[ "$(id -u)" = 0 ] || fatal "must run as root"

# Every tool checked before anything is asked, let alone written. Discovering a
# missing one after the partition table is rewritten leaves a disk that is
# neither the old system nor the new one.
missing=""
for t in sfdisk mkfs.ext4 mkfs.vfat unsquashfs blkid lsblk findmnt chpasswd \
         grub-install update-grub; do
  command -v "$t" >/dev/null 2>&1 || missing="$missing $t"
done
# THE LIST ON ROWS OF ITS OWN, folded. All ten missing is the case an operator
# meets on a medium that was built wrong - which is exactly when they read this
# - and ten names is 92 columns of value: with the verdict in front of them the
# row was 141 on an 80-column console that cannot reflow (#367). A verdict is
# one row and must not fold; a LIST folds between its items and loses nothing,
# which is the same trade appliance/selftest makes in say_list.
[ -z "$missing" ] || fatal "missing tools - the ISO should carry them:
$(printf '%s\n' "$missing" | fold -s -w 77 | sed 's/^ *//; s/^/  /')"

# The path is 41 columns of the 99 this measured (#367), and it is the whole of
# the answer: it says which file was looked for. It goes last, on its own row.
[ -f "$SRC" ] || fatal "live filesystem not found (are you on the ISO?):
  $SRC"

echo
echo "============== Prisma Routing: install to disk ============="
echo "Nothing is written until every question below is answered."
echo

# ------------------------------------------------------------------ 1. disk
#
# NO EMPTINESS CHECK HERE, and the reason is worth keeping so that nobody puts
# one back. There used to be `[ -n "$DISK" ] || die "no disk given"` on the
# next line, and it could not fire on any input at all: every path out of
# choose_disk() either returns non-zero - an empty menu, which exits above -
# or prints a path, and the branch is only taken when $DISK was empty to begin
# with. The reader in test/test_installer.sh found it by asking for a box that
# makes this program print each of its messages, and there was no box to
# arrange (#364). What an operator meets on a machine with nothing to install
# onto is the menu's own refusal, which says that and what to do about it;
# "no disk given" would have told them they gave no answer, about a machine
# they gave the only possible one for.
if [ -z "$DISK" ]; then
  DISK=$(choose_disk) || exit 1
fi
[ -b "$DISK" ] || { echo "Available:" >&2; list_disks >&2; \
                    die "$DISK is not a block device"; }

# Refuse the medium currently being read. Overwriting the ISO you booted from
# fails halfway through and leaves neither system usable.
ROOTDEV=$(findmnt -no SOURCE /run/live/medium 2>/dev/null || true)
case "${ROOTDEV:-}" in
  "$DISK"*) die "$DISK is the medium this system booted from" ;;
esac

# -------------------------------------------------------------- 2. hostname
#
# The default is still "hexarouting" after the rename to Prisma Routing
# (#202): a hostname is a name on the disk and in every box already racked,
# not a string a person reads on the banner, and the operator is asked.
if [ -z "$HOSTNAME_NEW" ]; then
  HOSTNAME_NEW=$(ask "Hostname" "hexarouting")
fi
case "$HOSTNAME_NEW" in
  ""|*[!A-Za-z0-9.-]*) die "hostname '$HOSTNAME_NEW' has characters a hostname may not have" ;;
esac

# -------------------------------------------------------------- 3. timezone
# It decides the timestamps on the configuration trail, which under the Marco
# Civil is a connection record. A box logging in the wrong zone produces
# records that do not line up with anybody else's.
if [ -z "$TIMEZONE" ]; then
  TIMEZONE=$(ask "Timezone" "America/Sao_Paulo")
fi
[ -f "/usr/share/zoneinfo/$TIMEZONE" ] \
  || die "unknown timezone '$TIMEZONE' (see /usr/share/zoneinfo)"

# ------------------------------------------------------- 3b. the log volume
#
# In dynamic mode the allocation log IS the connection record the Marco Civil
# requires this box to keep for a year. Put on the root filesystem it shares
# space with everything the box needs to keep working - so a log that fills
# stops the box writing its configuration, its trail, and anything else,
# because it was busy recording who connected to what (#83).
#
# It gets its own filesystem. Then a full log volume is a full log volume.
#
# The default is arithmetic, not a guess, and the arithmetic is shown: docs/
# logging.md measures ~80 MB/day for 200k subscribers in dynamic mode, so a
# year is ~29 GB. A box in deterministic mode logs no allocations at all and
# needs almost none of this - which is why it is a question rather than a
# constant.
# The size of the disk, if it can be had. blockdev needs privileges the check
# mode deliberately does not have, so this can legitimately be unknown - and a
# bound against an unknown size is not a bound. The SHAPE of the answer is
# always checked; the fit only when the size is known, and it says so when it
# is not.
# /sys first: it is world-readable, so the size is known in CHECK MODE too -
# and a check that skipped the fit because it lacked privileges would be more
# permissive than the real run, which this file already says a check must
# never be. blockdev is the fallback for anything /sys does not describe.
_sysblk="/sys/block/$(basename "$DISK")/size"
if [ -r "$_sysblk" ]; then
  DISK_MB=$(( $(cat "$_sysblk") / 2048 ))
else
  DISK_MB=$(( $(blockdev --getsize64 "$DISK" 2>/dev/null || echo 0) / 1048576 ))
fi
SYSTEM_MB=8192   # the system, VPP and FRR. Never leave root less than this.
LOG_DEFAULT=30
if [ "$DISK_MB" -gt 0 ]; then
  MAX_LOG=$(( DISK_MB - 512 - SYSTEM_MB ))
  [ "$MAX_LOG" -lt 0 ] && MAX_LOG=0
  [ "$LOG_DEFAULT" -gt $(( MAX_LOG / 1024 )) ] && LOG_DEFAULT=$(( MAX_LOG / 1024 ))
  [ "$LOG_DEFAULT" -lt 1 ] && LOG_DEFAULT=1
else
  MAX_LOG=""
fi

if [ -z "${HEXA_LOG_GB:-}" ] && [ "$ASSUME_YES" = 1 ]; then
  # An unattended install must not stop at a prompt. It has no console to
  # answer from, and a question nobody can answer is an install that hangs -
  # which is what the first version of this did, on a lab that had answered
  # every other question on the kernel command line.
  LOG_GB=$LOG_DEFAULT
  say "records: $LOG_GB GB (unattended; pass hexarouting.log-gb= to choose)"
elif [ -z "${HEXA_LOG_GB:-}" ]; then
  echo
  echo "  Connection records go on their own filesystem, so that a full log"
  echo "  cannot stop the box working. One year at 200k subscribers in dynamic"
  echo "  mode is about 29 GB; deterministic mode logs no allocations and"
  echo "  needs almost none. The arithmetic is in"
  # THE PATH THIS BOX HAS, not the one the source tree has. It said
  # docs/logging.md, and there is no docs/ on a box this product installs:
  # install.sh puts that file under /usr/share/doc/hexarouting/ (#348). An
  # operator answering this question has the box and not the repository, and
  # the installation page quotes this screen verbatim, so the path they cannot
  # follow reached a reader who has not installed anything yet.
  echo "  /usr/share/doc/hexarouting/logging.md once this box is installed."
  if [ -n "$MAX_LOG" ]; then
    echo "  This disk is $(( DISK_MB / 1024 )) GB; at most $(( MAX_LOG / 1024 )) GB can go to records."
  else
    echo "  The size of $DISK could not be read, so the fit is not checked."
  fi
  LOG_GB=$(ask "Gigabytes for connection records" "$LOG_DEFAULT")
else
  LOG_GB=$HEXA_LOG_GB
fi
case "$LOG_GB" in
  ""|*[!0-9]*) die "the log size must be a whole number of gigabytes, got '$LOG_GB'" ;;
esac
[ "$LOG_GB" -ge 1 ] || die "the log needs at least 1 GB of its own"
if [ -n "$MAX_LOG" ] && [ "$(( LOG_GB * 1024 ))" -gt "$MAX_LOG" ]; then
  die "$LOG_GB GB of records leaves the system less than $(( SYSTEM_MB / 1024 )) GB on a $(( DISK_MB / 1024 )) GB disk"
fi

# ------------------------------------------------- 3c. the records mirror
#
# Asked here because the answer needs LOG_GB - the second disk has to hold the
# records - and because it is still a QUESTION, before the first write. The
# ordering is the rule this whole script is built on and a disk that is going
# to be destroyed cannot be chosen after the partitioning has started.
if [ -z "$MIRROR" ]; then
  if [ "$ASSUME_YES" = 1 ]; then
    # Unattended and nothing said: one disk, exactly as before. It is said out
    # loud only when there WAS a second disk, because that is the install where
    # somebody may have expected a mirror and got none.
    # Named, not counted. "There is another disk" on a machine the operator
    # believes has one is a statement they cannot check, and the disk it means
    # is the whole of what makes it actionable.
    _others=$(disk_table | awk -v t="$DISK" '$1 != t { printf "%s ", $1 }')
    if [ -n "$_others" ]; then
      say "records: not mirrored, and this machine has ${_others}too"
      say "  (pass hexarouting.mirror=<disk> to keep the records on two disks)"
    fi
  else
    MIRROR=$(choose_mirror "$DISK")
  fi
fi

if [ -n "$MIRROR" ]; then
  [ "$MIRROR" != "$DISK" ] || \
    die "the mirror has to be a SECOND disk; $MIRROR is the one being installed"
  # The medium is refused here for the same reason it is refused as a target:
  # overwriting what is being read fails halfway through.
  case "${ROOTDEV:-}" in
    "$MIRROR"*) die "$MIRROR is the medium this system booted from" ;;
  esac
  [ -b "$MIRROR" ] || { echo "Available:" >&2; list_disks >&2; \
                        die "$MIRROR is not a block device"; }
  # A whole disk, not a partition. /sys/block/<name> exists only for whole
  # disks, so this is the same question as "can its size be read" - and the
  # size is the other half of the answer: a leg smaller than the records
  # partition makes an array smaller than the operator asked for, silently,
  # because md sizes a mirror by its smallest member.
  _msys="/sys/block/$(basename "$MIRROR")/size"
  [ -r "$_msys" ] || \
    die "$MIRROR is not a whole disk (no /sys/block entry); the mirror takes a
  whole disk, because everything on it is destroyed"
  MIRROR_MB=$(( $(cat "$_msys") / 2048 ))
  # 8 MB over, for the partition's own offset and md's superblock. Without the
  # margin an exactly-sized disk produces an array one megabyte short of the
  # answer, which nobody would notice until the volume filled early.
  if [ "$MIRROR_MB" -lt "$(( LOG_GB * 1024 + 8 ))" ]; then
    die "$MIRROR holds $(( MIRROR_MB / 1024 )) GB and the records need $LOG_GB GB:
  a mirror is as big as its smallest disk"
  fi
  # Checked here rather than in the tool list at the top, because a medium
  # without mdadm must still install a one-disk box. fatal, not die: this is
  # something about the MACHINE, and check mode reports those instead of
  # refusing answers that are perfectly good.
  command -v mdadm >/dev/null 2>&1 || \
    fatal "this medium has no mdadm, so it cannot build the records mirror"
fi

# ------------------------------------------------ 3d. the management network
#
# Asked here, with the other questions and before the first write, for the
# reason every question in this script is: a box that is going to be rebooted
# into a rack has to know how it is reached before anything is written, not
# after. The ANSWER is written much further down, next to the hostname, which
# is the other thing that makes a disk into a particular box.
MGMT_DEFAULT_IF=$(default_route_nic)
[ -n "$MGMT_DEFAULT_IF" ] || MGMT_DEFAULT_IF=$(nic_table | head -1 | cut -d' ' -f1)
MGMT_NICS=$(nic_table | wc -l | tr -d ' ')

# "none" from either answer means the same thing, because an operator setting
# this unattended will reach for whichever of the two they remember.
case "$MGMT_ADDR" in none|no) MGMT_IF=none ;; esac

if [ "$MGMT_NICS" = 0 ]; then
  # A machine with no card at all. There is nothing to ask and nothing to
  # write a stanza for, and a question with no possible answer is noise on the
  # one console where noise costs attention - the same argument the mirror
  # question makes about a box with one disk.
  [ -n "$MGMT_IF" ] || say "management network: this machine has no network card"
  MGMT_IF=none
elif [ -z "$MGMT_IF" ]; then
  if [ "$ASSUME_YES" = 1 ]; then
    # Unattended, and nothing said. It takes the default and SAYS it took the
    # default, for the reason the log volume does: an unattended install has no
    # console to answer from, and a question nobody can answer is a machine
    # that hangs.
    #
    # THE DEFAULT IS NONE, here as at the question (#394). It used to be the
    # card this medium was reaching the network through, which reads like the
    # best answer anything here has and is the wrong one twice over: it keeps
    # a card back from the dataplane on a product that claims every card it
    # has since 0.76.0, and it does it on the install that had nobody
    # watching. An unattended install that wanted a management network says
    # which card on the kernel command line, where the rest of its answers
    # already are.
    if [ -n "$MGMT_ADDR" ]; then
      # AN ADDRESS WAS ASKED FOR AND NO CARD NAMED. That is an install that
      # wants a management network, so `none` is not the answer to it: the
      # card is the one this medium is reaching the network through, which is
      # the only card anything here knows to be connected. Named separately
      # from the silence above because the two are different answers - one
      # said nothing at all, the other said which address.
      MGMT_IF=$MGMT_DEFAULT_IF
      # The two values LAST ON THEIR ROW and nothing behind them, which is
      # the rule #367 left: a card name and an address are as long as the box
      # makes them, and a row that carries one in the middle grows past the
      # console exactly when somebody is reading it.
      say "management network: unattended, and the address was asked for with"
      say "  no card named, so the card this medium is reaching the network"
      say "  through is the one:"
      say "  $MGMT_IF, $MGMT_ADDR"
    else
      MGMT_IF=none
      say "management network: none (unattended; nothing was asked)"
      say "  (pass hexarouting.mgmt-interface= and hexarouting.mgmt-address= to"
      say "  manage this box over the network instead)"
    fi
  else
    MGMT_IF=$(choose_interface none) || exit 1
  fi
fi

if [ "$MGMT_IF" = none ]; then
  # Recorded rather than dropped. The file written for this case is what lets
  # the boot self-test tell a box whose operator chose this from a box that
  # was installed by a medium which never asked - and the second of those is
  # every box installed before this existed.
  MGMT_ADDR=none
  MGMT_GW=""
  MGMT_DNS=""
else
  [ -e "$NET_SYS/$MGMT_IF" ] || { echo "Cards on this machine:" >&2
    nic_table | sed 's/^/  /' >&2
    die "this machine has no card called '$MGMT_IF'"; }
  if [ -z "$MGMT_ADDR" ]; then
    if [ "$ASSUME_YES" = 1 ]; then
      MGMT_ADDR=dhcp
    else
      MGMT_ADDR=$(ask_address)
    fi
  fi
  case "$MGMT_ADDR" in
    dhcp|DHCP) MGMT_ADDR=dhcp ;;
    *) cidr_ok "$MGMT_ADDR" || die "'$MGMT_ADDR' is not 'dhcp' and not an
  address with a prefix, like 10.0.0.2/24" ;;
  esac
  if [ "$MGMT_ADDR" = dhcp ]; then
    # A gateway and a DHCP answer name two different authorities for the same
    # route. Refused rather than quietly ignored: whoever wrote both down
    # believes one of them, and this installer cannot know which.
    [ -z "$MGMT_GW" ] || die "a gateway was given and DHCP carries its own:
  one of the two answers is not what was meant, and this cannot know which"
  else
    if [ -z "$MGMT_GW" ] && [ "$ASSUME_YES" != 1 ]; then
      MGMT_GW=$(ask_gateway "$MGMT_ADDR")
    fi
    if [ -n "$MGMT_GW" ]; then
      ipv4_ok "$MGMT_GW" || die "the gateway '$MGMT_GW' is not an address"
      same_subnet "$MGMT_ADDR" "$MGMT_GW" || \
        die "the gateway is not on the subnet of the address: this box would
  come up with an address, refuse the default route, and be reachable from its
  own subnet only. The two answers that disagree:
  gateway $MGMT_GW, address $MGMT_ADDR"
    fi
    if [ -z "$MGMT_DNS" ] && [ "$ASSUME_YES" != 1 ]; then
      MGMT_DNS=$(ask "DNS servers, comma separated (empty: none)" "")
    fi
    for _ns in $(printf '%s' "$MGMT_DNS" | tr ',' ' '); do
      ipv4_ok "$_ns" || die "the DNS server '$_ns' is not an address"
    done
  fi
fi

# --------------------------------------------------------- 4. root password
#
# Refused, not defaulted. A first boot that never asks for a password is a
# first boot whose password was decided by whoever built the image.
if [ -z "$ROOTPW" ]; then
  while : ; do
    ask_secret "Root password" \
      || die "no root password given; refusing to install a box nobody can log into"
    pw1=$SECRET
    if [ -z "$pw1" ]; then
      echo "  the root password may not be empty" >&2
      continue
    fi
    ask_secret "Repeat root password" \
      || die "no root password given; refusing to install a box nobody can log into"
    if [ "$pw1" = "$SECRET" ]; then
      ROOTPW=$pw1
      break
    fi
    echo "  the two do not match" >&2
  done
fi
[ -n "$ROOTPW" ] || die "no root password given; refusing to install a box nobody can log into"

# ----------------------------------------------------------------- summary
MODEL=$(lsblk -dno MODEL "$DISK" 2>/dev/null | tr -s ' ')
SIZE=$(lsblk -dno SIZE "$DISK" 2>/dev/null)
echo
echo "  disk           $DISK  ($SIZE ${MODEL:-unknown})   EVERYTHING ON IT IS DESTROYED"
lsblk -no NAME,SIZE,FSTYPE,MOUNTPOINT "$DISK" 2>/dev/null | sed 's/^/                   /'
if [ -n "$MIRROR" ]; then
  echo "  records mirror $MIRROR   EVERYTHING ON IT IS DESTROYED TOO"
  echo "                   the records go on both disks; the system does not"
else
  echo "  records mirror none (one disk: a disk failure loses the records)"
fi
echo "  hostname       $HOSTNAME_NEW"
echo "  timezone       $TIMEZONE"
# Repeated back with the other answers, because it is the one answer whose
# consequence the operator cannot see until the medium is out of the drive and
# the box has rebooted without them.
if [ "$MGMT_IF" = none ]; then
  echo "  management     none: this box is reached at its console only"
elif [ "$MGMT_ADDR" = dhcp ]; then
  echo "  management     $MGMT_IF, by DHCP"
else
  echo "  management     $MGMT_IF, $MGMT_ADDR${MGMT_GW:+ via $MGMT_GW}"
  [ -n "$MGMT_DNS" ] && echo "                 DNS $MGMT_DNS"
  [ -n "$MGMT_GW" ] || echo "                 no gateway: its own subnet reaches it, nothing else"
fi
echo "  root password  set"
echo

if [ "$CHECK_ONLY" = 1 ]; then
  if [ -n "$blockers" ]; then
    echo "the answers are valid, but this machine could not run the install:$blockers"
  fi
  echo "check only: nothing was written"
  exit 0
fi

if [ "$ASSUME_YES" != 1 ]; then
  #
  # The disk is repeated back with what it IS - size and model - and the answer
  # has to be the word "yes".
  #
  # This used to require re-typing the device path. The reasoning was sound as
  # far as it went: a yes/no prompt is answered reflexively, and typing a
  # device name is not. But it bought that by making the operator transcribe
  # the same string twice, which is the one moment in this install where a typo
  # is destructive - and the second transcription is no more likely to be right
  # than the first.
  #
  # What that prompt was really protecting is that a disk cannot be destroyed
  # by holding down the return key. That property is kept: a bare Enter is not
  # an answer here, and neither is "y". Showing the size and the model does the
  # other half, which re-typing a path never did - "/dev/sdb" typed twice is
  # still the wrong disk if it was the wrong disk.
  #
  _what=$(lsblk -dno SIZE,MODEL "$DISK" 2>/dev/null | sed 's/  */ /g;s/^ *//')
  echo
  echo "  About to ERASE $DISK  ${_what:-}"
  # The mirror disk is erased by this same "yes" and it is named in it. A
  # confirmation that repeats one disk back while a second is destroyed behind
  # it is not the confirmation this script claims to have.
  if [ -n "$MIRROR" ]; then
    _what2=$(lsblk -dno SIZE,MODEL "$MIRROR" 2>/dev/null | sed 's/  */ /g;s/^ *//')
    echo "  and to ERASE $MIRROR  ${_what2:-}  (the records mirror)"
  fi
  echo "  Everything on it is lost. This cannot be undone."
  printf "  Type 'yes' to install: "
  read -r answer
  [ "$answer" = "yes" ] || die "not confirmed (got '$answer')"
fi

EFI=0
[ -d /sys/firmware/efi ] && EFI=1

# A disk this install is about to erase has to be RELEASED first, and a box
# being reinstalled is where that bites: the medium's udev finds the md
# superblocks left by the previous install and assembles the array before
# anybody has typed anything. A partition held by a running array is one
# sfdisk will not rewrite.
#
# Measured three times on 2026-09-13, each reading naming the next step
# (lab/install-iso.sh mirror, phase 5):
#
#   1. with nothing done about it, the FIRST write stopped:
#        Checking that no-one is using this disk right now ... FAILED
#      and the summary above it had already shown what was in the way -
#        vda3  linux_raid_member / md127
#   2. stopping the array let sfdisk through, and rewriting the table made
#      udev re-probe the partitions and assemble it AGAIN, because the md
#      superblock lives 4 KB INTO the partition and wiping a partition table
#      never touches it:
#        [   35.026739] md/raid1:md127: active with 1 out of 2 mirrors
#        mdadm: super1.x cannot open /dev/vda3: Device or resource busy
#   3. stopping and erasing the superblocks on both disks got the system disk
#      partitioned, and then the SECOND disk was refused the same way - the
#      window between the two sfdisks is long enough for udev to act in.
#
# So it is done per disk, immediately before that disk is written, and never
# once for both. Erasing the superblock is inside what the operator confirmed:
# they were shown both disks and the word was "yes".
#
# It reports what it found. A disk that will not be released is a refusal
# somebody has to diagnose from the console they are standing at, and
# "sfdisk failed" on its own sends them to the partitioner.
# 0 released something, 1 nothing holds it, 2 nobody here can be asked.
release_disk() {   # <disk>; stop and erase what would hold it open
  command -v mdadm >/dev/null 2>&1 || return 2
  [ -r /proc/mdstat ] || return 2
  _rd=$1
  _rb=$(basename "$_rd")
  for _a in $(awk -v b="$_rb" '
        $1 ~ /^md[0-9]/ {
          for (i = 3; i <= NF; i++) {
            m = $i
            # "vda3[0]" and "vda3[0](S)" both name vda3.
            sub(/\[[0-9]+\](\([A-Z]\))?$/, "", m)
            if (m == b || m ~ "^" b "p?[0-9]+$") { print $1; next }
          }
        }' /proc/mdstat); do
    say "stopping /dev/$_a, an array on $_rd, which this install erases"
    mdadm --stop "/dev/$_a" >/dev/null 2>&1 \
      || say "  (/dev/$_a would not stop)"
  done
  # The superblocks those arrays were built from, so that re-reading the
  # partition table cannot bring one back.
  for _p in $(lsblk -lnpo NAME "$_rd" 2>/dev/null); do
    mdadm --zero-superblock --force "$_p" >/dev/null 2>&1 || true
  done
  command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=30 2>/dev/null
  grep -qE "^md[0-9]+ : .*[^a-z]$_rb" /proc/mdstat 2>/dev/null
}

# Released until it STAYS released, because the release has a side effect of
# its own.
#
# Measured, fourth run of the same reinstall: with the arrays stopped and the
# superblocks erased, the second disk was still refused, and the line this
# prints said what by -
#
#   ==> the records mirror on /dev/vdb
#   [   39.270871]  vdb: vdb1
#   ==>   /dev/vdb is still held by an array:
#       md127 : inactive vdb1[1](S)
#
# Closing a writable file descriptor on a whole disk makes the kernel re-read
# its partition table, which is what mdadm does when it looks for a superblock
# to erase. udev then sees the partition appear and assembles the stale leg it
# finds on it, INACTIVE, holding the very disk the erase was meant to free.
#
# So each attempt takes away what the last one brought back, and the loop ends
# when a pass finds nothing left rather than after a fixed number of tries. If
# it never does, the console gets /proc/mdstat and the operator is looking at
# the thing that is in the way instead of at the partitioner.
release_disk_until_free() {   # <disk>
  _rdu=$1
  _n=1
  while [ "$_n" -le 4 ]; do
    release_disk "$_rdu"
    case $? in
      1) return 0 ;;
      2) # SAID, NOT ASSUMED EITHER WAY. Without mdadm or /proc/mdstat this
         # box cannot be asked whether an array holds the disk, and the
         # install goes on - there is nothing here that could stop it. What it
         # must not do is claim the disk is held, which is what four rounds of
         # this used to produce.
         say "  cannot tell whether an array holds $_rdu: this box has no"
         say "  mdadm or no /proc/mdstat. Nothing here can release one."
         return 0 ;;
    esac
    _n=$((_n + 1))
  done
  say "  $_rdu is still held by an array after 4 attempts:"
  sed 's/^/    /' /proc/mdstat >&2
  return 1
}

release_disk_until_free "$DISK" || die "$DISK is held by an array that will not release. Partitioning it
     now would write over a member of that array: stop it by hand, or
     choose another disk."

say "partitioning $DISK (UEFI=$EFI)"
# udev opens a freshly attached disk to probe it, and sfdisk wants an exclusive
# lock on the same device. Losing that race makes sfdisk WAIT - printing
# nothing, so the install looks hung rather than blocked.
#
# --lock=no and a timeout, so that if it blocks anyway the installer says so
# instead of sitting there. A partitioner that can hang silently is worse than
# one that fails: the operator has no idea whether the disk was touched.
command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=30 2>/dev/null
# Records LAST, so growing the disk later grows the partition that fills.
#
# Type "R" - Linux RAID - when the records are mirrored, so that anyone who
# opens this table with fdisk on a box whose other disk has died is told what
# the partition is before they try to mount it directly. The type does not
# drive the assembly; the metadata and mdadm.conf do.
REC_TYPE=L
[ -n "$MIRROR" ] && REC_TYPE=R
if [ "$EFI" = 1 ]; then
  LAYOUT="label: gpt
,512M,U
,$(( DISK_MB - 512 - LOG_GB * 1024 ))M,L
,,$REC_TYPE"
else
  LAYOUT="label: dos
,512M,c,*
,$(( DISK_MB - 512 - LOG_GB * 1024 ))M,L
,,$REC_TYPE"
fi
printf '%s\n' "$LAYOUT" | timeout 90 sfdisk --lock=no --wipe=always \
    "$DISK" >/tmp/sfdisk.log 2>&1
rc=$?
if [ "$rc" = 124 ]; then
  die "sfdisk timed out on $DISK after 90s (device busy?); the disk may be
  partially written - see /tmp/sfdisk.log"
fi
[ "$rc" = 0 ] || { sed 's/^/  /' /tmp/sfdisk.log >&2; die "sfdisk failed on $DISK"; }
sync
partprobe "$DISK" 2>/dev/null || true
command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=30 2>/dev/null
sleep 2

case "$DISK" in
  *nvme*|*mmcblk*) P1="${DISK}p1"; P2="${DISK}p2"; P3="${DISK}p3" ;;
  *)               P1="${DISK}1";  P2="${DISK}2";  P3="${DISK}3"  ;;
esac
[ -b "$P2" ] || die "partitioning did not produce $P2"
[ -b "$P3" ] || die "partitioning did not produce $P3 for the records"

# The records go on BOTH disks, or on the one. Everything downstream - the
# mkfs, the UUID in fstab, the verification - uses this one name, so the
# one-disk path is the same path it has always been with $P3 in it.
RECORDS_DEV=$P3
if [ -n "$MIRROR" ]; then
  say "the records mirror on $MIRROR"
  # Released here, a second time and immediately before its own write. The run
  # that only did this once got the system disk partitioned and was then
  # refused on this one: the gap between the two sfdisks is long enough for
  # udev to assemble something out of what is still on the second disk.
  release_disk_until_free "$MIRROR" || die "$MIRROR is held by an array that will not release. Partitioning it
     now would write over a member of that array: stop it by hand, or
     choose another disk."
  # One partition over the whole disk rather than a sized one. The array is as
  # big as its smallest member either way, and a whole-disk leg is what makes a
  # replacement disk of a different size usable without re-doing arithmetic
  # somebody has to remember a year later.
  printf 'label: gpt\n,,R\n' | timeout 90 sfdisk --lock=no --wipe=always \
      "$MIRROR" >/tmp/sfdisk-mirror.log 2>&1
  rc=$?
  if [ "$rc" = 124 ]; then
    die "sfdisk timed out on $MIRROR after 90s (device busy?) - see
  /tmp/sfdisk-mirror.log"
  fi
  [ "$rc" = 0 ] || { sed 's/^/  /' /tmp/sfdisk-mirror.log >&2
                     die "sfdisk failed on $MIRROR"; }
  sync
  partprobe "$MIRROR" 2>/dev/null || true
  command -v udevadm >/dev/null 2>&1 && udevadm settle --timeout=30 2>/dev/null
  sleep 2
  case "$MIRROR" in
    *nvme*|*mmcblk*) MP1="${MIRROR}p1" ;;
    *)               MP1="${MIRROR}1"  ;;
  esac
  [ -b "$MP1" ] || die "partitioning did not produce $MP1 on the mirror disk"

  # A disk that carried a mirror before still carries its superblock, and
  # mdadm would refuse to build a new array over it - or worse, a stale
  # superblock gets picked up at the next boot and assembled as an array this
  # box knows nothing about. Reinstalling a box that already had a mirror is
  # the ordinary case, not the exotic one.
  mdadm --zero-superblock --force "$P3" >/dev/null 2>&1 || true
  mdadm --zero-superblock --force "$MP1" >/dev/null 2>&1 || true

  # stdin from /dev/null deliberately. mdadm asks "Continue creating array?"
  # when it finds something it recognises on a member, and an unattended
  # install has no console to answer from: with a closed stdin that question
  # is a loud refusal instead of a machine that hangs for ever with the disk
  # half written.
  #
  # No --assume-clean. It would skip the initial resync and mark two legs
  # holding different bytes as in sync - which is a lie told to the one
  # subsystem whose whole job is to know which copy is good. The resync runs
  # in the background and the box is usable while it does.
  say "  building the mirror (it synchronises in the background)"
  mdadm --create /dev/md0 --run --level=1 --raid-devices=2 --metadata=1.2 \
        --homehost="$HOSTNAME_NEW" --name=records "$P3" "$MP1" \
        </dev/null >/tmp/mdadm.log 2>&1 \
    || { sed 's/^/  /' /tmp/mdadm.log >&2
         die "mdadm could not create the records mirror - see /tmp/mdadm.log"; }
  RECORDS_DEV=/dev/md0
fi

say "formatting"
# The filesystem labels keep the old name (#202): a label is on the disk, and
# a box in service is not reformatted by an upgrade.
mkfs.vfat -F32 "$P1" >/dev/null
mkfs.ext4 -q -F -L hexarouting "$P2" >/dev/null
mkfs.ext4 -q -F -L hexa-records "$RECORDS_DEV" >/dev/null

say "copying the system"
rm -rf "$MNT"; mkdir -p "$MNT"
mount "$P2" "$MNT" || die "cannot mount $P2"
unsquashfs -f -d "$MNT" "$SRC" >/dev/null || die "unsquashfs failed"

# An empty /boot means the squashfs was built excluding it, and everything
# after this point would still succeed: grub-install writes a bootloader,
# update-grub writes a menu with no entries, and the disk boots to a "grub>"
# prompt. Failing here says which step was wrong instead of leaving that to be
# deduced from a bootloader prompt.
[ -f "$MNT"/boot/vmlinuz-* ] 2>/dev/null || \
  die "the live filesystem was built without /boot: no kernel in
  $MNT/boot"

mkdir -p "$MNT/boot/efi"
[ "$EFI" = 1 ] && mount "$P1" "$MNT/boot/efi"

say "fstab"
ROOT_UUID=$(blkid -s UUID -o value "$P2")
EFI_UUID=$(blkid -s UUID -o value "$P1" 2>/dev/null || true)
LOG_UUID=$(blkid -s UUID -o value "$RECORDS_DEV")
{
  echo "UUID=$ROOT_UUID / ext4 errors=remount-ro 0 1"
  [ "$EFI" = 1 ] && [ -n "$EFI_UUID" ] && \
    echo "UUID=$EFI_UUID /boot/efi vfat umask=0077 0 1"
  # nofail: a box that will not boot because the RECORDS volume is missing is
  # a box that cannot be logged into to find out why. It must come up and
  # complain, which the self-test does.
  #
  # The UUID is the filesystem's, so this line is identical on a mirrored box
  # and on a one-disk box: what changed underneath is which device carries the
  # filesystem, and fstab was never told the device. nofail matters more with a
  # mirror, not less - a degraded array that the kernel starts late must not be
  # the reason a box with working records does not boot.
  echo "UUID=$LOG_UUID /var/log/hexarouting ext4 defaults,nofail 0 2"
} > "$MNT/etc/fstab"
mkdir -p "$MNT/var/log/hexarouting"

# The live system boots with live-boot and logs in with no password, which an
# installed system must not do. Leaving these behind produces a box that mounts
# a squashfs that is no longer there, and one that anyone with console access
# owns.
# The AUTOLOGIN only. 10-after-selftest.conf stays, and the two are separate
# files for exactly this reason: they used to be one, this line took the
# ordering with the autologin, and an installed box drew a login prompt while
# hexarouting.service was still waiting for VPP - so the first `configure` of
# the first session built a candidate out of vppctl's error text and refused
# every commit after it (#211). A glob here would take it again.
rm -f "$MNT/etc/systemd/system/getty@tty1.service.d/20-autologin.conf" \
      "$MNT/etc/systemd/system/serial-getty@ttyS0.service.d/20-autologin.conf" \
      2>/dev/null || true

say "identity"
echo "$HOSTNAME_NEW" > "$MNT/etc/hostname"
printf '127.0.0.1 localhost\n127.0.1.1 %s\n' "$HOSTNAME_NEW" > "$MNT/etc/hosts"
ln -sf "/usr/share/zoneinfo/$TIMEZONE" "$MNT/etc/localtime"
echo "$TIMEZONE" > "$MNT/etc/timezone"

# The management network (#303), written here because it belongs with the
# hostname: both are the answers that make this disk a particular box rather
# than a copy of the medium. Everything about WHAT is written, and why it is
# written where it is, is at write_network_config() above.
#
# A hard failure. An install that finished with no management path is found by
# somebody who drove to the site, which is the same argument the ssh host keys
# are generated under, and the box this leaves is worse: sshd with no key
# refuses a connection, and a card with no address does not answer at all.
if [ "$MGMT_IF" = none ]; then
  say "management network: none, by answer"
else
  say "management network: $MGMT_IF"
fi
write_network_config "$MNT" "$MGMT_IF" "$MGMT_ADDR" "$MGMT_GW" "$MGMT_DNS" \
  || die "could not write the management network onto the target; the box
  would boot with its card down and no address"

# A racked appliance is reached by serial console or IPMI. The live ISO gets a
# console because the boot loader is handed console=ttyS0 on the command line;
# an installed system has to configure its own, and without it the box boots
# perfectly and shows nothing - which is indistinguishable from a box that did
# not boot. That is exactly how this was first seen: GRUB said "Welcome to
# GRUB!" and the console went silent for the rest of the boot.
say "serial console"
mkdir -p "$MNT/etc/default/grub.d"
cat > "$MNT/etc/default/grub.d/hexarouting-console.cfg" <<'GRUBEOF'
# Generated by hexarouting-install. Do not edit by hand.
GRUB_TERMINAL="console serial"
GRUB_SERIAL_COMMAND="serial --unit=0 --speed=115200 --word=8 --parity=no --stop=1"
GRUB_CMDLINE_LINUX="$GRUB_CMDLINE_LINUX console=tty0 console=ttyS0,115200"
GRUBEOF

say "bootloader"
for d in dev dev/pts proc sys run; do
  mkdir -p "$MNT/$d"; mount --bind "/$d" "$MNT/$d"
done
if [ "$EFI" = 1 ]; then
  # --bootloader-id names a directory under /boot/efi/EFI and a firmware boot
  # entry, both on the disk, so it keeps the old name through the rename to
  # Prisma Routing (#202): a box already installed has that directory, and
  # nothing here runs on an upgrade.
  chroot "$MNT" grub-install --target=x86_64-efi --efi-directory=/boot/efi \
      --bootloader-id=HexaRouting --removable >/dev/null 2>&1 \
      || die "grub-install (UEFI) failed"
else
  chroot "$MNT" grub-install "$DISK" >/dev/null 2>&1 \
      || die "grub-install (BIOS) failed"
fi
chroot "$MNT" update-grub >/dev/null 2>&1 || die "update-grub failed"

# The tuning service is a no-op on a live system, deliberately: isolcpus and
# hugepages come from the kernel command line and a live system has no next
# boot to apply them on. On the installed system it must run, and its result
# takes effect on the first reboot after this install.
say "boot tuning"
chroot "$MNT" /usr/lib/hexarouting/apply-tuning >/dev/null 2>&1 || true
chroot "$MNT" update-grub >/dev/null 2>&1 || true

# ------------------------------------------------------- the records mirror
#
# The installed system has to know the array exists. mdadm assembles arrays
# whose homehost matches even with no configuration at all, and relying on
# that leaves the box's own account of its disks empty: somebody looking at a
# machine whose records volume did not mount would find nothing on it saying
# there was ever supposed to be a mirror.
#
# Written from "mdadm --detail --scan", which reports the array the kernel
# actually has rather than the one this script meant to create.
if [ -n "$MIRROR" ]; then
  say "recording the mirror in the installed system"
  mkdir -p "$MNT/etc/mdadm"
  {
    echo "# Generated by hexarouting-install. Do not edit by hand."
    echo "DEVICE partitions"
    echo "HOMEHOST <system>"
    mdadm --detail --scan "$RECORDS_DEV"
  } > "$MNT/etc/mdadm/mdadm.conf"
  # The initramfs keeps its own copy of mdadm.conf. Nothing at boot depends on
  # it here - the records are not the root filesystem, so the array is
  # assembled later, by udev, in the real root - but an initramfs whose copy
  # names no array at all is a second answer to "what disks does this box
  # have", and whoever debugs a boot will find that one first.
  chroot "$MNT" update-initramfs -u >/dev/null 2>&1 || \
    say "  (update-initramfs did not run; the boot does not depend on it)"

  # And the box has to START that array when a disk is missing, which is the
  # only time any of this matters.
  #
  # MEASURED, on 2026-09-13, by booting an installed box with the mirror disk
  # detached (lab/install-iso.sh mirror): udev assembles the array far enough
  # to claim the surviving leg and then stops, because one leg of two is not a
  # complete array -
  #
  #   md0 : inactive vda3[0](S)
  #
  # and an INACTIVE array has no device to mount. fstab says nofail, so the box
  # came up perfectly, with /var/log/hexarouting back on the ROOT filesystem
  # and a year of records being written to the very arrangement the separate
  # volume replaced. Debian's own mdadm-last-resort@.timer is supposed to cover
  # this; on that box it did not fire, and a mirror whose survivor depends on a
  # timer nobody here can see firing is not a mirror this product can promise.
  #
  # So the box runs it itself, before local-fs.target, where the mount that
  # needs it is decided.
  say "  arming the survivor: the array must start with one disk"
  cat > "$MNT/etc/systemd/system/hexarouting-records-array.service" <<'MDUNIT'
# Generated by hexarouting-install. Do not edit by hand.
[Unit]
Description=Prisma Routing: start the connection-records mirror, degraded if it must
DefaultDependencies=no
# Before the mount that needs it, and before the target that decides the
# mount: an array started after local-fs.target is an array the records volume
# was already judged without.
Before=local-fs.target var-log-hexarouting.mount
# The disks have to have been seen first. settle is heavy-handed and it is what
# there is: the alternative is racing udev for the device this exists to start.
Wants=systemd-udev-settle.service
After=systemd-udev-settle.service
ConditionPathExists=/etc/mdadm/mdadm.conf

[Service]
Type=oneshot
RemainAfterExit=yes
# Every array that has enough devices to run - which for a two-disk mirror
# with one disk left means one. It is a no-op on a healthy box, where udev has
# already started the array with both legs.
ExecStart=-/sbin/mdadm --incremental --run --scan
# What mdadm's own last-resort unit runs, for the array this box has, because
# the scan above walks arrays it has been told about and this one is named in
# mdadm.conf. Both are "-": the assertion that the records came back is the
# self-test line on the console, not the exit status of a repair.
ExecStart=-/sbin/mdadm --run /dev/md0
# The mount is by UUID, and the symlink for it is made by udev after the array
# starts. Without this the mount can be decided in the gap between the two.
ExecStartPost=-/bin/udevadm settle --timeout=30

[Install]
WantedBy=local-fs.target
MDUNIT
  chroot "$MNT" systemctl enable hexarouting-records-array.service \
    >/dev/null 2>&1 || die "could not enable the records array unit"
fi

# --------------------------------------------------------------- credentials
#
# Last, because it is the step that turns a disk into a box somebody can log
# into, and because a failure here must leave the account locked - which is
# what it inherited from the live image - rather than half-set.
#
# Through a pipe, so the password is never an argument and never appears in
# the process list.
say "root password"
printf 'root:%s\n' "$ROOTPW" | chroot "$MNT" chpasswd \
  || die "setting the root password failed; the root account on the disk
  is still locked"

# The live image masks sshd and carries no sshd policy of its own; both
# decisions belong to the installed system, so they are made here.
say "ssh"
rm -f "$MNT/etc/systemd/system/ssh.service"
chroot "$MNT" systemctl unmask ssh.service >/dev/null 2>&1 || true
chroot "$MNT" systemctl enable ssh.service >/dev/null 2>&1 || true
mkdir -p "$MNT/etc/ssh/sshd_config.d"
echo "PermitRootLogin yes" > "$MNT/etc/ssh/sshd_config.d/hexarouting.conf"

# The host keys are made HERE, per box, out of whatever the medium handed over.
#
# They used to come out of the squashfs, which meant every appliance installed
# from one release answered with one host key whose private half was in the
# published ISO - impersonation of any of them by anybody who downloaded it,
# with nothing on the operator's client to notice, since the key it pinned is
# the key it was given. build-iso.sh removes them for that reason (#245) and
# install_ssh_host_keys() refuses to inherit them for the reason recorded at
# the function (#248).
#
# A hard failure, not a warning. sshd will not start without a host key, and
# the sshd this box just enabled is the management path an operator reaches a
# racked appliance through: an install that finished with no way in over the
# network is worse than one that says so while the operator is still standing
# there with the medium in the drive.
install_ssh_host_keys "$MNT" \
  || die "could not generate ssh host keys on the target; sshd would not start"

# Before the success line, not after it, and before the medium is removed.
#
# The check runs while the target is still mounted and its partitions still
# exist, which is the only moment blkid can answer for them.
say "verifying the disk that was just written"
VERIFY_BAD=0
verify_installed "$MNT" || VERIFY_BAD=1
# And the second disk, when there is one: an array that came up with one leg
# is the failure the mirror exists to prevent, and it must not be reported as
# a finished install.
[ -n "$MIRROR" ] && { verify_mirror /proc/mdstat "$RECORDS_DEV" || VERIFY_BAD=1; }

for d in run sys proc dev/pts dev; do umount -l "$MNT/$d" 2>/dev/null || true; done
[ "$EFI" = 1 ] && umount "$MNT/boot/efi" 2>/dev/null || true
umount "$MNT" 2>/dev/null || true
sync

# An install that did not verify is NOT an install, and it must not be reported
# as one: install-from-cmdline prints its completion marker only on a zero exit,
# and the operator is told to leave the medium where it is - a box that boots to
# a "grub>" prompt with the medium already back in its box is a site visit.
if [ "$VERIFY_BAD" != 0 ]; then
  # The disk goes last. With the sentence around it this row was 84 columns on
  # an 80-column console (#367), and it is the row that tells somebody standing
  # at a machine with the medium still in the drive what to do next.
  die "the installed system did not verify - see the failed check(s) above.
  Leave the medium in place and install again. Not usable as it stands:
  $DISK"
fi

echo
say "installed on $DISK"
echo "    hostname $HOSTNAME_NEW, timezone $TIMEZONE, root password set."
# Said at the end as well as in the summary, because this is the screen the
# operator is looking at when they decide whether they can walk away from the
# machine - and on a DHCP answer it is also the sentence that tells them where
# the address will be printed, which is the console they are about to leave.
if [ "$MGMT_IF" = none ]; then
  echo "    No management network was asked for: this box is reached at its"
  echo "    console, and the boot self-test says so at every boot."
elif [ "$MGMT_ADDR" = dhcp ]; then
  echo "    Managed on $MGMT_IF by DHCP. The address it is given is printed"
  echo "    by the boot self-test, on this console, at every boot."
else
  echo "    Managed on $MGMT_IF at $MGMT_ADDR${MGMT_GW:+ via $MGMT_GW}."
fi
if [ -n "$MIRROR" ]; then
  echo "    The connection records are on $DISK and $MIRROR. The mirror may"
  echo "    still be synchronising; it survives the reboot and finishes on its"
  echo "    own, and the boot self-test says so on every boot from now on."
fi
echo "    The first boot applies isolcpus and hugepages, so the box is fully"
echo "    tuned from the second boot on."

if [ "${HEXA_INSTALL_NO_REBOOT:-0}" = 1 ]; then
  exit 0
fi

echo
echo "    REMOVE THE INSTALLATION MEDIUM, then this machine will reboot."
if [ "$ASSUME_YES" != 1 ]; then
  printf "Press Enter to reboot: "
  read -r _ || true
fi
sync
systemctl reboot --no-block 2>/dev/null || reboot -f 2>/dev/null || true
exit 0
