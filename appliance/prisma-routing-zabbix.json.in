            "name": "Notification: bfdSessDown",
            "type": "SNMP_TRAP",
            "key": "snmptrap[\"bfdSessDown|1\\.3\\.6\\.1\\.2\\.1\\.222\\.0\\.2\\b\"]",
            "history": "31d",
            "trends": "0",
            "value_type": "LOG",
            "description": "Received through Zabbix's SNMP trap receiver; the box sends it to every `snmp trap-host`.",
            "tags": [
              {
