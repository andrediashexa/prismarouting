                    "tag": "component",
                    "value": "optics"
                  },
                  {
                    "tag": "interface",
                    "value": "{#XCVRNAME}"
                  }
                ]
              },
              {
                "uuid": "800241b0a6a74f45b4c0e6ef981bc8d9",
                "name": "Transceiver {#XCVRNAME}: temperature high warning",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.20.1.1.10.{#SNMPINDEX}",
                "key": "prisma.xcvr.temp.hwarn[{#SNMPINDEX}]",
                "delay": "1h",
                "history": "7d",
                "value_type": "FLOAT",
                "units": "°C",
                "description": "The module's own threshold; absent when it carries none.",
                "preprocessing": [
                  {
                    "type": "MULTIPLIER",
                    "parameters": [
                      "0.01"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "optics"
                  },
                  {
                    "tag": "interface",
                    "value": "{#XCVRNAME}"
                  }
                ]
              },
              {
                "uuid": "8aa11ab66f534a129cf3135e267baefd",
                "name": "Transceiver {#XCVRNAME}: threshold state",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.20.1.1.18.{#SNMPINDEX}",
                "key": "prisma.xcvr.state[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "description": "The worst level any reading of the module stands at against its own thresholds.",
                "valuemap": {
                  "name": "PRISMA-ROUTING-MIB::prXcvrState"
                },
                "tags": [
                  {
                    "tag": "component",
                    "value": "optics"
                  },
                  {
                    "tag": "interface",
                    "value": "{#XCVRNAME}"
                  }
                ]
              }
            ],
            "trigger_prototypes": [
              {
                "uuid": "8ee9c7beb1134b2489968101e2a67ebe",
                "expression": "{$PRISMA.XCVR.CONTROL:\"{#XCVRNAME}\"}=1 and (last(/Prisma Routing by SNMP/prisma.xcvr.temp[{#SNMPINDEX}])>{$PRISMA.XCVR.TEMP.MAX:\"{#XCVRNAME}\"} or last(/Prisma Routing by SNMP/prisma.xcvr.temp[{#SNMPINDEX}])>last(/Prisma Routing by SNMP/prisma.xcvr.temp.hwarn[{#SNMPINDEX}]))",
                "name": "Prisma Routing: transceiver {#XCVRNAME} temperature is high",
                "priority": "WARNING",
                "description": "Above {$PRISMA.XCVR.TEMP.MAX:\"{#XCVRNAME}\"} C or the module's own high warning: airflow, or a module failing.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "performance"
                  }
                ]
              },
              {
                "uuid": "e3de8825874349c990d44d6f7f239b78",
                "expression": "{$PRISMA.XCVR.CONTROL:\"{#XCVRNAME}\"}=1 and last(/Prisma Routing by SNMP/prisma.xcvr.state[{#SNMPINDEX}])=3",
                "name": "Prisma Routing: transceiver {#XCVRNAME} has a reading past its alarm threshold",
                "priority": "HIGH",
                "description": "A temperature, voltage, bias, TX or RX power past the module's own alarm level: 'show interface {#XCVRNAME} transceiver' says which.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
