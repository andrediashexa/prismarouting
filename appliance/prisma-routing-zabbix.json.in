                  },
                  {
                    "tag": "interface",
                    "value": "{#XCVRNAME}"
                  }
                ]
              },
              {
                "uuid": "658675f823bd4bee9eb61d599f588ca5",
                "name": "Transceiver {#XCVRNAME}: serial number",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.20.1.1.6.{#SNMPINDEX}",
                "key": "prisma.xcvr.serial[{#SNMPINDEX}]",
                "delay": "1h",
                "history": "7d",
                "trends": "0",
                "value_type": "CHAR",
                "description": "A new value is a module swapped in the cage.",
                "preprocessing": [
                  {
                    "type": "DISCARD_UNCHANGED_HEARTBEAT",
                    "parameters": [
                      "1d"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "optics"
                  },
                  {
                    "tag": "interface",
                    "value": "{#XCVRNAME}"
                  }
                ]
              },
              {
                "uuid": "90843967e6614b3a84849bfa40ada9fe",
                "name": "Transceiver {#XCVRNAME}: temperature",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.20.1.1.8.{#SNMPINDEX}",
                "key": "prisma.xcvr.temp[{#SNMPINDEX}]",
                "delay": "1m",
