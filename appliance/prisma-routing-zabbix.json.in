                "value": "notification"
              }
            ],
            "triggers": [
              {
                "uuid": "5cf4c1accc0c4390b228c45f7d64d1da",
                "expression": "nodata(/Prisma Routing by SNMP/snmptrap[\"bfdSessDown|1\\.3\\.6\\.1\\.2\\.1\\.222\\.0\\.2\\b\"],{$PRISMA.BFD.TRAP.HOLD})=0",
                "name": "Prisma Routing: a BFD session went down (bfdSessDown)",
                "priority": "HIGH",
                "description": "A neighbour stopped answering BFD, or said its session was down. The notification carries bfdSessDiag.<bfdSessIndex>: the session's row in bfdSessTable and its diagnostic (1 is the detection time expiring, 3 the neighbour saying down). Whether it came back is bfdSessUp's latest value, and `show bfd peers` on the box.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "de819952e56f4f159dcd755a68c13219",
