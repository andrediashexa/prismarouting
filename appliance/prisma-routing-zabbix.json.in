          {
            "uuid": "e22388bfb9c84e629f88a46dfd2a510a",
            "name": "IS-IS adjacency discovery",
            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#ISISSYSID},1.3.6.1.2.1.138.1.6.1.1.6]",
            "key": "isis.adj.discovery",
            "delay": "1h",
            "item_prototypes": [
              {
                "uuid": "c5788479ea624e2b9fdff7acaeb3e1cd",
                "name": "IS-IS adjacency {#SNMPINDEX}: state",
