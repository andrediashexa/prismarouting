                "expression": "{$PRISMA.XCVR.CONTROL:\"{#XCVRLANE}\"}=1 and (last(/Prisma Routing by SNMP/prisma.xcvr.lane.rx.level[{#SNMPINDEX}])=3 or last(/Prisma Routing by SNMP/prisma.xcvr.lane.rx.level[{#SNMPINDEX}])=5 or last(/Prisma Routing by SNMP/prisma.xcvr.lane.rx[{#SNMPINDEX}])<{$PRISMA.XCVR.RX.MIN:\"{#XCVRLANE}\"})",
