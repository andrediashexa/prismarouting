        "discovery_rules": [
          {
            "uuid": "e2b19a1e9dc54b50a202f6258127c521",
            "name": "CPU discovery",
            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#SNMPVALUE},1.3.6.1.2.1.25.3.3.1.2]",
            "key": "system.cpu.discovery",
            "delay": "1h",
            "description": "hrProcessorLoad per core. No trigger: the dataplane's worker cores poll at 100% by design.",
            "item_prototypes": [
              {
                "uuid": "97dae919286a4a82b555f7d2f4e6ba5c",
                "name": "CPU {#SNMPINDEX}: utilisation",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.25.3.3.1.2.{#SNMPINDEX}",
                "key": "system.cpu.util[hrProcessorLoad.{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "units": "%",
                "tags": [
                  {
                    "tag": "component",
                    "value": "cpu"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "f38c81e009c346f0a2e2c5180cb70de8",
            "name": "Disk discovery",
            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#DSKPATH},1.3.6.1.4.1.2021.9.1.2]",
            "key": "vfs.fs.discovery",
            "delay": "1h",
            "item_prototypes": [
              {
                "uuid": "849528108c934671850c9fc39c89c4ae",
                "name": "{#DSKPATH}: space used",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.2021.9.1.9.{#SNMPINDEX}",
                "key": "vfs.fs.pused[dskPercent.{#SNMPINDEX}]",
                "delay": "5m",
                "history": "7d",
                "value_type": "FLOAT",
                "units": "%",
                "tags": [
                  {
                    "tag": "component",
                    "value": "storage"
                  },
                  {
                    "tag": "filesystem",
                    "value": "{#DSKPATH}"
                  }
                ]
              },
              {
                "uuid": "9fb6a155db5841f5918ad37a98bd6e10",
                "name": "{#DSKPATH}: below its minimum free",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.2021.9.1.100.{#SNMPINDEX}",
                "key": "vfs.fs.error[dskErrorFlag.{#SNMPINDEX}]",
                "delay": "5m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "valuemap": {
                  "name": "UCD-SNMP-MIB::UCDErrorFlag"
                },
                "tags": [
                  {
                    "tag": "component",
                    "value": "storage"
                  },
                  {
                    "tag": "filesystem",
                    "value": "{#DSKPATH}"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "uuid": "62c698380c7e4d1585d490a8b26fbcda",
                    "expression": "last(/Prisma Routing by SNMP/vfs.fs.error[dskErrorFlag.{#SNMPINDEX}])=1",
                    "name": "Prisma Routing: {#DSKPATH} is below its minimum free space",
                    "priority": "AVERAGE",
                    "description": "On /var/log/prisma-routing this is the retention log's filesystem filling.",
                    "tags": [
                      {
                        "tag": "scope",
                        "value": "capacity"
                      }
                    ]
                  }
                ]
              }
            ]
          },
          {
            "uuid": "45773e3b8e1c464bb34cb1d9211de5a7",
            "name": "Network interfaces discovery",
            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#IFNAME},1.3.6.1.2.1.31.1.1.1.1,{#IFALIAS},1.3.6.1.2.1.31.1.1.1.18]",
            "key": "net.if.discovery",
            "delay": "1h",
            "filter": {
              "evaltype": "AND",
              "conditions": [
                {
                  "macro": "{#IFNAME}",
                  "value": "{$NET.IF.IFNAME.MATCHES}",
                  "formulaid": "A"
                },
                {
                  "macro": "{#IFNAME}",
                  "value": "{$NET.IF.IFNAME.NOT_MATCHES}",
                  "formulaid": "B",
                  "operator": "NOT_MATCHES_REGEX"
                }
              ]
            },
            "description": "The dataplane's cards, under the ifIndex the agent keeps for each for good (#498).",
            "item_prototypes": [
              {
                "uuid": "fd27b2f1d9e64671915e4ef0e8f63d9b",
                "name": "Interface {#IFNAME}({#IFALIAS}): bits received",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.31.1.1.1.6.{#SNMPINDEX}",
                "key": "net.if.in[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "units": "bps",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  },
                  {
                    "type": "MULTIPLIER",
                    "parameters": [
                      "8"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "e175cc6df554417d806f82f2b7e3f41c",
                "name": "Interface {#IFNAME}({#IFALIAS}): bits sent",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.31.1.1.1.10.{#SNMPINDEX}",
                "key": "net.if.out[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "units": "bps",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  },
                  {
                    "type": "MULTIPLIER",
                    "parameters": [
                      "8"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "1b4ee60a2e6342e6a2840c59794b6231",
                "name": "Interface {#IFNAME}({#IFALIAS}): inbound errors",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.2.2.1.14.{#SNMPINDEX}",
                "key": "net.if.in.errors[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "1a065d1fcdaa422081fc22732b7a17f8",
                "name": "Interface {#IFNAME}({#IFALIAS}): outbound errors",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.2.2.1.20.{#SNMPINDEX}",
                "key": "net.if.out.errors[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "11a05af1128c4e559fb3da10737a7d7c",
                "name": "Interface {#IFNAME}({#IFALIAS}): inbound discards",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.2.2.1.13.{#SNMPINDEX}",
                "key": "net.if.in.discards[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "91f7a517aef94874bffb77c90e1e0832",
                "name": "Interface {#IFNAME}({#IFALIAS}): outbound discards",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.2.2.1.19.{#SNMPINDEX}",
                "key": "net.if.out.discards[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "23e6e3e95642418ab6c11aed3fbac31f",
                "name": "Interface {#IFNAME}({#IFALIAS}): operational status",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.2.2.1.8.{#SNMPINDEX}",
                "key": "net.if.status[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "valuemap": {
                  "name": "IF-MIB::ifOperStatus"
                },
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "228875ba645b4ecc9766e0e936037b7b",
                "name": "Interface {#IFNAME}({#IFALIAS}): administrative status",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.2.2.1.7.{#SNMPINDEX}",
                "key": "net.if.adminstatus[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "description": "Polled as often as the operational status: a slower poll raised 'link down' for an interface an operator had just shut, with the old 'up' still stored.",
                "valuemap": {
                  "name": "IF-MIB::ifAdminStatus"
                },
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              },
              {
                "uuid": "534c2f8889ce4e6ba23fe0084220aa8d",
                "name": "Interface {#IFNAME}({#IFALIAS}): speed",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.31.1.1.1.15.{#SNMPINDEX}",
                "key": "net.if.speed[{#SNMPINDEX}]",
                "delay": "5m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "units": "bps",
                "preprocessing": [
                  {
                    "type": "MULTIPLIER",
                    "parameters": [
                      "1000000"
                    ]
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "network"
                  },
                  {
                    "tag": "interface",
                    "value": "{#IFNAME}"
                  }
                ]
              }
            ],
            "trigger_prototypes": [
              {
                "uuid": "bb1c20d66e124dc8a0c4a5d760c70022",
                "expression": "{$IFCONTROL:\"{#IFNAME}\"}=1 and last(/Prisma Routing by SNMP/net.if.adminstatus[{#SNMPINDEX}])=1 and last(/Prisma Routing by SNMP/net.if.status[{#SNMPINDEX}])=2",
                "name": "Prisma Routing: interface {#IFNAME}({#IFALIAS}) is down",
                "priority": "AVERAGE",
                "description": "Administratively up and operationally down. {$IFCONTROL:\"<ifName>\"}=0 silences one.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              },
              {
                "uuid": "92bc0bb1f35641a19bee8532ebf68202",
                "expression": "(avg(/Prisma Routing by SNMP/net.if.in[{#SNMPINDEX}],15m)>({$IF.UTIL.MAX:\"{#IFNAME}\"}/100)*last(/Prisma Routing by SNMP/net.if.speed[{#SNMPINDEX}]) or avg(/Prisma Routing by SNMP/net.if.out[{#SNMPINDEX}],15m)>({$IF.UTIL.MAX:\"{#IFNAME}\"}/100)*last(/Prisma Routing by SNMP/net.if.speed[{#SNMPINDEX}])) and last(/Prisma Routing by SNMP/net.if.speed[{#SNMPINDEX}])>0",
                "name": "Prisma Routing: interface {#IFNAME}({#IFALIAS}) above {$IF.UTIL.MAX:\"{#IFNAME}\"}% of its speed",
                "priority": "WARNING",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "performance"
                  }
                ]
              },
              {
                "uuid": "0e66b965b3f24f70bbecb810054818c6",
                "expression": "min(/Prisma Routing by SNMP/net.if.in.errors[{#SNMPINDEX}],5m)>{$IF.ERRORS.WARN:\"{#IFNAME}\"} or min(/Prisma Routing by SNMP/net.if.out.errors[{#SNMPINDEX}],5m)>{$IF.ERRORS.WARN:\"{#IFNAME}\"}",
                "name": "Prisma Routing: interface {#IFNAME}({#IFALIAS}) has errors",
                "priority": "WARNING",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "performance"
                  }
                ]
              }
            ]
          },
