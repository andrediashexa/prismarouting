{
  "zabbix_export": {
    "version": "7.0",
    "template_groups": [
      {
        "uuid": "f8470bfd58514254ae8724eabb9c0310",
        "name": "Templates/Network devices"
      }
    ],
    "templates": [
      {
        "uuid": "aff0644b6b8a45d88c9d1e8534efef44",
        "template": "Prisma Routing by SNMP",
        "name": "Prisma Routing by SNMP",
        "description": "Prisma Routing (#514): the dataplane's interfaces, the CGNAT, the connection records, HA, LACP, BGP, OSPF and IS-IS, over SNMP v2c or v3 (v1 is refused). Print it with the box's enterprise number filled in: `show snmp zabbix-template`.",
        "vendor": {
          "name": "Prisma Routing",
          "version": "0.146"
        },
        "groups": [
          {
            "name": "Templates/Network devices"
          }
        ],
        "items": [
          {
            "uuid": "49ea21d23e70467797f61f24d52be0ff",
            "name": "SNMP agent availability",
            "type": "INTERNAL",
            "key": "zabbix[host,snmp,available]",
            "delay": "1m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "valuemap": {
              "name": "Zabbix::SNMP availability"
            },
            "tags": [
              {
                "tag": "component",
                "value": "health"
              }
            ],
            "triggers": [
              {
                "uuid": "49f6e57c67404b87b16c13b3f161fe1f",
                "expression": "max(/Prisma Routing by SNMP/zabbix[host,snmp,available],{$SNMP.TIMEOUT})=0",
                "name": "Prisma Routing: no SNMP data collection",
                "priority": "WARNING",
                "description": "The box has not answered SNMP for {$SNMP.TIMEOUT}: down, unreachable, or snmpd stopped (`snmp enabled`).",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "70a7f21ecbf540b4b3ff20ccddc50b18",
            "name": "System name",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.2.1.1.5.0",
            "key": "system.name",
            "delay": "15m",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ]
          },
          {
            "uuid": "ad1b1ab7140342edbbf5d35ce65e26a8",
            "name": "System description",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.2.1.1.1.0",
            "key": "system.descr",
            "delay": "15m",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ]
          },
          {
            "uuid": "c89a66dbd7654e2a80d7e182e1f0a892",
            "name": "Uptime",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.2.1.25.1.1.0",
            "key": "system.hw.uptime",
            "delay": "5m",
            "history": "7d",
            "value_type": "FLOAT",
            "units": "uptime",
            "preprocessing": [
              {
                "type": "MULTIPLIER",
                "parameters": [
                  "0.01"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ],
            "triggers": [
              {
                "uuid": "3fe4991df7814f2f9833eccad89345ff",
                "expression": "last(/Prisma Routing by SNMP/system.hw.uptime)<10m",
                "name": "Prisma Routing: the box has been restarted (uptime < 10m)",
                "priority": "WARNING",
                "description": "hrSystemUptime: the host, not the SNMP daemon.",
                "manual_close": "YES",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "notice"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "bb094efa0cd44aa596a33e4265be5bfa",
            "name": "Load average (1m)",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.2021.10.1.3.1",
            "key": "system.cpu.load.avg1",
            "delay": "1m",
            "history": "7d",
            "value_type": "FLOAT",
            "tags": [
              {
                "tag": "component",
                "value": "cpu"
              }
            ]
          },
          {
            "uuid": "d12598516318417293d7b05d6e94e31f",
            "name": "Memory: total",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.2021.4.5.0",
            "key": "vm.memory.total",
            "delay": "15m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "units": "B",
            "preprocessing": [
              {
                "type": "MULTIPLIER",
                "parameters": [
                  "1024"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ]
          },
          {
            "uuid": "b633850da0f24dd09b4a4fb26102c392",
            "name": "Memory: available",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.2021.4.6.0",
            "key": "vm.memory.avail",
            "delay": "1m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "units": "B",
            "preprocessing": [
              {
                "type": "MULTIPLIER",
                "parameters": [
                  "1024"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ]
          },
          {
            "uuid": "7b96bc17cf8e483da26289ae46dba2c9",
            "name": "Memory: buffers",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.2021.4.14.0",
            "key": "vm.memory.buffers",
            "delay": "1m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "units": "B",
            "preprocessing": [
              {
                "type": "MULTIPLIER",
                "parameters": [
                  "1024"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ]
          },
          {
            "uuid": "d0553ecd4905448c97604e863280d676",
            "name": "Memory: cached",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.2021.4.15.0",
            "key": "vm.memory.cached",
            "delay": "1m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "units": "B",
            "preprocessing": [
              {
                "type": "MULTIPLIER",
                "parameters": [
                  "1024"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ]
          },
          {
            "uuid": "00cb7dd7d8884cce86c6ce11c42b7bdf",
            "name": "Memory utilisation",
            "type": "CALCULATED",
            "key": "vm.memory.util",
            "delay": "1m",
            "history": "7d",
            "value_type": "FLOAT",
            "units": "%",
            "params": "100*(last(//vm.memory.total)-last(//vm.memory.avail)-last(//vm.memory.buffers)-last(//vm.memory.cached))/last(//vm.memory.total)",
            "description": "The control plane's RAM: the dataplane's hugepages are reserved at boot and count as used.",
            "tags": [
              {
                "tag": "component",
                "value": "memory"
              }
            ],
            "triggers": [
              {
                "uuid": "3666ca2471d2450698578f9a24554f5b",
                "expression": "min(/Prisma Routing by SNMP/vm.memory.util,5m)>{$MEMORY.UTIL.MAX}",
                "name": "Prisma Routing: high memory utilisation (>{$MEMORY.UTIL.MAX}% for 5m)",
                "priority": "AVERAGE",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "capacity"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "ea2db408d13e41d888507b04df560239",
            "name": "FIB: routes (IPv4 and IPv6)",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.2.1.4.24.6.0",
            "key": "fib.routes",
            "delay": "1m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "description": "inetCidrRouteNumber, IPv4 and IPv6: the size of the table, not the table. ipCidrRouteNumber is left out: the box's net-snmp answers it with noSuchObject.",
            "tags": [
              {
                "tag": "component",
                "value": "routing"
              }
            ],
            "triggers": [
              {
                "uuid": "3bec724e1fed46ff8c4b96a999aff5d4",
                "expression": "last(/Prisma Routing by SNMP/fib.routes)<{$PRISMA.FIB.DROP.PCT}/100*max(/Prisma Routing by SNMP/fib.routes,1h) and max(/Prisma Routing by SNMP/fib.routes,1h)>{$PRISMA.FIB.MIN}",
                "name": "Prisma Routing: the FIB fell below {$PRISMA.FIB.DROP.PCT}% of its size in the last hour",
                "priority": "AVERAGE",
                "description": "A session that dropped took its routes with it.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "33027abfeaa94790b596d209218724a2",
            "name": "Release installed",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.12.1.0",
            "key": "prisma.release",
            "delay": "1h",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ]
          },
          {
            "uuid": "b245da9f2f184574ba910bea4b35efb3",
            "name": "Dataplane build running",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.12.2.0",
            "key": "prisma.dataplane.build",
            "delay": "1h",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ]
          },
          {
            "uuid": "c9a16eafa643498c9fe36decf127db68",
            "name": "Dataplane running the release installed",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.12.3.0",
            "key": "prisma.dataplane.current",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "valuemap": {
              "name": "SNMPv2-TC::TruthValue"
            },
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ],
            "triggers": [
              {
                "uuid": "ca449162791b40369476c8add3c1859c",
                "expression": "last(/Prisma Routing by SNMP/prisma.dataplane.current)=2",
                "name": "Prisma Routing: the dataplane is running the old build (reboot pending)",
                "priority": "WARNING",
                "description": "An upgrade waits for a reboot: the box forwards with the old build and refuses a commit that needs the new one.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "notice"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "f3f052273c0245868e1531ac062a5d7e",
            "name": "Dataplane uptime",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.12.4.0",
            "key": "prisma.dataplane.uptime",
            "delay": "5m",
            "history": "7d",
            "value_type": "FLOAT",
            "units": "uptime",
            "description": "prSystemDataplaneUptime: VPP's own clock (#534).",
            "preprocessing": [
              {
                "type": "MULTIPLIER",
                "parameters": [
                  "0.01"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "system"
              }
            ],
            "triggers": [
              {
                "uuid": "34877b4ed9a74aa68bf5c20a0423467d",
                "expression": "last(/Prisma Routing by SNMP/prisma.dataplane.uptime)<10m and last(/Prisma Routing by SNMP/system.hw.uptime)>15m",
                "name": "Prisma Routing: the dataplane restarted without the box",
                "priority": "AVERAGE",
                "description": "VPP's clock is younger than the box's: the dataplane restarted on its own (a crash, a restart of its service, a tuning change). Every session on the box was lost with it.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "e2ac203eca44417c8c90adb057b77b0c",
            "name": "Tuning: state",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.1.0",
            "key": "prisma.tuning.state",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "valuemap": {
              "name": "PRISMA-ROUTING-MIB::prTuningState"
            },
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ],
            "triggers": [
              {
                "uuid": "51f88c67973d41638932b23482e0fa35",
                "expression": "last(/Prisma Routing by SNMP/prisma.tuning.state)<>1",
                "name": "Prisma Routing: the tuning waits for a reboot",
                "priority": "WARNING",
                "description": "Between two plans the dataplane runs the workers the kernel isolates now, fewer than planned; on a first boot it runs the conservative configuration. A reboot applies the plan.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "notice"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "7afa71dfafee496a95e3124aeacf51f4",
            "name": "Tuning: workers this boot",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.2.0",
            "key": "prisma.tuning.workers",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ]
          },
          {
            "uuid": "6201aca3bfbe4aec83fd39771520db43",
            "name": "Tuning: workers the next boot",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.3.0",
            "key": "prisma.tuning.workers.next",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ]
          },
          {
            "uuid": "ec4a6e96f02d481485d3eeabfc28b0bd",
            "name": "Tuning: CPUs isolated",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.4.0",
            "key": "prisma.tuning.isolated",
            "delay": "1h",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ]
          },
          {
            "uuid": "aad8d79f3e264b30aafe5942d7f43ac7",
            "name": "Tuning: CPUs asked to isolate",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.5.0",
            "key": "prisma.tuning.isolated.wanted",
            "delay": "1h",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ]
          },
          {
            "uuid": "c1c70dc5903449b68661d7e7eca0d81d",
            "name": "Tuning: hugepages held",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.6.0",
            "key": "prisma.tuning.hugepages",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ],
            "triggers": [
              {
                "uuid": "48951f651e214339be7b57d110e97234",
                "expression": "last(/Prisma Routing by SNMP/prisma.tuning.hugepages)<last(/Prisma Routing by SNMP/prisma.tuning.hugepages.wanted)",
                "name": "Prisma Routing: the kernel holds fewer hugepages than the tuner asked for",
                "priority": "WARNING",
                "description": "The dataplane's memory is smaller than planned: the kernel could not reserve them, or this boot came before the request.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "capacity"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "81d354637bb546bf96f3c6380036318f",
            "name": "Tuning: hugepages asked for",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.16.7.0",
            "key": "prisma.tuning.hugepages.wanted",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "tuning"
              }
            ]
          },
          {
            "uuid": "3ef9793e808f47d1abecda8b9e2cabbb",
            "name": "Self-test: verdict",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.17.1.0",
            "key": "prisma.selftest.verdict",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "valuemap": {
              "name": "PRISMA-ROUTING-MIB::prSelfTestVerdict"
            },
            "tags": [
              {
                "tag": "component",
                "value": "selftest"
              }
            ],
            "triggers": [
              {
                "uuid": "2d9d26fd752841f1afc83820e300850c",
                "expression": "last(/Prisma Routing by SNMP/prisma.selftest.verdict)=4",
                "name": "Prisma Routing: the boot self-test failed",
                "priority": "HIGH",
                "description": "The boot's console says which checks failed, with the reason beside each.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              },
              {
                "uuid": "2c7135fdbfe94732ac0903a87c3fb271",
                "expression": "last(/Prisma Routing by SNMP/prisma.selftest.verdict)=3",
                "name": "Prisma Routing: installed and healthy, with nothing to forward on",
                "priority": "INFO",
                "description": "No interface to forward on yet: the step a racked box has left.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "notice"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "5b6071f0c44642c79c571bb0304e1acc",
            "name": "Self-test: checks failed",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.17.2.0",
            "key": "prisma.selftest.failures",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "selftest"
              }
            ]
          },
          {
            "uuid": "87f02170f89748ebadfd9210e9a95cc0",
            "name": "Self-test: warnings",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.17.3.0",
            "key": "prisma.selftest.warnings",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "selftest"
              }
            ]
          },
          {
            "uuid": "8c7b41bf1c254641b0b91ba942b56cd1",
            "name": "Self-test: ran at",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.17.4.0",
            "key": "prisma.selftest.ranat",
            "delay": "15m",
            "history": "7d",
            "trends": "0",
            "value_type": "CHAR",
            "preprocessing": [
              {
                "type": "DISCARD_UNCHANGED_HEARTBEAT",
                "parameters": [
                  "1d"
                ]
              }
            ],
            "tags": [
              {
                "tag": "component",
                "value": "selftest"
              }
            ]
          },
          {
            "uuid": "82fbfb53caff4700a47096082a4f222d",
            "name": "Configuration: changes applied since boot",
            "type": "SNMP_AGENT",
            "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.18.1.0",
            "key": "prisma.config.commits",
            "delay": "5m",
            "history": "7d",
            "value_type": "UNSIGNED",
            "tags": [
              {
                "tag": "component",
                "value": "configuration"
              }
            ]
          },
          {
