                "tags": [
                  {
                    "tag": "component",
                    "value": "lacp"
                  }
                ]
              },
              {
                "uuid": "3690c22275084b58bb616dbc6c14c850",
                "name": "Bundle {#BUNDLE}: members carrying traffic",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.14.1.1.5.{#SNMPINDEX}",
                "key": "prisma.bundle.active[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "tags": [
                  {
                    "tag": "component",
                    "value": "lacp"
                  }
                ]
              }
            ],
            "trigger_prototypes": [
              {
                "uuid": "798e4ee553884b5ebc6b7effbff18180",
                "expression": "last(/Prisma Routing by SNMP/prisma.bundle.active[{#SNMPINDEX}])=0 and last(/Prisma Routing by SNMP/prisma.bundle.members[{#SNMPINDEX}])>0",
                "name": "Prisma Routing: bundle {#BUNDLE} has no member carrying traffic",
                "priority": "HIGH",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              },
              {
                "uuid": "82f831c0ce5e4b8495a4747373004326",
                "expression": "last(/Prisma Routing by SNMP/prisma.bundle.active[{#SNMPINDEX}])<last(/Prisma Routing by SNMP/prisma.bundle.members[{#SNMPINDEX}])",
                "name": "Prisma Routing: bundle {#BUNDLE} running on fewer members than it has",
                "priority": "AVERAGE",
                "description": "Up in IF-MIB and at a fraction of its capacity.",
                "dependencies": [
                  {
                    "name": "Prisma Routing: bundle {#BUNDLE} has no member carrying traffic",
                    "expression": "last(/Prisma Routing by SNMP/prisma.bundle.active[{#SNMPINDEX}])=0 and last(/Prisma Routing by SNMP/prisma.bundle.members[{#SNMPINDEX}])>0"
                  }
                ],
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "fb10171fd6784d9a8ea468d50f40ff06",
            "name": "Transceiver discovery",
            "type": "SNMP_AGENT",
