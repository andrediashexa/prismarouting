                "value_type": "UNSIGNED",
                "tags": [
                  {
                    "tag": "component",
                    "value": "ha"
                  }
                ]
              },
              {
                "uuid": "79c793fcfc90482d889a79f2864d9765",
                "name": "VRRP {#VRRPIF} VRID {#VRID}: state",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.13.1.1.5.{#SNMPINDEX}",
                "key": "prisma.vrrp.state[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "valuemap": {
                  "name": "PRISMA-ROUTING-MIB::prVrrpState"
                },
