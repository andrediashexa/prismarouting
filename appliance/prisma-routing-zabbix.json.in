            "key": "prisma.xcvr.discovery",
            "delay": "1h",
            "description": "PRISMA-ROUTING-MIB's prXcvrTable (#590): a row per port with a cage, under its IF-MIB ifIndex.",
            "item_prototypes": [
              {
                "uuid": "6a488c10f5694b6f86953db9b8008325",
                "name": "Transceiver {#XCVRNAME}: status",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.20.1.1.3.{#SNMPINDEX}",
                "key": "prisma.xcvr.status[{#SNMPINDEX}]",
                "delay": "5m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "valuemap": {
                  "name": "PRISMA-ROUTING-MIB::prXcvrStatus"
                },
                "tags": [
                  {
