                "tags": [
                  {
                    "tag": "component",
                    "value": "logging"
                  }
                ]
              },
              {
                "uuid": "88c81db20d1e4d57a830c803afa62cda",
                "name": "Records transport {#TRANSPORT}: dropped per second",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.11.10.1.8.{#SNMPINDEX}",
                "key": "prisma.log.transport.dropped.rate[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "units": "rps",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "logging"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "uuid": "bcb14dfa65e44a6cb3662ea0d4fc5dde",
                    "expression": "last(/Prisma Routing by SNMP/prisma.log.transport.dropped.rate[{#SNMPINDEX}])>0",
                    "name": "Prisma Routing: {#TRANSPORT} connection records are being lost",
                    "priority": "HIGH",
                    "description": "A gap in the compliance log.",
                    "tags": [
                      {
                        "tag": "scope",
                        "value": "compliance"
                      }
                    ]
                  }
                ]
              }
            ],
            "trigger_prototypes": [
              {
                "uuid": "8efe9080e494459aad0cc97e1a19d905",
                "expression": "last(/Prisma Routing by SNMP/prisma.log.transport.enabled[{#SNMPINDEX}])=1 and min(/Prisma Routing by SNMP/prisma.log.transport.connected[{#SNMPINDEX}],5m)=2",
                "name": "Prisma Routing: {#TRANSPORT} records transport disconnected for 5m",
                "priority": "AVERAGE",
                "description": "The records go to the spill file until the collector is back.",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "compliance"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "aa18955572214e3a965602e0c4fc896a",
