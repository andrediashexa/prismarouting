            "item_prototypes": [
              {
                "uuid": "b6d8bc56975849d6801b1173d8986ce9",
                "name": "VRRP {#VRRPIF} VRID {#VRID}: priority advertised",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.13.1.1.4.{#SNMPINDEX}",
                "key": "prisma.vrrp.priority[{#SNMPINDEX}]",
                "delay": "1m",
