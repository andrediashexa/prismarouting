                      }
                    ]
                  },
                  {
                    "uuid": "d7a8754356f54d5cbb7bed34c9ca3aab",
                    "expression": "last(/Prisma Routing by SNMP/prisma.vrrp.state[{#SNMPINDEX}])=4",
                    "name": "Prisma Routing: VRRP {#VRRPIF} VRID {#VRID}: its interface is down",
                    "priority": "AVERAGE",
                    "tags": [
                      {
                        "tag": "scope",
