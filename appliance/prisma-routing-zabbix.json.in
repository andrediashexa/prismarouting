                  {
                    "tag": "component",
                    "value": "ha"
                  }
                ],
                "trigger_prototypes": [
                  {
                    "uuid": "f2de27de6bee4da6a974243291cbd155",
                    "expression": "change(/Prisma Routing by SNMP/prisma.vrrp.state[{#SNMPINDEX}])<>0",
                    "name": "Prisma Routing: VRRP {#VRRPIF} VRID {#VRID} changed state to {ITEM.VALUE}",
                    "priority": "WARNING",
