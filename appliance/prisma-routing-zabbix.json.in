            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#VRRPIF},1.3.6.1.4.1.{$PRISMA.PEN}.1.13.1.1.2,{#VRID},1.3.6.1.4.1.{$PRISMA.PEN}.1.13.1.1.3]",
            "key": "prisma.vrrp.discovery",
