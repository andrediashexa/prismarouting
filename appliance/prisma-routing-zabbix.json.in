                "history": "7d",
                "value_type": "FLOAT",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "bgp"
                  },
                  {
                    "tag": "peer",
                    "value": "{#BGPPEER}"
                  }
                ]
              },
              {
                "uuid": "1b52cb0a2893433cb9dd3727c7aed389",
                "name": "BGP peer {#BGPPEER}: updates sent per second",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.15.3.1.11.{#SNMPINDEX}",
                "key": "bgp.peer.out.updates[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "FLOAT",
                "preprocessing": [
                  {
                    "type": "CHANGE_PER_SECOND"
                  }
                ],
                "tags": [
                  {
                    "tag": "component",
                    "value": "bgp"
                  },
                  {
                    "tag": "peer",
                    "value": "{#BGPPEER}"
                  }
                ]
              },
              {
                "uuid": "b59fd43197474cfca7dc8b85d9d56393",
                "name": "BGP peer {#BGPPEER}: established for",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.15.3.1.16.{#SNMPINDEX}",
                "key": "bgp.peer.uptime[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "units": "uptime",
                "tags": [
                  {
                    "tag": "component",
                    "value": "bgp"
                  },
                  {
                    "tag": "peer",
                    "value": "{#BGPPEER}"
                  }
                ]
              }
            ],
            "trigger_prototypes": [
              {
                "uuid": "7be0b596098d4818960fdfbc24dae875",
                "expression": "last(/Prisma Routing by SNMP/bgp.peer.state[{#SNMPINDEX}])<>6 and last(/Prisma Routing by SNMP/bgp.peer.admin[{#SNMPINDEX}])=2",
                "name": "Prisma Routing: BGP peer {#BGPPEER} is not established",
                "priority": "AVERAGE",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "78f699a8e1974c61aa194db0b9ad7692",
            "name": "BGP peer discovery (BGP4V2-MIB)",
            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#BGP4V2STATE},1.3.6.1.3.5.1.1.2.1.13,{#BGP4V2DESCR},1.3.6.1.3.5.1.1.2.1.14]",
            "key": "bgp4v2.peer.discovery",
            "delay": "1h",
            "filter": {
              "evaltype": "AND",
              "conditions": [
                {
                  "macro": "{#SNMPINDEX}",
                  "value": "{$BGP4V2.INDEX.MATCHES}",
                  "formulaid": "A"
                }
              ]
            },
            "description": "BGP4V2-MIB (draft-ietf-idr-bgp4-mibv2, experimental arc), which bgpd indexes instance.type.address with no length byte: type 2 is IPv6, and an unnumbered session peers on a link-local address. IPv6 only by default: BGP4-MIB has the IPv4 peers.",
            "item_prototypes": [
              {
                "uuid": "0cbc4639caa342f1a2e1864078ad3981",
                "name": "BGP peer {#SNMPINDEX} ({#BGP4V2DESCR}): state",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.3.5.1.1.2.1.13.{#SNMPINDEX}",
                "key": "bgp4v2.peer.state[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "valuemap": {
                  "name": "BGP4-MIB::bgpPeerState"
                },
                "tags": [
                  {
                    "tag": "component",
                    "value": "bgp"
                  }
                ]
              },
              {
                "uuid": "439ae526f4fd4bc99159cd4bacec5d5f",
                "name": "BGP peer {#SNMPINDEX} ({#BGP4V2DESCR}): administrative status",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.3.5.1.1.2.1.12.{#SNMPINDEX}",
                "key": "bgp4v2.peer.admin[{#SNMPINDEX}]",
                "delay": "5m",
                "history": "7d",
                "value_type": "UNSIGNED",
                "valuemap": {
                  "name": "BGP4V2-MIB::bgp4V2PeerAdminStatus"
                },
                "tags": [
                  {
                    "tag": "component",
                    "value": "bgp"
                  }
                ]
              },
              {
                "uuid": "58a46bc96947451198d51e0b90b9ccc1",
                "name": "BGP peer {#SNMPINDEX} ({#BGP4V2DESCR}): remote AS",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.3.5.1.1.2.1.10.{#SNMPINDEX}",
                "key": "bgp4v2.peer.as[{#SNMPINDEX}]",
                "delay": "1h",
                "history": "7d",
                "value_type": "UNSIGNED",
                "tags": [
                  {
                    "tag": "component",
                    "value": "bgp"
                  }
                ]
              }
            ],
            "trigger_prototypes": [
              {
                "uuid": "8ba61525c61b46089a0f46f0d8e3148e",
                "expression": "last(/Prisma Routing by SNMP/bgp4v2.peer.state[{#SNMPINDEX}])<>6 and last(/Prisma Routing by SNMP/bgp4v2.peer.admin[{#SNMPINDEX}])=2",
                "name": "Prisma Routing: BGP peer {#SNMPINDEX} ({#BGP4V2DESCR}) is not established",
                "priority": "AVERAGE",
                "tags": [
                  {
                    "tag": "scope",
                    "value": "availability"
                  }
                ]
              }
            ]
          },
          {
            "uuid": "7e25133621c04f45a5918017dc5028ee",
            "name": "OSPF neighbour discovery",
            "type": "SNMP_AGENT",
            "snmp_oid": "discovery[{#OSPFNBR},1.3.6.1.2.1.14.10.1.3]",
            "key": "ospf.nbr.discovery",
            "delay": "1h",
            "item_prototypes": [
              {
                "uuid": "c7966099b647440092a218fce8678b93",
                "name": "OSPF neighbour {#OSPFNBR}: state",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.2.1.14.10.1.6.{#SNMPINDEX}",
                "key": "ospf.nbr.state[{#SNMPINDEX}]",
                "delay": "1m",
                "history": "7d",
