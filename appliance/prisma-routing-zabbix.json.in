        ],
        "macros": [
          {
            "macro": "{$PRISMA.PEN}",
            "value": "@PEN@",
            "description": "The enterprise number the box serves PRISMA-ROUTING-MIB under: `snmp enterprise-number`, or the product's."
          },
          {
            "macro": "{$SNMP.TIMEOUT}",
            "value": "5m",
            "description": "How long without an SNMP answer before the box is reported unreachable."
          },
          {
            "macro": "{$IFCONTROL}",
            "value": "1",
            "description": "1 raises 'link down' for an interface; set {$IFCONTROL:\"<ifName>\"} to 0 for one that may be down."
          },
          {
            "macro": "{$IF.UTIL.MAX}",
            "value": "90",
            "description": "Interface utilisation, percent of ifHighSpeed, above which a warning is raised."
          },
          {
            "macro": "{$IF.ERRORS.WARN}",
            "value": "2",
            "description": "Errors per second on an interface above which a warning is raised."
          },
          {
            "macro": "{$NET.IF.IFNAME.MATCHES}",
            "value": ".*",
            "description": "Interfaces discovered: ifName matching this."
          },
          {
            "macro": "{$NET.IF.IFNAME.NOT_MATCHES}",
            "value": "^(local0|tap[0-9]+)$",
            "description": "Interfaces not discovered: ifName matching this."
          },
          {
            "macro": "{$PRISMA.POOL.UTIL.WARN}",
            "value": "80",
            "description": "A pool's block utilisation, percent, above which a warning is raised."
          },
          {
            "macro": "{$PRISMA.POOL.UTIL.CRIT}",
            "value": "95",
            "description": "A pool's block utilisation, percent, above which a high is raised."
          },
          {
            "macro": "{$PRISMA.SESSIONS.FIT.WARN}",
            "value": "200000",
            "description": "Sessions still fitting in the CGNAT's memory below which a warning is raised."
          },
          {
            "macro": "{$PRISMA.SESSIONS.FIT.CRIT}",
            "value": "20000",
            "description": "Sessions still fitting in the CGNAT's memory below which a high is raised."
          },
          {
            "macro": "{$PRISMA.FIB.MIN}",
            "value": "100",
            "description": "FIB size below which a sudden drop is not reported (a lab or a box with a handful of routes)."
          },
          {
            "macro": "{$PRISMA.FIB.DROP.PCT}",
            "value": "50",
            "description": "The FIB falling below this percent of its maximum over the last hour raises an average."
          },
          {
            "macro": "{$MEMORY.UTIL.MAX}",
            "value": "90",
            "description": "Control-plane memory utilisation, percent, above which an average is raised."
          },
          {
            "macro": "{$PRISMA.XCVR.CONTROL}",
            "value": "1",
            "description": "1 raises a port's transceiver alarms; set {$PRISMA.XCVR.CONTROL:\"<port>\"} (a QSFP lane: \"<port> lane <n>\") to 0 for one whose module may be dark or absent."
          },
          {
            "macro": "{$PRISMA.XCVR.TEMP.MAX}",
            "value": "70",
            "description": "A module's temperature, degrees C, above which a warning is raised - beside the module's own high warning, whichever is crossed first."
          },
          {
            "macro": "{$PRISMA.XCVR.RX.MIN}",
            "value": "-40",
            "description": "RX power, dBm, below which a warning is raised - beside the module's own low warning. -40 is no light: raise it on a port to watch a level the module's thresholds do not."
          },
          {
            "macro": "{$PRISMA.XCVR.RX.MAX}",
            "value": "10",
            "description": "RX power, dBm, above which a warning is raised - beside the module's own high warning."
          },
          {
            "macro": "{$PRISMA.BFD.TRAP.HOLD}",
            "value": "10m",
            "description": "How long a bfdSessDown keeps its problem open after the last one arrived; the session's own state is bfdSessState."
          },
          {
            "macro": "{$BGP4V2.INDEX.MATCHES}",
            "value": "^[0-9]+\\.2\\.",
            "description": "BGP4V2-MIB peers discovered, by index (instance.type.address): IPv6 only by default, since BGP4-MIB already has the IPv4 ones."
          }
        ],
