                  }
                ],
                "trigger_prototypes": [
                  {
                    "uuid": "9ff8d2b0df3048779ecd84972fd08aaa",
                    "expression": "max(/Prisma Routing by SNMP/ospf.nbr.state[{#SNMPINDEX}],3m)<8 and last(/Prisma Routing by SNMP/ospf.nbr.state[{#SNMPINDEX}])<>4",
                    "name": "Prisma Routing: OSPF neighbour {#OSPFNBR} is not full",
                    "priority": "AVERAGE",
                    "description": "twoWay is left alone: it is the steady state between two routers that are not DR or BDR.",
                    "tags": [
                      {
                        "tag": "scope",
                        "value": "availability"
                      }
                    ]
                  }
                ]
              },
