              {
                "uuid": "e03f3562f9e94879926ae7898bed43b0",
                "name": "Bundle {#BUNDLE}: members configured",
                "type": "SNMP_AGENT",
                "snmp_oid": "1.3.6.1.4.1.{$PRISMA.PEN}.1.14.1.1.4.{#SNMPINDEX}",
                "key": "prisma.bundle.members[{#SNMPINDEX}]",
                "delay": "1m",
