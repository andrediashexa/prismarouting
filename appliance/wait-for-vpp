#!/bin/sh
# Espera o VPP aceitar comandos. O systemd considera o vpp.service iniciado
# as soon as the process starts, but the CLI socket and the plugins take a
# moment longer: applying configuration before that fails intermittently.
set -u
TIMEOUT=${1:-30}
n=0
until vppctl show version >/dev/null 2>&1; do
  n=$((n + 1))
  if [ "$n" -ge "$TIMEOUT" ]; then
    echo "VPP did not respond within ${TIMEOUT}s" >&2
    exit 1
  fi
  sleep 1
done
exit 0
