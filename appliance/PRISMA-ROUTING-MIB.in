PRISMA-ROUTING-MIB DEFINITIONS ::= BEGIN

--
-- The MIB of Prisma Routing's own objects: the CGNAT, the retention log's
-- transports and the release the box runs (#504).
--
-- ROOTED AT THE NUMBER THE BOX THAT PRINTED IT SERVES (`show snmp mib`):
-- the product's own IANA Private Enterprise Number, 67033 (32473, IANA's
-- number for documentation use, until 0.149.13) - or the one the operator
-- named with `snmp enterprise-number`. A file printed by another box,
-- or kept from before the number changed, names a subtree that box does not
-- serve. Nothing under the root moves when the number does.
--
-- What the box also serves, from standard MIBs, and is not repeated here:
-- IF-MIB (the dataplane's cards, 64-bit counters), BGP4-MIB, OSPF-MIB,
-- OSPFV3-MIB, ISIS-MIB, the FIB's size in IP-FORWARD-MIB, NAT-MIB's default
-- timeouts, HOST-RESOURCES-MIB and UCD-SNMP-MIB, and ENTITY-MIB with
-- ENTITY-SENSOR-MIB for the ports' modules (whose thresholds are here).
-- docs/snmp-mib.md lists them.
--

IMPORTS
    MODULE-IDENTITY, OBJECT-TYPE, enterprises,
    Counter32, Counter64, Gauge32, Integer32, Unsigned32, TimeTicks,
    IpAddress
        FROM SNMPv2-SMI
    DisplayString, TruthValue
        FROM SNMPv2-TC
    MODULE-COMPLIANCE, OBJECT-GROUP
        FROM SNMPv2-CONF
    entPhysicalIndex
        FROM ENTITY-MIB;

prismaRouting MODULE-IDENTITY
    LAST-UPDATED "202610130000Z"
    ORGANIZATION "NetConfig"
    CONTACT-INFO "https://prismarouting.com.br"
    DESCRIPTION
        "Prisma Routing's CGNAT, the transports of its connection records,
        and the build the box runs. Read-only: every object is
        read-only, and the agent refuses every SET."
    REVISION "202610130000Z"
    DESCRIPTION
        "PPPoE's control plane: the sessions, the RADIUS servers' answers,
        and the Disconnect/CoA listener's (#597)."
    REVISION "202610110000Z"
    DESCRIPTION
        "The thresholds of the sensors ENTITY-SENSOR-MIB serves for the
        ports' modules, under the sensor's entPhysicalIndex (#496)."
    REVISION "202610060000Z"
    DESCRIPTION
        "The ports' transceivers: each module's identity and its optical
        levels beside the thresholds it carries (#590)."
    REVISION "202610020000Z"
    DESCRIPTION
        "Rooted at the product's own IANA Private Enterprise Number, 67033,
        instead of 32473, IANA's number for documentation use (#554).
        Nothing under the root moved."
    REVISION "202609300600Z"
    DESCRIPTION
        "The box's own state: the tuning in effect, the boot self-test, the
        configuration's commits and confirm window, and the configuration
        trail's chain (#524)."
    REVISION "202609291200Z"
    DESCRIPTION
        "The workers, the session capacity, HA, the LACP bundles and the
        identity sources (#505)."
    REVISION "202609290000Z"
    DESCRIPTION "First version (#504)."
    ::= { enterprises @PEN@ }

prObjects      OBJECT IDENTIFIER ::= { prismaRouting 1 }
prConformance  OBJECT IDENTIFIER ::= { prismaRouting 2 }

--
-- The box's totals, at the OIDs they have been served at since the agent
-- was written: an NMS configured against them keeps working.
--

prSubscribers OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Subscribers holding at least one port block now, over every pool."
    ::= { prObjects 1 }

prPortsInUse OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Ports allocated to subscribers now, over every pool, including a
        port in hold-down: it is not free to hand out either."
    ::= { prObjects 2 }

prPortsHeld OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Ports in the blocks subscribers hold now: prPortsInUse over this is
        how full the handed-out blocks are."
    ::= { prObjects 3 }

prSubscribersNearFull OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Subscribers using 90% or more of the ports they hold. The early
        alarm: at 100% the subscriber is refused a port."
    ::= { prObjects 4 }

prPortRefusals OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Times a subscriber was refused a port because its blocks were full,
        since the dataplane started. Any increase is a subscriber who could
        not open a connection."
    ::= { prObjects 5 }

prPacketsDropped OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Packets the CGNAT did not pass, for any reason, since the dataplane
        started. prDropTable says which reasons."
    ::= { prObjects 6 }

--
-- The CGNAT.
--

prCgnat OBJECT IDENTIFIER ::= { prObjects 10 }

prPoolTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrPoolEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The CGNAT pools, one row each: what the pool is, what it can serve,
        and what it is serving now."
    ::= { prCgnat 1 }

prPoolEntry OBJECT-TYPE
    SYNTAX      PrPoolEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One pool."
    INDEX       { prPoolIndex }
    ::= { prPoolTable 1 }

PrPoolEntry ::= SEQUENCE {
    prPoolIndex                Unsigned32,
    prPoolName                 DisplayString,
    prPoolMode                 INTEGER,
    prPoolBlockSize            Unsigned32,
    prPoolInsideAddresses      Unsigned32,
    prPoolOutsideAddresses     Unsigned32,
    prPoolBlocksTotal          Unsigned32,
    prPoolCapacity             Unsigned32,
    prPoolGuaranteed           Unsigned32,
    prPoolSubscribers          Gauge32,
    prPoolBlocksHeld           Gauge32,
    prPoolUtilisation          Gauge32,
    prPoolSessions             Gauge32,
    prPoolPortsInUse           Gauge32,
    prPoolSubscribersNearFull  Gauge32,
    prPoolRefusals             Counter64
}

prPoolIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..4294967295)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The pool's index in the dataplane, plus one. Stable while the pool
        exists; a pool deleted and created again may take another."
    ::= { prPoolEntry 1 }

prPoolName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The pool's name, as the configuration gives it."
    ::= { prPoolEntry 2 }

prPoolMode OBJECT-TYPE
    SYNTAX      INTEGER { deterministic(1), dynamic(2) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "deterministic: a subscriber's block follows from its address by
        formula. dynamic: blocks are allocated on demand (BPA)."
    ::= { prPoolEntry 3 }

prPoolBlockSize OBJECT-TYPE
    SYNTAX      Unsigned32
    UNITS       "ports"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Ports in one block."
    ::= { prPoolEntry 4 }

prPoolInsideAddresses OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Subscriber addresses the pool's inside ranges hold."
    ::= { prPoolEntry 5 }

prPoolOutsideAddresses OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Public addresses the pool translates to."
    ::= { prPoolEntry 6 }

prPoolBlocksTotal OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Blocks the pool can hand out: public addresses times the blocks
        each maps, reserve excluded."
    ::= { prPoolEntry 7 }

prPoolCapacity OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Subscribers the pool can serve at once: a ceiling. On a dynamic pool
        with several workers a subscriber can be refused below it; see
        prPoolGuaranteed."
    ::= { prPoolEntry 8 }

prPoolGuaranteed OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Subscribers the pool serves whatever worker each lands on: the
        number to size against. Equal to prPoolCapacity on a deterministic
        pool or a single worker."
    ::= { prPoolEntry 9 }

prPoolSubscribers OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Subscribers holding a block of this pool now."
    ::= { prPoolEntry 10 }

prPoolBlocksHeld OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Blocks those subscribers hold now."
    ::= { prPoolEntry 11 }

prPoolUtilisation OBJECT-TYPE
    SYNTAX      Gauge32 (0..100)
    UNITS       "percent"
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "prPoolBlocksHeld over prPoolBlocksTotal, in percent: how much of the
        pool is handed out. The number to alarm on for a pool running out."
    ::= { prPoolEntry 12 }

prPoolSessions OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Translation sessions open in this pool now."
    ::= { prPoolEntry 13 }

prPoolPortsInUse OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Ports allocated in this pool now, hold-down included."
    ::= { prPoolEntry 14 }

prPoolSubscribersNearFull OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Subscribers of this pool using 90% or more of the ports they hold."
    ::= { prPoolEntry 15 }

prPoolRefusals OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Times a subscriber of this pool was refused a port, since the pool
        was created."
    ::= { prPoolEntry 16 }

prDropTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrDropEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "What the CGNAT did not pass, by the node that counted it and the
        reason. A reason that has never happened has no row."
    ::= { prCgnat 2 }

prDropEntry OBJECT-TYPE
    SYNTAX      PrDropEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One reason, at one node."
    INDEX       { prDropIndex }
    ::= { prDropTable 1 }

PrDropEntry ::= SEQUENCE {
    prDropIndex    Unsigned32,
    prDropNode     DisplayString,
    prDropReason   DisplayString,
    prDropPackets  Counter64
}

prDropIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..4294967295)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The row's position, by node and then by reason. A reason seen for
        the first time can move the rows after it: read prDropNode and
        prDropReason, not the index."
    ::= { prDropEntry 1 }

prDropNode OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "bpa-in2out (towards the internet) or bpa-out2in (back)."
    ::= { prDropEntry 2 }

prDropReason OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The reason, in the words `show cgnat drops` uses."
    ::= { prDropEntry 3 }

prDropPackets OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Packets dropped for it since the dataplane started."
    ::= { prDropEntry 4 }

prSessions OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Translation sessions open now, over every pool."
    ::= { prCgnat 3 }

prSessionsFit OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Sessions that still fit in the CGNAT's memory: the dataplane's free
        heap at the ~300 bytes a session measured takes, as `show cgnat
        memory` computes it. At zero, new sessions are refused for want of
        memory while the ones open go on."
    ::= { prCgnat 4 }

prWorkerTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrWorkerEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "What each thread of the dataplane translates. A dynamic pool's
        blocks are shared out per worker, so a worker whose share runs out
        refuses subscribers with blocks free on another: an imbalance here is
        the early sign."
    ::= { prCgnat 5 }

prWorkerEntry OBJECT-TYPE
    SYNTAX      PrWorkerEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One thread."
    INDEX       { prWorkerIndex }
    ::= { prWorkerTable 1 }

PrWorkerEntry ::= SEQUENCE {
    prWorkerIndex        Unsigned32,
    prWorkerSubscribers  Gauge32,
    prWorkerSessions     Gauge32,
    prWorkerPortsInUse   Gauge32
}

prWorkerIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..4294967295)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The thread's index plus one: 1 is the main thread, which translates
        only on a box with no workers."
    ::= { prWorkerEntry 1 }

prWorkerSubscribers OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Subscribers this thread holds, over every pool."
    ::= { prWorkerEntry 2 }

prWorkerSessions OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Sessions open on this thread."
    ::= { prWorkerEntry 3 }

prWorkerPortsInUse OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Ports allocated on this thread."
    ::= { prWorkerEntry 4 }

--
-- The connection records: IPFIX over UDP, and the TCP and syslog streams.
-- A transport that stops is the compliance log stopping.
--

prLogging OBJECT IDENTIFIER ::= { prObjects 11 }

prLogIpfixEnabled OBJECT-TYPE
    SYNTAX      TruthValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Whether IPFIX export of block events over UDP is on."
    ::= { prLogging 1 }

prLogIpfixRecords OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "IPFIX records emitted since the dataplane started."
    ::= { prLogging 2 }

prLogIpfixDropped OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Block events with no IPFIX collector to go to, since the dataplane
        started. Rising while logging is required is a gap in the record."
    ::= { prLogging 3 }

prLogTransportTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrLogTransportEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The reliable streams: IPFIX over TCP (1) and syslog (2), each with
        its spill file for when the collector is away."
    ::= { prLogging 10 }

prLogTransportEntry OBJECT-TYPE
    SYNTAX      PrLogTransportEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One stream."
    INDEX       { prLogTransportIndex }
    ::= { prLogTransportTable 1 }

PrLogTransportEntry ::= SEQUENCE {
    prLogTransportIndex      Unsigned32,
    prLogTransportName       DisplayString,
    prLogTransportEnabled    TruthValue,
    prLogTransportConnected  TruthValue,
    prLogTransportRecords    Counter64,
    prLogTransportSent       Counter64,
    prLogTransportSpilled    Counter64,
    prLogTransportDropped    Counter64,
    prLogTransportConnects   Counter32
}

prLogTransportIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..2)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "1: IPFIX over TCP. 2: syslog."
    ::= { prLogTransportEntry 1 }

prLogTransportName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "tcp or syslog."
    ::= { prLogTransportEntry 2 }

prLogTransportEnabled OBJECT-TYPE
    SYNTAX      TruthValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Whether the stream is configured on."
    ::= { prLogTransportEntry 3 }

prLogTransportConnected OBJECT-TYPE
    SYNTAX      TruthValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Whether the collector's connection is up. Enabled and not connected
        is records going to the spill file: alarm on it."
    ::= { prLogTransportEntry 4 }

prLogTransportRecords OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Records given to the stream."
    ::= { prLogTransportEntry 5 }

prLogTransportSent OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Records the collector's socket took."
    ::= { prLogTransportEntry 6 }

prLogTransportSpilled OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Records written to the spill file, to replay later."
    ::= { prLogTransportEntry 7 }

prLogTransportDropped OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Records lost: neither sent nor spilled. Anything but zero is a gap
        in the connection records."
    ::= { prLogTransportEntry 8 }

prLogTransportConnects OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Connections made to the collector. Rising is a connection that keeps
        dropping."
    ::= { prLogTransportEntry 9 }

--
-- The box.
--

prSystem OBJECT IDENTIFIER ::= { prObjects 12 }

prSystemRelease OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The Prisma Routing release installed on the box."
    ::= { prSystem 1 }

prSystemDataplaneBuild OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The build of the CGNAT plugin the RUNNING dataplane loaded, as
        `show version` prints it."
    ::= { prSystem 2 }

prSystemDataplaneCurrent OBJECT-TYPE
    SYNTAX      TruthValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Whether the running dataplane is the release installed. false after
        an upgrade until the next reboot: the new files are on disk and the
        old build is forwarding, and a commit that needs the new build is
        refused."
    ::= { prSystem 3 }

prSystemDataplaneUptime OBJECT-TYPE
    SYNTAX      TimeTicks
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "How long the dataplane has run, from VPP's own clock (`show clock`).
        Younger than the box's hrSystemUptime when the dataplane restarted
        without the box - a crash, a restart of its service, a tuning change
        - which is the case worth an alarm. Absent when the dataplane does
        not answer."
    ::= { prSystem 4 }

--
-- High availability: the VRRP virtual routers the dataplane runs.
--

prHa OBJECT IDENTIFIER ::= { prObjects 13 }

prVrrpTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrVrrpEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One row per virtual router. A change of prVrrpState is a takeover,
        and a takeover the NMS cannot see is a failover nobody notices."
    ::= { prHa 1 }

prVrrpEntry OBJECT-TYPE
    SYNTAX      PrVrrpEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One virtual router."
    INDEX       { prVrrpIndex }
    ::= { prVrrpTable 1 }

PrVrrpEntry ::= SEQUENCE {
    prVrrpIndex      Unsigned32,
    prVrrpInterface  DisplayString,
    prVrrpId         Unsigned32,
    prVrrpPriority   Unsigned32,
    prVrrpState      INTEGER,
    prVrrpAddresses  DisplayString
}

prVrrpIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..4294967295)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "The row's position, by interface and then by VR ID."
    ::= { prVrrpEntry 1 }

prVrrpInterface OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The interface the virtual router backs up."
    ::= { prVrrpEntry 2 }

prVrrpId OBJECT-TYPE
    SYNTAX      Unsigned32 (1..255)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The VR ID."
    ::= { prVrrpEntry 3 }

prVrrpPriority OBJECT-TYPE
    SYNTAX      Unsigned32 (0..255)
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The priority advertised now, which tracking lowers while a tracked
        interface is down."
    ::= { prVrrpEntry 4 }

prVrrpState OBJECT-TYPE
    SYNTAX      INTEGER { init(1), backup(2), master(3), interfaceDown(4) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "master holds the virtual addresses; backup watches."
    ::= { prVrrpEntry 5 }

prVrrpAddresses OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The virtual addresses, separated by spaces."
    ::= { prVrrpEntry 6 }

--
-- LACP bundles.
--

prLacp OBJECT IDENTIFIER ::= { prObjects 14 }

prBundleTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrBundleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One row per bundle. A bundle running on one of its two legs is up in
        IF-MIB and at half its capacity: prBundleActiveMembers below
        prBundleMembers is the alarm."
    ::= { prLacp 1 }

prBundleEntry OBJECT-TYPE
    SYNTAX      PrBundleEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One bundle."
    INDEX       { prBundleIndex }
    ::= { prBundleTable 1 }

PrBundleEntry ::= SEQUENCE {
    prBundleIndex          Unsigned32,
    prBundleName           DisplayString,
    prBundleMode           DisplayString,
    prBundleMembers        Gauge32,
    prBundleActiveMembers  Gauge32
}

prBundleIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..4294967295)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "The row's position, by the bundle's name."
    ::= { prBundleEntry 1 }

prBundleName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The bundle's interface."
    ::= { prBundleEntry 2 }

prBundleMode OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "lacp, or the static mode the bundle runs."
    ::= { prBundleEntry 3 }

prBundleMembers OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Members configured."
    ::= { prBundleEntry 4 }

prBundleActiveMembers OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Members carrying traffic: collecting and distributing."
    ::= { prBundleEntry 5 }

--
-- The identity sources: who each subscriber address was, for the records.
--

prIdentity OBJECT IDENTIFIER ::= { prObjects 15 }

prIdentityEntries OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Subscribers the identity table names. Zero on a box that logs
        identities is records that say 'unknown'."
    ::= { prIdentity 1 }

prIdentityReadAt OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "When the table was last read, as the dataplane prints it; empty
        when there is no table."
    ::= { prIdentity 2 }

prRadiusReceived OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "RADIUS accounting packets received."
    ::= { prIdentity 3 }

prRadiusApplied OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "RADIUS accounting packets applied to the table."
    ::= { prIdentity 4 }

prRadiusRefused OBJECT-TYPE
    SYNTAX      Counter64
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "RADIUS accounting packets refused: a bad authenticator or a
        malformed packet. A bad authenticator is usually a shared secret that
        differs between the BNG and the box."
    ::= { prIdentity 5 }

--
-- The tuning in effect (#524): what prisma-routing-tune wrote into the
-- dataplane's startup.conf and asked the kernel for, and what the kernel did.
--

prTuning OBJECT IDENTIFIER ::= { prObjects 16 }

prTuningState OBJECT-TYPE
    SYNTAX      INTEGER { tuned(1), betweenPlans(2), firstBoot(3) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "tuned: the kernel holds what the tuner asked for. betweenPlans: a
        change asked the kernel for more isolated CPUs than this boot has,
        so the dataplane runs on the ones isolated now until the next reboot
        (prTuningWorkers against prTuningWorkersNextBoot). firstBoot: the
        kernel is not tuned yet and the dataplane runs the conservative
        configuration until a reboot."
    ::= { prTuning 1 }

prTuningWorkers OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Dataplane worker threads this boot runs."
    ::= { prTuning 2 }

prTuningWorkersNextBoot OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Worker threads the next boot runs; prTuningWorkers when the box is
        not between two plans."
    ::= { prTuning 3 }

prTuningIsolated OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The CPUs the running kernel isolates, as a list (2-7)."
    ::= { prTuning 4 }

prTuningIsolatedWanted OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The CPUs the tuner asked the kernel to isolate, for the next boot."
    ::= { prTuning 5 }

prTuningHugepages OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Hugepages of the tuner's size the kernel holds now. Absent when the
        tuner asked for none."
    ::= { prTuning 6 }

prTuningHugepagesWanted OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Hugepages the tuner asked the kernel for. Fewer held than asked is a
        kernel that could not reserve them, or a boot before the request."
    ::= { prTuning 7 }

--
-- The boot self-test's verdict (#524), as the console's last line says it.
--

prSelfTest OBJECT IDENTIFIER ::= { prObjects 17 }

prSelfTestVerdict OBJECT-TYPE
    SYNTAX      INTEGER { ready(1), readyWithWarnings(2),
                          notForwarding(3), failed(4) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The last self-test's verdict. notForwarding is a healthy box with a
        step left: nothing to forward on yet."
    ::= { prSelfTest 1 }

prSelfTestFailures OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Checks the last self-test failed."
    ::= { prSelfTest 2 }

prSelfTestWarnings OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Warnings the last self-test gave."
    ::= { prSelfTest 3 }

prSelfTestRanAt OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "When the last self-test finished, UTC (2026-09-30T06:00:00Z)."
    ::= { prSelfTest 4 }

--
-- The configuration (#524): commits, the commit-confirmed window, rollbacks.
-- The counters count since the box started.
--

prConfig OBJECT IDENTIFIER ::= { prObjects 18 }

prConfigCommits OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Configurations applied since the box started: every commit, the
        boot's own load, a rollback and a confirm window's revert."
    ::= { prConfig 1 }

prConfigLastCommitAt OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "When the last configuration was applied, UTC."
    ::= { prConfig 2 }

prConfigLastCommitBy OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The account that applied it; 'boot' for the configuration loaded at
        boot, 'confirm-expired' for a revert."
    ::= { prConfig 3 }

prConfigConfirmPending OBJECT-TYPE
    SYNTAX      TruthValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "A commit confirmed is waiting for its confirmation, and the box
        reverts it at prConfigConfirmDeadline unless it comes."
    ::= { prConfig 4 }

prConfigConfirmDeadline OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "When a pending commit confirmed reverts, UTC; empty for none."
    ::= { prConfig 5 }

prConfigConfirmReverts OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Commits confirmed nobody confirmed, reverted by the box. Each one is
        a change somebody made and then could not reach the box to keep."
    ::= { prConfig 6 }

prConfigRollbacks OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Rollbacks to an earlier revision an operator committed."
    ::= { prConfig 7 }

prConfigSavedDiffers OBJECT-TYPE
    SYNTAX      TruthValue
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The running configuration is not the saved one: a reboot would come
        back without the changes since the last save."
    ::= { prConfig 8 }

--
-- The configuration trail (#524): the dataplane's hash-chained record of
-- every pool change, as `show bpa pool history verify` checks it.
--

prAudit OBJECT IDENTIFIER ::= { prObjects 19 }

prAuditState OBJECT-TYPE
    SYNTAX      INTEGER { intact(1), empty(2), broken(3), truncated(4),
                          incomplete(5) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "intact: every entry matches its digest and follows the last. empty:
        nothing chained to check. broken: an entry was altered or removed
        from the middle. truncated: entries removed from the end. incomplete:
        writes this dataplane could not make are missing from the file.
        Checked at most every five minutes."
    ::= { prAudit 1 }

prAuditEntries OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Chained entries the check read."
    ::= { prAudit 2 }

prAuditHeadSeq OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The last entry's sequence number."
    ::= { prAudit 3 }

prAuditHeadDigest OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The last entry's SHA-256, in hex. Kept by the NMS, it is the chain's
        head off the box: a trail rewritten from scratch verifies, and only a
        head recorded elsewhere tells it from the one that was there."
    ::= { prAudit 4 }

prAuditLost OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Entries this dataplane could not write since it started: missing
        from the file and from everywhere else."
    ::= { prAudit 5 }

--
-- The ports' transceivers (#590): each module's identity and, when it
-- implements diagnostics (DDM), its levels beside the alarm and warning
-- thresholds the module itself carries - what `show interface transceiver`
-- prints. A row per port of the dataplane driven through DPDK and per card
-- Linux owns, under the port's ifIndex in IF-MIB; a lane table beside it
-- for the optical levels, one lane for an SFP and four for a QSFP.
-- Not ENTITY-SENSOR-MIB: its sensors hang off an ENTITY-MIB the box does
-- not serve, it has no dBm and no thresholds (docs/snmp-mib.md).
-- A value the module does not give, and the thresholds of a quantity that
-- has none, are absent rather than 0.
--

prTransceiver OBJECT IDENTIFIER ::= { prObjects 20 }

prXcvrTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrXcvrEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One row per port with a cage: its module, the module's temperature
        and supply voltage, and the worst level any of its readings stands
        at."
    ::= { prTransceiver 1 }

prXcvrEntry OBJECT-TYPE
    SYNTAX      PrXcvrEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One port's module."
    INDEX       { prXcvrIndex }
    ::= { prXcvrTable 1 }

PrXcvrEntry ::= SEQUENCE {
    prXcvrIndex                  Unsigned32,
    prXcvrName                   DisplayString,
    prXcvrStatus                 INTEGER,
    prXcvrVendor                 DisplayString,
    prXcvrPartNumber             DisplayString,
    prXcvrSerialNumber           DisplayString,
    prXcvrWavelength             Unsigned32,
    prXcvrTemperature            Integer32,
    prXcvrTemperatureHighAlarm   Integer32,
    prXcvrTemperatureHighWarning Integer32,
    prXcvrTemperatureLowWarning  Integer32,
    prXcvrTemperatureLowAlarm    Integer32,
    prXcvrVoltage                Unsigned32,
    prXcvrVoltageHighAlarm       Unsigned32,
    prXcvrVoltageHighWarning     Unsigned32,
    prXcvrVoltageLowWarning      Unsigned32,
    prXcvrVoltageLowAlarm        Unsigned32,
    prXcvrState                  INTEGER,
    prXcvrSource                 DisplayString
}

prXcvrIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..2147483647)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The port's ifIndex in IF-MIB."
    ::= { prXcvrEntry 1 }

prXcvrName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The port: the dataplane's name for it, or the Linux card's."
    ::= { prXcvrEntry 2 }

prXcvrStatus OBJECT-TYPE
    SYNTAX      INTEGER { ddm(1), noDdm(2), copper(3), absent(4),
                          unreadable(5) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "ddm: a module with diagnostics, whose levels are below. noDdm:
        a module without them, or whose diagnostics page the driver cannot
        reach. copper: a copper cable or RJ45 module. absent: no module
        answered. unreadable: the card's driver cannot read a module."
    ::= { prXcvrEntry 3 }

prXcvrVendor OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's vendor, as its EEPROM names it."
    ::= { prXcvrEntry 4 }

prXcvrPartNumber OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's part number."
    ::= { prXcvrEntry 5 }

prXcvrSerialNumber OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's serial number."
    ::= { prXcvrEntry 6 }

prXcvrWavelength OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The laser's wavelength, nm; 0 for a copper module."
    ::= { prXcvrEntry 7 }

prXcvrTemperature OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's temperature, hundredths of a degree Celsius."
    ::= { prXcvrEntry 8 }

prXcvrTemperatureHighAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high alarm threshold for prXcvrTemperature."
    ::= { prXcvrEntry 9 }

prXcvrTemperatureHighWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high warning threshold for prXcvrTemperature."
    ::= { prXcvrEntry 10 }

prXcvrTemperatureLowWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low warning threshold for prXcvrTemperature."
    ::= { prXcvrEntry 11 }

prXcvrTemperatureLowAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low alarm threshold for prXcvrTemperature."
    ::= { prXcvrEntry 12 }

prXcvrVoltage OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's supply voltage, millivolts."
    ::= { prXcvrEntry 13 }

prXcvrVoltageHighAlarm OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high alarm threshold for prXcvrVoltage."
    ::= { prXcvrEntry 14 }

prXcvrVoltageHighWarning OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high warning threshold for prXcvrVoltage."
    ::= { prXcvrEntry 15 }

prXcvrVoltageLowWarning OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low warning threshold for prXcvrVoltage."
    ::= { prXcvrEntry 16 }

prXcvrVoltageLowAlarm OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low alarm threshold for prXcvrVoltage."
    ::= { prXcvrEntry 17 }

prXcvrState OBJECT-TYPE
    SYNTAX      INTEGER { normal(1), warning(2), alarm(3), unknown(4) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The worst level any reading of the module stands at against
        its thresholds: temperature, voltage, and every lane's bias, TX
        and RX power. unknown: no reading had thresholds to stand against."
    ::= { prXcvrEntry 18 }

prXcvrSource OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Where the bytes were read: dpdk (the dataplane), linux (the
        host), or stand-in (a lab's bytes, never on a box)."
    ::= { prXcvrEntry 19 }

prXcvrLaneTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrXcvrLaneEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One row per optical lane of a module with diagnostics: one for an
        SFP, four for a QSFP. Power is in hundredths of a dBm; a receiver
        reading 0 mW - no light - reads -4000 (-40.00 dBm), below any
        receiver's sensitivity."
    ::= { prTransceiver 2 }

prXcvrLaneEntry OBJECT-TYPE
    SYNTAX      PrXcvrLaneEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One lane."
    INDEX       { prXcvrIndex, prXcvrLaneIndex }
    ::= { prXcvrLaneTable 1 }

PrXcvrLaneEntry ::= SEQUENCE {
    prXcvrLaneIndex              Unsigned32,
    prXcvrLaneName               DisplayString,
    prXcvrLaneRxPower            Integer32,
    prXcvrLaneRxPowerHighAlarm   Integer32,
    prXcvrLaneRxPowerHighWarning Integer32,
    prXcvrLaneRxPowerLowWarning  Integer32,
    prXcvrLaneRxPowerLowAlarm    Integer32,
    prXcvrLaneRxLevel            INTEGER,
    prXcvrLaneTxPower            Integer32,
    prXcvrLaneTxPowerHighAlarm   Integer32,
    prXcvrLaneTxPowerHighWarning Integer32,
    prXcvrLaneTxPowerLowWarning  Integer32,
    prXcvrLaneTxPowerLowAlarm    Integer32,
    prXcvrLaneTxLevel            INTEGER,
    prXcvrLaneBias               Unsigned32,
    prXcvrLaneBiasHighAlarm      Unsigned32,
    prXcvrLaneBiasHighWarning    Unsigned32,
    prXcvrLaneBiasLowWarning     Unsigned32,
    prXcvrLaneBiasLowAlarm       Unsigned32,
    prXcvrLaneBiasLevel          INTEGER
}

prXcvrLaneIndex OBJECT-TYPE
    SYNTAX      Unsigned32 (1..4)
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The lane, from 1."
    ::= { prXcvrLaneEntry 1 }

prXcvrLaneName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The port, and the lane on a module with more than one."
    ::= { prXcvrLaneEntry 2 }

prXcvrLaneRxPower OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The lane's RX power, hundredths of a dBm."
    ::= { prXcvrLaneEntry 3 }

prXcvrLaneRxPowerHighAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high alarm threshold for prXcvrLaneRxPower."
    ::= { prXcvrLaneEntry 4 }

prXcvrLaneRxPowerHighWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high warning threshold for prXcvrLaneRxPower."
    ::= { prXcvrLaneEntry 5 }

prXcvrLaneRxPowerLowWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low warning threshold for prXcvrLaneRxPower."
    ::= { prXcvrLaneEntry 6 }

prXcvrLaneRxPowerLowAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low alarm threshold for prXcvrLaneRxPower."
    ::= { prXcvrLaneEntry 7 }

prXcvrLaneRxLevel OBJECT-TYPE
    SYNTAX      INTEGER { normal(1), highWarning(2), lowWarning(3), highAlarm(4),
                          lowAlarm(5), unknown(6) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Where prXcvrLaneRxPower stands against its thresholds; unknown
        when the module carries none."
    ::= { prXcvrLaneEntry 8 }

prXcvrLaneTxPower OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The lane's TX power, hundredths of a dBm."
    ::= { prXcvrLaneEntry 9 }

prXcvrLaneTxPowerHighAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high alarm threshold for prXcvrLaneTxPower."
    ::= { prXcvrLaneEntry 10 }

prXcvrLaneTxPowerHighWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high warning threshold for prXcvrLaneTxPower."
    ::= { prXcvrLaneEntry 11 }

prXcvrLaneTxPowerLowWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low warning threshold for prXcvrLaneTxPower."
    ::= { prXcvrLaneEntry 12 }

prXcvrLaneTxPowerLowAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low alarm threshold for prXcvrLaneTxPower."
    ::= { prXcvrLaneEntry 13 }

prXcvrLaneTxLevel OBJECT-TYPE
    SYNTAX      INTEGER { normal(1), highWarning(2), lowWarning(3), highAlarm(4),
                          lowAlarm(5), unknown(6) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Where prXcvrLaneTxPower stands against its thresholds; unknown
        when the module carries none."
    ::= { prXcvrLaneEntry 14 }

prXcvrLaneBias OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The lane's laser bias current, microamperes."
    ::= { prXcvrLaneEntry 15 }

prXcvrLaneBiasHighAlarm OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high alarm threshold for prXcvrLaneBias."
    ::= { prXcvrLaneEntry 16 }

prXcvrLaneBiasHighWarning OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's high warning threshold for prXcvrLaneBias."
    ::= { prXcvrLaneEntry 17 }

prXcvrLaneBiasLowWarning OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low warning threshold for prXcvrLaneBias."
    ::= { prXcvrLaneEntry 18 }

prXcvrLaneBiasLowAlarm OBJECT-TYPE
    SYNTAX      Unsigned32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The module's low alarm threshold for prXcvrLaneBias."
    ::= { prXcvrLaneEntry 19 }

prXcvrLaneBiasLevel OBJECT-TYPE
    SYNTAX      INTEGER { normal(1), highWarning(2), lowWarning(3), highAlarm(4),
                          lowAlarm(5), unknown(6) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Where prXcvrLaneBias stands against its thresholds; unknown
        when the module carries none."
    ::= { prXcvrLaneEntry 20 }

--
-- The sensors' thresholds (#496, phase 5).
--
-- ENTITY-SENSOR-MIB (RFC 3433) serves each module's diagnostics as a
-- sensor, and has no thresholds: its section 2.3 leaves them to a general
-- mechanism, RMON's alarmTable, in which the NMS writes each threshold as a
-- row. This box is read-only, and a module's thresholds are the module's
-- own, read from its EEPROM - so they are here, a row per sensor that has
-- them, under the sensor's own entPhysicalIndex and in its own units.
--

prSensor OBJECT IDENTIFIER ::= { prObjects 21 }

prSensorThresholdTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrSensorThresholdEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "The thresholds of the sensors in ENTITY-SENSOR-MIB's
        entPhySensorTable that have them. A sensor whose module carries
        no thresholds has no row."
    ::= { prSensor 1 }

prSensorThresholdEntry OBJECT-TYPE
    SYNTAX      PrSensorThresholdEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One sensor's thresholds, each in the units of its
        entPhySensorValue: the same entPhySensorType, entPhySensorScale and
        entPhySensorPrecision apply."
    INDEX       { entPhysicalIndex }
    ::= { prSensorThresholdTable 1 }

PrSensorThresholdEntry ::= SEQUENCE {
    prSensorHighAlarm    Integer32,
    prSensorHighWarning  Integer32,
    prSensorLowWarning   Integer32,
    prSensorLowAlarm     Integer32,
    prSensorLevel        INTEGER
}

prSensorHighAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The high alarm threshold of the sensor's value."
    ::= { prSensorThresholdEntry 1 }

prSensorHighWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The high warning threshold of the sensor's value."
    ::= { prSensorThresholdEntry 2 }

prSensorLowWarning OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The low warning threshold of the sensor's value."
    ::= { prSensorThresholdEntry 3 }

prSensorLowAlarm OBJECT-TYPE
    SYNTAX      Integer32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The low alarm threshold of the sensor's value."
    ::= { prSensorThresholdEntry 4 }

prSensorLevel OBJECT-TYPE
    SYNTAX      INTEGER { normal(1), highWarning(2), lowWarning(3), highAlarm(4),
                          lowAlarm(5), unknown(6) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Where the sensor's value stands against the thresholds above,
        strictly beyond each as the module's own flags are set: a value at
        a threshold is not past it."
    ::= { prSensorThresholdEntry 5 }

--
-- PPPoE's control plane (#597): accel-pppd in the prisma-bng container, read
-- with its own `show stat`. Every counter counts from the control plane's
-- start - a restart of the container, by a commit or a crash, starts them
-- again at zero, and prBngUptime says when. On a box with no PPPoE,
-- prBngState is notConfigured, the counters are zero and the server table is
-- empty: there is no control plane to have counted anything.
--

prBng OBJECT IDENTIFIER ::= { prObjects 22 }

prBngState OBJECT-TYPE
    SYNTAX      INTEGER { running(1), stopped(2), notConfigured(3),
                          noContainers(4) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "The control plane: running; stopped, with PPPoE configured - no
        subscriber can dial; notConfigured; or noContainers, a box that runs
        the dataplane as systemd units, where PPPoE is not offered."
    ::= { prBng 1 }

prBngUptime OBJECT-TYPE
    SYNTAX      TimeTicks
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "How long the control plane has run: the counters below count from
        then. Not instantiated while it does not run."
    ::= { prBng 2 }

prBngSessionsActive OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "PPPoE sessions up: authenticated, addressed and forwarding. Always
        prBngSessionsStarted minus prBngSessionsStopped."
    ::= { prBng 3 }

prBngSessionsStarting OBJECT-TYPE
    SYNTAX      Gauge32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Sessions being set up: discovery done, not yet up. A number that
        stays high is subscribers stuck at authentication."
    ::= { prBng 4 }

prBngSessionsStarted OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Sessions that came up since the control plane started."
    ::= { prBng 5 }

prBngSessionsStopped OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Sessions that were up and ended since the control plane started:
        by the subscriber, a clear, a Disconnect, a timeout or a lost
        carrier."
    ::= { prBng 6 }

prBngDisconnectAcks OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Disconnect-Requests (RFC 5176) answered with an ACK."
    ::= { prBng 7 }

prBngDisconnectNaks OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Disconnect-Requests answered with a NAK: no such session, or a
        NAS identification that is not this box's."
    ::= { prBng 8 }

prBngCoaAcks OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "CoA-Requests applied and answered with an ACK."
    ::= { prBng 9 }

prBngCoaNaks OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "CoA-Requests refused with a NAK, nothing changed: no such session,
        an attribute nothing acts on, or a rate that is not one."
    ::= { prBng 10 }

prBngDaeDropped OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Disconnect and CoA requests answered with nothing: a source that
        is not a configured client, a wrong secret, or a request for a
        session that already has one pending. Rising is usually a secret
        that differs between the RADIUS side and the box."
    ::= { prBng 11 }

prBngRadiusTable OBJECT-TYPE
    SYNTAX      SEQUENCE OF PrBngRadiusEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION
        "One row per RADIUS server under `aaa radius`, while the control
        plane runs. Empty with no PPPoE, or with local users only."
    ::= { prBng 20 }

prBngRadiusEntry OBJECT-TYPE
    SYNTAX      PrBngRadiusEntry
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "One RADIUS server, by its address."
    INDEX       { prBngRadiusAddress }
    ::= { prBngRadiusTable 1 }

PrBngRadiusEntry ::= SEQUENCE {
    prBngRadiusAddress       IpAddress,
    prBngRadiusName          DisplayString,
    prBngRadiusState         INTEGER,
    prBngRadiusAuthSent      Counter32,
    prBngRadiusAuthAccepts   Counter32,
    prBngRadiusAuthRejects   Counter32,
    prBngRadiusAuthTimeouts  Counter32,
    prBngRadiusAcctSent      Counter32,
    prBngRadiusAcctTimeouts  Counter32
}

prBngRadiusAddress OBJECT-TYPE
    SYNTAX      IpAddress
    MAX-ACCESS  not-accessible
    STATUS      current
    DESCRIPTION "The server's address, as configured."
    ::= { prBngRadiusEntry 1 }

prBngRadiusName OBJECT-TYPE
    SYNTAX      DisplayString
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "The server's address, as text."
    ::= { prBngRadiusEntry 2 }

prBngRadiusState OBJECT-TYPE
    SYNTAX      INTEGER { active(1), failed(2) }
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "failed while the server is skipped for its dead-time, after it
        left as many sends in a row unanswered as `retries` allows."
    ::= { prBngRadiusEntry 3 }

prBngRadiusAuthSent OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Access-Requests sent to it, each retry counted."
    ::= { prBngRadiusEntry 4 }

prBngRadiusAuthAccepts OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Access-Accepts it answered."
    ::= { prBngRadiusEntry 5 }

prBngRadiusAuthRejects OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Access-Rejects it answered: a wrong password, an unknown or a
        suspended subscriber."
    ::= { prBngRadiusEntry 6 }

prBngRadiusAuthTimeouts OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Access-Requests it did not answer within `timeout`, each send
        counted."
    ::= { prBngRadiusEntry 7 }

prBngRadiusAcctSent OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION
        "Accounting-Requests sent to it - Start, Interim-Update and Stop -
        each retry counted."
    ::= { prBngRadiusEntry 8 }

prBngRadiusAcctTimeouts OBJECT-TYPE
    SYNTAX      Counter32
    MAX-ACCESS  read-only
    STATUS      current
    DESCRIPTION "Accounting-Requests it did not answer within `timeout`."
    ::= { prBngRadiusEntry 9 }

--
-- Conformance.
--

prGroups       OBJECT IDENTIFIER ::= { prConformance 1 }
prCompliances  OBJECT IDENTIFIER ::= { prConformance 2 }

prTotalsGroup OBJECT-GROUP
    OBJECTS { prSubscribers, prPortsInUse, prPortsHeld,
              prSubscribersNearFull, prPortRefusals, prPacketsDropped }
    STATUS      current
    DESCRIPTION "The box's totals."
    ::= { prGroups 1 }

prCgnatGroup OBJECT-GROUP
    OBJECTS { prPoolName, prPoolMode, prPoolBlockSize,
              prPoolInsideAddresses, prPoolOutsideAddresses,
              prPoolBlocksTotal, prPoolCapacity, prPoolGuaranteed,
              prPoolSubscribers, prPoolBlocksHeld, prPoolUtilisation,
              prPoolSessions, prPoolPortsInUse, prPoolSubscribersNearFull,
              prPoolRefusals, prDropNode, prDropReason, prDropPackets,
              prSessions, prSessionsFit, prWorkerSubscribers,
              prWorkerSessions, prWorkerPortsInUse }
    STATUS      current
    DESCRIPTION "The CGNAT's pools, drops and sessions."
    ::= { prGroups 2 }

prLoggingGroup OBJECT-GROUP
    OBJECTS { prLogIpfixEnabled, prLogIpfixRecords, prLogIpfixDropped,
              prLogTransportName, prLogTransportEnabled,
              prLogTransportConnected, prLogTransportRecords,
              prLogTransportSent, prLogTransportSpilled,
              prLogTransportDropped, prLogTransportConnects }
    STATUS      current
    DESCRIPTION "The connection records' transports."
    ::= { prGroups 3 }

prSystemGroup OBJECT-GROUP
    OBJECTS { prSystemRelease, prSystemDataplaneBuild,
              prSystemDataplaneCurrent, prSystemDataplaneUptime }
    STATUS      current
    DESCRIPTION "The release and the running dataplane's build."
    ::= { prGroups 4 }

prHaGroup OBJECT-GROUP
    OBJECTS { prVrrpInterface, prVrrpId, prVrrpPriority, prVrrpState,
              prVrrpAddresses }
    STATUS      current
    DESCRIPTION "The VRRP virtual routers."
    ::= { prGroups 5 }

prLacpGroup OBJECT-GROUP
    OBJECTS { prBundleName, prBundleMode, prBundleMembers,
              prBundleActiveMembers }
    STATUS      current
    DESCRIPTION "The LACP bundles."
    ::= { prGroups 6 }

prIdentityGroup OBJECT-GROUP
    OBJECTS { prIdentityEntries, prIdentityReadAt, prRadiusReceived,
              prRadiusApplied, prRadiusRefused }
    STATUS      current
    DESCRIPTION "The identity sources."
    ::= { prGroups 7 }

prTuningGroup OBJECT-GROUP
    OBJECTS { prTuningState, prTuningWorkers, prTuningWorkersNextBoot,
              prTuningIsolated, prTuningIsolatedWanted, prTuningHugepages,
              prTuningHugepagesWanted }
    STATUS      current
    DESCRIPTION "The tuning in effect."
    ::= { prGroups 8 }

prSelfTestGroup OBJECT-GROUP
    OBJECTS { prSelfTestVerdict, prSelfTestFailures, prSelfTestWarnings,
              prSelfTestRanAt }
    STATUS      current
    DESCRIPTION "The boot self-test."
    ::= { prGroups 9 }

prConfigGroup OBJECT-GROUP
    OBJECTS { prConfigCommits, prConfigLastCommitAt, prConfigLastCommitBy,
              prConfigConfirmPending, prConfigConfirmDeadline,
              prConfigConfirmReverts, prConfigRollbacks,
              prConfigSavedDiffers }
    STATUS      current
    DESCRIPTION "The configuration's commits and confirm window."
    ::= { prGroups 10 }

prAuditGroup OBJECT-GROUP
    OBJECTS { prAuditState, prAuditEntries, prAuditHeadSeq,
              prAuditHeadDigest, prAuditLost }
    STATUS      current
    DESCRIPTION "The configuration trail."
    ::= { prGroups 11 }

prTransceiverGroup OBJECT-GROUP
    OBJECTS { prXcvrName, prXcvrStatus, prXcvrVendor, prXcvrPartNumber,
              prXcvrSerialNumber, prXcvrWavelength, prXcvrTemperature,
              prXcvrTemperatureHighAlarm, prXcvrTemperatureHighWarning,
              prXcvrTemperatureLowWarning, prXcvrTemperatureLowAlarm,
              prXcvrVoltage, prXcvrVoltageHighAlarm,
              prXcvrVoltageHighWarning, prXcvrVoltageLowWarning,
              prXcvrVoltageLowAlarm, prXcvrState, prXcvrSource,
              prXcvrLaneName, prXcvrLaneRxPower, prXcvrLaneRxPowerHighAlarm,
              prXcvrLaneRxPowerHighWarning, prXcvrLaneRxPowerLowWarning,
              prXcvrLaneRxPowerLowAlarm, prXcvrLaneRxLevel,
              prXcvrLaneTxPower, prXcvrLaneTxPowerHighAlarm,
              prXcvrLaneTxPowerHighWarning, prXcvrLaneTxPowerLowWarning,
              prXcvrLaneTxPowerLowAlarm, prXcvrLaneTxLevel, prXcvrLaneBias,
              prXcvrLaneBiasHighAlarm, prXcvrLaneBiasHighWarning,
              prXcvrLaneBiasLowWarning, prXcvrLaneBiasLowAlarm,
              prXcvrLaneBiasLevel }
    STATUS      current
    DESCRIPTION "The ports' transceivers."
    ::= { prGroups 12 }

prSensorGroup OBJECT-GROUP
    OBJECTS { prSensorHighAlarm, prSensorHighWarning, prSensorLowWarning,
              prSensorLowAlarm, prSensorLevel }
    STATUS      current
    DESCRIPTION "The sensors' thresholds."
    ::= { prGroups 13 }

prBngGroup OBJECT-GROUP
    OBJECTS { prBngState, prBngUptime, prBngSessionsActive,
              prBngSessionsStarting, prBngSessionsStarted,
              prBngSessionsStopped, prBngDisconnectAcks, prBngDisconnectNaks,
              prBngCoaAcks, prBngCoaNaks, prBngDaeDropped, prBngRadiusName,
              prBngRadiusState, prBngRadiusAuthSent, prBngRadiusAuthAccepts,
              prBngRadiusAuthRejects, prBngRadiusAuthTimeouts,
              prBngRadiusAcctSent, prBngRadiusAcctTimeouts }
    STATUS      current
    DESCRIPTION "PPPoE's control plane."
    ::= { prGroups 14 }

prCompliance MODULE-COMPLIANCE
    STATUS      current
    DESCRIPTION "What every Prisma Routing box serves."
    MODULE
        MANDATORY-GROUPS { prTotalsGroup, prCgnatGroup, prLoggingGroup,
                           prSystemGroup, prHaGroup, prLacpGroup,
                           prIdentityGroup, prTuningGroup, prSelfTestGroup,
                           prConfigGroup, prAuditGroup,
                           prTransceiverGroup, prSensorGroup, prBngGroup }
    ::= { prCompliances 1 }

END
