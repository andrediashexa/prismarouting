[Unit]
Description=HexaRouting - compute boot tuning from the hardware
Documentation=file:///usr/share/doc/hexarouting/architecture.md
# Runs before VPP: the generated startup.conf is what VPP reads. Kernel
# command line changes (isolcpus, hugepages) only apply on the next boot.
#
# Runs on every boot, with no sentinel: the calculation is cheap, so a change
# in tune.env or a swapped NIC is honoured. What avoids the cost of
# update-grub is apply-tuning, which compares before regenerating.
Before=vpp.service

# AND AFTER THE NETWORK IS CONFIGURED, which it did not used to need to be.
#
# Since #378 this unit computes the way back for a card it is about to claim:
# the address, MAC and gateway, read off the live card in the window before
# anything is unbound. On a box whose management network is DHCP, or static
# through ifupdown, that address does not exist until networking.service has
# run - so without this ordering the read returns nothing, the tuner reads no
# way back and declines the card it is reached on, leaving it with Linux: on
# a one-card box that is the only card, and startup.conf says `no-pci`. The
# box would then come up reachable and not forwarding, for a reason that is
# a race rather than a fault.
#
# After= and not Wants=, which is the same choice hexarouting-selftest.service
# makes about the same unit and for the same reason: networking.service is
# enabled on every installed box and absent on the live medium, and a Wants=
# would drag it onto a medium that deliberately has no persisted network.
After=networking.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Without this systemd waits "no limit": a slow update-grub stalls the
# whole boot, and that is what happened - 5 minutes stuck in tuning. The
# tuning only takes effect on the next boot anyway, so it is not worth it.
TimeoutStartSec=90
ExecStart=/usr/lib/hexarouting/apply-tuning
EnvironmentFile=-/etc/hexarouting/tune.env

[Install]
WantedBy=multi-user.target
