[Unit]
Description=HexaRouting - calcula o tuning de boot a partir do hardware
Documentation=file:///usr/share/doc/hexarouting/architecture.md
# Roda antes do VPP: o startup.conf gerado e o que o VPP le. As mudancas de
# linha de comando do kernel (isolcpus, hugepages) so valem no boot seguinte.
#
# Roda em todo boot, sem sentinela: o calculo e barato e assim uma mudanca em
# tune.env, ou uma troca de NIC, e respeitada. Quem evita o custo do
# update-grub e o apply-tuning, comparando antes de regenerar.
Before=vpp.service

[Service]
Type=oneshot
RemainAfterExit=yes
# Sem isto o systemd espera "no limit": um update-grub lento trava o boot
# inteiro, e foi o que aconteceu - 5 minutos parado no tuning. O tuning so
# surte efeito no proximo boot de qualquer forma, entao nao vale esse preco.
TimeoutStartSec=90
ExecStart=/usr/lib/hexarouting/apply-tuning
EnvironmentFile=-/etc/hexarouting/tune.env

[Install]
WantedBy=multi-user.target
