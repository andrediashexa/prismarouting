[Unit]
Description=Prisma Routing - apply the CGNAT configuration to the dataplane
Documentation=file:///usr/share/doc/prisma-routing/architecture.md
# FRR IS ORDERED AND NOT WANTED, and that is a change #426 measured on a
# booted box. It was `Wants=frr.service`, on the argument that without
# routing the box still forwards what static routes cover - which is right,
# and is an argument for not REQUIRING it. Wants starts it all the same, and
# on a box whose control plane is a container that is a second FRR: the host
# one came up beside the container's, both holding /etc/frr and /var/run/frr.
# lab/install-iso.sh's PHASE 6 watched it happen.
#
# Ordering is all that was ever needed. frr.service is enabled by its own
# package on a box on the unit path, and on a container box the control
# plane comes up with the stack.
After=vpp.service frr.service prisma-routing-containers.service
# PartOf THE DATAPLANE THIS BOX RUNS, so this is stopped and restarted with
# it. The containers here; the unit path adds `PartOf=vpp.service` in
# prisma-routing-unit-path.conf, which install.sh puts only on a box that runs
# vpp.service (#459).
#
# NOT BOTH, which is what this said until #459, on the argument that PartOf a
# unit nobody started is inert. It is not inert in a transaction: the
# containers unit Conflicts=vpp.service, so `systemctl restart
# prisma-routing-containers` queued a stop of vpp.service, PartOf carried that
# stop to this unit, and PartOf carried the restart too - and systemd refused
# the whole transaction: "Transaction contains conflicting jobs 'restart' and
# 'stop' for prisma-routing.service". Measured on a KVM guest on the
# containers; every screen that told an operator to type that command was
# telling them to type a refusal.
PartOf=prisma-routing-containers.service
# AND `Requires=vpp.service` IS GONE, WHICH IS THE POINT (#426).
#
# Requires PULLS THE UNIT IN: on a box whose dataplane is a container, this
# would have started vpp.service - and vpp.service Conflicts with
# prisma-routing-containers.service, so systemd would stop the containers to
# start it, or refuse, and which of those happens is decided nowhere. The box
# would end up with the configuration loader fighting its own dataplane at
# every boot.
#
# Wants= is no better: it pulls the unit in just the same, only without
# failing if it will not start.
#
# NOTHING IS LOST ON THE UNIT PATH. vpp.service is enabled on every installed
# box, so it is started by its own enablement and not by this; the ordering
# that matters is After=, which is kept, and the race that remains is the one
# ExecStartPre has always covered - wait-for-vpp waits for a dataplane that
# ANSWERS, whichever unit started it. A box where the dataplane is genuinely
# not coming gets the 60-second timeout and its message, which is a better
# answer than a dependency that starts a second dataplane.

[Service]
Type=oneshot
RemainAfterExit=yes
ExecStartPre=/usr/lib/prisma-routing/wait-for-vpp 60
ExecStart=/usr/bin/prismash --load /etc/prisma-routing/prisma-routing.conf
# The control plane must not be the process that empties a box sized to the
# documented floor. docs/appliance.md sets that floor at 4 GB, and the tuner
# leaves a quarter of RAM outside the hugepage pool for everything that is not
# VPP - 2 GB on such a box, shared by the kernel, the page cache, FRR and this.
# Loading a configuration is the interpreter plus prismash's own modules and the
# file: 13 MB peak measured, and it does not grow with the routing table or the
# session count, both of which live in VPP. 512M is a quarter of that 2 GB and
# forty times the measured need, so a runaway here is killed while it is still
# a bug in one unit, instead of becoming a machine-wide shortage that lets the
# kernel choose a victim (#172).
#
# Deliberately NOT applied to frr.service, and now for a measured reason rather
# than for the absence of one. One full IPv4 table fed to bgpd costs 837 MB
# resident with zebra at 553 MB behind it: 1.37 GB of FRR, against 37 MB on a
# box that takes default routes only. That spread belongs to the operator's
# peering and not to this product, and one number in a shipped unit file would
# have to serve both ends of it on boxes whose share of RAM for everything that
# is not VPP differs by a factor of eight.
#
# Guessed low it does not degrade BGP, it kills it. bgpd under memory.max=512M
# was killed ten seconds into convergence holding 428 MB, with pgscan 100 and
# pgsteal 4 beside it - there was nothing reclaimable, so the limit went
# straight from full to a kill - and frr.service carries Restart=always with
# RestartSec=5, which turns that into a loop on the box with the most to lose.
# docs/appliance.md carries the numbers and how they were taken (#172).
#
# Reach: this is a oneshot, so the bound holds while the configuration is being
# applied and not afterwards - the unit keeps its cgroup but no processes. The
# interactive VTY is started by the login shell, not by this unit, and is not
# covered here.
MemoryMax=512M
# No ExecStop: the configuration lives in VPP, and stopping this service must
# not erase a production pool. Removing a pool is the operator's action,
# through the VTY. A stop-time command runs on every RESTART too, so one here
# would fire on any restart at all and not only when somebody meant it. The
# PartOf=vpp.service above makes that wider than it looks: `systemctl restart
# vpp`, which is what `show version` tells an operator to run to pick up a new
# dataplane build, stops this unit with it.
#
# That was a comment and nothing else until #238: adding the ExecStop it
# forbids left all 34 suites green. test/test_stop_is_not_a_teardown.py now
# reads this file, so the sentence above has a red light behind it.
#
# Closing the retention log when the box stops is a different job and is NOT
# here, for the same reason: it belongs to the process that holds the blocks.
# It is an ExecStop in a vpp.service drop-in, appliance/systemd/vpp-stop-drain.conf.
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
