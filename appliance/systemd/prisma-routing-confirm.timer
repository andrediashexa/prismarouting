[Unit]
Description=Prisma Routing - watch for a 'commit confirmed' that was never confirmed
Documentation=file:///usr/share/doc/prisma-routing/routing.md

[Timer]
# Polled, not armed at the moment of the commit.
#
# Arming would be exact, and it would need the committing account to reach
# systemd. That account is not root - it holds a role, which is membership of
# prisma-admin or prisma-cgnat - so arming a transient unit from an operator's
# session means granting every such account the ability to make this box run
# units. That is a far larger grant than the feature is worth. Writing a file
# into a directory its role group already owns is not a grant at all, which is
# why the state is a file and this is a poll (#212).
#
# 15 seconds is the error this adds to a deadline the operator gave in
# minutes. Measured rather than assumed: a transient timer with these exact
# properties elapsed at 16.008, 16.096, 15.888 and 16.012 seconds, so the
# figure to quote is about sixteen - the interval is counted from the last
# activation and the oneshot's own start is inside it. 'commit confirmed 10'
# therefore reverts between 10:00 and roughly 10:16 after the commit. The
# alternative error is the one being removed, which is infinite.
OnBootSec=60
OnUnitActiveSec=15
# Without this the default accuracy is one minute and the interval above would
# be decoration - systemd would coalesce these into whatever minute suited it.
AccuracySec=1s
Unit=prisma-routing-confirm.service

[Install]
WantedBy=timers.target
