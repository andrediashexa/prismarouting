[Unit]
Description=HexaRouting - boot self-test on the console
Documentation=file:///usr/share/doc/hexarouting/appliance.md
After=hexarouting.service frr.service
Wants=hexarouting.service
# Runs even when hexarouting.service fails: that is precisely when the
# diagnosis matters.
DefaultDependencies=no

# NOT ordered after multi-user.target, deliberately.
#
# The console getty is ordered AFTER this unit so that the report is on the
# screen before the VTY prompt is drawn on top of it (#93). getty.target is
# pulled in by multi-user.target, so ordering this unit after multi-user.target
# as well would close a cycle - and systemd breaks a cycle by dropping one of
# its edges, which would make the console come out right on some boots and
# wrong on others. Right sometimes is worse than wrong always: it cannot be
# reproduced and it will be blamed on the hardware.
#
# What this unit actually needs is what it already says: VPP and FRR up. It
# reports on those two and on the VTY, not on the whole target.

[Service]
Type=oneshot
RemainAfterExit=yes
# The leading "-" is the systemd half of "the diagnostic MUST NOT bring down
# the boot" (docs/appliance.md). Without it the promise rests entirely on the
# last line of a 1000-line shell script: measured on systemd 252 with a
# transient unit of this exact shape, a command exiting 3 gives
# Result=exit-code and ActiveState=failed, and a command killed by SIGSEGV
# gives Result=signal and ActiveState=failed. With the "-" both give
# Result=success and ActiveState=active.
#
# Nothing is lost by ignoring it. systemd still records what happened:
# ExecMainStatus stayed 3 and 11 in those same readings, and the script's own
# report goes to the console and the journal either way. The status is the one
# thing about this unit that must reach nobody, because a unit that fails here
# is a unit anything ordered around it can be made to fail with - the console
# getty is ordered after this one (#93), and it is Wants= rather than Requires=
# only because somebody chose right once. With ExecStart=- that choice stops
# being load-bearing.
ExecStart=-/usr/lib/hexarouting/selftest
StandardOutput=journal
StandardError=journal

[Install]
WantedBy=multi-user.target
