# The dataplane and the control plane as containers (#396).
#
# NOT ENABLED BY THIS RELEASE. The medium carries the images and this unit,
# and a box still boots vpp.service and frr.service exactly as it did - the
# release that flips the default is the one whose gate boots a box on
# containers and watches it forward. Enabling a unit that changes what an
# appliance runs, in the same release that first ships it, would be asking
# an operator to take both on one upgrade.
#
#   systemctl enable --now prisma-routing-containers.service
#
# WHAT IT REPLACES, when it is enabled: vpp.service and frr.service. The
# three cannot run together - the socket paths, the hugepages and the NIC are
# the same ones - so this unit conflicts with them rather than leaving that
# to whoever reads the file.
[Unit]
Description=Prisma Routing dataplane and control plane, in containers
Documentation=file:/usr/share/doc/prisma-routing/appliance.md
After=network-pre.target prisma-routing-tune.service docker.service
Requires=docker.service
Conflicts=vpp.service frr.service
# The tuner writes /etc/vpp/startup.conf and reserves the hugepages the EAL
# needs; a dataplane started before it reads a configuration from the boot
# before this one.
After=prisma-routing-tune.service

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=/etc/prisma-routing
# Written by load-the-images, one line: PRISMA_VERSION=<tag>. `-` because
# the file is in /run and this unit is what creates it.
EnvironmentFile=-/run/prisma-routing/compose.env
# THE DEFAULT IS 90 SECONDS AND THE LOAD IS 118 MB OF GZIP. A box that took
# longer than the default would have its dataplane killed mid-load and the
# unit marked failed, which on a first boot reads as "the containers do not
# work on this hardware".
TimeoutStartSec=600
# The images are loaded from the medium's copy on every start rather than
# once at install: a box that was rolled back, or whose docker state was
# cleared, then starts the images it has rather than none. `docker load` on
# an image that is already there is a no-op that prints the tag.
#
# THE IMAGES, AND THE VERSION COMPOSE IS TOLD TO RUN. This was a one-line
# `docker load` and it was not enough: compose.yaml asks for
# `prisma-vpp:${PRISMA_VERSION:-latest}`, the images are saved tagged with
# the VERSION file, and nothing set PRISMA_VERSION - so an installed box
# asked a registry for `prisma-vpp:latest` and came up with NO CONTAINERS AT
# ALL. Measured by lab/install-iso.sh's PHASE 6, which is the first thing in
# this repository to boot a box on the stack.
#
# load-the-images loads them, reads the tag off what this box actually has,
# and writes PRISMA_VERSION into the environment file below.
ExecStartPre=/usr/lib/prisma-routing/load-the-images
# THE CARD'S DEVICE NODE, READ OFF THIS BOOT AND NOT GUESSED AT.
# compose.yaml names /dev/net/tun and /dev/vhost-net, which every box has;
# it deliberately names no /dev/vfio, because a box with no IOMMU has none
# and compose refuses to start a service whose device is missing. Which node
# the dataplane needs follows from the driver the bind script chose, and that
# script is the one holder of that rule - a second copy here is the defect
# #328 was about wearing a container.
#
# AFTER THE BIND AND NOT BEFORE: on the uio path the node does not exist
# until the device is bound. prisma-routing-tune.service is what binds, and
# this unit is ordered after it.
#
# `devices` MERGES BY APPENDING across -f files on docker-compose 1.29.2,
# measured on the version the medium carries - so the fragment adds the
# card's node to the two above rather than replacing them.
ExecStartPre=/bin/sh -c 'install -d -m 0755 /run/prisma-routing && /usr/lib/prisma-routing/bind-dataplane-nic --compose-devices > /run/prisma-routing/compose-devices.yaml'
ExecStart=/usr/bin/docker-compose -f /etc/prisma-routing/compose.yaml -f /run/prisma-routing/compose-devices.yaml up -d
# THE BINARY API, MADE REACHABLE BY THE ACCOUNTS THIS BOX GAVE A ROLE.
# prismash runs on the HOST and maps /dev/shm/global_vm and /dev/shm/vpe-api.
# The dataplane in a container creates them in the host's /dev/shm because
# compose.yaml says `ipc: host` - measured: without it the host's /dev/shm
# stays empty and the VTY has no API at all - and they come out root:root,
# so the same chgrp vpp.service's drop-in does has to be done here. One
# script for both, because a rule written twice is corrected once.
# PRISMA_API_WAIT=240 is sixty seconds in quarter-seconds, and it is longer
# than the drop-in's ten because the clock starts somewhere else: `up -d`
# returns when the container has been CREATED, not when the dataplane inside
# it is serving. Measured on an installed box - ten was not enough and the
# binary API stayed root-only.
Environment=PRISMA_API_WAIT=240
ExecStartPost=/usr/lib/prisma-routing/share-the-api-segment
# `down` and not `stop`: the containers are recreated from the compose file
# on every start, so leaving them around buys nothing and a stopped container
# holding /run/vpp is a dataplane the next start cannot bind.
#
# THE TIMEOUT IS THE DRAIN'S. compose.yaml gives the dataplane 30 seconds to
# stop, and systemd killing this unit before that would cut the drain off -
# which is the retention record #217 is about. 60 leaves room for the
# control plane's own stop after it.
#
# THE SAME -f PAIR AS THE START, because compose computes the project from
# the files it is given: `down` with only the base file is `down` against a
# different definition of the same project, and what it would take with it
# is not a thing to find out on a box in service.
ExecStop=/usr/bin/docker-compose -f /etc/prisma-routing/compose.yaml -f /run/prisma-routing/compose-devices.yaml down -t 30
TimeoutStopSec=60

[Install]
WantedBy=multi-user.target
