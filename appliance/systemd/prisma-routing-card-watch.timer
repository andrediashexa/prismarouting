# Every 30 seconds, and the interval is the cost of being stranded.
#
# A box whose dataplane container has given up has no interface at all: no
# ssh, no VTY, no console but the physical one. Half a minute of that is a
# reboot's worth of patience; five minutes of it is an engineer in a car.
#
# OnBootSec is 2 minutes rather than 0: Docker's own policy is allowed its
# five attempts first, and a watcher that fires while the dataplane is still
# being retried would hand the card back underneath it.
# ENABLED WITH prisma-routing-containers.service, which is what an installed
# box runs. The two belong together: a box on the containers without this
# timer is one that can be left stranded with its card bound to DPDK and no
# interface at all, and on a box an operator has switched back to
# vpp.service the script exits at its first line and costs nothing.
[Unit]
Description=Prisma Routing - look for a dataplane container that gave up
Documentation=file:/usr/share/doc/prisma-routing/appliance.md

[Timer]
OnBootSec=2min
OnUnitActiveSec=30s
AccuracySec=5s
Unit=prisma-routing-card-watch.service

[Install]
WantedBy=timers.target
