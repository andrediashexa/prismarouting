# The management network's connections to the API, carried to the server on
# the backplane (#532). Started by prisma-routing-api-proxy.socket, which
# api-configure writes; TLS passes through untouched.
[Unit]
Description=Prisma Routing - the management API's proxy to the backplane
Requires=prisma-routing-api.service
After=prisma-routing-api.service

[Service]
# THROUGH THE BACKPLANE'S VRF: bp0 is enslaved to `prisma-bp` (table 128),
# and from the main table 128.0.0.2 is reached by the default route - out of
# the management card. Measured on the X520 bench (0.148.4): the proxy never
# reached the server until it ran inside the VRF.
ExecStart=/usr/sbin/ip vrf exec prisma-bp /lib/systemd/systemd-socket-proxyd 128.0.0.2:50051
