#!/bin/sh
# Refuses to let a credential leave the building inside the image.
#
#   no-credentials-in-image <dir> [<dir>...]
#
# Exits 0 when every tree given is clean, 1 when one of them carries something
# that must not be published, 2 when it was called wrongly. Every refusal names
# the file and says which rule it broke.
#
# WHY THIS EXISTS
#
# docs/appliance.md says it in one line: "No answer file is shipped in the ISO,
# and the build MUST NOT put one there. A credential in a published image is
# the defect the locked live root account exists to prevent." An ISO is the one
# artefact of this project that leaves the building - CONTRIBUTING.md section 5
# requires every release to publish one - so whatever is inside it is handed to
# whoever downloads it, on a USB stick, at a site, and it stays handed over.
#
# The rule was written down and enforced nowhere. Writing an answer file into
# the root the build was about to squash left all 34 suites green (#245).
#
# WHAT COUNTS AS AN ANSWER FILE
#
# Not "any file that mentions an install answer". This product has a real
# cmdline install path, and hexarouting-install, install-from-cmdline and
# docs/appliance.md all describe the format at length; those are documentation
# of the format, not instances of it. The test is what the installer would
# READ:
#
#   - a file whose NAME contains "answers", because hexarouting.answers with no
#     argument reads /run/live/medium/hexarouting.answers - the root of the
#     medium. That one needs nobody to name it, so it is refused whatever is in
#     it: an empty one still proves the build put an answer file there. The
#     name rule is deliberately wider than the parser, and it costs nothing -
#     no file in a real image has "answers" in its name, measured on the
#     16,965 files of hexarouting-0.37.0.
#   - a file whose WHOLE content parses as answers - every non-blank,
#     non-comment line is one of the six keys read_answers() accepts, in the
#     "key = value" form it accepts them in. That is the file the installer
#     takes at HEXA_ANSWERS=<path> whatever it is called, and it is the shape
#     of the mutation in #245: root/answers.conf.
#
# Requiring EVERY line to parse is what keeps this off the installer's own
# source and off the document. A script that assigns hostname= among a hundred
# other lines is a script; a six-line file that is nothing but answers is an
# answer file wherever it sits.
#
# AND ANY OTHER CREDENTIAL
#
# The answer file is one instance of a larger rule, and the larger rule is the
# one worth holding: nothing in a published image may be a secret. So a private
# key, an authorized_keys and an /etc/shadow carrying a usable hash are refused
# on the same grounds.
#
# That group is not hypothetical. Every ISO this project has published carried
# /etc/ssh/ssh_host_{rsa,ecdsa,ed25519}_key, generated inside the build
# container by openssh-server's postinst and squashed in with everything else.
# hexarouting-install unpacks that squashfs onto the disk and then enables sshd
# with PermitRootLogin yes, so every box installed from one release shared one
# host key whose private half was in the download - which is an operator's
# management session impersonated by anybody who fetched the ISO. build-iso.sh
# now removes them and the installer generates a set per box.
#
# WHERE IT IS CALLED
#
#   - appliance/build-iso.sh, on the root before mksquashfs and on the ISO tree
#     before grub-mkrescue. That is the refusal that matters: a build that
#     would ship a credential stops instead of shipping it.
#   - test/test_no_credentials.sh, against fake roots, in make test. Reading a
#     real ISO means building one, which needs root and ten minutes.
#   - lab/install-iso.sh, against the image that was actually built. The fast
#     test proves this script refuses; only the lab proves the file the build
#     shipped was put through it.
set -u

ME=$(basename "$0")
[ $# -ge 1 ] || { echo "usage: $ME <dir> [<dir>...]" >&2; exit 2; }

# The six keys hexarouting-install's read_answers() accepts, in the order of
# its case arms so the two read side by side. A key added there and not here
# makes this blind to the newest kind of answer file, so
# test/test_no_credentials.sh compares the two lists and fails when they drift.
ANSWER_KEYS='disk|hostname|timezone|password|log-gb|mirror|yes'

HITS=$(mktemp) || exit 2
trap 'rm -f "$HITS"' EXIT INT TERM

hit() { printf '%s\t%s\n' "$1" "$2" >> "$HITS"; }

is_answer_file() {  # <file>; true when every line in it is an install answer
  awk -v keys="$ANSWER_KEYS" '
    BEGIN { split(keys, k, "|"); for (i in k) known[k[i]] = 1
            answers = 0; other = 0 }
    # The same lexer as read_answers(): trim, skip blanks, and "#" starts a
    # comment only at the beginning of a line because a password may contain
    # one.
    #
    # A counter rather than an early exit: in awk, exit runs the END block, and
    # END would overwrite the status. That is how the first version of this
    # called a shell script an answer file - the two assignments in it counted
    # and the line that disqualified it did not.
    { line = $0
      sub(/^[ \t]+/, "", line); sub(/[ \t]+$/, "", line)
      if (line == "" || substr(line, 1, 1) == "#") next
      if (index(line, "=") == 0) { other++; next }
      key = substr(line, 1, index(line, "=") - 1)
      sub(/[ \t]+$/, "", key)
      if (key in known) answers++; else other++
    }
    END { exit (other == 0 && answers > 0 ? 0 : 1) }
  ' "$1" 2>/dev/null
}

for d in "$@"; do
  [ -d "$d" ] || { echo "$ME: no such directory: $d" >&2; exit 2; }

  # -xdev throughout: build-iso.sh runs this on a chroot that can still have
  # /proc, /sys or /dev bound underneath it, and walking those is both
  # pointless and slow.
  find "$d" -xdev -type f -name '*answers*' 2>/dev/null | while IFS= read -r f
  do
    hit "$f" "an answer file by its name. hexarouting.answers with no argument reads exactly that path off the medium, so it needs nobody to name it - and a file called anything like it is refused whatever is in it, because an empty one still proves the build put an answer file there (docs/appliance.md: no answer file is shipped in the ISO)"
  done

  # One grep pass narrows a whole root filesystem to the few files carrying a
  # line that looks like an answer; each candidate is then parsed in full.
  # Parsing every file instead takes minutes on a debootstrap chroot, and a
  # check somebody switches off for being slow is not a check.
  #
  # -I skips binaries, which is also what stops the pass over the ISO tree from
  # reading the 300 MB squashfs. Its contents were checked as the root, before
  # it was compressed.
  grep -rlIE "^[[:space:]]*($ANSWER_KEYS)[[:space:]]*=" "$d" 2>/dev/null \
  | while IFS= read -r f; do
      case "$f" in *answers*) continue ;; esac
      # An answer file is six lines. The bound keeps a large configuration file
      # out of the parser, and keeps this from reading anything big twice.
      lines=$(wc -l < "$f" 2>/dev/null || echo 99999)
      [ "$lines" -le 64 ] || continue
      is_answer_file "$f" || continue
      hit "$f" "every line in it is an install answer, so HEXA_ANSWERS on this path installs from it. An answer file carries the root password and this image is published"
    done

  # Private keys. ANCHORED to a whole line, for two reasons: that is what a PEM
  # header is, and unanchored it matches this script's own source - which is
  # how this rule was first seen working, and would have made every tree
  # containing this file dirty. The CA bundle under /etc/ssl/certs is
  # certificates, which have no private half and do not match either way.
  grep -rlIE '^-----BEGIN ([A-Z0-9 ]+ )?PRIVATE KEY-----[[:space:]]*$' \
       "$d" 2>/dev/null \
  | while IFS= read -r f; do
      hit "$f" "a private key. Every box installed from this image would carry the same one, and its private half is in the download"
    done

  find "$d" -xdev -type f -name 'authorized_keys' -size +0 2>/dev/null \
  | while IFS= read -r f; do
      hit "$f" "an authorized_keys in a published image is a login for whoever holds the matching key, on every box installed from it"
    done

  # The live root account is locked on purpose - build-iso.sh runs
  # "passwd -l root" and says why - and locked is '!', '*', '!!' or '!*'.
  # Anything else is a hash somebody can attack offline, out of a file anybody
  # can download, and it is what used to travel onto the disk (#83).
  if [ -f "$d/etc/shadow" ]; then
    awk -F: '$2 != "" && $2 !~ /^[!*]+$/ { print $1 }' "$d/etc/shadow" \
      2>/dev/null | while IFS= read -r u; do
      hit "$d/etc/shadow" "the account '$u' has a usable password hash. The image ships with every account locked; hexarouting-install sets the real password from an answer the operator gave before it wrote anything"
    done
  fi
done

# Reported here, not inside the loops: each pipeline above runs its body in a
# subshell, so a counter incremented there would be back to zero by the time
# this line read it - which is a check that finds everything and reports
# nothing.
[ -s "$HITS" ] || exit 0
sort -u "$HITS" | while IFS="$(printf '\t')" read -r f why; do
  echo "credential in the image: $f" >&2
  echo "  $why" >&2
done
echo "the build MUST NOT put a credential in the image (docs/appliance.md)" >&2
exit 1
