#!/usr/bin/env python3
"""
SNMP agent for the CGNAT, spoken over net-snmp's pass_persist protocol.

Why an agent at all: every ISP already has an NMS, and it is where somebody
actually looks. A CGNAT whose only observability is vppctl on the box is a
CGNAT nobody watches until a customer calls.

Two rules shape everything below.

READ-ONLY. Every SET is refused. Configuration belongs to the VTY, where it is
validated, committed and rollback-able; an SNMP SET that reconfigures a CGNAT
is an outage one typo away.

NO STALE NUMBERS. If the dataplane is not answering, this returns NOTHING
rather than the last values it saw. A monitoring system that keeps reporting
yesterday's numbers through an outage is worse than one that reports none: the
first hides the outage, the second shows it as a gap.
"""

import os
import re
import subprocess
import sys
import time

# Absolute: snmpd hands a pass_persist helper a minimal environment, and a
# PATH lookup that works from a shell can fail there.
VPPCTL = os.environ.get("VPPCTL", "/usr/bin/vppctl")
CACHE_SECONDS = float(os.environ.get("PRISMA_SNMP_CACHE", "10"))

# RFC 4008, natDefTimeouts. Exact mappings, which is the whole reason to use a
# standard MIB: an NMS understands these without a custom template.
NAT_DEF_TIMEOUTS = "1.3.6.1.2.1.123.1.1"
_TIMEOUT_OIDS = [
    (1, "port-holddown"),      # natBindDefIdleTimeout
    (2, "udp"),                # natUdpDefIdleTimeout
    (3, "icmp"),               # natIcmpDefIdleTimeout
    (4, "gre"),                # natOtherDefIdleTimeout
    (5, "tcp-established"),    # natTcpDefIdleTimeout
    (6, "tcp-transitory"),     # natTcpDefNegTimeout
]

# The numbers an operator actually watches have no standard OID, so they live
# under the operator's own IANA Private Enterprise Number. There is no default
# and there cannot be one: an OID under somebody else's PEN is a lie about who
# the object belongs to, and it collides the day that organisation uses the
# same subtree. Until "snmp enterprise-number" is set, this half is dark and
# "show snmp" says so.
def _enterprise():
    """
    The PEN, read from the snmpd.conf this VTY generates.

    Not from the environment: snmpd spawns a pass_persist helper with none, so
    an environment variable would work in a test and be empty on the box.
    """
    override = os.environ.get("PRISMA_SNMP_ENTERPRISE", "").strip()
    if override:
        return override
    # ON ITS OWN COMMAND LINE FIRST (#499): snmpd runs this agent as
    # Debian-snmp, and the snmpd.conf the VTY writes is 0600 root - it holds
    # the communities - so on an installed box the file below cannot be
    # opened, the number came back empty, and the whole enterprise half was
    # dark while the lab, running everything as root, read it fine. The VTY
    # writes the number onto the pass_persist line instead.
    for i, a in enumerate(sys.argv[1:-1], 1):
        if a == "--enterprise" and sys.argv[i + 1].isdigit():
            return sys.argv[i + 1]
    try:
        with open(os.environ.get("PRISMA_SNMPD_CONF", "/etc/snmp/snmpd.conf")) as f:
            for line in f:
                w = line.split()
                # FROM THIS AGENT'S OWN REGISTRATION, "pass_persist <oid>
                # <agent>", and not from a view line (#497): the view carries
                # UCD-SNMP-MIB's .1.3.6.1.4.1.2021 as well, and reading the
                # first enterprise OID there made this agent serve the CGNAT
                # under net-snmp's number - measured in lab/snmp.sh, a getnext
                # from .1.3.6.1.4.1 answered .1.3.6.1.4.1.2021.1.1.0. The
                # NAT-MIB registration is under .1.3.6.1.2.1 and never matches.
                if len(w) > 1 and w[0] == "pass_persist" \
                        and w[1].startswith(".1.3.6.1.4.1."):
                    return w[1].rsplit(".", 1)[-1]
    except OSError:
        pass
    return ""


ENTERPRISE = _enterprise()

# The box's totals at the OIDs they have had since this agent was written,
# with the types PRISMA-ROUTING-MIB declares (#504): the four that go down as
# well as up are gauges. They were all served as Counter32, and an NMS told a
# gauge is a counter draws a falling value as a wrap - the spike the wiki had
# to warn about.
_ENTERPRISE_OBJECTS = [
    (1, "subscribers", "gauge", "the subscribers holding a block right now"),
    (2, "portsUsed", "gauge", "ports allocated across all subscribers"),
    (3, "portsTotal", "gauge", "ports in the blocks currently held"),
    (4, "subscribersAtLimit", "gauge", "subscribers at 90% of their blocks or more"),
    (5, "portRefusals", "counter", "times a subscriber was refused a port"),
    (6, "packetsDropped", "counter", "packets the CGNAT did not pass"),
]


def vppctl(cmd):
    try:
        p = subprocess.run([VPPCTL] + cmd.split(), capture_output=True,
                           text=True, timeout=5)
    except (OSError, subprocess.TimeoutExpired):
        return None
    if p.returncode != 0:
        return None
    # vppctl exits 0 for a command it did not understand and says so on
    # stdout. Without this the agent parsed an error message into no values at
    # all and served nothing, which is indistinguishable from a dataplane that
    # is down - and that is exactly what happened while this was written.
    if "unknown input" in p.stdout or p.stdout.startswith(("show bpa:", "bpa:")):
        return None
    return p.stdout


class Values:
    def __init__(self):
        self.at = 0.0
        self.data = {}

    def refresh(self):
        # The liveness check runs on EVERY poll, before the cache is consulted.
        #
        # Caching it too would be the obvious saving and it is the whole bug:
        # with a ten-second cache, the first ten seconds of an outage are
        # served as though nothing had happened. Measured - the lab killed the
        # dataplane and SNMP went on reporting a subscriber. One extra vppctl
        # per poll is what "no stale numbers" costs.
        if not vppctl("show version"):
            self.data = {}
            self.at = 0.0
            return self.data

        if time.time() - self.at < CACHE_SECONDS and self.data:
            return self.data

        d = {}
        t = vppctl("bpa timeouts") or ""
        w = t.split()
        for i in range(0, len(w) - 1):
            if w[i] in ("udp", "icmp", "tcp-syn", "tcp-transitory",
                        "tcp-established", "gre", "port-holddown",
                        "alg-expect") and w[i + 1].isdigit():
                d[w[i]] = int(w[i + 1])

        # THE CGNAT'S NUMBERS, FROM THE STATISTICS SEGMENT (#504). They were
        # parsed out of `show bpa top 100000`, a walk of every subscriber in
        # every worker's table on each refresh - a million entries on a box
        # sized for a million subscribers, every ten seconds, to answer six
        # numbers. The dataplane keeps them where they change now.
        stats = stats_dump("^/bpa/")
        drops = parse_drops(vppctl("show bpa drops") or "")
        d["cgnat"] = cgnat_state(stats, drops)
        d["config"] = parse_bpa_config(vppctl("show bpa config") or "")
        d.update(cgnat_totals(d["cgnat"]))
        d["release"] = _read(VERSION_FILE).split()[0] if _read(VERSION_FILE) else ""
        d["build"] = plugin_build(vppctl("show plugins") or "")
        d["dp_uptime"] = vpp_clock(vppctl("show clock") or "")
        # #505: each one command the VTY's own screens run, none a walk.
        vrrp_text = vppctl("show vrrp vr") or ""
        if_names = parse_stats_dump(stats_dump("^/if/names$"))[0]
        vrrp_detail = parse_vrrp_detail(vrrp_text, if_names)
        addr_text = vppctl("show interface address") or ""
        # IP-MIB (#522): the cards with an address, by vpp_cards' rule.
        prefixes = {n: p for n, p in parse_interface_prefixes(addr_text).items()
                    if p and n != "local0" and not n.startswith("tap")}
        free = heap_free(vppctl("show memory main-heap") or "")
        bonds = parse_bond(vppctl("show bond") or "")
        # IEEE8023-LAG-MIB (#515): the LACP bundles only, and the two screens
        # read only when there is one.
        lag = ({b: v for b, v in parse_bond_details(
                   vppctl("show bond details") or "").items()
                if b in {x[0] for x in bonds if x[1] == "lacp"}}
               if any(x[1] == "lacp" for x in bonds) else {})
        d["extra"] = {
            "fit": free // SESSION_BYTES if free is not None else None,
            "workers": worker_rows(parse_stats_threads(stats, "/bpa/pool/")),
            "vrrp": parse_vrrp(vrrp_text, if_names),
            "vrrpv3": vrrpv3_rows(
                vrrp_detail,
                # Only the VRRP routers' interfaces: every name handed over is
                # given an ifIndex for good, and local0 and the taps have none
                # in IF-MIB (#498).
                if_indexes(sorted({r["interface"] for r in vrrp_detail})),
                parse_interface_addresses(addr_text))
            if vrrp_detail else [],
            "bonds": bonds,
            "lag": lag_rows(lag, parse_lacp_details(
                vppctl("show lacp details") or ""),
                if_indexes(sorted(set(lag) | {m for b in lag.values()
                                              for m in b["members"]})))
            if lag else [],
            "identity": parse_identity(vppctl("show bpa identity") or ""),
            "ip": ip_rows(prefixes, if_indexes(sorted(prefixes))),
        }
        self.data = d
        self.at = time.time()
        return d


VALUES = Values()


# --- PRISMA-ROUTING-MIB: the CGNAT, its records, the box (#504) --------------
#
# appliance/PRISMA-ROUTING-MIB.in is the definition; test_snmp_agent.py holds
# every OID and type served here against it, so the two cannot drift.

VERSION_FILE = os.environ.get("PRISMA_VERSION_FILE",
                              "/usr/share/prisma-routing/VERSION")
POOL_STATS = ["subscribers", "blocks", "sessions", "refused", "ports",
              "near-full", "mode", "block-size", "inside", "outside",
              "blocks-total", "capacity", "guaranteed"]
TRANSPORTS = [(1, "tcp"), (2, "syslog")]


# not a unit: runs vpp_get_stats against the live dataplane; what it returns
# is parsed by parse_stats_dump and parse_stats_gauges, which are
def stats_dump(pattern):
    try:
        p = subprocess.run([VPP_GET_STATS, "socket-name", STATS_SOCKET, "dump",
                            pattern], capture_output=True, text=True, timeout=5)
        return p.stdout if p.returncode == 0 else ""
    except (OSError, subprocess.TimeoutExpired):
        return ""


def parse_stats_gauges(text, prefix):
    """
    {name: value} for the scalar gauges under `prefix`, which vpp_get_stats
    prints as "<value> <path>" with two decimals.
    """
    out = {}
    for line in text.splitlines():
        f = line.split()
        if len(f) == 2 and f[1].startswith(prefix):
            try:
                out[f[1][len(prefix):]] = int(float(f[0]))
            except ValueError:
                continue
    return out


def parse_drops(text):
    """
    [(node, reason, packets)] from `show bpa drops`: the rows under "did not
    get through", and not those under "everything else it counted" - a packet
    translated is counted by the same node and is not a drop.
    """
    out, node, counting = [], "", False
    for line in text.splitlines():
        if line and not line.startswith(" "):
            node, counting = line.strip(), False
            continue
        if "did not get through" in line:
            counting = True
            continue
        if "everything else" in line or "nothing dropped" in line:
            counting = False
            continue
        f = line.split(None, 1)
        if counting and len(f) == 2 and f[0].isdigit():
            out.append((node, f[1].strip(), int(f[0])))
    return out


PLUGIN_ROW = re.compile(r"\bbpa_plugin\.so\s{2,}(\S.*?)\s{2,}\S", re.M)


def plugin_build(text):
    """
    The build the running dataplane's plugin reports in `show plugins`, or ''.
    The same row and pattern `show version` reads (prismash's Dataplane).
    """
    m = PLUGIN_ROW.search(text)
    return m.group(1).strip() if m else ""


def cgnat_state(stats, drops):
    """
    {"pools": {index: {field: value}}, "drops": [...], "log": {...}} from a
    dump of /bpa/ and the drop rows. A pool whose name is empty was deleted:
    its index is waiting for the next pool and it has no row.
    """
    names, counters = parse_stats_dump(stats, "/bpa/pool/")
    pools = {}
    for idx, name in names.items():
        if not name:
            continue
        pools[idx] = {"name": name}
        for f in POOL_STATS:
            pools[idx][f] = counters.get(f, {}).get(idx, [0, 0])[0]
    return {"pools": pools, "drops": drops,
            "log": parse_stats_gauges(stats, "/bpa/log/")}


def cgnat_totals(state):
    """The six totals the enterprise subtree has always served."""
    pools = state["pools"].values()
    return {
        "subscribers": sum(p["subscribers"] for p in pools),
        "portsUsed": sum(p["ports"] for p in pools),
        "portsTotal": sum(p["blocks"] * p["block-size"] for p in pools),
        "subscribersAtLimit": sum(p["near-full"] for p in pools),
        "portRefusals": sum(p["refused"] for p in pools),
        "packetsDropped": sum(n for _node, _reason, n in state["drops"]),
    }


def vpp_clock(text):
    """
    Seconds the dataplane has run, from `show clock`'s "Time now <s>" (#534),
    or None - the reading the VTY's `show system uptime` makes.
    """
    m = re.search(r"Time now\s+([0-9.]+)", text)
    return float(m.group(1)) if m else None


def product_rows(base, state, release, build, dp_uptime=None):
    """
    PRISMA-ROUTING-MIB's rows under `base` (the enterprise's .1), beyond the
    six totals: the pool table, the drops, the sessions, the transports and
    the box.
    """
    out = []
    pools = state["pools"]
    cols = [(2, "string", "name"), (3, "integer", "mode"),
            (4, "gauge", "block-size"), (5, "gauge", "inside"),
            (6, "gauge", "outside"), (7, "gauge", "blocks-total"),
            (8, "gauge", "capacity"), (9, "gauge", "guaranteed"),
            (10, "gauge", "subscribers"), (11, "gauge", "blocks"),
            (12, "gauge", None), (13, "gauge", "sessions"),
            (14, "gauge", "ports"), (15, "gauge", "near-full"),
            (16, "counter64", "refused")]
    for col, typ, f in cols:
        for idx in sorted(pools):
            p = pools[idx]
            if f is None:           # utilisation, in percent
                v = (p["blocks"] * 100 // p["blocks-total"]
                     if p["blocks-total"] else 0)
            else:
                v = p[f]
            out.append((f"{base}.10.1.1.{col}.{idx + 1}", typ, v))
    drops = sorted(state["drops"], key=lambda r: (r[0], r[1]))
    for col, typ, i in ((2, "string", 0), (3, "string", 1),
                        (4, "counter64", 2)):
        for n, r in enumerate(drops, 1):
            out.append((f"{base}.10.2.1.{col}.{n}", typ, r[i]))
    out.append((f"{base}.10.3.0", "gauge",
                sum(p["sessions"] for p in pools.values())))
    log = state["log"]
    truth = {True: 1, False: 2}
    out.append((f"{base}.11.1.0", "integer",
                truth[bool(log.get("ipfix/enabled"))]))
    out.append((f"{base}.11.2.0", "counter64", log.get("ipfix/records", 0)))
    out.append((f"{base}.11.3.0", "counter64", log.get("ipfix/dropped", 0)))
    tcols = [(2, "string", None), (3, "integer", "enabled"),
             (4, "integer", "connected"), (5, "counter64", "records"),
             (6, "counter64", "sent"), (7, "counter64", "spilled"),
             (8, "counter64", "dropped"), (9, "counter", "connects")]
    for col, typ, f in tcols:
        for i, name in TRANSPORTS:
            if f is None:
                v = name
            elif typ == "integer":
                v = truth[bool(log.get(f"{name}/{f}"))]
            else:
                v = log.get(f"{name}/{f}", 0) % (2 ** 32 if typ == "counter"
                                                 else 2 ** 64)
            out.append((f"{base}.11.10.1.{col}.{i}", typ, v))
    out.append((f"{base}.12.1.0", "string", release))
    out.append((f"{base}.12.2.0", "string", build))
    out.append((f"{base}.12.3.0", "integer",
                truth[bool(release) and build.split()[:1] == [release]]))
    # #534: VPP's own clock, in hundredths; left out when it did not answer.
    if dp_uptime is not None:
        out.append((f"{base}.12.4.0", "timeticks", int(dp_uptime * 100)))
    return out


# --- PRISMA-ROUTING-MIB, second part: workers, capacity, HA, LACP (#505) ---

#: What a session takes of the dataplane's heap, measured; the VTY's
#: `show cgnat memory` divides by the same number (prismash.SESSION_BYTES,
#: which test_snmp_agent.py holds this against).
SESSION_BYTES = 300


def parse_stats_threads(text, prefix):
    """
    {stat: {index: {thread: value}}} for the simple counters under `prefix`:
    what parse_stats_dump sums, kept per thread.
    """
    out = {}
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("[") or "]: " not in line:
            continue
        head, rest = line[1:].split("]: ", 1)
        stat = rest.rsplit(" ", 1)[-1]
        if not stat.startswith(prefix) or " @ " not in head:
            continue
        idx, thread = head.split(" @ ")
        try:
            v = int(rest.split()[0])
            out.setdefault(stat[len(prefix):], {}).setdefault(
                int(idx), {})[int(thread)] = v
        except ValueError:
            continue
    return out


def worker_rows(threads):
    """
    [(thread, subscribers, sessions, ports)] summed over the pools, one per
    thread that has ever had a counter slot.
    """
    seen = set()
    for per_idx in threads.values():
        for per_thread in per_idx.values():
            seen.update(per_thread)
    rows = []
    for t in sorted(seen):
        # not a unit: a closure over this loop's thread, measured through the
        # rows worker_rows builds in test_snmp_agent.py
        def total(stat):
            return sum(v.get(t, 0) for v in threads.get(stat, {}).values())
        rows.append((t, total("subscribers"), total("sessions"),
                     total("ports")))
    return rows


def heap_free(text):
    """The dataplane's free heap in bytes, off `show memory main-heap`."""
    m = re.search(r"free:\s*([0-9.]+)([KMGT]?)", text or "")
    if not m:
        return None
    return int(float(m.group(1)) * (1 << (10 * " KMGT".index(m.group(2) or " "))))


VRRP_STATES = {"init": 1, "initialize": 1, "backup": 2, "master": 3,
               "interface down": 4, "intf down": 4}


def more_rows(base, extra):
    """
    #505's rows under `base`: the session capacity and the workers under the
    CGNAT, the VRRP routers, the LACP bundles and the identity sources.
    `extra` is what refresh() read: fit, workers, vrrp, bonds, identity.
    """
    out = []
    if extra.get("fit") is not None:
        out.append((f"{base}.10.4.0", "gauge", extra["fit"]))
    workers = extra.get("workers", [])
    for col, i in ((2, 1), (3, 2), (4, 3)):
        for w in workers:
            out.append((f"{base}.10.5.1.{col}.{w[0] + 1}", "gauge", w[i]))
    vrrp = extra.get("vrrp", [])
    for col, typ, i in ((2, "string", 0), (3, "gauge", 1), (4, "gauge", 2),
                        (5, "integer", 3), (6, "string", 4)):
        for n, r in enumerate(vrrp, 1):
            out.append((f"{base}.13.1.1.{col}.{n}", typ, r[i]))
    bonds = extra.get("bonds", [])
    for col, typ, i in ((2, "string", 0), (3, "string", 1), (4, "gauge", 2),
                        (5, "gauge", 3)):
        for n, b in enumerate(bonds, 1):
            out.append((f"{base}.14.1.1.{col}.{n}", typ, b[i]))
    ident = extra.get("identity")
    if ident is not None:
        out += [(f"{base}.15.1.0", "gauge", ident["entries"]),
                (f"{base}.15.2.0", "string", ident["read"]),
                (f"{base}.15.3.0", "counter64", ident["received"]),
                (f"{base}.15.4.0", "counter64", ident["applied"]),
                (f"{base}.15.5.0", "counter64", ident["refused"])]
    return out


def parse_vrrp(text, names=None):
    """
    [(interface, vr_id, priority, state, addresses)] off `show vrrp vr`,
    whose blocks open with "[n] sw_if_index <i> VR ID <id> IPv4": the
    interface named through `names` ({sw_if_index: name}, /if/names), the
    priority the one advertised now ("adjusted"), the state as
    PRISMA-ROUTING-MIB numbers it. Sorted by interface, then VR ID.
    """
    names = names or {}
    rows, cur = [], None
    for line in text.replace("\r", "").splitlines():
        m = re.match(r"\[\d+\] sw_if_index (\d+) VR ID (\d+)", line.strip())
        if m:
            cur = [names.get(int(m.group(1)), f"sw_if_index {m.group(1)}"),
                   int(m.group(2)), 0, 1, ""]
            rows.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"state (.+?) flags:", line.strip())
        if m:
            cur[3] = VRRP_STATES.get(m.group(1).lower(), 1)
            continue
        m = re.search(r"adjusted (\d+)", line)
        if m and "priority" in line:
            cur[2] = int(m.group(1))
            continue
        if line.strip().startswith("addresses"):
            cur[4] = " ".join(line.split()[1:])
    return sorted(tuple(r) for r in rows)


def parse_bond(text):
    """
    [(name, mode, members, active)] off `show bond`'s table:
    interface name, sw_if_index, mode, load balance, active members, members.
    """
    out = []
    for line in text.splitlines():
        f = line.split()
        if len(f) == 6 and f[1].isdigit() and f[4].isdigit() and f[5].isdigit():
            out.append((f[0], f[2], int(f[5]), int(f[4])))
    return sorted(out)


def parse_identity(text):
    """
    {"entries", "read", "received", "applied", "refused"} off
    `show bpa identity`; entries 0 and read "" when there is no table.
    """
    d = {"entries": 0, "read": "", "received": 0, "applied": 0, "refused": 0}
    m = re.search(r"identity table:\s*(\d+) entry\(s\), read (.+)", text)
    if m:
        d["entries"] = int(m.group(1))
        d["read"] = m.group(2).strip()
    m = re.search(r"packets\s+(\d+) received, (\d+) applied", text)
    if m:
        d["received"], d["applied"] = int(m.group(1)), int(m.group(2))
    m = re.search(r"refused\s+(\d+) bad authenticator, (\d+) malformed", text)
    if m:
        d["refused"] = int(m.group(1)) + int(m.group(2))
    return d


# --- NATV2-MIB, RFC 7659: the IETF's own CGNAT MIB, aggregate only (#512) ---
#
# ONE NAT INSTANCE PER POOL. Filtering behaviour is a pool's setting here, and
# an instance is where RFC 7659 puts it. By the maintainer's decision no table
# with a row per subscriber or per mapping is served: the protocol,
# subscriber, address map and port map tables are left out, and so is every
# column whose number the box keeps only box-wide - served under a pool, it
# would be a number that pool did not count.

NATV2 = "1.3.6.1.2.1.234"


def parse_bpa_config(text):
    """
    {pool name: {"outside": [(first, last)], "ports": (min, max),
    "max_blocks": n, "filter": 0|1}} off `show bpa config`, which prints the
    configuration in VTY syntax and walks nothing. A field left at its
    default is not printed there, and is the default here.
    """
    import ipaddress
    pools, cur = {}, None
    for line in text.replace("\r", "").splitlines():
        w = line.split()
        if not w:
            continue
        if not line.startswith(" "):
            # A pool's block opens at `cgnat pool <name>`; any other line at
            # the left margin - `cgnat interface`, another pool - closes it.
            cur = (pools.setdefault(w[2], {"outside": [],
                                           "ports": (1024, 65535),
                                           "max_blocks": 1, "filter": 0})
                   if w[:2] == ["cgnat", "pool"] and len(w) == 3 else None)
            continue
        if cur is None:
            continue
        try:
            if w[0] == "outside" and len(w) == 2:
                net = ipaddress.ip_network(w[1], strict=False)
                cur["outside"].append((str(net.network_address),
                                       str(net.broadcast_address)))
            elif w[0] == "ports" and len(w) == 3:
                cur["ports"] = (int(w[1]), int(w[2]))
            elif w[0] == "max-blocks" and len(w) == 2:
                cur["max_blocks"] = int(w[1])
            elif w[:2] == ["filter", "address-dependent"]:
                cur["filter"] = 1
        except ValueError:
            continue
    return pools


def natv2_rows(state, config):
    """
    NATV2-MIB's rows for the pools the statistics segment names, with what
    `show bpa config` says of each. Every value is the pool's own.
    """
    out = []
    pools = state.get("pools", {})
    rows = [(idx + 1, pools[idx], config.get(pools[idx]["name"], {}))
            for idx in sorted(pools)]
    inst = f"{NATV2}.2.1.1"
    cols = [
        (2, "string", lambda p, c: p["name"]),                 # alias
        (3, "integer", lambda p, c: 0),     # endpointIndependent: lab/nat-behaviour.sh
        (4, "integer", lambda p, c: c.get("filter", 0)),       # the pool's filter
        # paired unless a subscriber may hold blocks on several addresses
        (5, "integer", lambda p, c: 1 if c.get("max_blocks", 1) <= 1 else 0),
        (6, "integer", lambda p, c: 1),     # fragmentInOrder: what lab/frag.sh measures
        (7, "gauge", lambda p, c: p["subscribers"]),           # address map entries
        (8, "gauge", lambda p, c: p["ports"]),                 # port map entries
        (16, "counter64", lambda p, c: p["refused"]),          # port map failure drops
        (19, "timeticks", lambda p, c: 0),                     # discontinuity
        (20, "integer", lambda p, c: -1),   # thresholds: the RFC's notifications
        (21, "integer", lambda p, c: -1),   # are not sent; the product's are (#507)
        (22, "gauge", lambda p, c: 60),
        (23, "gauge", lambda p, c: 0), (24, "gauge", lambda p, c: 0),
        (25, "gauge", lambda p, c: 0), (26, "gauge", lambda p, c: 0),
    ]
    for col, typ, f in cols:
        for i, p, c in rows:
            out.append((f"{inst}.{col}.{i}", typ, f(p, c)))
    pool = f"{NATV2}.2.3.1"
    pcols = [
        (3, "string", lambda p, c: "external"),
        (4, "integer", lambda p, c: 1),                        # ipv4
        (5, "gauge", lambda p, c: c.get("ports", (1024, 65535))[0]),
        (6, "gauge", lambda p, c: c.get("ports", (1024, 65535))[1]),
        (7, "gauge", lambda p, c: p["subscribers"]),
        (8, "gauge", lambda p, c: p["ports"]),
        (12, "counter64", lambda p, c: p["refused"]),
        (13, "timeticks", lambda p, c: 0),
        (14, "integer", lambda p, c: -1), (15, "integer", lambda p, c: -1),
        (18, "gauge", lambda p, c: 60),
    ]
    for col, typ, f in pcols:
        for i, p, c in rows:
            out.append((f"{pool}.{col}.{i}.1", typ, f(p, c)))
    rng = f"{NATV2}.2.4.1"
    for col, at in ((4, 0), (5, 1)):
        for i, p, c in rows:
            for n, r in enumerate(c.get("outside", []), 1):
                out.append((f"{rng}.{col}.{i}.1.{n}", "octet",
                            " ".join(f"{int(b):02X}" for b in r[at].split("."))))
    return out


# --- the box's own state: tuning, self-test, configuration, trail (#524) ----
#
# Phase 4 of docs/snmp-plan.md. Four groups under PRISMA-ROUTING-MIB, each
# read from what the box already writes, and each LEFT OUT - not served as a
# zero - when its source cannot be read: a box whose self-test never ran is
# not a box whose self-test found nothing.
#
# WHO CAN READ WHAT. This agent is Debian-snmp, in no group but its own and
# vpp's. The tuner's files and /sys are world-readable. The configuration
# store is not, and must not be: /etc/prisma-routing is 2770 root:prisma-cgnat
# and every revision in it carries password hashes. So the VTY and the
# self-test each write a few lines that say nothing secret into
# /run/prisma-routing/state, 0644, and those are what is read here.
#
# Tuning, self-test and configuration are served whether or not the
# dataplane answers: they are about the box, and the box whose dataplane did
# not come up is the one somebody needs them for. The trail is the
# dataplane's own answer and goes with it.

STARTUP_CONF = os.environ.get("PRISMA_STARTUP_CONF", "/etc/vpp/startup.conf")
GRUB_CFG = os.environ.get("PRISMA_GRUB_CFG",
                          "/etc/default/grub.d/prisma-routing.cfg")
SYSFS = os.environ.get("PRISMA_SYSFS_ROOT", "/sys")
STATE_DIR = os.environ.get("PRISMA_STATE_DIR", "/run/prisma-routing/state")
#: `show bpa pool history verify` reads the whole trail, so it is asked at
#: most this often; the trail changes at a commit, not every poll.
AUDIT_SECONDS = float(os.environ.get("PRISMA_SNMP_AUDIT_CACHE", "300"))
TUNING_STATES = {"tuned": 1, "between": 2, "firstboot": 3}
SELFTEST_VERDICTS = {"ready": 1, "warnings": 2, "notforwarding": 3,
                     "failed": 4}
AUDIT_STATES = {"intact": 1, "empty": 2, "broken": 3, "truncated": 4,
                "incomplete": 5}


def _read_or_none(path):
    """A file's text, or None when it is not there or cannot be read."""
    try:
        with open(path) as fh:
            return fh.read()
    except OSError:
        return None


def cpu_count(spec):
    """How many CPUs a list like '2-6,9' names; 0 for none."""
    n = 0
    for part in spec.replace(" ", "").split(","):
        if not part:
            continue
        a, _, b = part.partition("-")
        if a.isdigit() and (not b or b.isdigit()):
            n += int(b or a) - int(a) + 1
    return n


def parse_startup_state(text):
    """
    (state, workers this boot, workers the next boot) off the header and the
    `corelist-workers` line prisma-routing-tune writes into startup.conf.
    """
    if text is None:
        return None
    m = re.search(r"^\s*corelist-workers\s+(\S+)", text, re.M)
    now = cpu_count(m.group(1)) if m else 0
    m = re.search(r"# BETWEEN TWO PLANS\..*?runs (\d+)\.", text, re.S)
    if m:
        return ("between", now, int(m.group(1)))
    if "# FIRST BOOT MODE" in text:
        return ("firstboot", now, now)
    return ("tuned", now, now)


def parse_grub_request(text):
    """
    What the tuner asked the kernel for: (isolcpus, hugepage size in kB,
    hugepages), off its GRUB_CMDLINE line. None when it asked nothing.
    """
    if not text:
        return None
    iso = re.search(r"isolcpus=(?:[a-z_]+,)*([0-9][0-9,-]*)", text)
    size = re.search(r"\bhugepagesz=(\d+)([GMK])", text)
    count = re.search(r"\bhugepages=(\d+)", text)
    kb = 0
    if size:
        kb = int(size.group(1)) * {"G": 1048576, "M": 1024, "K": 1}[size.group(2)]
    return (iso.group(1) if iso else "", kb, int(count.group(1)) if count else 0)


def hugepages_reserved(kb, root=None):
    """The kernel's pages of `kb` kB reserved now, or None if it cannot say."""
    root = root or SYSFS
    if not kb:
        return None
    t = _read_or_none(os.path.join(
        root, f"kernel/mm/hugepages/hugepages-{kb}kB/nr_hugepages"))
    return int(t) if t and t.strip().isdigit() else None


def parse_state_file(text):
    """{key: value} off the `key value` lines of a file in STATE_DIR."""
    if text is None:
        return None
    out = {}
    for line in text.splitlines():
        k, _, v = line.strip().partition(" ")
        if k and not k.startswith("#"):
            out[k] = v.strip()
    return out


def parse_audit_verify(text):
    """
    The configuration trail's verdict off `show bpa pool history verify`:
    state, entries checked, the head's sequence and digest, entries lost.
    """
    if not text or "configuration trail:" not in text:
        return None
    d = {"state": "intact", "entries": 0, "seq": 0, "digest": "", "lost": 0}
    m = re.search(r"(\d+) entr(?:y|ies) checked", text)
    if m:
        d["entries"] = int(m.group(1))
    m = re.search(r"head\s+seq (\d+) sha256 ([0-9a-f]+)", text)
    if m:
        d["seq"], d["digest"] = int(m.group(1)), m.group(2)
    m = re.search(r"INCOMPLETE: (\d+) entr", text)
    if m:
        d["lost"] = int(m.group(1))
    if "BROKEN" in text:
        d["state"] = "broken"
    elif "TRUNCATED" in text:
        d["state"] = "truncated"
    elif d["lost"]:
        d["state"] = "incomplete"
    elif "no chained entries" in text or "no trail at" in text:
        d["state"] = "empty"
    return d


def _utc(epoch):
    """An epoch as the UTC time the product MIB prints, '' for none."""
    try:
        e = int(epoch)
    except (TypeError, ValueError):
        return ""
    return time.strftime("%Y-%m-%dT%H:%M:%SZ", time.gmtime(e)) if e else ""


def box_state(startup=None, grub=None, sysfs=None, state_dir=None):
    """
    What box_rows() serves, read now: tuning, self-test and configuration,
    each None when its source cannot be read. The paths default to the
    module's, read at the call so a test can point them elsewhere.
    """
    startup = startup or STARTUP_CONF
    grub = grub or GRUB_CFG
    sysfs = sysfs or SYSFS
    state_dir = state_dir or STATE_DIR
    tuning = None
    st = parse_startup_state(_read_or_none(startup))
    if st is not None:
        req = parse_grub_request(_read_or_none(grub)) or ("", 0, 0)
        tuning = {"state": st[0], "workers": st[1], "workers_next": st[2],
                  "isolated": (_read_or_none(os.path.join(
                      sysfs, "devices/system/cpu/isolated")) or "").strip(),
                  "isolated_wanted": req[0],
                  "hugepages": hugepages_reserved(req[1], sysfs),
                  "hugepages_wanted": req[2]}
    return {"tuning": tuning,
            "selftest": parse_state_file(_read_or_none(
                os.path.join(state_dir, "selftest"))),
            "config": parse_state_file(_read_or_none(
                os.path.join(state_dir, "config")))}


def _int(d, k):
    """d[k] as a non-negative int, 0 when it is missing or not a number."""
    v = str(d.get(k, "")).strip()
    return int(v) if v.isdigit() else 0


def box_rows(base, box, trail=None):
    """
    PRISMA-ROUTING-MIB's #524 rows under `base` for `box` (box_state()) and
    `trail` (parse_audit_verify()): prTuning (.16), prSelfTest (.17),
    prConfig (.18), prAudit (.19). A group whose source was not read is
    left out whole.
    """
    truth = {True: 1, False: 2}
    out = []
    t = box.get("tuning")
    if t:
        out += [(f"{base}.16.1.0", "integer", TUNING_STATES[t["state"]]),
                (f"{base}.16.2.0", "gauge", t["workers"]),
                (f"{base}.16.3.0", "gauge", t["workers_next"]),
                (f"{base}.16.4.0", "string", t["isolated"]),
                (f"{base}.16.5.0", "string", t["isolated_wanted"]),
                (f"{base}.16.7.0", "gauge", t["hugepages_wanted"])]
        if t["hugepages"] is not None:
            out.append((f"{base}.16.6.0", "gauge", t["hugepages"]))
    s = box.get("selftest")
    if s is not None:
        fails, warns = _int(s, "fail"), _int(s, "warn")
        verdict = ("failed" if fails else "notforwarding"
                   if s.get("forwarding") == "no" else "warnings" if warns
                   else "ready")
        out += [(f"{base}.17.1.0", "integer", SELFTEST_VERDICTS[verdict]),
                (f"{base}.17.2.0", "gauge", fails),
                (f"{base}.17.3.0", "gauge", warns),
                (f"{base}.17.4.0", "string", _utc(s.get("at")))]
    c = box.get("config")
    if c is not None:
        out += [(f"{base}.18.1.0", "counter", _int(c, "commits") % 2 ** 32),
                (f"{base}.18.2.0", "string", _utc(c.get("commit_at"))),
                (f"{base}.18.3.0", "string", c.get("commit_by", "")),
                (f"{base}.18.4.0", "integer",
                 truth[c.get("confirm_pending") == "yes"]),
                (f"{base}.18.5.0", "string",
                 _utc(c.get("confirm_deadline"))
                 if c.get("confirm_pending") == "yes" else ""),
                (f"{base}.18.6.0", "counter",
                 _int(c, "confirm_reverts") % 2 ** 32),
                (f"{base}.18.7.0", "counter", _int(c, "rollbacks") % 2 ** 32),
                (f"{base}.18.8.0", "integer",
                 truth[c.get("saved_differs") == "yes"])]
    if trail is not None:
        out += [(f"{base}.19.1.0", "integer", AUDIT_STATES[trail["state"]]),
                (f"{base}.19.2.0", "gauge", trail["entries"]),
                (f"{base}.19.3.0", "gauge", trail["seq"] % 2 ** 32),
                (f"{base}.19.4.0", "string", trail["digest"]),
                (f"{base}.19.5.0", "gauge", trail["lost"])]
    return out


class Audit:
    """
    The trail's verdict, asked of the dataplane at most every AUDIT_SECONDS:
    verify reads the whole file, and a poll every ten seconds would read it
    six times a minute for an answer that changes at a commit.
    """

    def __init__(self):
        self.at = 0.0
        self.data = None

    # not a unit: asks the running dataplane through vppctl; the parsing is
    # parse_audit_verify(), which test_snmp_agent.py holds.
    def refresh(self):
        if time.time() - self.at < AUDIT_SECONDS and self.data is not None:
            return self.data
        self.data = parse_audit_verify(vppctl("show bpa pool history verify"))
        self.at = time.time()
        return self.data


AUDIT = Audit()


class Box:
    """
    box_state(), read at most every CACHE_SECONDS like the rest: a walk asks
    this table once per OID, and each asking would read six files.
    """

    def __init__(self):
        self.at = 0.0
        self.data = None

    # not a unit: box_state() and the clock; box_state() is held by
    # test_snmp_agent.py, and the window is Values' own.
    def refresh(self):
        if time.time() - self.at < CACHE_SECONDS and self.data is not None:
            return self.data
        self.data = box_state()
        self.at = time.time()
        return self.data


BOX = Box()


# --- VRRPV3-MIB, RFC 6527: the VRRP routers in the IETF's own MIB (#513) ----

VRRPV3 = "1.3.6.1.2.1.207"
VRRPV3_STATUS = {"initialize": 1, "backup": 2, "master": 3, "interface down": 1}


def parse_vrrp_detail(text, names=None):
    """
    Every virtual router `show vrrp vr` prints, as a dict: interface (named
    through /if/names), vr_id, family (4 or 6), status as VRRPV3-MIB numbers
    it, the configured priority, the advertisement interval in centiseconds,
    the virtual MAC, preempt and accept, and the virtual addresses.
    """
    names = names or {}
    out, cur = [], None
    for line in text.replace("\r", "").splitlines():
        t = line.strip()
        m = re.match(r"\[\d+\] sw_if_index (\d+) VR ID (\d+) IPv(\d)", t)
        if m:
            cur = {"interface": names.get(int(m.group(1)),
                                         f"sw_if_index {m.group(1)}"),
                   "vr_id": int(m.group(2)), "family": int(m.group(3)),
                   "status": 1, "priority": 0, "adv": 100, "mac": "",
                   "preempt": False, "accept": False, "addresses": []}
            out.append(cur)
            continue
        if cur is None:
            continue
        m = re.match(r"state (.+?) flags: preempt (\w+) accept (\w+)", t)
        if m:
            cur["status"] = VRRPV3_STATUS.get(m.group(1).lower(), 1)
            cur["preempt"] = m.group(2) == "yes"
            cur["accept"] = m.group(3) == "yes"
            continue
        m = re.match(r"priority: configured (\d+)", t)
        if m:
            cur["priority"] = int(m.group(1))
            continue
        m = re.match(r"timers: adv interval (\d+)", t)
        if m:
            cur["adv"] = int(m.group(1))
            continue
        m = re.match(r"virtual MAC (\S+)", t)
        if m:
            cur["mac"] = m.group(1)
            continue
        if t.startswith("addresses"):
            cur["addresses"] = t.split()[1:]
    return sorted(out, key=lambda r: (r["interface"], r["vr_id"], r["family"]))


def parse_interface_prefixes(text):
    """{interface: [(address, prefix length), ...]} off `show interface address`."""
    out, cur = {}, None
    for line in text.replace("\r", "").splitlines():
        if line and not line.startswith(" "):
            cur = line.split()[0]
            out.setdefault(cur, [])
            continue
        w = line.split()
        if cur and w[:1] == ["L3"] and len(w) > 1 and "/" in w[1]:
            a, _, plen = w[1].partition("/")
            if plen.isdigit():
                out[cur].append((a, int(plen)))
    return out


def parse_interface_addresses(text):
    """{interface: [address, ...]} off `show interface address`."""
    return {n: [a for a, _ in p]
            for n, p in parse_interface_prefixes(text).items()}


def _inet_octets(address):
    """An address as the hex octets an InetAddress is written in."""
    import ipaddress
    return " ".join(f"{b:02X}" for b in ipaddress.ip_address(address).packed)


def vrrpv3_rows(routers, indexes, own):
    """
    VRRPV3-MIB's operations and associated-address rows for `routers`
    (parse_vrrp_detail), indexed by the interface's IF-MIB ifIndex
    (`indexes`, the agent's own file). The master's address is served only
    when this box is the master - its own primary address, from `own` - since
    VPP does not say who the master is.
    """
    import ipaddress
    out = []
    ops = f"{VRRPV3}.1.1.1.1"
    for r in routers:
        if r["interface"] not in indexes:
            continue
        idx = f"{indexes[r['interface']]}.{r['vr_id']}.{1 if r['family'] == 4 else 2}"
        mine = [a for a in own.get(r["interface"], [])
                if ipaddress.ip_address(a).version == r["family"]]
        if r["status"] == 3 and mine:
            out.append((f"{ops}.3.{idx}", "octet", _inet_octets(mine[0])))
        if mine:
            out.append((f"{ops}.4.{idx}", "octet", _inet_octets(mine[0])))
        if r["mac"]:
            out.append((f"{ops}.5.{idx}", "octet",
                        " ".join(r["mac"].upper().split(":"))))
        out += [(f"{ops}.6.{idx}", "integer", r["status"]),
                (f"{ops}.7.{idx}", "gauge", r["priority"]),
                (f"{ops}.8.{idx}", "integer", len(r["addresses"])),
                (f"{ops}.9.{idx}", "integer", r["adv"]),
                (f"{ops}.10.{idx}", "integer", 1 if r["preempt"] else 2),
                (f"{ops}.11.{idx}", "integer", 1 if r["accept"] else 2),
                (f"{ops}.13.{idx}", "integer", 1)]
        for a in r["addresses"]:
            b = ipaddress.ip_address(a).packed
            out.append((f"{VRRPV3}.1.1.2.1.2.{idx}.{len(b)}."
                        + ".".join(str(x) for x in b), "integer", 1))
    return out


# --- IEEE8023-LAG-MIB: the LACP bundles in IEEE 802.1AX's MIB (#515) -------
#
# The aggregator table has a row per bundle and the port tables a row per
# member, each indexed by the IF-MIB ifIndex this agent gives the card (#498).
# What VPP keeps is what is served: the actor and partner of each member as
# the last LACPDU left them, its PDU counters and its state machines. The
# partner's admin values, the conversation tables (802.1AX-2014's per-service
# distribution) and DRNI are not served - VPP has none of them.

LAG = "1.2.840.10006.300.43"
LAG_MUX = {"DETACHED": 1, "WAITING": 2, "ATTACHED": 3, "COLLECTING": 4,
           "DISTRIBUTING": 5, "COLLECTING_DISTRIBUTING": 6}
LAG_RX = {"CURRENT": 1, "EXPIRED": 2, "DEFAULTED": 3, "INITIALIZE": 4,
          "LACP_DISABLED": 5, "PORT_DISABLED": 6}


def parse_bond_details(text):
    """
    {bundle: {"members": [...], "active": [...]}} off `show bond details`:
    a bundle's name at the margin, its member lists under the two counts.
    """
    out, cur, into = {}, None, None
    for line in text.splitlines():
        if not line.strip():
            continue
        if not line[0].isspace():
            cur = out.setdefault(line.split()[0], {"members": [], "active": []})
            into = None
            continue
        t = line.strip()
        if cur is None:
            continue
        if t.startswith("number of active members"):
            into = "active"
        elif t.startswith("number of members"):
            into = "members"
        elif ":" in t:
            into = None
        elif into and len(line) - len(line.lstrip()) >= 4:
            cur[into].append(t)
    return out


def parse_lacp_details(text):
    """
    {member: {...}} off `show lacp details`: each member's PDU counters, its
    actor and partner (system, priority, key, port priority, port number,
    state byte) and its receive and mux machines' states.
    """
    out, cur, side = {}, None, None
    for line in text.splitlines():
        t = line.strip()
        ind = len(line) - len(line.lstrip())
        if not t:
            continue
        if ind == 2 and not t.startswith("Number of"):
            cur = out.setdefault(t, {"actor": {}, "partner": {}})
            side = None
            continue
        if cur is None:
            continue
        if t in ("Actor", "Partner"):
            side = cur[t.lower()]
            continue
        k, _, v = t.partition(":")
        k, v = k.strip(), v.strip()
        num = v.split()[0] if v else ""
        if k in ("Good LACP PDUs received", "Bad LACP PDUs received",
                 "LACP PDUs sent", "Good Marker PDUs received",
                 "Bad Marker PDUs received") and num.isdigit():
            cur[k] = int(num)
        elif k in ("RX-state", "MUX-state"):
            cur[k] = v
            side = None
        elif side is not None and k in ("system", "system priority", "key",
                                        "port priority", "port number", "state"):
            if k == "system":
                side[k] = v
            elif k == "state":
                side[k] = int(v, 16)
            elif num.isdigit():
                side[k] = int(num)
    return out


def _lacp_state(b):
    """
    VPP's state byte (bit 0 is LACP activity) as LacpState BITS: SNMP's first
    bit is the octet's most significant.
    """
    return f"{int(format(b & 0xFF, '08b')[::-1], 2):02X}"


def lag_rows(bonds, lacp, indexes):
    """
    IEEE8023-LAG-MIB's aggregator, port, port statistics and port debug rows
    for the LACP bundles in `bonds` (parse_bond_details) whose members
    `lacp` (parse_lacp_details) knows, indexed by `indexes` (the agent's
    ifIndex file).
    """
    agg, port = f"{LAG}.1.1.1.1", f"{LAG}.1.2"
    rows = []
    for name in sorted(bonds):
        members = [m for m in bonds[name]["members"] if m in lacp]
        if name not in indexes or not members:
            continue
        a, p = lacp[members[0]]["actor"], lacp[members[0]]["partner"]
        i = indexes[name]
        rows += [(f"{agg}.3.{i}", "integer", a.get("system priority", 0)),
                 (f"{agg}.4.{i}", "octet", mac_octets(a.get("system", ""))),
                 (f"{agg}.5.{i}", "integer", 1),
                 (f"{agg}.6.{i}", "integer", a.get("key", 0)),
                 (f"{agg}.7.{i}", "integer", a.get("key", 0)),
                 (f"{agg}.8.{i}", "octet", mac_octets(p.get("system", ""))),
                 (f"{agg}.9.{i}", "integer", p.get("system priority", 0)),
                 (f"{agg}.10.{i}", "integer", p.get("key", 0)),
                 (f"{agg}.11.{i}", "integer", 0)]
        for m in members:
            if m not in indexes:
                continue
            j, d = indexes[m], lacp[m]
            a, p = d["actor"], d["partner"]
            attached = i if m in bonds[name]["active"] else 0
            rows += [
                (f"{port}.1.1.2.{j}", "integer", a.get("system priority", 0)),
                (f"{port}.1.1.3.{j}", "octet", mac_octets(a.get("system", ""))),
                (f"{port}.1.1.4.{j}", "integer", a.get("key", 0)),
                (f"{port}.1.1.5.{j}", "integer", a.get("key", 0)),
                (f"{port}.1.1.7.{j}", "integer", p.get("system priority", 0)),
                (f"{port}.1.1.9.{j}", "octet", mac_octets(p.get("system", ""))),
                (f"{port}.1.1.11.{j}", "integer", p.get("key", 0)),
                (f"{port}.1.1.12.{j}", "integer", i),
                (f"{port}.1.1.13.{j}", "integer", attached),
                (f"{port}.1.1.14.{j}", "integer", a.get("port number", 0)),
                (f"{port}.1.1.15.{j}", "integer", a.get("port priority", 0)),
                (f"{port}.1.1.17.{j}", "integer", p.get("port number", 0)),
                (f"{port}.1.1.19.{j}", "integer", p.get("port priority", 0)),
                (f"{port}.1.1.21.{j}", "octet", _lacp_state(a.get("state", 0))),
                (f"{port}.1.1.23.{j}", "octet", _lacp_state(p.get("state", 0))),
                (f"{port}.1.1.24.{j}", "integer", 1),
                (f"{port}.2.1.1.{j}", "counter", d.get("Good LACP PDUs received", 0)),
                (f"{port}.2.1.2.{j}", "counter", d.get("Good Marker PDUs received", 0)),
                (f"{port}.2.1.6.{j}", "counter", d.get("LACP PDUs sent", 0)),
                (f"{port}.2.1.5.{j}", "counter", d.get("Bad LACP PDUs received", 0)
                 + d.get("Bad Marker PDUs received", 0))]
            if d.get("RX-state") in LAG_RX:
                rows.append((f"{port}.3.1.1.{j}", "integer", LAG_RX[d["RX-state"]]))
            if d.get("MUX-state") in LAG_MUX:
                rows.append((f"{port}.3.1.3.{j}", "integer", LAG_MUX[d["MUX-state"]]))
    return rows


# --- IP-MIB: the dataplane's addresses, under the ifIndex IF-MIB gives them --
#
# net-snmp's own IP-MIB reads Linux, whose interfaces are the linux_cp taps:
# the addresses are there, but each under the TAP's Linux ifIndex, which is no
# row of the IF-MIB this agent serves (#498) - an NMS that joins the two, as
# every one does to name an interface by its address, joins nothing. So the
# address tables are served here, from the dataplane, under the same ifIndex,
# and the two forwarding scalars say what the box is: a router, whatever the
# host's own sysctl says.
#
# Served: ipForwarding and ipv6IpForwarding; ipAddrTable (IPv4, deprecated
# and still what most NMS read); ipAddressTable and ipAddressPrefixTable (both
# families). Not served: the link-local IPv6 addresses (ipv6z, whose zone the
# dataplane does not give), the statistics tables and the neighbour tables.

IP_MIB = "1.3.6.1.2.1.4"


def ip_rows(prefixes, indexes):
    """
    IP-MIB's forwarding scalars and address rows for `prefixes`
    (parse_interface_prefixes), under `indexes` (the agent's ifIndex file).
    An interface IF-MIB has no row for - local0, a linux_cp tap - is left out,
    by vpp_cards' rule.
    """
    import ipaddress
    out = [(f"{IP_MIB}.1.0", "integer", 1),          # ipForwarding: forwarding
           (f"{IP_MIB}.25.0", "integer", 1)]         # ipv6IpForwarding
    v4, addr, pfx = [], [], {}
    for name in sorted(prefixes):
        if name == "local0" or name.startswith("tap") or name not in indexes:
            continue
        i = indexes[name]
        for a, plen in prefixes[name]:
            ip = ipaddress.ip_address(a)
            if ip.version == 6 and ip.is_link_local:
                continue
            t = 1 if ip.version == 4 else 2
            b = ip.packed
            net = ipaddress.ip_network(f"{a}/{plen}", strict=False)
            if t == 1:
                v4.append((a, i, str(net.netmask)))
            key = f"{t}.{len(b)}." + ".".join(str(x) for x in b)
            nkey = (f"{i}.{t}.{len(b)}."
                    + ".".join(str(x) for x in net.network_address.packed)
                    + f".{plen}")
            addr.append((key, i, nkey))
            pfx[nkey] = True
    for col, typ, f in ((1, "ipaddress", lambda r: r[0]),
                        (2, "integer", lambda r: r[1]),
                        (3, "ipaddress", lambda r: r[2]),
                        (4, "integer", lambda r: 1),
                        (5, "integer", lambda r: 65535)):
        for r in v4:
            out.append((f"{IP_MIB}.20.1.{col}.{r[0]}", typ, f(r)))
    for col, typ, f in ((3, "integer", lambda r: r[1]),
                        (4, "integer", lambda r: 1),       # unicast
                        (5, "objectid",
                         lambda r: f".{IP_MIB}.32.1.5.{r[2]}"),
                        (6, "integer", lambda r: 2),       # manual
                        (7, "integer", lambda r: 1),       # preferred
                        (8, "timeticks", lambda r: 0),
                        (9, "timeticks", lambda r: 0),
                        (10, "integer", lambda r: 1),      # active
                        (11, "integer", lambda r: 3)):     # nonVolatile
        for r in addr:
            out.append((f"{IP_MIB}.34.1.{col}.{r[0]}", typ, f(r)))
    for col, typ, v in ((5, "integer", 2),                 # manual
                        (6, "integer", 1),                 # on-link: true
                        (7, "integer", 2),                 # autonomous: false
                        (8, "gauge", 4294967295),          # infinite
                        (9, "gauge", 4294967295)):
        for k in sorted(pfx):
            out.append((f"{IP_MIB}.32.1.{col}.{k}", typ, v))
    return out


# --- the interface table: IF-MIB for the dataplane's cards (#498) -----------
#
# net-snmp's own IF-MIB reads Linux, and Linux does not have the cards the
# dataplane holds: an NMS saw the linux_cp taps, whose counters are the
# control plane's traffic, and not a byte of what the box forwards. This agent
# is registered on ifNumber, ifTable and ifXTable above net-snmp's module and
# serves every card the box has: VPP's, and the physical ones Linux still
# holds (a management card kept for Linux).
#
# The counters come from VPP's statistics segment through vpp_get_stats, which
# reads shared memory and costs the dataplane nothing; one line per interface
# PER THREAD, so they are summed here. What the segment does not carry -
# admin and link state, MTU, speed, MAC - comes from the dataplane's own
# screens, cached with the rest.

VPP_GET_STATS = os.environ.get("PRISMA_VPP_GET_STATS", "/usr/bin/vpp_get_stats")
STATS_SOCKET = os.environ.get("PRISMA_STATS_SOCKET", "/run/vpp/stats.sock")
SYS_CLASS_NET = os.environ.get("PRISMA_SYS_CLASS_NET", "/sys/class/net")
IFINDEX_FILE = os.environ.get("PRISMA_SNMP_IFINDEX", "/var/lib/snmp/prisma-ifindex")
IF_STATS = ["rx", "tx", "rx-unicast", "rx-multicast", "rx-broadcast",
            "tx-unicast", "tx-multicast", "tx-broadcast", "drops", "rx-miss",
            "rx-no-buf", "rx-error", "tx-error"]
IF_MIB = "1.3.6.1.2.1.2"
IFX_TABLE = "1.3.6.1.2.1.31.1.1.1"


def parse_stats_dump(text, prefix="/if/"):
    """
    vpp_get_stats' dump into (names, counters): names {index: name} from
    <prefix>names, and counters {stat: {index: [packets, bytes]}} summed over
    every thread's row. A simple counter has no bytes, and carries 0.
    `prefix` is /if/ for the interfaces and /bpa/pool/ for the CGNAT's pools.
    """
    names, counters = {}, {}
    for line in text.splitlines():
        line = line.strip()
        if not line.startswith("[") or "]: " not in line:
            continue
        head, rest = line[1:].split("]: ", 1)
        stat = rest.rsplit(" ", 1)[-1]
        if not stat.startswith(prefix):
            continue
        stat = stat[len(prefix):]
        idx = head.split(" @ ")[0]
        if not idx.isdigit():
            continue
        if stat == "names":
            # A name can be empty - a deleted pool - and then the dump has
            # two spaces and no word between the index and the path.
            names[int(idx)] = rest.rsplit(" ", 1)[0].strip() if " " in rest else ""
            continue
        f = rest.replace(",", "").split()
        try:
            pk = int(f[0])
            by = int(f[2]) if len(f) > 3 and f[3] == "bytes" else 0
        except (ValueError, IndexError):
            continue
        c = counters.setdefault(stat, {}).setdefault(int(idx), [0, 0])
        c[0] += pk
        c[1] += by
    return names, counters


def parse_show_interface(text):
    """`show interface` into {name: {"admin": "up"|"down", "mtu": int}}."""
    out = {}
    for line in text.splitlines():
        f = line.split()
        if len(f) >= 4 and not line[:1].isspace() and f[1].isdigit() \
                and f[2] in ("up", "down"):
            try:
                mtu = int(f[3].split("/")[0])
            except ValueError:
                mtu = 0
            out[f[0]] = {"admin": f[2], "mtu": mtu}
    return out


def speed_bps(text):
    """'10 Gbps', '1.000000 Gbps', '100 Mbps' as bits a second; 0 unknown."""
    f = text.split()
    if len(f) < 2:
        return 0
    unit = {"gbps": 10 ** 9, "mbps": 10 ** 6, "kbps": 10 ** 3}.get(f[1].lower())
    try:
        return int(float(f[0]) * unit) if unit else 0
    except ValueError:
        return 0


def parse_show_hardware(text):
    """
    `show hardware-interfaces` into {name: {"link", "speed", "mac"}}: the
    link column of each card's first line, "Link speed:" and "Ethernet
    address" in the lines under it.
    """
    out, cur = {}, None
    for line in text.splitlines():
        f = line.split()
        if not f:
            continue
        if not line[:1].isspace() and len(f) >= 3 and f[1].isdigit():
            cur = out.setdefault(f[0], {"link": f[2], "speed": 0, "mac": ""})
        elif cur is not None and line.strip().startswith("Link speed:"):
            cur["speed"] = speed_bps(line.split(":", 1)[1])
        elif cur is not None and line.strip().startswith("Ethernet address"):
            cur["mac"] = f[-1]
    return out


def _read(path):
    try:
        with open(path) as fh:
            return fh.read().strip()
    except OSError:
        return ""


def linux_cards(root=SYS_CLASS_NET, skip=()):
    """
    The physical cards Linux holds - a netdev with a device behind it - that
    the dataplane has not got, as interface records. The linux_cp taps have
    no device and are not here: their traffic is the control plane's, and a
    card the dataplane holds is already a row.
    """
    out = []
    try:
        entries = sorted(os.listdir(root))
    except OSError:
        return out
    for name in entries:
        d = os.path.join(root, name)
        if name in skip or not os.path.exists(os.path.join(d, "device")):
            continue
        st = lambda k: int(_read(os.path.join(d, "statistics", k)) or 0)
        sp = _read(os.path.join(d, "speed"))
        out.append({
            "name": name, "alias": _read(os.path.join(d, "ifalias")),
            "admin": "up" if int(_read(os.path.join(d, "flags")) or "0", 16) & 1
                     else "down",
            "oper": "up" if _read(os.path.join(d, "operstate")) == "up" else "down",
            "mtu": int(_read(os.path.join(d, "mtu")) or 0),
            "speed": int(sp) * 10 ** 6 if sp.lstrip("-").isdigit()
                     and int(sp) > 0 else 0,
            "mac": _read(os.path.join(d, "address")),
            "in_octets": st("rx_bytes"), "out_octets": st("tx_bytes"),
            "in_ucast": st("rx_packets") - st("multicast"),
            "out_ucast": st("tx_packets"),
            "in_mcast": st("multicast"), "in_bcast": 0,
            "out_mcast": 0, "out_bcast": 0,
            "in_discards": st("rx_dropped"), "out_discards": st("tx_dropped"),
            "in_errors": st("rx_errors"), "out_errors": st("tx_errors")})
    return out


def vpp_cards(names, counters, attrs, hw, aliases):
    """
    The dataplane's interfaces as records, from the parsed statistics, the
    parsed `show interface` and `show hardware-interfaces`, and the Linux
    ends' aliases (the VTY's description is written there). local0 and the
    linux_cp taps are left out: the first carries nothing, the second is the
    inside of a pair whose outside is already a row.
    """
    # not a unit: a closure inside vpp_cards, measured on the records it
    # builds in appliance/test_snmp_agent.py.
    def c(stat, idx, part):
        return counters.get(stat, {}).get(idx, [0, 0])[part]

    # not a unit: a closure inside vpp_cards, like c above.
    def ucast(way, idx):
        # Only some drivers fill the per-type counters. On the X520 box
        # (#501) virtio and ixgbe left rx-unicast, -multicast and -broadcast
        # at 0 while /if/rx counted 356,644 packets, and ifInUcastPkts read a
        # flat 0. A direction with none of the three filled is all unicast as
        # far as anything can say.
        by_type = [c(f"{way}-{t}", idx, 0)
                   for t in ("unicast", "multicast", "broadcast")]
        return by_type[0] if any(by_type) else c(way, idx, 0)
    out = []
    for idx in sorted(names):
        name = names[idx]
        if name == "local0" or name.startswith("tap"):
            continue
        parent = name.split(".")[0]
        h = hw.get(name) or hw.get(parent) or {}
        a = attrs.get(name, {})
        admin = a.get("admin", "down")
        out.append({
            "name": name, "alias": aliases.get(name, ""),
            "admin": admin,
            "oper": "up" if admin == "up" and h.get("link") == "up" else "down",
            "mtu": a.get("mtu", 0), "speed": h.get("speed", 0),
            "mac": h.get("mac", ""),
            "in_octets": c("rx", idx, 1), "out_octets": c("tx", idx, 1),
            "in_ucast": ucast("rx", idx), "out_ucast": ucast("tx", idx),
            "in_mcast": c("rx-multicast", idx, 0), "in_bcast": c("rx-broadcast", idx, 0),
            "out_mcast": c("tx-multicast", idx, 0), "out_bcast": c("tx-broadcast", idx, 0),
            "in_discards": c("drops", idx, 0) + c("rx-miss", idx, 0)
                           + c("rx-no-buf", idx, 0),
            "out_discards": 0,
            "in_errors": c("rx-error", idx, 0), "out_errors": c("tx-error", idx, 0)})
    return out


def if_indexes(names, path=IFINDEX_FILE):
    """
    {name: ifIndex}, stable for as long as the file lives: a name keeps the
    index it was first given, and a new name takes the next free one. An NMS
    keeps a year of graphs per ifIndex, and a reboot, a card added or a card
    handed over that renumbered them would draw one card's traffic under
    another's name without an error anywhere.
    """
    known = {}
    for line in _read(path).splitlines():
        f = line.split()
        if len(f) == 2 and f[1].isdigit():
            known[f[0]] = int(f[1])
    nxt = max(known.values(), default=0) + 1
    changed = False
    for n in names:
        if n not in known:
            known[n] = nxt
            nxt += 1
            changed = True
    if changed:
        try:
            tmp = path + ".new"
            with open(tmp, "w") as fh:
                fh.write("".join(f"{n} {i}\n" for n, i in sorted(
                    known.items(), key=lambda kv: kv[1])))
            os.replace(tmp, path)
        except OSError:
            pass
    return {n: known[n] for n in names}


def if_type(name):
    """ifType: a bundle, a VLAN sub-interface, or an Ethernet card."""
    if name.startswith("BondEthernet"):
        return 161                      # ieee8023adLag
    if "." in name:
        return 135                      # l2vlan
    return 6                            # ethernetCsmacd


def mac_octets(mac):
    """'bc:24:11:92:67:ab' as pass_persist's octet form, '' for none."""
    parts = mac.split(":")
    if len(parts) != 6:
        return ""
    return " ".join(p.upper() for p in parts)


def if_rows(cards, indexes):
    """The ifNumber, ifTable and ifXTable rows for these interface records."""
    rows = [(f"{IF_MIB}.1.0", "integer", len(cards))]
    m32 = 2 ** 32
    for r in cards:
        i = indexes[r["name"]]
        t = f"{IF_MIB}.2.1"
        st = {"up": 1, "down": 2}
        rows += [
            (f"{t}.1.{i}", "integer", i),
            (f"{t}.2.{i}", "string", r["name"]),
            (f"{t}.3.{i}", "integer", if_type(r["name"])),
            (f"{t}.4.{i}", "integer", r["mtu"]),
            (f"{t}.5.{i}", "gauge", min(r["speed"], m32 - 1)),
            (f"{t}.6.{i}", "octet", mac_octets(r["mac"])),
            (f"{t}.7.{i}", "integer", st[r["admin"]]),
            (f"{t}.8.{i}", "integer", st[r["oper"]]),
            (f"{t}.10.{i}", "counter", r["in_octets"] % m32),
            (f"{t}.11.{i}", "counter", r["in_ucast"] % m32),
            (f"{t}.13.{i}", "counter", r["in_discards"] % m32),
            (f"{t}.14.{i}", "counter", r["in_errors"] % m32),
            (f"{t}.16.{i}", "counter", r["out_octets"] % m32),
            (f"{t}.17.{i}", "counter", r["out_ucast"] % m32),
            (f"{t}.19.{i}", "counter", r["out_discards"] % m32),
            (f"{t}.20.{i}", "counter", r["out_errors"] % m32)]
        x = IFX_TABLE
        rows += [
            (f"{x}.1.{i}", "string", r["name"]),
            (f"{x}.2.{i}", "counter", r["in_mcast"] % m32),
            (f"{x}.3.{i}", "counter", r["in_bcast"] % m32),
            (f"{x}.4.{i}", "counter", r["out_mcast"] % m32),
            (f"{x}.5.{i}", "counter", r["out_bcast"] % m32),
            (f"{x}.6.{i}", "counter64", r["in_octets"]),
            (f"{x}.7.{i}", "counter64", r["in_ucast"]),
            (f"{x}.8.{i}", "counter64", r["in_mcast"]),
            (f"{x}.9.{i}", "counter64", r["in_bcast"]),
            (f"{x}.10.{i}", "counter64", r["out_octets"]),
            (f"{x}.11.{i}", "counter64", r["out_ucast"]),
            (f"{x}.12.{i}", "counter64", r["out_mcast"]),
            (f"{x}.13.{i}", "counter64", r["out_bcast"]),
            (f"{x}.15.{i}", "gauge", r["speed"] // 10 ** 6),
            (f"{x}.18.{i}", "string", r["alias"])]
    return rows


class Interfaces:
    """The interface rows, read at most once every CACHE_SECONDS."""

    def __init__(self):
        self.at = 0.0
        self.rows = []

    # not a unit: runs vpp_get_stats and vppctl against a live dataplane;
    # what it builds is vpp_cards/linux_cards/if_rows, each held by
    # appliance/test_snmp_agent.py, and lab/snmp.sh walks the result.
    def refresh(self):
        if self.rows and time.time() - self.at < CACHE_SECONDS:
            return self.rows
        try:
            p = subprocess.run([VPP_GET_STATS, "socket-name", STATS_SOCKET, "dump"]
                               + [f"^/if/{s}$" for s in ["names"] + IF_STATS],
                               capture_output=True, text=True, timeout=5)
            stats = p.stdout if p.returncode == 0 else ""
        except (OSError, subprocess.TimeoutExpired):
            stats = ""
        names, counters = parse_stats_dump(stats)
        attrs = parse_show_interface(vppctl("show interface") or "")
        hw = parse_show_hardware(vppctl("show hardware-interfaces") or "")
        aliases = {n: _read(os.path.join(SYS_CLASS_NET, n, "ifalias"))
                   for n in names.values()}
        cards = vpp_cards(names, counters, attrs, hw, aliases)
        cards += linux_cards(skip={r["name"] for r in cards})
        self.rows = if_rows(cards, if_indexes([r["name"] for r in cards]))
        self.at = time.time()
        return self.rows


INTERFACES = Interfaces()


# --- BFD-STD-MIB, RFC 7331: bfdd's sessions in the IETF's own MIB (#559) ----
#
# FRR 10.7.1 ships no bfdd_snmp module (`ls /usr/lib/*/frr/modules` has
# bgpd, ospfd, ospf6d, isisd, ldpd, ripd and zebra), so bfdd answers no
# AgentX and this agent serves the table, from the same `show bfd peers json`
# and `show bfd peers counters json` the VTY's `show bfd` reads. It has its
# own registration (`--bfd`) and does not depend on the dataplane: a box
# whose VPP is down still has BFD sessions to report, and that is exactly
# when they matter.
#
# The index is bfdd's local discriminator (its `id`), which RFC 7331 also
# serves as bfdSessDiscriminator: stable for as long as bfdd runs, which is as
# long as the session exists. bfdSessInterface is 0: bfdd names the Linux end
# of an interface and IF-MIB numbers the dataplane's, and serving a number
# that belongs to another interface is worse than serving none. Traps
# (bfdSessUp, bfdSessDown) are not sent - pass_persist answers polls and
# cannot raise one - so bfdNotificationsEnable reads false(2), which is true.

BFD_MIB = "1.3.6.1.2.1.222"
VTYSH = os.environ.get("VTYSH", "/usr/bin/vtysh")
BFD_CACHE_SECONDS = float(os.environ.get("PRISMA_SNMP_BFD_CACHE", "2"))

#: IANA-BFD-TC-STD-MIB's IANAbfdDiagTC, from bfdd's words for them.
BFD_DIAG = {"ok": 0, "control detection time expired": 1,
            "echo function failed": 2, "neighbor signaled session down": 3,
            "forwarding plane reset": 4, "path down": 5,
            "concatenated path down": 6, "administratively down": 7,
            "reverse concatenated path down": 8}
#: IANAbfdSessStateTC.
BFD_STATE = {"shutdown": 1, "admindown": 1, "admin-down": 1, "down": 2,
             "init": 3, "up": 4}


# not a unit: runs vtysh against the live bfdd; parse_bfd() is what reads its
# answer, and is tested.
def vtysh_json(cmd):
    """bfdd's answer to `cmd` as text, or None when it did not answer."""
    try:
        p = subprocess.run([VTYSH, "-c", cmd], capture_output=True,
                           text=True, timeout=10)
    except (OSError, subprocess.TimeoutExpired):
        return None
    return p.stdout if p.returncode == 0 else None


def parse_bfd(peers_text, counters_text):
    """
    bfdd's sessions from its two JSON answers, the counters folded in by
    `id`; None when either is not the list bfdd prints.
    """
    import json
    try:
        peers = json.loads(peers_text[peers_text.index("["):])
        counters = json.loads(counters_text[counters_text.index("["):])
    except (ValueError, AttributeError, TypeError):
        return None
    by_id = {c.get("id"): c for c in counters if isinstance(c, dict)}
    return [dict(p, counters=by_id.get(p.get("id"), {}))
            for p in peers if isinstance(p, dict) and isinstance(p.get("id"), int)]


def _octets(text):
    """An address as (InetAddressType, its octets as pass_persist writes them)."""
    import ipaddress
    try:
        a = ipaddress.ip_address(text)
    except ValueError:
        return None
    return (1 if a.version == 4 else 2), a.packed


def bfd_rows(sessions):
    """
    BFD-STD-MIB's rows for `sessions` (parse_bfd): the scalars, bfdSessTable,
    bfdSessPerfTable, and the two map tables, every OID as RFC 7331 numbers
    it. Timers are microseconds there and milliseconds in bfdd.
    """
    objs = f"{BFD_MIB}.1"
    out = [(f"{objs}.1.1.0", "integer", 1),     # bfdAdminStatus enabled
           (f"{objs}.1.2.0", "integer", 1),     # bfdOperStatus up
           (f"{objs}.1.3.0", "integer", 2),     # bfdNotificationsEnable false
           (f"{objs}.1.4.0", "gauge", 0)]       # bfdSessIndexNext: none
    sess, perf = f"{objs}.2.1", f"{objs}.3.1"
    for s in sessions:
        i = s["id"]
        status = str(s.get("status", "")).lower()
        state = BFD_STATE.get(status, 2)
        multi = bool(s.get("multihop"))
        echo = int(s.get("echo-transmit-interval") or 0)
        c = s.get("counters") or {}

        col = lambda n, typ, val: out.append(  # noqa: E731
            (f"{sess}.{n}.{i}", typ, val))
        col(2, "gauge", 1)
        col(3, "integer", 2 if multi else 1)
        col(4, "gauge", i)
        col(5, "gauge", int(s.get("remote-id") or 0))
        col(6, "gauge", 0 if state == 1 else (4784 if multi else 3784))
        col(9, "integer", 3 if state == 1 else 1)
        col(10, "integer", 1 if state == 4 else (3 if state == 1 else 2))
        col(11, "integer", state)
        col(12, "integer", 1 if state in (3, 4) else 2)
        col(13, "integer", BFD_DIAG.get(str(s.get("diagnostic", "ok")).lower(), 0))
        col(14, "integer", 1 if echo else 2)
        col(15, "integer", 2)
        col(16, "integer", 2)
        col(17, "integer", 2)
        col(18, "integer", 0)
        src, dst = _octets(str(s.get("local", ""))), _octets(str(s.get("peer", "")))
        if src:
            col(19, "integer", src[0])
            col(20, "octet", " ".join(f"{b:02X}" for b in src[1]))
        if dst:
            col(21, "integer", dst[0])
            col(22, "octet", " ".join(f"{b:02X}" for b in dst[1]))
        ttl = int(s.get("minimum-ttl") or 0)
        col(23, "integer", 1 if multi and ttl else 2)
        col(24, "gauge", ttl if multi else 0)
        tx = int(s.get("transmit-interval") or 0)
        rx = int(s.get("receive-interval") or 0)
        col(25, "gauge", tx * 1000)
        col(26, "gauge", rx * 1000)
        col(27, "gauge", int(s.get("echo-receive-interval") or 0) * 1000)
        col(28, "gauge", int(s.get("detect-multiplier") or 0))
        rrx = int(s.get("remote-receive-interval") or 0)
        if rrx:
            # RFC 5880 6.8.7: what this end transmits at is the larger of its
            # own desired interval and the neighbour's required one.
            col(29, "gauge", max(tx, rrx) * 1000)
        rdm = int(s.get("remote-detect-multiplier") or 0)
        if rdm:
            col(31, "gauge", rdm)
        col(32, "integer", 2)
        col(33, "integer", -1)
        col(36, "integer", 3 if s.get("type") == "configured" else 2)
        col(37, "integer", 1)
        if c:
            pin = int(c.get("control-packet-input") or 0)
            pout = int(c.get("control-packet-output") or 0)
            bad = int(c.get("controlPacketBadInput") or 0)
            out += [(f"{perf}.1.{i}", "counter", pin % 2 ** 32),
                    (f"{perf}.2.{i}", "counter", pout % 2 ** 32),
                    (f"{perf}.3.{i}", "counter", bad % 2 ** 32),
                    (f"{perf}.12.{i}", "counter",
                     int(c.get("session-up") or 0) % 2 ** 32),
                    (f"{perf}.14.{i}", "counter64", pin),
                    (f"{perf}.15.{i}", "counter64", pout),
                    (f"{perf}.16.{i}", "counter64", bad)]
        out.append((f"{objs}.4.1.1.{i}", "gauge", i))
        if src and dst:
            idx = (f"0.{src[0]}.{len(src[1])}." + ".".join(str(b) for b in src[1])
                   + f".{dst[0]}.{len(dst[1])}." + ".".join(str(b) for b in dst[1]))
            out.append((f"{objs}.5.1.1.{idx}", "gauge", i))
    return out


class Bfd:
    """bfdd's sessions, read at most every BFD_CACHE_SECONDS; [] silent."""

    def __init__(self):
        self.at = 0.0
        self.rows = []

    # not a unit: a cache over vtysh_json(); bfd_rows() and parse_bfd() are
    # what it serves, and are tested.
    def refresh(self):
        if time.time() - self.at < BFD_CACHE_SECONDS:
            return self.rows
        peers = vtysh_json("show bfd peers json")
        counters = vtysh_json("show bfd peers counters json") if peers else None
        sessions = parse_bfd(peers, counters) if peers and counters else None
        # bfdd silent: nothing, not the last rows (the module docstring's
        # "no stale numbers").
        self.rows = bfd_rows(sessions) if sessions is not None else []
        self.at = time.time()
        return self.rows


BFD = Bfd()


def oid_table():
    """Every OID this agent serves, in lexicographic order."""
    if "--interfaces" in sys.argv[1:]:
        return sorted(INTERFACES.refresh(),
                      key=lambda r: [int(x) for x in r[0].split(".")])
    if "--bfd" in sys.argv[1:]:
        return sorted(BFD.refresh(),
                      key=lambda r: [int(x) for x in r[0].split(".")])
    d = VALUES.refresh()
    out = []
    base = f"1.3.6.1.4.1.{ENTERPRISE}.1" if ENTERPRISE.isdigit() else None
    if base:
        # The box's own state (#524), served with the dataplane silent too:
        # it is the box whose dataplane did not come up that it is for.
        out += box_rows(base, BOX.refresh(), AUDIT.refresh() if d else None)
    if not d:
        # dataplane silent: serve nothing of it
        return sorted(out, key=lambda r: [int(x) for x in r[0].split(".")])
    for n, key in _TIMEOUT_OIDS:
        if key in d:
            out.append((f"{NAT_DEF_TIMEOUTS}.{n}.0", "gauge", d[key]))
    out += natv2_rows(d.get("cgnat", {}), d.get("config", {}))
    out += d.get("extra", {}).get("vrrpv3", [])
    out += d.get("extra", {}).get("lag", [])
    out += d.get("extra", {}).get("ip", [])
    if ENTERPRISE.isdigit():
        base = f"1.3.6.1.4.1.{ENTERPRISE}.1"
        for n, key, typ, _desc in _ENTERPRISE_OBJECTS:
            if key in d:
                out.append((f"{base}.{n}.0", typ,
                            d[key] % 2 ** 32 if typ == "counter" else d[key]))
        out += product_rows(base, d["cgnat"], d["release"], d["build"],
                            d.get("dp_uptime"))
        out += more_rows(base, d.get("extra", {}))
    return sorted(out, key=lambda r: [int(x) for x in r[0].split(".")])


def reply(oid, typ, value):
    sys.stdout.write(f"{oid}\n{typ}\n{value}\n")
    sys.stdout.flush()


def none():
    sys.stdout.write("NONE\n")
    sys.stdout.flush()


def as_key(oid):
    try:
        return [int(x) for x in oid.strip().lstrip(".").split(".")]
    except ValueError:
        return None


# not a unit: the program's entry, the pass_persist loop snmpd drives over
# stdin; the OID table and the answers are what a test can hold.
def main():
    # readline() throughout, never "for line in sys.stdin".
    #
    # File iteration reads ahead into a buffer, so a readline() inside the loop
    # - which this protocol needs, because "get" is followed by its OID on the
    # next line - sees nothing. The agent answered PING and returned NONE to
    # every request, which looks exactly like a dataplane that is not running.
    while True:
        line = sys.stdin.readline()
        if not line:
            return
        cmd = line.strip().upper()
        if cmd == "PING":
            sys.stdout.write("PONG\n")
            sys.stdout.flush()
        elif cmd == "SET":
            sys.stdin.readline()        # oid
            sys.stdin.readline()        # type and value
            # Refused, always. See the module docstring.
            sys.stdout.write("not-writable\n")
            sys.stdout.flush()
        elif cmd in ("GET", "GETNEXT"):
            want = sys.stdin.readline()
            key = as_key(want)
            if key is None:
                none()
                continue
            rows = oid_table()
            hit = None
            for oid, typ, val in rows:
                k = as_key(oid)
                if cmd == "GET" and k == key:
                    hit = (oid, typ, val)
                    break
                if cmd == "GETNEXT" and k > key:
                    hit = (oid, typ, val)
                    break
            if hit:
                reply(*hit)
            else:
                none()
        elif cmd == "":
            continue
        else:
            none()


if __name__ == "__main__":
    main()
