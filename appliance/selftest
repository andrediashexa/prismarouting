#!/bin/sh
# Prisma Routing boot self-test, written to the console.
#
# A racked appliance is seen through a serial console or IPMI, not through
# journalctl. If something essential did not come up, it has to be on the
# screen - with the reason next to it, not just "failed". The lack of that is
# what made every ISO diagnosis cost a full rebuild.
set -u
OUT=${PRISMA_SELFTEST_OUT:-/dev/console}
fail=0
warns=0
# Set where an INSTALLED box is found with no way to forward a packet. Not on
# a live medium, where DPDK is off by design and a box that forwards nothing is
# a box behaving correctly - the distinction this file already carries a scar
# for conflating.
noforward=

# PRISMA_SELFTEST_ROOT is empty on every box and is set only by
# test/test_selftest.sh, because the states the core checks below have to be
# shown in - a worker pinned to a core the kernel is not isolating, a dataplane
# holding cores its own profile does not name - cannot be arranged on the
# machine running the tests without arranging the very thing being checked.
# prisma-routing-tune takes a sysfs root for its synthetic topologies for the same
# reason. The reading with nothing set, on a box that really booted, is
# lab/install-iso.sh.
#
# It covers the kernel command line, the cpufreq governor and the records
# volume for the same reason (#222): a machine cannot be made to disagree with
# itself about isolcpus, about its own C-states or about where /var/log is
# mounted without rebooting it, and those three statements were the ones with
# nothing holding them.
ROOT=${PRISMA_SELFTEST_ROOT:-}
STARTUP="$ROOT/etc/vpp/startup.conf"
# The operator-editable base, read apart from the generated file because the
# two carry different decisions: a statseg stanza HERE is somebody's own, and
# one that reached startup.conf without being here was written by the tuner.
VPPBASE="$ROOT/etc/prisma-routing/vpp-base.conf"

say()  { echo "$*" > "$OUT" 2>/dev/null || echo "$*"; }
ok()   { say "  [ ok ] $*"; }
bad()  { say "  [FAIL] $*"; fail=$((fail+1)); }
# Counted, and NOT a failure. A warning is by design something that does not
# stop the box: the single-cpu trade below is one an operator may have chosen,
# and prisma-routing-selftest.service has to report a verdict on a box that boots
# either way. What counting buys is the summary. Twenty-six warnings were
# written in this file, each because somebody would otherwise not notice
# something, and a last line that says only "ready" undoes all of them at once
# - on a console that scrolls, read from the bottom, by somebody racking a box
# (#297).
warn() { say "  [warn] $*"; warns=$((warns+1)); }

# say, folded to the console, continuation rows aligned under the first.
#
# For a LIST of values rather than one value. A single token - a PCI address,
# an interface name - is printed whole and may run past the margin, because it
# is what the reader greps for or types back and splitting it destroys that.
# A list of cpu numbers is not one token: it can be folded between its items
# and nothing is lost. On a 32-core box the worker-pinning failure measured
# 153 columns on an 80-column console, and that is the message somebody reads
# at a serial console because the box is forwarding badly (#285).
#
# `fold -s` breaks at spaces only, so no number is ever cut in half.
say_list() {  # <indent> <text...>
  _ind=$1; shift
  printf '%s\n' "$*" | fold -s -w $((79 - ${#_ind})) | while IFS= read -r _r; do
    say "${_ind}${_r% }"
  done
}

say ""
say "=============== Prisma Routing: boot self-test =============="

# The first thing on the screen is the version. Whoever is at the console of a
# faulty box has to say what is running before anything else, and "unknown" is
# an answer too - worse is the line not being there at all.
ver=$(cat "$ROOT/usr/share/prisma-routing/VERSION" 2>/dev/null || echo "")
if [ -n "$ver" ]; then
  ok "Prisma Routing $ver"
else
  bad "no version stamp in /usr/share/prisma-routing/VERSION"
fi

# --- and the files that line is a claim about ---
#
# The line above is one sentence about thirty-odd files, and until #302 it
# could be checked against exactly one of them: the dataplane plugin carries a
# build stamp (#291) and the other thirty carry no version of any kind. So a
# box stamped 0.70.0 with 0.71.0's prisma-routing-tune on it printed that line,
# correctly as far as anything could tell, and went on printing it. That is
# not a hypothesis - it is the appliance supplied for the #290 work, and the
# file got there by somebody proving a fix on it, which is what debugging
# looks like.
#
# WHY HERE AND NOT IN `show version`. Three places were open: this file, the
# VTY's version command, and a command of its own. `show version` is where the
# claim is MADE, which is the argument for putting it there, and it is also a
# command an operator runs several times a minute while working - so the cost
# of the check would be paid over and over to be told nothing, and the one
# reading that matters would be the one nobody waited for. A command of its
# own is honest and is one more thing nobody runs. This file already reports
# on the state of the box, it already runs unattended on every boot with
# nobody watching, and a set of files that is not the set this box says it is
# running is precisely the shape of thing it exists to notice - it is the same
# check as "is VPP responding", one layer down.
#
# NOT FATAL, and it cannot be: this whole script is forbidden from stopping a
# boot (see the exit at the bottom, and prisma-routing-selftest.service's
# "ExecStart=-"). A box carrying one file from another release is a box that
# should be looked at, not a box that should be refused - it is very probably
# still forwarding, and the operator who copied the file on may be in the
# middle of using it.
#
# WHY IT IS [FAIL] AND NOT [warn]. The version line is the first thing anybody
# reads about a box and the first thing anybody reports on the telephone. When
# it is wrong, every later diagnosis is being made against the wrong release
# notes, which is the cost #302 is about and the reason it was written. A
# warning is what #301 refused one component over: a box that asserts a build
# it only partly has, with something quieter than the assertion saying so.
#
# THE OPERATOR'S OWN FILES ARE NOT IN THIS. tune.env, vpp-base.conf and
# prisma-routing.conf are named in the manifest with no checksum, because
# install.sh writes them once and then leaves them alone for the operator to
# edit - so an edit is the file working, not the file broken. A check that
# reported those would be switched off, and the one file that really was from
# another release would go quiet with it.
MANIFEST="$ROOT/usr/share/prisma-routing/MANIFEST"
if ! command -v sha256sum >/dev/null 2>&1; then
  # Not a pass: a check that cannot look is not a check that agrees.
  warn "no sha256sum here, so nothing checked that line against the files"
elif [ ! -f "$MANIFEST" ]; then
  warn "no /usr/share/prisma-routing/MANIFEST, so nothing checked that line"
  say_list "         " "the installer that put this version on the box writes" \
    "one. Without it the version above is a claim about thirty files that" \
    "no longer answer for themselves (#302)."
else
  # `grep -c` PRINTS its count and EXITS 1 when the count is zero, so a
  # `|| echo 0` beside it puts TWO numbers in the substitution and the test
  # below compares "0 0" against 0. Written that way, a manifest of nothing
  # but comments fell through to the comparison instead of being reported as
  # empty, and the box read as failing a check nothing had run. Found by
  # mutating install.sh's recording away and reading what this said.
  nfiles=$(grep -c '^[^#]' "$MANIFEST" 2>/dev/null) || nfiles=0
  if [ "${nfiles:-0}" -eq 0 ]; then
    warn "the manifest names no files, so it checked nothing:"
    say "         /usr/share/prisma-routing/MANIFEST"
  # THE EXIT STATUS IS THE VERDICT AND THE TEXT ONLY NAMES NAMES. sha256sum
  # writes "<path>: FAILED", which is its wording and not ours, and a needle
  # for it is a needle that stops matching the day coreutils rephrases it -
  # silently, and in the direction that reports a broken box as a healthy one.
  # So whether anything is wrong is read off the status, which is defined
  # behaviour, and the parse below only decides how much detail can be given.
  elif changed=$(cd "${ROOT:-/}" && sha256sum --quiet -c "$MANIFEST" 2>/dev/null)
  then
    ok "all $nfiles files of that build are the ones it shipped"
  else
    names=$(printf '%s\n' "$changed" | sed -n 's/:[[:space:]]*FAILED.*$//p')
    nbad=$(printf '%s\n' "$names" | grep -c . || true)
    if [ "${nbad:-0}" -gt 0 ]; then
      bad "$nbad file(s) on this box are not from ${ver:-that build}:"
      say_list "          " "$names"
    else
      # The status said something is wrong and the output could not be read.
      # Reporting nothing here would turn a broken box into a silent one.
      bad "this box does not match its own manifest and this check could not"
      say "        read which files: $(printf '%s' "$changed" | tr -s '[:space:]' ' ' | cut -c1-40)"
    fi
    say_list "        " "that line is one sentence about $nfiles files, and" \
      "these are not the ones that build shipped. A file replaced by hand," \
      "an install that stopped half way, or an upgrade that ran over part" \
      "of the box leaves exactly this, and every diagnosis from here is" \
      "made against the wrong release notes (#302). Compared with" \
      "/usr/share/prisma-routing/MANIFEST, which that version's own installer" \
      "wrote."
  fi
fi

# --- memory ---
# A live system keeps the whole overlay in RAM. Together with VPP, 2 GB is
# not enough: the OOM killer takes VPP and brings the rest down with it. Found
# by booting the ISO with 2 GB - "Out of memory: Killed process (vpp)".
memkb=$(awk '/MemTotal/{print $2}' "$ROOT/proc/meminfo")
memmb=$((memkb / 1024))
if [ "$memmb" -lt 2600 ]; then
  bad "only ${memmb} MB of RAM: VPP will be killed by the OOM killer"
  say "        minimum recommended: 4 GB (2 GB is not enough on a live system)"
elif [ "$memmb" -lt 3600 ]; then
  warn "${memmb} MB of RAM: enough to boot, tight under load"
else
  ok "${memmb} MB of RAM"
fi

# --- CPU instructions ---
# The VPP binary is compiled assuming SSE4.2 and uses AVX where available.
# On a CPU without them it dies with SIGILL in milliseconds, and since
# vpp.service has Restart=always the symptom becomes a restart loop that says
# nothing about the cause. That is how several hours went: the diagnosis only
# showed up in the journal's "code=killed, signal=ILL".
missing=""
for f in sse4_2; do
  grep -qw "$f" "$ROOT/proc/cpuinfo" || missing="$missing $f"
done
if [ -n "$missing" ]; then
  bad "CPU lacks:$missing - VPP requires it and will die with SIGILL"
  say "        model: $(grep -m1 "model name" "$ROOT/proc/cpuinfo" | cut -d: -f2-)"
elif grep -qw avx2 "$ROOT/proc/cpuinfo"; then
  ok "CPU has sse4_2 and avx2"
else
  warn "CPU lacks avx2: VPP works but delivers less"
fi

# --- dataplane ---
if vppctl show version >/dev/null 2>&1; then
  ok "VPP responding: $(vppctl show version 2>/dev/null | cut -d' ' -f1-2)"
else
  bad "VPP not responding"
  say "        tail of /var/log/vpp/vpp.log:"
  tail -12 /var/log/vpp/vpp.log 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
  say "        systemctl status vpp:"
  systemctl status vpp.service --no-pager -n 8 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
fi

# --- servico instavel: sobe, cai, sobe de novo ---
# A service in a restart loop can be "active" at the instant you look, and
# "systemctl status" shows it active. Only the restart counter tells the
# story - and without it the diagnosis becomes guesswork.
restarts=$(systemctl show vpp.service -p NRestarts --value 2>/dev/null)
[ -n "$restarts" ] || restarts=0
if [ "$restarts" -gt 2 ] 2>/dev/null; then
  bad "vpp.service has restarted $restarts times: it is looping"
  say "        tail of /var/log/vpp/vpp.log:"
  tail -20 /var/log/vpp/vpp.log 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
  say "        vpp.service journal:"
  journalctl -u vpp.service --no-pager -n 20 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
elif [ "$restarts" -gt 0 ] 2>/dev/null; then
  warn "vpp.service restarted $restarts time(s)"
else
  ok "vpp.service stable (0 restarts)"
fi

# --- is the dataplane out of the OOM killer's selection? ---
#
# docs/appliance.md records the event this guards against: the ISO booted with
# 2 GB and the console said "Out of memory: Killed process (vpp)" with VPP
# holding 19 MB resident. It was the chosen victim, not the glutton. The answer
# is a drop-in on vpp.service carrying OOMScoreAdjust, and until now nothing on
# an installed box ever looked at whether it took effect - a drop-in that was
# never installed, or that systemd parsed and refused, is indistinguishable
# from one that is working.
#
# What is read is /proc/<pid>/oom_score_adj, which is what the kernel will act
# on, and not the drop-in file, which is only what somebody asked for. Read and
# never written: a check that arranges the condition it is checking for cannot
# report its absence, which is #184 in one sentence.
#
# -1000 is the kernel's OOM_SCORE_ADJ_MIN, and it is the only value that takes
# the process out of the selection. Anything else merely reweights it, and a
# reweighted process is still a candidate - which is why a negative value that
# is not the minimum is reported rather than accepted.
vpid=$(systemctl show vpp.service -p MainPID --value 2>/dev/null)
[ -n "$vpid" ] || vpid=0
if [ "$vpid" = 0 ]; then
  # A VPP that is not running at all was already reported above. A VPP that IS
  # running while vpp.service owns no process is a different box: something
  # started the dataplane by hand, and no drop-in on that unit covers it.
  if vppctl show version >/dev/null 2>&1; then
    warn "VPP is running but vpp.service owns no process: the drop-in"
    say "         that takes the dataplane out of the OOM killer's selection"
    say "         does not apply to a VPP somebody started by hand"
  fi
elif adj=$(cat "/proc/$vpid/oom_score_adj" 2>/dev/null); then
  case "$adj" in
    -1000)
      ok "dataplane out of the OOM killer's selection (oom_score_adj $adj)" ;;
    -*)
      warn "vpp's oom_score_adj is $adj: lowered, not removed. The"
      say "         dataplane is still a candidate when something else on this"
      say "         box grows, which is how it was killed at 19 MB resident" ;;
    *)
      bad "vpp's oom_score_adj is $adj: the dataplane can be chosen as an"
      say "        OOM victim for somebody else's allocation. The drop-in"
      say "        /etc/systemd/system/vpp.service.d/prisma-routing-oom-protect.conf"
      say "        is missing or did not take effect; check it, then"
      say "        'systemctl daemon-reload' and restart vpp.service" ;;
  esac
else
  bad "cannot read /proc/$vpid/oom_score_adj for vpp.service (pid $vpid)"
  say "        whether the dataplane is protected from the OOM killer is"
  say "        unknown on this box, which is not the same as protected"
fi

# --- plugins ---
if vppctl show plugins 2>/dev/null | grep -q bpa_plugin; then
  ok "CGNAT plugin loaded"
else
  bad "CGNAT plugin missing"
fi

# --- tuning: silence here is what costs half the throughput ---
if [ -f "$STARTUP" ] && grep -q "GENERATED by prisma-routing-tune" "$STARTUP"; then
  if grep -q "FIRST BOOT MODE" "$STARTUP"; then
    warn "running in FIRST BOOT mode: no pinning and no hugepages."
    say "         reboot for isolcpus and hugepages to take effect."
  else
    ok "full tuning active: $(grep -o 'corelist-workers.*' "$STARTUP" || echo 'no workers')"
    # The || used to sit after "head -1", which succeeds on empty input: a
    # box with no num-rx-queues printed "[ ok ] rx queues:" and nothing after
    # it, which is the reporting version of an assertion that cannot fail.
    #
    # WHAT THE DATAPLANE OPENED, read off the running process, card by card
    # (#345). /etc/vpp/startup.conf is what the tuner ASKED the dataplane
    # for, and a card that has fewer queues than that gets what it has: #330
    # is the box where seven were asked for on a NIC with one, VPP refused
    # the interface outright, and this row printed green about seven queues
    # over a box with no dataplane at all.
    #
    # DELIBERATELY `vppctl show hardware-interfaces`, where the cores below
    # deliberately refuse `vppctl show threads`. That one asks whether the
    # KERNEL agrees with VPP about where the threads are, and VPP reporting
    # on itself cannot answer it. This asks whether the dataplane opened the
    # queues it was asked for, and VPP is the only thing that can answer
    # that: the card's queues exist inside the DPDK driver and nothing in
    # /sys or /proc counts them once the card is bound.
    #
    # The format, captured off the guest lab/install-iso.sh boots (a virtio
    # card on uio_pci_generic, 2026-09-16), and not from a lab: the
    # packet-generator interfaces every lab here uses print no queue row of
    # any kind, which is why this waited for that guest. Under a name row
    # that starts in column one, a DPDK device prints, indented:
    #
    #   rx: queues 1 (max 1), desc 256 (min 32 max 32768 align 1)
    #   pci: device 1af4:1000 subsystem 1af4:0001 address 0000:00:09.00 numa 0
    #
    # The name is whatever the dataplane calls the card: the Linux name the
    # tuner wrote into the card's stanza (ens9 on that guest once #389 names
    # it; the capture below predates that and shows the bus name), or the
    # bus-address name VPP gives a card nobody named, and this prints it as
    # the dataplane does, because that is the name `show interface` and the
    # VTY answer to. The pci row is what pairs the card to its own `dev`
    # stanza in startup.conf: the tuner writes one request PER CARD, capped
    # at what each card can do, so the first num-rx-queues in the file is the
    # request for one card and not for the box. VPP prints the function as
    # two hex digits and the file as one (0000:00:09.00 against 0000:00:09.0),
    # so both are read as a number before they are compared.
    #
    # AND THE COUNT IS WHAT VPP WAS CONFIGURED WITH, NOT WHAT IT OPENED,
    # UNTIL THE DRIVER'S STATE IS READ BESIDE IT. That same capture is of a
    # card the driver REFUSED: `carrier down`, `flags: pmd-init-fail`, an
    # `Errors:` block naming rte_eth_rx_queue_setup errno -22, and it still
    # prints `rx: queues 1 (max 1)`. Read alone, the queue row says a dead
    # card opened one queue as requested, which is the #330 outcome this row
    # exists to stop printing. So the flags and Errors rows under the card
    # are read with it, and a card in that state opened nothing.
    rxq=$(grep -o 'num-rx-queues.*' "$STARTUP" | head -1)
    # <pci or "default"> <requested>, one row per dev stanza in the file.
    rxq_asked=$(awk '$1 == "dev" && $NF == "{" {dev = $2}
                     $1 == "num-rx-queues" && dev != "" {print dev, $2}
                     $1 == "}" && dev != "" && NF == 1 {dev = ""}' \
                "$STARTUP" 2>/dev/null)
    pcikey() {  # 0000:00:09.00 and 0000:00:09.0 -> the same key
      _f=${1##*.}; case "$_f" in *[!0-9a-fA-F]*|"") printf '%s' "$1"; return ;; esac
      printf '%s.%d' "${1%.*}" "$((0x$_f))"
    }
    rxq_have=""
    if vppctl show version >/dev/null 2>&1; then
      vpp_asked=1
      # <name> <opened> <max> <pci> <state>, one row per card that reports
      # queues; state is `ok`, `pmd-init-fail` (the driver's own flag) or
      # `errors` (an Errors: block under the card with no flag naming it).
      # `tr -d '\r'` because vppctl ends its rows with CR LF, and the CR would
      # stay on the last field of every row (the reason test_lab_crlf.py is).
      rxq_have=$(vppctl show hardware-interfaces 2>/dev/null | tr -d '\r' \
        | awk '
          function flush() { if (n != "") print name, n, m, (pci == "" ? "-" : pci), st }
          /^[^ \t]/ && $1 != "Name" { flush(); name = $1; n = ""; m = ""; pci = ""; st = "ok" }
          $1 == "rx:" && $2 == "queues" { n = $3; m = $5; gsub(/[^0-9]/, "", m) }
          $1 == "pci:" { for (i = 2; i < NF; i++) if ($i == "address") pci = $(i + 1) }
          $1 == "flags:" { for (i = 2; i <= NF; i++) if ($i == "pmd-init-fail") st = $i }
          $1 == "Errors:" && st == "ok" { st = "errors" }
          END { flush() }')
    else
      vpp_asked=0
    fi
    if [ -n "$rxq_have" ]; then
      # A here-document and not a pipe: `warn` counts what it prints, and a
      # pipe would run the loop in a subshell where the count is lost, so the
      # closing "ready, with N warning(s)" row would leave this one out (#297).
      while read -r _card _n _m _pci _st; do
        _rq=""
        [ "$_pci" != "-" ] && _rq=$(printf '%s\n' "$rxq_asked" \
            | while read -r _d _q; do
                [ "$_d" != default ] && [ "$(pcikey "$_d")" = "$(pcikey "$_pci")" ] \
                  && { echo "$_q"; break; }
              done)
        [ -n "$_rq" ] || _rq=$(printf '%s\n' "$rxq_asked" \
                               | awk '$1 == "default" {print $2; exit}')
        # VPP's own default when the file names none for this card, and the
        # row says so: "as requested" over a number nobody requested would
        # read as the tuner's doing.
        _rq_from=file
        [ -n "$_rq" ] || { _rq=1; _rq_from=vpp; }
        if [ "$_st" != ok ]; then
          # THE CARD OPENED NOTHING. The driver's init failed, the port sits
          # in `error` state in `show interface` (the failure a few rows
          # down names it), and the queue count VPP prints for it is the
          # count it was configured with, never opened. A failure and not a
          # warning: this box forwards nothing on this card.
          bad "rx queues: none opened on $_card"
          # Two states, two sentences: a flag is a mark VPP prints, an
          # Errors: block is a block it prints, and "marks the card errors"
          # would name a mark that does not exist.
          if [ "$_st" = errors ]; then
            say "        'show hardware-interfaces' lists an Errors: block"
            say "        under the card, so the"
          else
            say "        'show hardware-interfaces' marks the card $_st, so the"
          fi
          say "        $_n of $_m it lists were configured and never opened:"
          say "        the driver refused the port and the card carries no"
          say "        traffic. 'journalctl -u vpp' has the driver's reason."
        elif [ "$_n" = "$_rq" ] && [ "$_rq_from" = file ]; then
          # A card nobody named carries VPP's bus-address spelling, up to
          # 28 characters, and the whole row with three counts on it runs
          # past the console; the name goes on its own row then. A Linux
          # name never does (15 at most), so the guest's screen is one row.
          # The width is measured on the name alone (the three counts and
          # the words come to 35 columns at their widest), so the row below
          # is spelled out here and not built once and printed twice: the
          # reader that counts what this script prints cannot see a row
          # that is only a variable.
          if [ ${#_card} -gt 20 ]; then
            ok "rx queues: $_n of $_m, as requested ($_rq)"
            say "         on the card the dataplane calls $_card"
          else
            ok "rx queues: $_n of $_m on $_card, as requested ($_rq)"
          fi
        elif [ "$_n" = "$_rq" ]; then
          ok "rx queues: $_n of $_m on $_card, none requested"
          say "         the file asks nothing of this card and VPP opened its"
          say "         own default of $_rq."
        else
          # `[warn]` and not a failure: the box forwards on what it opened.
          # What it costs is throughput. The tuner sizes the workers on the
          # CPUs and asks for one queue per worker, capped at what the card
          # reported; a queue is what a worker receives from, and VPP gives
          # each queue to one worker, so a worker with no queue on this card
          # receives nothing from it, which is how the tuner's docstring
          # puts it too.
          warn "rx queues: $_n of $_m on $_card, $_rq requested"
          say "         the tuner asked for one queue per worker, capped at"
          say "         what the card reported, and the dataplane opened $_n:"
          say "         at most $_n worker(s) receive from this card, and the"
          say "         other workers receive nothing from it."
        fi
      done <<RXQ
$rxq_have
RXQ
    else
      # "REQUESTED" is the whole row here, and it is kept for the box where
      # nothing could be read: the number is the tuner's request and must not
      # read like a measurement. Two boxes land here and the row under it
      # tells them apart, because they need opposite work: a dataplane that
      # is not answering, and one that answers and holds no card that reports
      # queues - the box with no claimed card, which has no `dev` stanza and
      # so no request either (racking day), or a lab's pg0. On the second
      # there is no count in effect to read, and that is not a reading that
      # failed. (A FIRST BOOT profile never reaches this row: it takes the
      # warning above.)
      ok "rx queues requested: ${rxq:-default (1 per interface, one worker takes all)}"
      if [ "$vpp_asked" = 1 ]; then
        say "         the dataplane holds no card that reports its queues, so"
        say "         there is no count in effect to read back."
      else
        say "         what the dataplane opened could not be read: it is not"
        say "         answering, so the count in effect is unknown on this box."
      fi
    fi
  fi
else
  bad "/etc/vpp/startup.conf was not generated by prisma-routing-tune"
fi

# --- the dataplane's cores, and what is left over for the control plane ---
#
# The line above reports what /etc/vpp/startup.conf ASKS for. Nothing on an
# installed box has ever read what the dataplane GOT, and the two come apart
# quietly: prisma-routing-tune.service can fail and leave a startup.conf written
# for hardware that has since changed, /etc/vpp/startup.conf is a configuration
# file an operator may edit, and a VPP that has been running since before either
# happened is pinned to whatever it read when it started. In each of those the
# box boots, forwards, answers every command, and delivers a fraction of its
# throughput - and the only outward sign is a poll-mode thread reading 100%
# busy, which it does whether or not it has a core to itself.
#
# Three places, none of them the one that made the decision:
#
#   TOLD   /etc/vpp/startup.conf             what the tuner asked for
#   HAS    /proc/<vpp pid>/task/*/status     where the kernel put those threads
#   HAS    /sys/devices/system/cpu/isolated  what the kernel is isolating
#
# Deliberately NOT "vppctl show threads", which also carries the lcore: that is
# VPP reporting on itself, and the question here is whether the kernel agrees
# with VPP. Nothing below writes anything (#184).
#
cpulist() {  # "1-3,8" -> " 1 2 3 8"; the kernel's own format, everywhere
  _out=""
  for _part in $(printf '%s' "${1:-}" | tr ',' ' '); do
    case "$_part" in
      *-*) _a=${_part%%-*}; _b=${_part##*-}
           case "$_a$_b" in *[!0-9]*) continue ;; esac
           while [ "$_a" -le "$_b" ]; do _out="$_out $_a"; _a=$((_a+1)); done ;;
      *[!0-9]*|"") ;;
      *)   _out="$_out $_part" ;;
    esac
  done
  printf '%s' "$_out"
}
norm() {  # sorted, unique, space-delimited with a leading and trailing space
  printf ' %s ' "$(printf '%s' "${1:-}" | tr ' ' '\n' | grep -v '^$' \
                   | sort -n -u | tr '\n' ' ' | sed 's/ *$//')"
}
count() { set -- $1; echo $#; }
disp() {  # the same list, fit to print
  _d=$(norm "${1:-}"); _d=${_d# }; printf '%s' "${_d% }"
}

cp_isolated=$(cpulist "$(cat "$ROOT/sys/devices/system/cpu/isolated" 2>/dev/null)")
cp_online=$(cpulist "$(cat "$ROOT/sys/devices/system/cpu/online" 2>/dev/null)")
# Not nproc: nproc counts the CPUs available to the process that asks, so a
# self-test started under an affinity would report the box as smaller than it
# is and find nothing wrong with it.
niso_set=$(norm "$cp_isolated")   # once, not once per cpu: this is the boot path
cp_left=""
for c in $cp_online; do
  case "$niso_set" in *" $c "*) ;; *) cp_left="$cp_left $c" ;; esac
done

told_wk=$(cpulist "$(sed -n 's/^[[:space:]]*corelist-workers[[:space:]]*//p' \
                     "$STARTUP" 2>/dev/null | head -1)")
has_wk=""; has_main=""
if [ "${vpid:-0}" != 0 ]; then
  for t in "$ROOT/proc/$vpid/task/"*; do
    [ -r "$t/comm" ] || continue
    tname=$(cat "$t/comm" 2>/dev/null)
    tcpus=$(cpulist "$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' \
                       "$t/status" 2>/dev/null)")
    case "$tname" in
      vpp_wk_*) has_wk="$has_wk $tcpus" ;;
      vpp_main) has_main="$tcpus" ;;
    esac
  done
fi

if [ -z "$told_wk" ]; then
  # No corelist-workers: first boot, or a box too small for a dedicated
  # worker. Both are already reported above, and neither has cores to compare.
  :
elif [ "${vpid:-0}" = 0 ]; then
  warn "vpp.service owns no process, so where the dataplane's workers"
  say "         actually run cannot be read: the profile names"
  say "        $(disp "$told_wk") and nothing confirms it"
elif [ -z "$has_wk" ]; then
  bad "startup.conf pins workers to cores the dataplane has none of"
  say_list "        " "pinned:$told_wk"
  say "        the dataplane has no worker thread at all: it is forwarding on"
  say "        its main thread, at a"
  say "        fraction of this box's capacity. VPP was started before that"
  say "        profile was written - 'systemctl restart vpp.service'"
else
  # Does the running dataplane hold the cores its own profile names? A VPP
  # older than the file it is judged against is the ordinary way this goes
  # wrong, and "full tuning active" above reports the file, so it says yes.
  if [ "$(norm "$has_wk")" = "$(norm "$told_wk")" ]; then
    ok "dataplane workers hold the cores the profile names: $(disp "$has_wk")"
  else
    bad "startup.conf pins workers to cores the dataplane is not holding"
    say_list "        " "pinned:$told_wk"
    say_list "        " "holding: $(disp "$has_wk")"
    say "        This VPP is older than the"
    say "        profile it is being judged against; the box is running the"
    say "        previous tuning. 'systemctl restart vpp.service'"
  fi
  # And is the kernel keeping everything else off them? isolcpus is what stops
  # the scheduler putting other work on a worker's core. A worker pinned to a
  # core the kernel is not isolating shares it with everything the scheduler
  # has to place, and poll mode means it never yields: the core is contended
  # for the whole time and the loss appears as burst drops with no counter
  # behind them.
  notiso=""
  for c in $(norm "$has_wk"); do
    case "$niso_set" in *" $c "*) ;; *) notiso="$notiso $c" ;; esac
  done
  if [ -z "$notiso" ]; then
    ok "and the kernel is isolating every one of them"
  else
    bad "worker core(s)$notiso are NOT isolated by this kernel"
    say "        (isolcpus gives $(disp "$cp_isolated"))."
    say "        A poll-mode worker there shares its core with everything the"
    say "        scheduler places, and never yields. The box forwards and"
    say "        loses throughput with no counter to show for it. The command"
    say "        line is generated into /etc/default/grub.d/prisma-routing.cfg:"
    say "        check it matches, run update-grub and reboot"
  fi
fi

# What the control plane is left with, reported and not capped.
#
# This product bounds the control plane where a bound can be derived and
# refuses to where it cannot - MemoryMax on prisma-routing.service against a
# measured 13 MB, no MemoryMax on frr.service because one full table costs
# 1.37 GB and 37 MB is the same product with default routes (docs/appliance.md).
# The CPUs are the same shape: which cores the control plane has is decided by
# the tuner, per box, and written to the kernel command line - so the box can
# READ it back and say what it came to, which is what this line is.
#
# The warning is arithmetic, not a threshold somebody liked. One CPU left while
# more than one is isolated means every worker core but one could have been
# handed back and was not: FRR, frr-reload, vtysh, prismash, sshd and VPP's own
# main thread are all on that single CPU, and the main thread is the one that
# takes the worker barrier once a second (bpa-expire-process). A box with one
# isolated core has nothing to give back and is not warned about.
if [ -n "$cp_isolated" ] && [ -n "$cp_left" ]; then
  nleft=$(count "$cp_left"); niso=$(count "$cp_isolated")
  main_note=""
  nleft_set=$(norm "$cp_left")
  for c in $has_main; do
    case "$nleft_set" in *" $c "*) main_note=", with VPP's main thread" ;; esac
  done
  if [ "$nleft" = 1 ] && [ "$niso" -gt 1 ]; then
    warn "the control plane has ONE cpu ($(disp "$cp_left"))$main_note:"
    say "         $niso cores are isolated for workers and everything that is"
    say "         not a worker shares what is left. VPP's main thread takes the"
    say "         worker barrier once a second there, and forwarding stops for"
    say "         as long as it waits to be scheduled. Hand cores back with"
    say "         PRISMA_MAX_WORKERS in /etc/prisma-routing/tune.env - each one costs"
    say "         that share of forwarding, so the trade is the operator's"
  else
    ok "control plane has $nleft cpu(s): $(disp "$cp_left")$main_note"
  fi
fi

# --- latency: without this the box forwards and still loses under burst ---
#
# TWO readings, not one. /proc/cmdline is what THIS boot actually got;
# /etc/prisma-routing/tune.env is what was asked for and what the next boot will
# get. The line used to read only the first and then advise "set
# PRISMA_LOW_LATENCY=0" - which on a box that had already set it was the console
# telling the operator to do the thing they did, about a state they chose.
#
# And the case worth the most is the one that had no line at all: tune.env
# saying 0 while the command line still carries the parameters, or the reverse.
# That is a box running a command line older than the file that generates it,
# which is exactly "the tuning requested is not the tuning in effect".
#
# Read, never sourced: tune.env is a file an operator edits by hand, and
# sourcing it would run whatever is in it as root inside the boot self-test.
TUNEENV=${PRISMA_TUNE_ENV:-$ROOT/etc/prisma-routing/tune.env}
# The management network the installer recorded, read ONCE and here.
#
# Two sections need it and they are seven hundred lines apart: the dataplane
# block says which card was reserved for Linux and why (#378), and the network
# section below says what became of that card. Reading the file twice would be
# two answers to one question in one script, which is what this file's own
# comment about not keeping a second opinion is against - and they would
# disagree the first time one of them moved.
#
# The words on that line are interfaces(5)'s, not this product's, so the name
# comes out of column two rather than being matched against a string this file
# could reword. appliance/prisma-routing-tune reads the same file the same way.
MGMTCONF="$ROOT/etc/network/interfaces.d/prisma-routing"
mgmt_if=$(awk '$1 == "iface" { print $2; exit }' "$MGMTCONF" 2>/dev/null)
mgmt_how=$(awk '$1 == "iface" { print $4; exit }' "$MGMTCONF" 2>/dev/null)
ll=$(sed -n 's/^[[:space:]]*PRISMA_LOW_LATENCY[[:space:]]*=[[:space:]]*//p' \
     "$TUNEENV" 2>/dev/null | tail -1 | tr -d '"'"'"' \t')
ll=${ll:-1}
ll_refused=""
case "$ll" in
  0|1) ;;
  # apply-tuning refuses anything else and uses 1. The self-test says the same
  # thing rather than a second, different answer: two components disagreeing
  # about one file is worse than either being wrong.
  *) ll_refused=$ll; ll=1 ;;
esac
if [ -n "$ll_refused" ]; then
  warn "PRISMA_LOW_LATENCY='$ll_refused' in /etc/prisma-routing/tune.env is"
  say "         not a value the box accepts. Only 1 (deep C-states off,"
  say "         transparent hugepages off, cpufreq governor on performance)"
  say "         and 0 (leave all three alone). Being read as 1, the default"
fi

cst=no
grep -q "processor.max_cstate=1" "$ROOT/proc/cmdline" 2>/dev/null && cst=yes
case "$ll$cst" in
  1yes) ok "deep C-states disabled on the kernel command line" ;;
  1no)  warn "deep C-states still enabled: expect jitter on bursts."
        say "         PRISMA_LOW_LATENCY=1 asks for them off, so the tuning has"
        say "         not reached this boot's command line. Reboot; if it is"
        say "         still missing after that, read the generated file"
        say "         /etc/default/grub.d/prisma-routing.cfg and run update-grub" ;;
  0no)  say "  [info] deep C-states left enabled on purpose:"
        say "         PRISMA_LOW_LATENCY=0 in /etc/prisma-routing/tune.env. Expect"
        say "         jitter on bursts; set 1 and reboot to trade power for it" ;;
  0yes) warn "this boot's command line disables deep C-states and"
        say "         PRISMA_LOW_LATENCY=0 in /etc/prisma-routing/tune.env asks for"
        say "         them left alone: the box booted a command line older"
        say "         than that file. Reboot to run what it now says" ;;
esac

# And what the kernel actually exposes, which is not what it was asked for. A
# parameter the kernel IGNORED leaves /proc/cmdline saying it was requested
# and the kernel behaving as though it was not, so a green line above can be
# about nothing at all. This is the readback that says when it is.
idle=$(cat "$ROOT/sys/devices/system/cpu/cpuidle/current_driver" 2>/dev/null \
       || echo "")
if [ -z "$idle" ] || [ "$idle" = none ]; then
  say "  [info] the kernel exposes no idle-state driver, so nothing here"
  say "         enters a C-state and those parameters have nothing to act"
  say "         on either way. Usual on a virtual machine"
fi

gov=$(cat "$ROOT/sys/devices/system/cpu/cpufreq/policy0/scaling_governor" 2>/dev/null || echo "")
if [ -z "$gov" ]; then
  say "  [info] no cpufreq exposed (virtual machine): nothing to set"
elif [ "$gov" = performance ]; then
  ok "cpufreq governor: performance"
else
  warn "cpufreq governor is '$gov', not performance"
fi

# --- and did the KERNEL take the tuning, or only receive it? ---
#
# Every line above reads one side or the other. This reads both against each
# other, for every rule the tuner writes: the generated GRUB file is the
# request, /proc/cmdline is what THIS boot was given, and /sys and /proc/sys
# are what the kernel is actually doing. A request can be lost at each step -
# update-grub never ran, the box has not rebooted since, or the kernel saw the
# parameter and refused it - and #290 is the box where it was lost at the
# last one: a command line carrying `hugepagesz=1G hugepages=5` on a cpu with
# no 1G page, for the life of that machine, while every reader of that command
# line went on reporting a tuned box.
#
# THE READING IS THE TUNER'S, and not a second copy kept here. It writes those
# parameters, so it is the one component that knows what they are; a list of
# them in this file would be the same truth in two places with nothing
# comparing them, which is what the IPFIX record, docs/context.md and the VTY
# transcripts each cost before they got a reader. `--report-effective` prints
# one rule per line in a fixed shape, and this renders it.
#
# FOUR ANSWERS AND NOT TWO, which is the whole of #163: "requested and NOT in
# effect" must not collapse into "in effect" - that is an appliance claiming
# tuning it does not have - nor into "not requested", which makes a broken box
# look like a deliberate one. And a parameter this box exposes no way to read
# is a fourth answer, not a guess in either direction.
#
# PRISMA_TUNE is the same seam as PRISMA_SYSTEMCTL in appliance/apply-tuning: the
# one external command whose answer decides what gets printed, named so that
# test/test_selftest.sh can arrange a box whose tuning went each of those four
# ways - and a box with no tuner on it at all, which is a different line from
# a box whose tuning did not take.
TUNER=${PRISMA_TUNE:-prisma-routing-tune}
if ! command -v "$TUNER" >/dev/null 2>&1; then
  warn "prisma-routing-tune is not on this box, so what the kernel did"
  say "         with the tuning cannot be read here at all"
else
  eff=$("$TUNER" --report-effective --sysfs-root "${ROOT:-/}" 2>/dev/null)
  if [ -z "$eff" ]; then
    warn "prisma-routing-tune could not say what tuning is in effect, so"
    say "         this box is unmeasured rather than confirmed"
  else
    ntaken=0
    nrefused=0
    # No pipe: a `while read` behind one runs in a subshell and the counts
    # would come back to nothing, which is the summary line saying "0" on a
    # box with sixteen rules in effect.
    _oifs=$IFS
    IFS='
'
    for _l in $eff; do
      IFS=$_oifs
      _state=${_l%% *}; _rest=${_l#* }
      _rule=${_rest%%: *}; _why=${_rest#*: }
      case "$_state" in
        in-effect) ntaken=$((ntaken + 1)) ;;
        not-in-effect)
          nrefused=$((nrefused + 1))
          warn "requested and NOT in effect: $_rule"
          say_list "         " "$_why" ;;
        cannot-tell)
          say "  [info] cannot be read on this box: $_rule"
          say_list "         " "$_why" ;;
        not-requested)
          say "  [info] not requested on this box: $_rule"
          say_list "         " "$_why" ;;
        # A parameter the tuner writes and has no readback for. It cannot
        # reach a shipped box - appliance/test_tune.py compares the readbacks
        # against the command line the tuner really generates - so this is
        # here for the build where somebody adds a knob and not its reader.
        no-reader)
          warn "no way to read back a parameter this box sets: $_rule"
          say_list "         " "$_why" ;;
      esac
      IFS='
'
    done
    IFS=$_oifs
    if [ "$nrefused" = 0 ] && [ "$ntaken" -gt 0 ]; then
      ok "every tuning rule this box can read back is in effect ($ntaken)"
    fi
  fi
fi

# --- does the VTY open? ---
# 0.2.0 shipped a prismash that died at start for want of config.py, and this
# self-test went green: it measured the dataplane, the routing and the tuning,
# and never the front door. A boot that does not exercise the VTY does not know
# whether it is there.
if ! command -v prismash >/dev/null 2>&1; then
  bad "prismash is not installed"
else
  out=$(prismash -c "show rollback" 2>&1)
  case "$out" in
    *Traceback*|*ModuleNotFoundError*|*"No module named"*)
      bad "prismash does not start: $(printf '%s' "$out" | tail -1)" ;;
    *) ok "VTY starts: $(printf '%s' "$out" | head -1)" ;;
  esac
fi

# --- can this box reach anything, and can it say so? ---
#
# The three statements the VTY answers reachability with run Debian's own
# tools (#395), and a statement whose tool is absent is a promise the box does
# not keep - found by an operator diagnosing something else, at the moment
# they had a question. The VTY refuses such a statement by naming the package;
# this says the same thing at boot, where nobody has to ask first.
#
# A warning and not a failure: a box with no mtr forwards every packet it is
# given, and the release this line was written for would rather say what is
# missing on a box that works than refuse to declare one.
probe_missing=""
for _p in ping traceroute mtr; do
  command -v "$_p" >/dev/null 2>&1 || probe_missing="$probe_missing $_p"
done
if [ -z "$probe_missing" ]; then
  ok "ping, traceroute and mtr are installed, so the VTY can reach out"
else
  warn "the VTY cannot run:$probe_missing"
  say "         each is an operational statement of prismash, and the box"
  say "         refuses the ones whose tool is not here. They come from"
  say "         iputils-ping, traceroute and mtr-tiny"
fi

# --- plano de controle ---
if vtysh -c "show version" >/dev/null 2>&1; then
  ok "FRR responding"
  # WHICH daemons, not merely that FRR answers. zebra, mgmtd and staticd are
  # started unconditionally by frrinit.sh, so "FRR responding" is true on a box
  # that cannot run a single routing protocol - which is what it was, before
  # the installer enabled them (#99). A box that cannot run BGP should say so
  # before somebody configures BGP on it.
  daemons=$(vtysh -c "show daemons" 2>/dev/null | tr -s ' ')
  missing=""
  # ospf6d is here for the same reason the other three are, and it was left
  # out for one release longer (#187): the VTY accepted `router ospf6` and the
  # installer enabled every daemon but that one, so OSPFv3 was the one
  # protocol a box could be configured for and never run.
  for d in bgpd ospfd ospf6d isisd; do
    case " $daemons " in *" $d "*) ;; *) missing="$missing $d" ;; esac
  done
  if [ -n "$missing" ]; then
    warn "routing daemons not running:$missing"
    say "         the VTY offers these protocols and they would commit and"
    say "         reach nothing. Enable them in /etc/frr/daemons."
  else
    ok "routing daemons up:$(printf '%s' "$daemons" | tr -d '\n')"
  fi

  # IS-IS is not carried over IP: it is OSI NLPID 0x83 straight over the link,
  # and linux_cp drops it unless told to punt it. A box with an IS-IS instance
  # and no punt commits cleanly, brings isisd up, reads back correctly, and
  # forms no adjacency ever - with the only evidence in a dataplane error
  # counter nothing surfaces. Worth its own line for that reason.
  if vtysh -c "show running-config" 2>/dev/null | grep -q "^router isis"; then
    if vppctl show lcp 2>/dev/null | grep -qi "osi.*0x83\|osi-proto.*131"; then
      ok "IS-IS frames are punted to the kernel"
    else
      warn "IS-IS is configured and its frames are NOT punted"
      say "         the adjacency will never form, and the only sign of it"
      say "         is a dataplane counter for unknown OSI protocols"
    fi
  fi

  # RPKI is a loadable module, and one that is present and not loaded is not
  # there. Worth its own line because the symptom is misleading: bgpd refuses
  # to start when told to load a module it cannot find, so a missing module
  # presents as "bgpd is not running" and sends the reader after the wrong
  # thing entirely.
  if vtysh -c "show rpki cache-connection" >/dev/null 2>&1; then
    caches=$(vtysh -c "show running-config" 2>/dev/null \
             | grep -c "^ rpki cache" || true)
    if [ "${caches:-0}" -eq 0 ]; then
      ok "RPKI module loaded (no cache configured, so nothing is validated)"
    else
      # A cache that is configured and not connected marks EVERY route
      # notfound. A policy that denies invalid keeps working; one that treats
      # notfound as suspicious degrades every route on the box, quietly, and
      # cache outages are ordinary.
      # The per-cache "(connected)" marker, not the "Connected to group N"
      # header - measured: the header still says Connected long after the
      # cache is gone.
      conn=$(vtysh -c "show rpki cache-connection" 2>/dev/null \
             | grep -c "(connected)" || true)
      if [ "${conn:-0}" -ge 1 ]; then
        ok "RPKI: $caches cache(s) configured and connected"
      else
        warn "RPKI: $caches cache(s) configured, NONE connected"
        say "         validation is running on what the caches already sent,"
        say "         which expires; after that every route is notfound and a"
        say "         policy keyed on notfound is acting on all of them"
      fi
    fi
  else
    warn "RPKI module not loaded: origin validation is unavailable"
    say "         install frr-rpki-rtrlib and add '-M rpki' to bgpd_options"
    say "         in /etc/frr/daemons"
  fi
else
  bad "FRR not responding"
fi

# --- the binary API, which is how a pool gets created ---
#
# prismash creates and changes pools over the binary API, not the CLI socket.
# Without the vat2 plugin that API is not registered and every pool operation
# fails - so the box runs, answers, routes, and cannot be configured to do the
# one thing it is for. The ISO shipped without that plugin for the life of the
# project and said so only as a warning in the build log
# (https://github.com/andrediashexa/hexarouting/issues/119).
#
# Read-only on purpose. This runs at every boot on a production box: it asks
# whether the API is registered and does not create anything to find out.
if vat2 --dump-apis 2>/dev/null | grep -q bpa_pool_add_del; then
  ok "binary API registered, so pools can be configured"
else
  bad "binary API NOT registered: no CGNAT pool can be configured here"
  say "         the vat2 plugin is missing from this install. The box will"
  say "         route and answer, and every pool commit will fail."
fi

# --- can the accounts on THIS box use that API? ---
#
# Roles (#35) bound what the VTY will do. They are decorative if every operator
# still has to be root to reach the dataplane, and worse than decorative: the
# box would report a boundary it does not have.
#
# "api-segment { gid vpp }" group-owns /dev/shm/vpe-api and NOT
# /dev/shm/global_vm, which a client maps as well. A drop-in on vpp.service
# fixes the second one after the dataplane starts. Asserted by actually making
# a call, not by reading the mode bits: the mode being right is the thing that
# was meant to make the call work, and checking the means instead of the end is
# how a permission comes to be set correctly and still not be enough.
# https://github.com/andrediashexa/hexarouting/issues/76
#
# The call used to be made by "setpriv --groups vpp", which SYNTHESISED the
# membership. That answers "would an account in group vpp work" - which was
# always yes - and never "is any account in group vpp", which for the whole
# life of the product was no: the VTY created accounts and put them in no group
# at all (#184). A self-test that manufactures the condition it is checking for
# cannot report its absence, and this one reported a working box while every
# operator account on it was inert.
#
# So: the accounts the box actually has, run as themselves. Read-only, and it
# creates nothing - --dump-apis only lists what is registered.
VPPGID=$(getent group vpp 2>/dev/null | cut -d: -f3)
# The login shell is what marks an account as this VTY's, the same marker the
# VTY itself reads. A list kept somewhere else would be a second thing to keep
# in step.
VTY_ACCOUNTS=$(getent passwd 2>/dev/null \
  | awk -F: '$7 == "/usr/bin/prismash-login" && $1 != "root" { print $1 }')
if [ -z "$VPPGID" ]; then
  bad "there is no 'vpp' group, so the API cannot be shared with anybody"
elif [ -z "$VTY_ACCOUNTS" ]; then
  # Not a failure: a freshly installed box has no operator accounts yet, and
  # the operator makes those. Said out loud so that "no accounts" is never
  # mistaken for "the accounts are fine".
  say "  [info] no operator account exists yet: only root can use this box"
  say "         create one with 'user <name>' and give it a role"
else
  prover=""
  for u in $VTY_ACCOUNTS; do
    ugroups=" $(id -nG "$u" 2>/dev/null) "
    missing=""
    for need in vpp frr frrvty; do
      case "$ugroups" in *" $need "*) ;; *) missing="$missing $need" ;; esac
    done
    urole=""
    case "$ugroups" in *" prisma-admin "*) urole=administrator ;; esac
    if [ -z "$urole" ]; then
      case "$ugroups" in *" prisma-cgnat "*) urole=cgnat-operator ;; esac
    fi
    if [ -n "$missing" ] && [ -n "$urole" ]; then
      # The exact shape of #184: a rank the box grants and an account that
      # cannot exercise it. Every command it issues fails with permission
      # denied, which reads as an authorization refusal and is not one.
      bad "$u has role $urole and is in none of:$missing"
      say "        the role cannot be exercised: VPP's sockets are group vpp"
      say "        and /etc/frr is group frr. Re-apply the role from the VTY:"
      say "        configure / user $u / role $urole / commit"
    elif [ -n "$missing" ]; then
      warn "$u is read-only and is in none of:$missing"
      say "         it cannot read the dataplane or the routing state either"
    fi
    [ -n "$prover" ] && continue
    case "$ugroups" in *" vpp "*) prover=$u ;; esac
  done
  if [ -z "$prover" ]; then
    bad "no account on this box is in group vpp: only root can use the API"
  elif runuser -u "$prover" -- vat2 --dump-apis >/dev/null 2>&1; then
    ok "the binary API works for $prover, an account that really has the group"
  else
    bad "the binary API does not work for $prover: it would have to be root"
    say "         /dev/shm/global_vm is $(stat -c '%U:%G %a' /dev/shm/global_vm \
2>/dev/null || echo 'not there'), and it must be group vpp, mode 660"
  fi
fi

# --- which NIC the dataplane was given ---
#
# Said out loud because the failure it replaces was silent. The box used to
# ship PRISMA_DATAPLANE_IF=eth0, which does not exist under predictable interface
# names, and the tuner then generated a DPDK stanza with no device allowlist -
# so VPP claimed whatever NIC it found, which on a single-NIC box is the
# management one. The operator learned about it by losing the session (#123).
#
# Then nothing was claimed unless it was named, which was safe and was also a
# box that could not forward until somebody typed. Now the box claims every
# card it has but a reserve, and never the last one (#378) - so what reaches
# the branches below is a box that claimed nothing because it had nothing to
# claim, or one that was told which card to take.
#
# The reason this is said out loud at all did not change: a box that forwards
# nothing looks like a box that is working.
if grep -q "plugin dpdk_plugin.so { disable }" "$STARTUP" 2>/dev/null
then
  # No DPDK at all, so no device can be claimed by anything. This is the
  # first-boot profile: without hugepages the EAL fails and VPP exits, so the
  # tuner turns the plugin off until a reboot has reserved them. Safe, and it
  # has to be told apart from "DPDK is on and no device is named", which is the
  # dangerous case below - the first version of this check conflated them and
  # failed every live medium.
  say "  [info] DPDK is off until hugepages exist; no NIC can be claimed yet"
elif grep -q "no-pci" "$STARTUP" 2>/dev/null; then
  # The remedy is a command in the VTY now, not a path and an editor (#283).
  # This is the account an operator reads on the console of a box that has
  # just come up forwarding nothing, so it has to be true of THIS box.
  #
  # IT WAS NOT, ON THE BOX WHERE IT MATTERS MOST (#309). It used to end "and
  # so is the interface carrying the default route, so naming the management
  # one cannot cut it off". Since #303 a box with only that card ACCEPTS it:
  # the card moves and the management address goes with it onto the linux_cp
  # pair. So on a one-NIC VM - which is how most people meet this product -
  # this promised a refusal the box does not make.
  #
  # Both cases are stated rather than computed here. Deciding which applies
  # would mean a second copy of the VTY's rule living in a shell script, and
  # the two would disagree the first time one of them moved; the operator is
  # about to type the command anyway, and the box answers for itself.
  # AND THIS IS NO LONGER THE ORDINARY BOX (#378). The box claims every card
  # it has but a reserve, and never the last one, so reaching here means it
  # claimed nothing - not that nobody has typed yet. The old sentence told the
  # operator to name a card, which on a box that already looked is advice for
  # a state this box is not in.
  #
  # AND WHICH OF TWO BOXES THIS IS, because they need opposite work and read
  # identically from `no-pci` alone. A box with no card has nothing to claim;
  # a box WITH a card that claimed nothing declined it, and the only reason it
  # declines is that it could not work out how to stay reachable without the
  # card it is reached on.
  #
  # COUNTED FROM PCI AND NOT FROM /sys/class/net, which is the same reading
  # the tuner makes: class 0x02 is a network controller and does not change
  # when a driver does, so this counts the same cards before and after a bind.
  _pcinics=0
  for _d in "$ROOT"/sys/bus/pci/devices/*; do
    [ -e "$_d/class" ] || continue
    case "$(cat "$_d/class" 2>/dev/null)" in
      0x02*) _pcinics=$((_pcinics + 1)) ;;
    esac
  done
  noforward="no interface to forward on"
  if [ "$_pcinics" = 0 ]; then
    warn "no dataplane interface: this box has no PCI network card for the"
    say "         dataplane to claim, so it forwards nothing. A virtio card in"
    say "         a virtual machine does count; a card Linux cannot see does"
    say "         not. 'show hardware' lists what this box can see."
  else
    warn "no dataplane interface: this box has $_pcinics card(s) and claimed"
    say "         none. The card it is reached on is the only one it could"
    say "         have taken, and it could not read an address, a MAC and a"
    say "         gateway to put back - so it kept the card and stayed"
    say "         reachable. prisma-routing-tune says which of the three in the"
    say "         journal."
  fi
elif grep -q "dev 0000:" "$STARTUP" 2>/dev/null; then
  # A NAME IN A FILE IS NOT A NIC. This said [ ok ] as soon as a device
  # appeared in startup.conf, so a box whose dataplane has no interface at all
  # passed its own self-test on the strength of a line somebody wrote (#283).
  # That is docs/context.md 1.4 one more time: the configuration is the
  # intention, and the dataplane is the fact.
  #
  # Nothing in this appliance binds a NIC to vfio-pci or loads it, so an
  # operator who did exactly what the warning above tells them - name the
  # interface - lands here, is told the NIC is fine, and still forwards
  # nothing.
  # EVERY device, not the first (#378). A box claiming three cards and holding
  # one is a box forwarding on a third of its ports, and `head -1` reported the
  # one that worked.
  NICPCI=$(grep -o 'dev 0000:[0-9a-f:.]*' "$STARTUP" | cut -d' ' -f2 \
           | tr '\n' ' ' | sed 's/ $//')
  NICN=$(printf '%s' "$NICPCI" | tr ' ' '\n' | grep -c .)
  # WHETHER THE BOX CHOSE, which is the whole of what #378 changed and the one
  # thing an operator cannot see from the PCI address. PRISMA_DATAPLANE_IF is
  # the tuner's input and the VTY writes it; it ships empty, so empty means
  # nobody named a card and the box claimed by itself.
  #
  # Read with sed and never sourced, for the reason PRISMA_LOW_LATENCY is:
  # tune.env is a file an operator edits by hand, and sourcing it would run
  # whatever is in it as root inside the boot self-test.
  NAMEDIF=$(sed -n \
      's/^[[:space:]]*PRISMA_DATAPLANE_IF[[:space:]]*=[[:space:]]*//p' \
      "$TUNEENV" 2>/dev/null | tail -1 | tr -d '"'"'"'')
  # "any interface that is not local0" and not a count: local0 is VPP's own
  # loopback and is present on a box with no NIC whatever.
  if vppctl show interface 2>/dev/null \
       | awk 'NR>1 && $1 != "" && $1 != "local0" {found=1} END {exit !found}'
  then
    # WHAT THE BOX DID AND WHY, because a box that silently ate a card is
    # worse than one that asked (#378). The address alone was the whole line
    # when there was only ever one card and somebody had always typed it.
    if [ -n "$NAMEDIF" ]; then
      ok "dataplane NIC: $NICPCI"
      say "         named in the configuration as '$NAMEDIF', so the box"
      say "         claims that card and no other."
    elif [ "$NICN" = 1 ]; then
      ok "dataplane NIC: $NICPCI, claimed by this box with nobody asked"
    else
      ok "dataplane NIC(s): claimed by this box with nobody asked"
      say_list "         " "$NICPCI"
    fi
    # AND WHICH CARD LINUX KEPT, if any. The reserve is the management network
    # the installer recorded, and an operator looking at a box with three
    # cards and two claimed needs the reason the third was spared - otherwise
    # it reads as a card the box failed to take.
    if [ -z "$NAMEDIF" ] && [ -n "${mgmt_if:-}" ] \
       && [ "$NICN" -lt "$(ls "$ROOT/sys/class/net" 2>/dev/null | wc -l)" ]
    then
      say "         '$mgmt_if' is reserved for Linux: it is the"
      say "         management network this box was installed with."
    fi
    # AND WHETHER THOSE PORTS ACTUALLY STARTED (#382).
    #
    # THE SAME SCREEN, deliberately. The three readings above say which cards
    # the box took and which it left; this says whether the ones it took work,
    # and an operator reading a console does not care that the two halves
    # arrived from different issues. A card claimed and a card forwarding are
    # different claims, and the gap between them is where #382 lived.
    #
    # An interface the dataplane HOLDS is not an interface that forwards. VPP
    # puts `error` in the State column of a port whose driver refused to start
    # it, and every reading above this line is true of such a box: the card is
    # bound to a driver DPDK can use, the dataplane lists the interface, the
    # pair is there and the address is on it. The box reports ready and cannot
    # pass a packet.
    #
    # That is the state #382 was reported from - VPP brings a DPDK port up at
    # 9000 and the card's maximum was 1500 - and it is the shape #297 and #311
    # are about: a green report about a box whose only interface is dead.
    #
    # The state word is column three of `show interface`, and only a name
    # starts in column one; every counter line is indented.
    errored=$(vppctl show interface 2>/dev/null \
              | awk '/^[^ \t]/ && $1 != "Name" && $3 == "error" {print $1}' \
              | tr '\n' ' ')
    if [ -n "$errored" ]; then
      bad "the dataplane holds interface(s) its driver refused to start:"
      say "       $errored"
      # THE SMALLEST OF ITS CARDS' MAXIMA, not "the card's maximum" (#378).
      # The box can claim several and VPP takes one value for them all, so
      # naming a single card here would describe a box that has one - and on
      # the box this sentence is for, the operator is looking at a list.
      say_list "        " "'show interface' reports them in error state." \
        "They carry no traffic, and everything else about this box can look" \
        "right. 'journalctl -u vpp' has the driver's own reason." \
        "An MTU above what the card accepts is one: the box starts every" \
        "interface at the smallest maximum its claimed cards report, so a" \
        "port in this state after an 'mtu' was configured is a value that" \
        "card cannot carry."
    fi
  else
    bad "the dataplane has no interface, and one is named"
    say "        $NICPCI"
    NICDRV=$(basename "$(readlink -f "/sys/bus/pci/devices/$NICPCI/driver" \
                         2>/dev/null)" 2>/dev/null)
    case "$NICDRV" in
      vfio-pci|uio_pci_generic|igb_uio)
        say "         it is bound to $NICDRV, which DPDK can use, so the"
        say "         binding is not the problem. The VPP journal says why." ;;
      "" |.)
        say "         no driver is bound to it at all." ;;
      *)
        say "         it is bound to '$NICDRV', which DPDK cannot take it"
        say "         through." ;;
    esac
    for d in vfio-pci uio_pci_generic igb_uio; do
      [ -d "/sys/bus/pci/drivers/$d" ] && { HAVEDRV=$d; break; }
    done
    if [ -n "${HAVEDRV:-}" ]; then
      case "$NICDRV" in
        vfio-pci|uio_pci_generic|igb_uio) : ;;
        *) say "         $HAVEDRV is loaded, and nothing has bound the device to it." ;;
      esac
    else
      say "         no driver DPDK can use is loaded: none of vfio-pci,"
      say "         uio_pci_generic, igb_uio."
    fi
  fi
else
  bad "the dataplane may claim any NIC it finds, including this box's"
  say "         management interface. /etc/vpp/startup.conf names no device"
  say "         and does not say no-pci."
fi

# --- is any dataplane interface paired into the kernel? ---
#
# FRR only ever sees a linux_cp pair. VPP owns the NIC outright, so without a
# pair the port that carries traffic has no netdev at all: `ip` does not have
# it, zebra does not have it, and BGP, OSPF and IS-IS are configurable and
# completely inert (#182). For the life of the product nothing created a pair
# and every lab created one by hand, so the labs proved a box nobody received.
#
# The pair is the OPERATOR's to ask for, by name - `linux-name <name>` under
# `interface` - and that is a decision rather than an omission: the Linux-side
# name is what FRR, `ip` and the operator's own scripts act on, so a name this
# product invented would be one nobody could predict, and #161 is the standing
# rule that such a name must be read back from the box rather than remembered.
# The cost of the decision is that a box can be installed, tuned, given a NIC
# and left with no pair, which from outside looks exactly like a box that is
# working. This line is what pays that cost.
#
# Read from the box and never arranged here. A check that creates the pair it
# is checking for cannot report its absence, which is #184 in one sentence.
#
# Excluded from the count, with the reason for each:
#   local0   VPP's own null interface. On every box, never paired.
#   pg*      the packet generator, which exists in labs and not on appliances
#   tap*     the LINUX end of a pair is itself an interface in VPP's list, so
#            counting it would make every correctly paired box look half done
if vppctl show version >/dev/null 2>&1; then
  lcp_lines=$(vppctl show lcp 2>/dev/null | grep "itf-pair" || true)
  unpaired=""
  npaired=0
  # The header of `show interface` is INDENTED, and so is every continuation
  # line carrying a counter; only a name starts in column one. The $1 != "Name"
  # is the second half of the same belt, because a header that ever loses its
  # indentation would otherwise be reported as an unpaired interface.
  for iface in $(vppctl show interface 2>/dev/null \
                 | awk '/^[^ \t]/ && $1 != "Name" {print $1}'); do
    case "$iface" in local0|pg*|tap*) continue ;; esac
    # Matched as a fixed string between spaces, not as a pattern: VPP's own
    # interface names are full of "/" and "." and a pattern made of one would
    # match interfaces it does not name. Every name on an itf-pair line is
    # followed by a space, because the line ends "type tap".
    if printf '%s\n' "$lcp_lines" | grep -qF " $iface "; then
      npaired=$((npaired + 1))
    else
      unpaired="$unpaired $iface"
    fi
  done
  # WHO NEEDS THIS PAIR, and there are TWO answers rather than one. Asking
  # only the first is what #334 is: a box that hands its only card over gets
  # its default route put back in Linux by `prismash --load`, off the way back
  # in /run, and has no `router` stanza at all, so the box the handover was
  # written for took the softer branch - the one box where a missing pair
  # means nobody can reach it was told so as a nicety.
  #
  # FIRST: configured routing turns this from something worth knowing into a
  # box that cannot do what it has been told to do. `router bgp`, `router
  # ospf` and `router isis` are all top level in FRR's running configuration.
  routing_configured=no
  if vtysh -c "show running-config" 2>/dev/null | grep -q "^router "; then
    routing_configured=yes
  fi
  # SECOND: did this box give away the card it is reached on. The way back
  # prisma-routing-tune computed off that card on THIS boot, before the bind, is
  # the holder of that answer and the only one there is (#378, #385): after
  # the bind Linux no longer has the netdev and the dataplane never had the
  # address, so nothing running now can be asked. It lives in /run, so it
  # cannot outlive the boot that computed it, and it is there exactly when
  # this boot gave the card away. Nothing here parses it; the VTY does.
  handed_over=$(cat "$ROOT/run/prisma-routing/dataplane-management" 2>/dev/null \
                | tail -1)
  if [ -z "$unpaired" ] && [ "$npaired" -eq 0 ]; then
    # Nothing but local0. The DPDK block above already said why, in the
    # operator's terms, so this does not say it a second time as a warning.
    say "  [info] the dataplane has no interface that could be paired yet"
  # A box with NEITHER answer stays a warning, which is the point of asking
  # two questions instead of failing every unpaired interface. A box that
  # forwards CGNAT, runs no protocol and was never handed its own card is a
  # supported configuration of this product, and a check that goes red on it
  # is one people learn to run around.
  #
  # The count and not the names: the record holds the card's LINUX name, which
  # is the one thing the handover destroys, so there is no honest way to say
  # which of several dataplane interfaces was meant to carry it back. On the
  # single-card box this is about, one pair anywhere is the pair.
  elif [ "$npaired" -eq 0 ] && \
       { [ -n "$handed_over" ] || [ "$routing_configured" = yes ]; }; then
    # The headline is the WORSE of the two reasons. Adjacencies that will not
    # form are a box somebody can still log in to and fix; a box whose only
    # card went to the dataplane with no pair behind it is a box reachable at
    # a console somebody has to walk to.
    if [ -n "$handed_over" ]; then
      bad "this box handed its only card over and NO pair carries the address"
      say_list "        " "The card this box is reached on was given to the" \
        "dataplane, and the linux_cp pair is where the address the box" \
        "answers on goes back. Without one it comes up forwarding and" \
        "unreachable from anywhere but its console."
      # The record itself, because the operator at that console has to put the
      # address back by hand and it is the only place the old one is written.
      say_list "        " "the way back it computed on this boot: $handed_over"
    else
      bad "routing is configured and NO interface is paired into the kernel"
    fi
    # Said whichever headline was chosen. A box that did both is a box whose
    # adjacencies are down as well, and the operator is owed both facts.
    if [ "$routing_configured" = yes ]; then
      say "        FRR has no interface for the port that carries traffic, so"
      say "        BGP, OSPF and IS-IS will never form an adjacency."
    fi
    say "        without a pair:$unpaired"
    say "        give each one a 'linux-name <name>' under 'interface' in"
    say "        prismash, and commit. A card named after its Linux card is"
    say "        paired under that name by any 'interface' block for it."
  elif [ -n "$unpaired" ]; then
    warn "no linux_cp pair on:$unpaired"
    say "         FRR and 'ip' cannot see these, so no routing protocol can"
    say "         run on them. Set 'linux-name <name>' under 'interface' in"
    say "         prismash, and commit. A card named after its Linux card is"
    say "         paired under that name by any 'interface' block for it."
  else
    ok "$npaired dataplane interface(s) paired into the kernel, so FRR sees them"
  fi
fi

# --- the statistics segment, the one resource with an abort behind it ---
#
# VPP exports every counter through a shared segment of FIXED size, and each
# dataplane interface adds seventeen directory entries to it plus one counter
# slot per thread. The segment never grows. Filling it is not a refusal:
# vnet_register_interface reaches os_panic and the process takes SIGABRT, so
# the whole dataplane goes, not the interface that was one too many.
#
# Measured on a box this product's own tuner built: the segment was VPP's
# built-in 32 MB and creating subscriber interfaces aborted it between 7,000
# and 8,000, twice, at the same step.
#
# prisma-routing-tune sizes the segment from the interfaces the box is CONFIGURED
# for, at 4793 bytes each - 32 MB divided by the 7,000 that default was
# measured holding - and writes nothing when they fit in what VPP gives away.
# What no configuration file holds is an interface created while the box runs:
# a PPPoE session, a pair made from the VTY.
#
# This line is what covers that gap. It reads the segment the dataplane
# ACTUALLY has, so an operator can see the wall approaching instead of meeting
# it as a SIGABRT with no sentence in front of it.
#
# Read and never written (#184): what is reported is what the dataplane says
# its own heap holds, not what a configuration file asked for.
if vppctl show version >/dev/null 2>&1; then
  # A named counter plus `verbose` prints that one entry and then the heap,
  # instead of the whole directory - which on the box this matters for is
  # forty thousand lines. /sys/vector_rate is registered when the segment is
  # created, so it is on every box.
  seg=$(vppctl show statistics segment /sys/vector_rate verbose 2>/dev/null \
        | grep -m1 'total:.*used:')
  if [ -z "$seg" ]; then
    warn "the dataplane did not report its statistics segment, so how"
    say "         close this box is to aborting on it is unknown - which is"
    say "         not the same as being far from it"
  else
    # VPP prints "total: 31.99M, used: 4.20M, free: ..., trimmable: ...",
    # with K/M/G and two decimals, and bytes below 1 K. awk because sh has no
    # floating point, and the percentage is the whole judgement.
    segpct=$(printf '%s\n' "$seg" | awk -F'[:,]' '
      function bytes(v,  n, u) {
        gsub(/ /, "", v); u = substr(v, length(v)); n = v + 0
        if (u == "G") return n * 1073741824
        if (u == "M") return n * 1048576
        if (u == "K") return n * 1024
        return n
      }
      { t = bytes($2); u = bytes($4); if (t > 0) printf "%d", u * 100 / t }')
    segtot=$(printf '%s\n' "$seg" | sed -n 's/.*total: *\([^,]*\),.*/\1/p')
    segused=$(printf '%s\n' "$seg" | sed -n 's/.*used: *\([^,]*\),.*/\1/p')
    # Same listing, same exclusions as the pair check above, except that
    # local0 and the tap ends are COUNTED here: every interface VPP holds has
    # its entries in the segment, whoever created it.
    segif=$(vppctl show interface 2>/dev/null \
            | awk '/^[^ \t]/ && $1 != "Name"' | wc -l | tr -d ' ')
    [ -n "$segpct" ] || segpct=0
    if [ "$segpct" -ge 75 ]; then
      bad "statistics segment ${segpct}% used: $segused of $segtot, with"
      say "        $segif interface(s). VPP ABORTS when this fills - os_panic,"
      say "        SIGABRT, the whole dataplane - and it neither refuses the"
      say "        interface first nor says why afterwards. The last part of"
      say "        the segment cannot be spent either: the counter directory"
      say "        is one block that is COPIED to grow, so a growth needs the"
      say "        old and the new at the same time."
      say "        Put 'statseg { size 256M }' in"
      say "        /etc/prisma-routing/vpp-base.conf and restart vpp.service."
    elif [ "$segpct" -ge 50 ]; then
      warn "statistics segment ${segpct}% used: $segused of $segtot,"
      say "         with $segif interface(s). The dataplane ABORTS when this"
      say "         fills, it does not refuse the next interface. Raise it"
      say "         with a 'statseg { size 256M }' stanza in"
      say "         /etc/prisma-routing/vpp-base.conf, then restart vpp.service."
    else
      # Where the size came from, which is the sentence nobody was ever told.
      # THREE ANSWERS AND NOT TWO, because the tuner now sizes the segment
      # from the interfaces the box is configured for (#288): a stanza in the
      # base file is the operator's own and is never overridden, a stanza that
      # reached startup.conf without being in the base was written by the
      # tuner, and neither means VPP's own default. Reading only startup.conf
      # would tell a box the tuner sized that its operator had sized it.
      #
      # A STANZA, not the word. The base file ships a comment block explaining
      # where statseg goes and that comment is copied into startup.conf, so a
      # plain grep would report every shipped box as one somebody had sized.
      if grep -qE '^[[:space:]]*statseg' "$VPPBASE" 2>/dev/null; then
        segsrc="set in /etc/prisma-routing/vpp-base.conf"
      elif grep -qE '^[[:space:]]*statseg' "$STARTUP" 2>/dev/null; then
        segsrc="chosen by prisma-routing-tune from this box's configuration"
      else
        segsrc="VPP's own default, which this product does not set"
      fi
      ok "statistics segment: $segused of $segtot used, $segif interface(s)"
      say "        size: $segsrc"
    fi
  fi
fi

# --- where the connection records live ---
#
# In dynamic mode the allocation log IS the record the Marco Civil requires to
# be kept for a year. It has its own filesystem so that a full log cannot stop
# the box working (#83) - and fstab mounts it "nofail", because a box that
# will not boot because that volume is missing is a box nobody can log into to
# find out why.
#
# Which means something has to say so, or the box comes up quietly writing
# records onto the root filesystem, which is the arrangement this replaced.
if [ -d "$ROOT/var/log/prisma-routing" ]; then
  rec_src=$(findmnt -no SOURCE --target "$ROOT/var/log/prisma-routing" 2>/dev/null)
  root_src=$(findmnt -no SOURCE --target / 2>/dev/null)
  if [ -n "$rec_src" ] && [ "$rec_src" != "$root_src" ]; then
    ok "records on their own filesystem: $rec_src, $(df -h "$ROOT/var/log/prisma-routing" 2>/dev/null | awk 'NR==2{print $4" free of "$2}')"
  elif [ -f "$ROOT/run/live/medium/live/filesystem.squashfs" ]; then
    say "  [info] live medium: records are not persisted anyway"
  else
    warn "connection records are on the ROOT filesystem"
    say "         a log that fills will stop this box writing its own"
    say "         configuration. Check that /var/log/prisma-routing is mounted."
  fi

  # --- and are they still on TWO disks? (#83) ---
  #
  # A mirror nobody is told about is a mirror that silently becomes one disk,
  # and then zero. Nothing else on this box notices a disk dying under a
  # mirror: the volume stays mounted, the records keep being written, the box
  # forwards - and the SECOND failure is the one that loses the year the Marco
  # Civil requires. Downtime is recoverable by rebooting; this is not
  # recoverable at all, which is why it is a failed check and not a warning.
  #
  # A box with one disk is told NOTHING here. It has no array, so there is no
  # question to answer, and inventing one would put a line about hardware
  # nobody bought on every console in the field.
  case "${rec_src:-}" in
    /dev/md*)
      _md=${rec_src#/dev/}
      # The array's OWN block line - the one carrying [n/m]. /proc/mdstat
      # lists every array on the box, so a grep for "[2/2]" anywhere in it can
      # be answered by a different array entirely.
      _mdline=$(awk -v d="$_md" '$1 == d { f = 1 }
                                 f && /\[[0-9]+\/[0-9]+\]/ { print; exit }' \
                "$ROOT/proc/mdstat" 2>/dev/null)
      _legs=$(printf '%s' "$_mdline" | grep -o '\[[0-9]*/[0-9]*\]' | head -1 | tr -d '[]')
      # The members, taken as the fields that carry a slot number, because the
      # header is not fixed-width: an array that came up read-only reads
      # "active (auto-read-only) raid1", and counting from field 5 then names
      # the personality as a disk.
      _members=$(awk -v d="$_md" '$1 == d {
                     for (i = 3; i <= NF; i++) if ($i ~ /\[[0-9]+\]/) printf "%s ", $i
                     exit }' "$ROOT/proc/mdstat" 2>/dev/null \
                 | sed 's/\[[0-9]*\]//g; s/  *$//')
      # A rebuild in progress, from the array's own block: the lines under it
      # up to the blank line that separates arrays. It is the difference
      # between a disk that has been replaced and one that has not, and
      # reporting a rebuild as a failure trains whoever reads this console to
      # ignore the line that matters.
      _rebuild=$(awk -v d="$_md" '$1 == d { f = 1; next }
                                  f && (/^$/ || /^md/) { exit }
                                  f && /(recovery|resync|reshape) *=/ {
                                      sub(/.*(recovery|resync|reshape) *= */, "", $0)
                                      print $1; exit }' \
                 "$ROOT/proc/mdstat" 2>/dev/null)
      if [ -z "$_legs" ]; then
        bad "the records are mounted from $rec_src and the kernel has no such array"
        say "        /proc/mdstat does not describe it, so nothing here can say"
        say "        how many disks the records are on."
      else
        _want=${_legs%/*}
        _have=${_legs#*/}
        if [ "$_have" = "$_want" ] && [ -n "$_rebuild" ]; then
          ok "records mirrored on $_have disks ($_members), synchronising $_rebuild"
        elif [ "$_have" = "$_want" ]; then
          ok "records mirrored on $_have disks ($_members)"
        elif [ -n "$_rebuild" ]; then
          warn "the records mirror is REBUILDING: $_have of $_want disks, $_rebuild"
          say "         a replaced disk is being copied onto. Until it finishes"
          say "         the records are on one disk. Members: $_members"
        else
          bad "the records mirror is DEGRADED: $_have of $_want disks ($_members)"
          say "        a disk has died and the records are on one. In dynamic mode"
          say "        those records are what this box answers a court order with,"
          say "        and the next failure loses them - a reinstall does not put"
          say "        them back. Replace the disk and add it with 'mdadm --add'."
        fi
      fi ;;
    *)
      # Installed WITH a mirror and running without one. The check above cannot
      # see this: the array never assembled, so the records are not on an md
      # device and, with fstab mounting them nofail, the box came up with the
      # volume missing altogether. The box's own record of its disks is the
      # only thing that knows a mirror was ever meant to be here.
      if grep -q 'name=[^ ]*:records' "$ROOT/etc/mdadm/mdadm.conf" 2>/dev/null; then
        bad "this box was installed with a records mirror and is not using it"
        say "        /etc/mdadm/mdadm.conf names a records array and"
        say "        /var/log/prisma-routing is not on it, so everything written"
        say "        since this boot is on one disk. Read /proc/mdstat: an array"
        say "        that is not there is started with 'mdadm --assemble --scan',"
        say "        and one that is there was not mounted."
      fi ;;
  esac
fi

# --- is the allocation log actually LEAVING the box? ---
#
# In dynamic mode the IPFIX export IS the connection record the Marco Civil
# requires to be kept for a year, and until #209 it could not run at all over
# UDP: VPP's own exporter needs a collector, nothing on an installed box set
# one, and no VTY statement reached it. The dataplane refused `bpa logging
# enable` and - before #76 - the VTY discarded the refusal and said "commit
# complete".
#
# Which is the shape this check exists for, and it is the OOM drop-in's shape
# exactly: a setting that was REFUSED looks, from the configuration, identical
# to one that is working. So the two are read from different places and
# compared - what the box was TOLD at boot, from the file prisma-routing.service
# hands to prismash, against what the dataplane HAS. Nothing here configures
# anything: a check that arranges the condition it is checking for cannot
# report its absence (#184).
# The same variable prismash reads, so this looks at the file the box was
# actually loaded from and not at a second guess about where it lives.
LOGCONF=${PRISMA_CONFIG:-/etc/prisma-routing/prisma-routing.conf}
if vppctl show version >/dev/null 2>&1; then
  log=$(vppctl show bpa logging 2>/dev/null)
  # The value the dataplane acts on, not the word "enabled" anywhere in the
  # output: the TCP block below carries "enabled" too.
  udp_on=no
  echo "$log" | grep -qE "^  state +enabled" && udp_on=yes
  udp_dst=$(echo "$log" | sed -n 's/^  exporter  *\(.*\)$/\1/p')
  case "$udp_dst" in none*|"") udp_dst="" ;; esac
  want_on=no; want_dst=no
  if [ -f "$LOGCONF" ]; then
    grep -q "^cgnat logging enable" "$LOGCONF" && want_on=yes
    grep -q "^cgnat logging udp " "$LOGCONF" && want_dst=yes
  fi

  if [ "$want_dst" = yes ] && [ -z "$udp_dst" ]; then
    bad "the saved configuration names an IPFIX collector and the dataplane"
    say "        has none: '$(grep -m1 "^cgnat logging udp " "$LOGCONF")' was"
    say "        refused when it was applied. 'journalctl -u prisma-routing' has"
    say "        the reason."
  elif [ "$want_on" = yes ] && [ "$udp_on" = no ]; then
    # The exact failure #209 is about, and the one that used to be invisible.
    bad "the saved configuration turns UDP export ON and the dataplane has it"
    say "        OFF: the allocation log is not being exported. In dynamic"
    say "        mode that log is the connection record, so this box cannot"
    say "        say who held a public port at a given moment."
    say "        'prismash -c \"show cgnat logging\"' says what it has."
  elif [ "$udp_on" = yes ] && [ -z "$udp_dst" ]; then
    # Measured: clearing the exporter leaves the export state enabled, so
    # "state enabled" on its own is not evidence that anything is sent.
    bad "UDP export is enabled and the IPFIX exporter has no collector:"
    say "        every record is produced and none leaves this box. Set one"
    say "        with 'nat cgnat logging udp <collector> src <source>'."
  elif [ "$udp_on" = yes ]; then
    ok "UDP export running"
    say "        $udp_dst"
  fi

  # TCP, which has a state UDP does not: a collector that is named, accepted,
  # and never reached. The records are on disk in the spill file rather than
  # lost, so this is a warning and not a failure - but nothing else on the box
  # would say so.
  #
  # The STATE WORD ON ITS OWN, matched whole. This was `case "$tcp_dst" in
  # *connected)` first and `*disconnected|*connecting)` second, and `*connected`
  # matches `disconnected` - so a box whose collector was unreachable printed
  # "[ ok ] TCP export 192.0.2.5:4739 connected" and the warning arm below it
  # was dead code (#300). Suffix globs over a field that ends in another
  # field's name cannot be ordered safely; whole words can, because no two of
  # bpa_show_logging_command_fn's three are each other's tail.
  #
  # The state is captured as any run of non-blanks rather than as [a-z]* for
  # the same reason the default arm exists: a word this does not recognise
  # must ARRIVE here to be reported, and a sed that only matches the three
  # known words would drop it before the case could say so.
  tcp_dst=$(echo "$log" | sed -n 's/^  collector  *\([0-9][^ ]*\)  *\([^ ][^ ]*\)$/\1 \2/p')
  tcp_addr=${tcp_dst% *}
  tcp_state=${tcp_dst##* }
  case "$tcp_state" in
    # No TCP transport at all: "TCP transport: disabled" prints no collector
    # line. Silent here on purpose - the dynamic-pool check below is the one
    # that decides whether having no transport matters on this box.
    "") ;;
    connected) ok "TCP export $tcp_addr connected" ;;
    disconnected)
      warn "the TCP collector $tcp_addr is disconnected:"
      say "         records are spilling to /var/log/prisma-routing and will be"
      say "         replayed when it comes back" ;;
    # Its own arm, and a warning, because "connecting" is NOT the harmless
    # half-second it reads as. bpa_tcp_disconnect() does not clear
    # pending_connect, so a handshake that times out leaves the state word at
    # "connecting" while it starts over every 5 s - which is exactly what a
    # collector whose SYN is dropped by a firewall looks like, for as long as
    # the firewall is there. Records spill in this state the same as in
    # disconnected. Said differently from it because the cause is different:
    # disconnected is a connect() that was answered and refused, connecting is
    # one that was not answered at all.
    connecting)
      warn "the TCP collector $tcp_addr is still connecting:"
      say "         records are spilling to /var/log/prisma-routing. This clears"
      say "         on its own if the box has just booted; if it is still"
      say "         here on the next look, nothing is reaching the collector"
      say "         and the handshake is being dropped rather than refused" ;;
    # A word the dataplane grew after this was written. Without this arm the
    # case would say nothing at all, which is how the bug above survived 105
    # boxes: an arm that never runs and an arm that does not exist read the
    # same from the console.
    #
    # The address and the word go on a folded continuation row rather than
    # into the headline: both are interpolated, the state word has no bound at
    # all, and a headline carrying them measured 80 columns on the widest
    # address this can print - on the 79-column console this file is read at.
    *)
      warn "the TCP collector reports a state this self-test does not know:"
      say_list "         " "$tcp_addr is '$tcp_state'. Read the spill counters" \
               "under 'prismash -c \"show cgnat logging\"': they say whether the" \
               "records are leaving the box." ;;
  esac

  # A dynamic pool and no transport at all. Not a failure - an operator may
  # run a collector elsewhere, or be mid-deployment - but it is the state in
  # which the box is translating traffic and keeping no record of it.
  if [ "$udp_on" = no ] && [ -z "$tcp_dst" ] \
     && vppctl show bpa config 2>/dev/null | grep -q "^ mode dynamic"; then
    warn "a pool runs in dynamic mode and NOTHING is being exported:"
    say "         block allocations are not being recorded anywhere. In"
    say "         dynamic mode that log is the connection record."
  fi
fi

# --- the unit that APPLIES the configuration ---
#
# The self-test measured the dataplane, the routing, the tuning and the VTY,
# and never the one unit whose job is to put the configuration INTO the
# dataplane. So a box whose configuration was never applied reported
# "Prisma Routing ready." to the one person - standing at the console - whose job
# it is to notice (#94).
#
# When it has failed, the reason goes on the screen with it. "Failed" without
# a reason sends whoever is standing there to a journal they may not be able
# to reach yet.
state=$(systemctl is-failed prisma-routing.service 2>/dev/null || true)
if [ "$state" = failed ]; then
  bad "prisma-routing.service FAILED: the CGNAT configuration was not applied"
  say "        the last thing it said:"
  journalctl -u prisma-routing.service -n 6 --no-pager -o cat 2>/dev/null \
    | sed 's/^/          /' > "$OUT" 2>/dev/null
fi

# --- the configuration that is applied ---
pools=$(vppctl show bpa pool 2>/dev/null | grep -c "^pool ")
[ -n "$pools" ] || pools=0
if [ "$pools" -gt 0 ] && [ -n "$noforward" ]; then
  # NOT a green tick, and not a second warning either (#299).
  #
  # Measured on a real appliance whose dataplane held only local0: the pool
  # committed cleanly and this line read "[ ok ] 1 CGNAT pool(s) configured",
  # six lines below the warning saying the box had been given no NIC. A reader
  # scanning for green takes a tick as an answer, and the answer here is that
  # the pool exists and cannot be reached.
  #
  # [info] rather than [warn] because the box is already warned about the
  # cause, three checks up, and the summary line names it. A second warning
  # for one fact inflates a count an operator is meant to act on, which is how
  # a count stops meaning anything. What this line owes the reader is the
  # CONSEQUENCE, which the no-NIC warning does not state: the pools they
  # configured are not doing anything.
  say "  [info] $pools CGNAT pool(s) configured, and $noforward:"
  say "         no packet can reach them yet"
elif [ "$pools" -gt 0 ]; then
  ok "$pools CGNAT pool(s) configured"
else
  say "  [info] no CGNAT pool configured yet (use 'prismash')"
fi

# And the pools the box was TOLD about, against the pools it HAS.
#
# The same comparison the IPFIX block above makes, for the object this product
# exists for. prisma-routing.service hands the saved file to prismash at boot; a
# pool the dataplane refuses is applied by nobody and reported by nothing -
# the service succeeds because the rest of the file applied, and the line
# above counts what is there rather than what is missing. Every subscriber
# behind that pool is untranslated, on a box that boots, forwards other
# people's traffic and answers every command.
#
# Names only. The line above already counts, and comparing settings would mean
# re-deriving the dataplane's own normalisation here, which is the mistake
# #184 names: a check that recomputes what it is checking agrees with its own
# arithmetic rather than with the box.
if vppctl show version >/dev/null 2>&1 && [ -f "$LOGCONF" ]; then
  want_pools=$(sed -n 's/^nat cgnat pool  *\([^ ]*\).*/\1/p' "$LOGCONF" \
               | sort -u)
  have_pools=$(vppctl show bpa pool 2>/dev/null \
               | sed -n 's/^pool  *\([^ []*[^ []\).*/\1/p' | sort -u)
  missing_pools=""
  for _p in $want_pools; do
    case " $(echo $have_pools) " in *" $_p "*) ;; *) missing_pools="$missing_pools $_p" ;; esac
  done
  if [ -n "$missing_pools" ]; then
    bad "the saved configuration has pool(s)$missing_pools and the dataplane"
    say "        does not: they were refused when they were applied, so every"
    say "        subscriber behind them is untranslated. 'journalctl -u"
    say "        prisma-routing' has the reason the dataplane gave."
  elif [ -n "$want_pools" ]; then
    ok "and every pool the saved configuration names is on the dataplane"
  fi

  # And uRPF, for the same reason and with more at stake.
  #
  # uRPF is the check that stops a spoofed source being translated, and
  # therefore stops a packet nobody sent being attributed to a subscriber in
  # the retention log - a record indistinguishable from a true one
  # (docs/architecture.md). A box whose saved configuration turns it on and
  # whose dataplane does not have it forwards, translates, logs and answers
  # everything: there is no counter for a protection that is simply absent.
  #
  # Interface names only, and the mode is compared with them because "strict
  # where the file says loose" is a different box from "off where the file
  # says strict", and an operator reading this line has to be able to tell.
  want_urpf=$(sed -n 's/^ *urpf  *\([a-z]*\).*/\1/p' "$LOGCONF" | sort -u)
  if [ -n "$want_urpf" ] && [ "$want_urpf" != "off" ]; then
    have_urpf=$(vppctl show bpa urpf 2>/dev/null)
    case "$have_urpf" in
      *"no interface has uRPF enabled"*|"")
        bad "the saved configuration turns uRPF on and the dataplane has it on"
        say "        no interface. A spoofed source is translated and attributed"
        say "        to a subscriber who did not send it, and nothing counts it."
        say "        'journalctl -u prisma-routing' has the reason it was refused." ;;
      *)
        ok "uRPF is on in the dataplane, as the saved configuration asks"
           say "        $(printf '%s' "$have_urpf" | tr '\n' ';' | cut -c1-60)" ;;
    esac
  fi

  # And the MTU, which is the one whose mismatch this project has already paid
  # for twice.
  #
  # An interface whose saved mtu the dataplane did not take is not a box that
  # stops working: it forwards, and then an OSPF adjacency will not leave
  # Exchange because the two ends advertise different MTUs and neither logs
  # anything (docs/routing.md, Pitfall 1). That is the fault that costs an
  # afternoon rather than a minute, and until now the only thing that noticed
  # was a finding at commit time - which says nothing on a box that was
  # rebooted, or whose interface was renumbered underneath it.
  #
  # The dataplane's own column, not the TAP's: `show interface` prints
  # "<name> <idx> <state> <l3>/<ip4>/<ip6>/<mpls>", and the L3 MTU is the one
  # the saved `mtu` statement sets.
  ifaces=$(vppctl show interface 2>/dev/null)
  mtu_wrong=""
  while read -r _if _want; do
    [ -n "$_if" ] || continue
    _got=$(printf '%s' "$ifaces" \
           | awk -v n="$_if" '$1 == n { split($4, m, "/"); print m[1]; exit }')
    [ -n "$_got" ] || continue          # not on this box: the pair check says so
    [ "$_got" = "$_want" ] || mtu_wrong="$mtu_wrong $_if($_want/$_got)"
  done <<MTUS
$(awk '/^interface /{ifn=$2} /^ *mtu /{if (ifn != "") print ifn, $2}' "$LOGCONF")
MTUS
  # The addresses, which is the one that can leave the box unreachable.
  #
  # An address in the saved file that the dataplane did not take is not a
  # degraded box: it is a box that answers on one fewer address than the
  # operator believes, and if that was the management address nobody can reach
  # it to find out. Same read as everything above - what the file says against
  # what `show interface addr` reports - and the same silence otherwise.
  addrs=$(vppctl show interface addr 2>/dev/null)
  addr_missing=""
  while read -r _if _addr; do
    [ -n "$_if" ] || continue
    # The block for this interface, from its header to the next one. An L3
    # line outside it belongs to a different port, and matching the address
    # anywhere in the output would pass on a box that put it on the wrong one.
    _block=$(printf '%s' "$addrs" | awk -v n="$_if" '
      $0 ~ "^"n" \\(" {inb=1; next} /^[^ ]/ {inb=0} inb')
    printf '%s' "$_block" | grep -q "L3 $_addr" \
      || addr_missing="$addr_missing $_if:$_addr"
  done <<ADDRS
$(awk '/^interface /{ifn=$2} /^ *ipv[46] address /{if (ifn != "") print ifn, $3}' "$LOGCONF")
ADDRS
  if [ -n "$addr_missing" ]; then
    bad "the saved configuration has address(es) the dataplane does not:"
    say "       $addr_missing"
    say "        the box answers on one fewer address than whoever configured"
    say "        it believes, and if that was the management address nobody"
    say "        can reach it to find out. 'journalctl -u prisma-routing' has the"
    say "        reason it was refused."
  fi

  if [ -n "$mtu_wrong" ]; then
    bad "the saved MTU is not the MTU the dataplane has:"
    say "       $mtu_wrong"
    say "        (interface(saved/actual)). An OSPF adjacency stops at Exchange"
    say "        when the two ends disagree, and neither end logs anything."
    say "        'journalctl -u prisma-routing' has why it was refused."
  fi

  # --- and the virtual routers, which are what a pair IS ---
  #
  # THE FAILURE THIS CATCHES IS A BOX THAT IS IN A PAIR ON PAPER. The saved
  # file says `vrrp 1 address ...`, the dataplane took it or refused it, and
  # nothing else on this box would say which: `show running-config` reads the
  # dataplane and would simply not mention it, so an operator comparing the
  # file with the screen sees a statement they wrote and a screen that does
  # not argue. Meanwhile the peer is holding the service alone and there is no
  # standby at all - which is discovered the day the peer dies.
  #
  # It is the same comparison as the pools, the addresses and the MTU above,
  # against the one thing whose absence has no counter behind it.
  want_vrs=$(awk '/^interface /{ifn=$2}
                  /^ *vrrp [0-9]+ address /{if (ifn != "") print ifn"/"$2}' \
             "$LOGCONF" | sort -u)
  if [ -n "$want_vrs" ]; then
    # `show vrrp vr` heads each router with "[n] sw_if_index <i> VR ID <v>",
    # and the interface is an index there rather than a name - so the name is
    # taken from `show interface`, which is already read above.
    vrs=$(vppctl show vrrp vr 2>/dev/null)
    vr_missing=""
    for _w in $want_vrs; do
      # `##*/` and `%/*`, not `#*/`: a dataplane interface name has slashes
      # in it - TenGigabitEthernet0/0/0 - so the shortest-prefix form takes
      # "0/0/1" for the id and the check then looks for a router nobody ever
      # configured. It went green as a FAILED check, which is the worst way
      # for a bug like this to behave.
      _if=${_w%/*}; _vrid=${_w##*/}
      _idx=$(printf '%s' "$ifaces" | awk -v n="$_if" '$1 == n {print $2; exit}')
      if [ -z "$_idx" ]; then
        vr_missing="$vr_missing $_w"
        continue
      fi
      printf '%s' "$vrs" \
        | grep -q "sw_if_index $_idx VR ID $_vrid " \
        || vr_missing="$vr_missing $_w"
    done
    if [ -n "$vr_missing" ]; then
      bad "the saved configuration has virtual router(s) the dataplane does"
      say "        not:$vr_missing (interface/id). This box is in a pair on"
      say "        paper and stands for nothing: the peer holds the service"
      say "        address alone, and there is no standby to find that out"
      say "        until the peer dies. 'journalctl -u prisma-routing' has the"
      say "        reason it was refused."
    else
      # THE ROLE, and not just the count. Which box is holding the service
      # address is the first thing anybody asks about a pair, and the boot
      # console is where they are already looking.
      _master=$(printf '%s' "$vrs" | grep -c "state Master")
      _backup=$(printf '%s' "$vrs" | grep -c "state Backup")
      ok "every virtual router the saved configuration names is on the"
      say "         dataplane: $_master holding an address, $_backup standing by"
    fi
  fi
fi

# --- the network this box is managed on (#303) ---
#
# THE ONE CHECK THAT ANSWERS "can anybody reach this box tomorrow". Measured on
# a 0.72.0 appliance: /etc/network/interfaces.d empty, networking.service
# enabled with nothing to do, the card DOWN with no address, and nothing on
# the console saying any of it. The operator brought the card up by hand at
# the console, and the next reboot undid that, three times, before it was
# filed.
#
# The installer writes the answer to ONE file and this reads that same file
# back. It is deliberately not a second opinion: what the box was asked to be
# is in the file, what the box IS comes from the kernel, and every line below
# is one of those two compared against the other. A check that decided for
# itself what the management network ought to be would be a third answer for
# the next person to reconcile.
#
# The live medium is skipped whole. It has no persisted configuration by
# definition, it is reached at the console it is being installed from, and a
# [FAIL] there would fail a healthy medium on every boot - the same argument
# the ssh host keys below are skipped on a live image for.
# MGMTCONF, mgmt_if and mgmt_how are read once, at the top of this file,
# because the dataplane block above needs the same answer (#378).
if [ -d "$ROOT/run/live/medium" ] || [ -f "$ROOT/run/live/overlay" ]; then
  :
elif [ ! -f "$MGMTCONF" ]; then
  bad "no management network: nothing was ever written for one"
  say_list "        " "This box has no /etc/network/interfaces.d/prisma-routing," \
    "so nothing configures a card at boot. It comes back from every reboot" \
    "with its card down and no address, reachable at this console and" \
    "nowhere else - and what is typed at a console does not survive the" \
    "next reboot. Media up to 0.72.0 never asked."
  # No backslash and no escape in the lines below, deliberately: say() is
  # echo, /bin/sh here is dash, and dash's echo expands a backslash escape in
  # what it is handed. A "\\n" written into an instruction somebody is meant to
  # TYPE would reach the console as a line break, and the operator would copy a
  # command that is missing half of itself.
  say "        to fix it here, and have it survive a reboot:"
  say "          F=/etc/network/interfaces.d/prisma-routing"
  say "          echo \"auto eth0\" > \$F"
  say "          echo \"iface eth0 inet dhcp\" >> \$F"
  say "          ifup eth0"
  # The box's own card names, because the operator reading this is at a
  # console with no network and eth0 is almost certainly not what this machine
  # calls its card. Without them the instruction above needs a command they
  # have to know to run before they can run the instruction.
  _have=$(ls "$ROOT/sys/class/net" 2>/dev/null | grep -v '^lo$' | tr '\n' ' ')
  say_list "        " "in place of eth0, use one of this box's own cards:" \
    "${_have:-<this box reports no network card at all>}"
  say_list "        " "and 'inet static' with 'address' and 'gateway' lines" \
    "where there is no DHCP server. Reinstalling asks the question."
else
  # What the file ASKS FOR. One "iface" line, written by the installer, and
  # read here with awk rather than grepped for a string: the words on that
  # line are interfaces(5)'s and not this product's, so they cannot be
  # reworded, and taking the interface name out of column two is what makes
  # this check about the box rather than about the message.
  if [ -z "$mgmt_if" ]; then
    # Installed with "none". A decision somebody made, said quietly: the file
    # exists, so this box is NOT one the installer forgot to ask.
    #
    # BUT THE ANSWER IS ABOUT INSTALL TIME AND THE SENTENCE WAS ABOUT NOW.
    # "this box is reached at its console" was drawn from that answer without
    # asking the box, and it was printed on a box being read over ssh at that
    # moment, on a card added after the install (#387).
    #
    # Since #378 that is worse than a wrong sentence. A card nothing reserves
    # is claimed by the dataplane at the next boot, and on a box installed
    # this way the reserve can NEVER exist: `none` writes no `iface` line for
    # reserved_for_linux() to read. So the box takes the card it is reached
    # on, and the one screen that could have said so said the subject does
    # not apply.
    #
    # PCI-BACKED NETDEVS ONLY, which is the guard that stops this crying
    # wolf. On a one-card box that already handed its card over, the address
    # lives on the linux_cp pair - and a pair has no `device` link, because it
    # is not a card. The dataplane cannot claim what it already holds. That is
    # the same reading the tuner makes in pci_nics().
    _onnet=""
    for _n in "$ROOT"/sys/class/net/*; do
      _ni=$(basename "$_n")
      [ "$_ni" = lo ] && continue
      [ -e "$_n/device" ] || continue
      [ -n "$(ip -o -4 addr show dev "$_ni" 2>/dev/null)" ] || continue
      _onnet="$_onnet $_ni"
    done
    if [ -n "$_onnet" ]; then
      warn "no management network was asked for, and this box is on one anyway"
      say_list "        " "Linux holds:$_onnet, with an address. The install" \
        "answered 'none', so nothing is reserved for Linux - and a card" \
        "nothing reserves is one the" \
        "dataplane claims at the next boot. The address moves onto the pair" \
        "it keeps for that card, so the box is not lost, but it is reached" \
        "THROUGH the dataplane from then on rather than beside it."
      say "        to keep a card for Linux, and have its address survive a"
      say "        reboot, write the stanza the install would have written:"
      say "          F=/etc/network/interfaces.d/prisma-routing"
      for _ni in $_onnet; do
        say "          echo \"auto $_ni\" >> \$F"
        say "          echo \"iface $_ni inet dhcp\" >> \$F"
      done
      say "        a static address takes 'inet static' and an 'address' line."
    else
      say "  [info] no management network was asked for at install time; this"
      say "         box is reached at its console"
    fi
  elif [ ! -e "$ROOT/sys/class/net/$mgmt_if" ]; then
    bad "management network: this box has no card called $mgmt_if"
    say_list "        " "It was named at install time and is not here now: a" \
      "card that was moved, replaced, or renamed. Nothing is configuring" \
      "any interface, so this box is reachable at its console only."
    _have=$(ls "$ROOT/sys/class/net" 2>/dev/null | grep -v '^lo$' | tr '\n' ' ')
    say_list "        " "cards this box has:${_have:+ $_have}"
  else
    mgmt_addrs=$(ip -o -4 addr show dev "$mgmt_if" 2>/dev/null | awk '{printf "%s ", $4}')
    mgmt_def=$(ip -o -4 route list default 2>/dev/null | head -1)
    mgmt_gw_asked=$(awk '$1 == "gateway" { print $2; exit }' "$MGMTCONF" 2>/dev/null)
    if [ -z "$mgmt_addrs" ]; then
      bad "management network: $mgmt_if has no address"
      if [ "$mgmt_how" = dhcp ]; then
        say_list "        " "It is configured by DHCP and has none, so either" \
          "no server answered or the cable is not in. This box is reachable" \
          "at its console only until it does."
      else
        say_list "        " "It is configured statically and has none, so" \
          "bringing it up failed. 'ifup $mgmt_if' says why. This box is" \
          "reachable at its console only until it does."
      fi
    elif [ -z "$mgmt_def" ] && [ -n "$mgmt_gw_asked" ]; then
      # The signature of the answer that was wrong rather than missing. ifup
      # refuses a gateway that is not on the interface's own subnet - "Error:
      # Nexthop has invalid gateway" - and carries on, so the box comes up
      # with an address, without a default route, and reachable from its own
      # subnet only. From a floor away that is indistinguishable from a box
      # that did not boot.
      bad "management network: $mgmt_if has an address and no default route"
      say_list "         " "$mgmt_addrs"
      say_list "        " "The gateway this box was installed with is" \
        "$mgmt_gw_asked, and it did not take: a gateway outside the" \
        "interface's own subnet is refused when the interface comes up. So" \
        "only this box's own subnet can reach it. Check that the address and" \
        "the gateway are on the same subnet."
    elif [ -z "$mgmt_def" ]; then
      warn "$mgmt_if is up with no default route: its own subnet reaches it"
      say_list "         " "$mgmt_addrs"
      if [ "$mgmt_how" = dhcp ]; then
        say_list "         " "DHCP answered with an address and no router." \
          "Anything on another subnet cannot reach this box."
      else
        say_list "         " "No gateway was given at install time. Anything" \
          "on another subnet cannot reach this box."
      fi
    else
      ok "managed on $mgmt_if ($mgmt_how)"
      # The address is PRINTED, on every boot, and that is half of why the
      # DHCP answer can be the default at all: a racked box whose address
      # nobody chose still tells whoever is at the console where to ssh to.
      say_list "         " "$mgmt_addrs"
      say_list "         " "$mgmt_def"
    fi
  fi
fi

# --- were these ssh host keys made on this box, or handed to it? ---
#
# THE RULE AND THE REPAIR ARE NOT IN THIS FILE. appliance/ssh-host-key-origin
# holds both, because the VTY banner has to reach the same answer for an
# operator who logged in over ssh - and that operator is the one the answer is
# about (#248). Its header carries the argument whole: why the timestamp and
# not the key's comment, why no list of published fingerprints, and why the
# report this file writes was reaching nobody who was not at the console at
# boot.
#
# What is decided HERE is how that answer is rendered on a boot console, which
# is this file's own job and no other reader's.
ORIGIN=$(dirname "$0")/ssh-host-key-origin
origin=$("$ORIGIN" "$ROOT" 2>/dev/null || true)
handed_keys=$(printf '%s\n' "$origin" | sed -n 's/^handed *//p')
unread_keys=$(printf '%s\n' "$origin" | sed -n 's/^unreadable *//p')
own_keys=$(printf '%s\n' "$origin" | sed -n 's/^own //p')

# The live image carries no host keys at all and masks sshd, which is #245's
# half and is correct rather than a fault. Saying "no host keys" there would
# fail a healthy medium on every boot.
if [ -d "$ROOT/run/live/medium" ] || [ -f "$ROOT/run/live/overlay" ]; then
  :
elif [ -z "$own_keys" ]; then
  # The holder answered nothing, so this box knows nothing about its own keys.
  # Not silence, and not a warning: a check that could not run reads exactly
  # like a check that agreed, and what this one is about is whether an ssh
  # session to this box can be impersonated.
  bad "cannot tell where the ssh host keys were made"
  say_list "        " "The program that answers it did not run, so nothing on" \
    "this box knows whether its ssh host keys were generated here or came" \
    "in with the system image - and a box installed from a medium that" \
    "carried keys answers with a key whose private half is in the published" \
    "download."
  say_list "          " "$ORIGIN"
elif [ -n "$handed_keys" ]; then
  bad "the ssh host keys were not generated on this box"
  say_list "        " "They are older than the filesystem they sit on, so they" \
    "came in with the system image. Every box installed from that medium" \
    "answers with this same key and the private half of it is in the" \
    "published download: an ssh session to this box can be impersonated," \
    "and the client will not object, because the fingerprint it pinned is" \
    "the fingerprint it was handed."
  say_list "          " "$handed_keys"
  say "        regenerate them, at the console:"
  # Printed from the holder rather than spelled here. A command an operator
  # copies off a console has to be the command the VTY banner gave them and
  # the command the repair was measured with, and three files that each write
  # it out are three files that can disagree about it.
  printf '%s\n' "$origin" | sed -n 's/^fix /          /p' | \
  while IFS= read -r _r; do
    say "$_r"
  done
  say_list "        " "Every client that pinned the old fingerprint will then" \
    "refuse to connect and report that the host key changed. That is this" \
    "being fixed, not an attack, and it is the cost of fixing it."
elif [ "$own_keys" = 0 ] && [ -z "$unread_keys" ]; then
  # Not a pass. An installed box with no host key is a box whose sshd will not
  # start, and sshd is how a racked appliance is reached.
  bad "no ssh host keys in /etc/ssh: sshd cannot start"
  say_list "        " "Until a set exists this box is reachable only at the" \
    "console. There:"
  printf '%s\n' "$origin" | sed -n 's/^generate /          /p' | \
  while IFS= read -r _r; do
    say "$_r"
  done
elif [ -n "$unread_keys" ]; then
  # Also not a pass: a check that cannot see is not a check that agrees.
  warn "cannot tell where these ssh host keys were made:"
  say_list "          " "$unread_keys"
  say_list "         " "their birth time is not recorded, so there is nothing" \
    "to compare their contents against."
else
  ok "the ssh host keys were generated on this box, not handed to it"
fi

# A live system says so, and says how to stop being one. Without this the
# operator boots a working appliance, finds no install option, and concludes
# the product is broken rather than running from a live image.
if [ -d /run/live/medium ] || [ -f /run/live/overlay ]; then
  say "  [info] live system: nothing is persisted across a reboot."
  if [ -x /usr/sbin/prisma-routing-install ]; then
    say "         to install: prisma-routing-install /dev/sdX"
  fi
fi

say "-------------------------------------------------------------"
#
# The last line is what survives. A console scrolls, a serial session is read
# from the bottom, and somebody racking a box reads the verdict rather than the
# forty lines above it. Until #297 this said "Prisma Routing ready." whenever
# nothing had FAILED, so a box with five warnings and a box with none ended
# identically - measured on a real appliance that had no interface to forward
# on and said it was ready.
#
# Three outcomes and not two, because "installed, healthy, and not yet able to
# do its job" is a different thing from both of the others and is the ordinary
# state of a box somebody has just racked. It is not a failure: nothing is
# broken and nothing needs fixing, there is a step left. Saying "ready" of it
# is the part that misleads, and this file's own comment two hundred lines up
# says why - "a box that forwards nothing looks like a box that is working".
#
# The warning count rather than the warnings again. Repeating them here would
# double the length of the thing somebody reads on a scrolling console, and
# the count plus "above" is what sends a reader back up.
if [ "$fail" != 0 ]; then
  say "  $fail check(s) failed. The box is NOT ready."
elif [ -n "$noforward" ]; then
  say "  Prisma Routing is installed and healthy, and has $noforward:"
  say "  it is not forwarding. See the [warn] above for the one step left."
elif [ "$warns" != 0 ]; then
  say "  Prisma Routing ready, with $warns warning(s) above."
else
  say "  Prisma Routing ready."
fi
say "============================================================="
say ""
# The diagnostic MUST NOT bring down the boot (docs/appliance.md). It reports a
# verdict about the box; it does not answer for it. The one moment this script
# must not add a failure of its own is the moment it has just found one, since
# the box that fails a check is the box whose console somebody needs.
#
# This is half of the rule. The other half is that systemd is told not to care:
# prisma-routing-selftest.service carries "ExecStart=-", so a status this line
# stopped producing, or a signal that kills the script before it gets here,
# still cannot fail the unit.
exit 0
