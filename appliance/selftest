#!/bin/sh
# HexaRouting boot self-test, written to the console.
#
# A racked appliance is seen through a serial console or IPMI, not through
# journalctl. If something essential did not come up, it has to be on the
# screen - with the reason next to it, not just "failed". The lack of that is
# what made every ISO diagnosis cost a full rebuild.
set -u
OUT=${HEXA_SELFTEST_OUT:-/dev/console}
fail=0

say()  { echo "$*" > "$OUT" 2>/dev/null || echo "$*"; }
ok()   { say "  [ ok ] $*"; }
bad()  { say "  [FAIL] $*"; fail=$((fail+1)); }

say ""
say "================ HexaRouting: boot self-test ================"

# The first thing on the screen is the version. Whoever is at the console of a
# faulty box has to say what is running before anything else, and "unknown" is
# an answer too - worse is the line not being there at all.
ver=$(cat /usr/share/hexarouting/VERSION 2>/dev/null || echo "")
if [ -n "$ver" ]; then
  ok "HexaRouting $ver"
else
  bad "no version stamp in /usr/share/hexarouting/VERSION"
fi

# --- memoria ---
# A live system keeps the whole overlay in RAM. Together with VPP, 2 GB is
# not enough: the OOM killer takes VPP and brings the rest down with it. Found
# by booting the ISO with 2 GB - "Out of memory: Killed process (vpp)".
memkb=$(awk '/MemTotal/{print $2}' /proc/meminfo)
memmb=$((memkb / 1024))
if [ "$memmb" -lt 2600 ]; then
  bad "only ${memmb} MB of RAM: VPP will be killed by the OOM killer"
  say "        minimum recommended: 4 GB (2 GB is not enough on a live system)"
elif [ "$memmb" -lt 3600 ]; then
  say "  [warn] ${memmb} MB of RAM: enough to boot, tight under load"
else
  ok "${memmb} MB of RAM"
fi

# --- instrucoes de CPU ---
# O binario do VPP e compilado assumindo SSE4.2 e usa AVX quando disponivel.
# On a CPU without them it dies with SIGILL in milliseconds, and since
# vpp.service has Restart=always the symptom becomes a restart loop that says
# nothing about the cause. That is how several hours went: the diagnosis only
# showed up in the journal's "code=killed, signal=ILL".
missing=""
for f in sse4_2; do
  grep -qw "$f" /proc/cpuinfo || missing="$missing $f"
done
if [ -n "$missing" ]; then
  bad "CPU lacks:$missing - VPP requires it and will die with SIGILL"
  say "        model: $(grep -m1 "model name" /proc/cpuinfo | cut -d: -f2-)"
elif grep -qw avx2 /proc/cpuinfo; then
  ok "CPU has sse4_2 and avx2"
else
  say "  [warn] CPU lacks avx2: VPP works but delivers less"
fi

# --- dataplane ---
if vppctl show version >/dev/null 2>&1; then
  ok "VPP responding: $(vppctl show version 2>/dev/null | cut -d' ' -f1-2)"
else
  bad "VPP not responding"
  say "        tail of /var/log/vpp/vpp.log:"
  tail -12 /var/log/vpp/vpp.log 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
  say "        systemctl status vpp:"
  systemctl status vpp.service --no-pager -n 8 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
fi

# --- servico instavel: sobe, cai, sobe de novo ---
# A service in a restart loop can be "active" at the instant you look, and
# "systemctl status" shows it active. Only the restart counter tells the
# story - and without it the diagnosis becomes guesswork.
restarts=$(systemctl show vpp.service -p NRestarts --value 2>/dev/null)
[ -n "$restarts" ] || restarts=0
if [ "$restarts" -gt 2 ] 2>/dev/null; then
  bad "vpp.service has restarted $restarts times: it is looping"
  say "        tail of /var/log/vpp/vpp.log:"
  tail -20 /var/log/vpp/vpp.log 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
  say "        vpp.service journal:"
  journalctl -u vpp.service --no-pager -n 20 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
elif [ "$restarts" -gt 0 ] 2>/dev/null; then
  say "  [warn] vpp.service restarted $restarts time(s)"
else
  ok "vpp.service stable (0 restarts)"
fi

# --- plugins ---
if vppctl show plugins 2>/dev/null | grep -q bpa_plugin; then
  ok "CGNAT plugin loaded"
else
  bad "CGNAT plugin missing"
fi

# --- tuning: silence here is what costs half the throughput ---
if [ -f /etc/vpp/startup.conf ] && grep -q "GENERATED by hexarouting-tune" /etc/vpp/startup.conf; then
  if grep -q "FIRST BOOT MODE" /etc/vpp/startup.conf; then
    say "  [warn] running in FIRST BOOT mode: no pinning and no hugepages."
    say "         reboot for isolcpus and hugepages to take effect."
  else
    ok "full tuning active: $(grep -o 'corelist-workers.*' /etc/vpp/startup.conf || echo 'no workers')"
    ok "rx queues: $(grep -o 'num-rx-queues.*' /etc/vpp/startup.conf | head -1 || echo 'default')"
  fi
else
  bad "/etc/vpp/startup.conf was not generated by hexarouting-tune"
fi

# --- latency: without this the box forwards and still loses under burst ---
if grep -q "processor.max_cstate=1" /proc/cmdline 2>/dev/null; then
  ok "deep C-states disabled on the kernel command line"
else
  say "  [warn] deep C-states still enabled: expect jitter on bursts."
  say "         reboot after tuning applies, or set HEXA_LOW_LATENCY=0."
fi

gov=$(cat /sys/devices/system/cpu/cpufreq/policy0/scaling_governor 2>/dev/null || echo "")
if [ -z "$gov" ]; then
  say "  [info] no cpufreq exposed (virtual machine): nothing to set"
elif [ "$gov" = performance ]; then
  ok "cpufreq governor: performance"
else
  say "  [warn] cpufreq governor is '$gov', not performance"
fi

# --- a VTY abre? ---
# 0.2.0 embarcou um hexash que morria no start por falta de config.py, e este
# autoteste passou verde: ele media o dataplane, o roteamento e o tuning, e
# nunca a porta de entrada. Um boot que nao exercita a VTY nao sabe se ela
# existe.
if ! command -v hexash >/dev/null 2>&1; then
  bad "hexash is not installed"
else
  out=$(hexash -c "show rollback" 2>&1)
  case "$out" in
    *Traceback*|*ModuleNotFoundError*|*"No module named"*)
      bad "hexash does not start: $(printf '%s' "$out" | tail -1)" ;;
    *) ok "VTY starts: $(printf '%s' "$out" | head -1)" ;;
  esac
fi

# --- plano de controle ---
if vtysh -c "show version" >/dev/null 2>&1; then
  ok "FRR responding"
else
  bad "FRR not responding"
fi

# --- configuracao aplicada ---
pools=$(vppctl show bpa pool 2>/dev/null | grep -c "^pool ")
[ -n "$pools" ] || pools=0
if [ "$pools" -gt 0 ]; then
  ok "$pools CGNAT pool(s) configured"
else
  say "  [info] no CGNAT pool configured yet (use 'hexash')"
fi

# A live system says so, and says how to stop being one. Without this the
# operator boots a working appliance, finds no install option, and concludes
# the product is broken rather than running from a live image.
if [ -d /run/live/medium ] || [ -f /run/live/overlay ]; then
  say "  [info] live system: nothing is persisted across a reboot."
  if [ -x /usr/sbin/hexarouting-install ]; then
    say "         to install: hexarouting-install /dev/sdX"
  fi
fi

say "-------------------------------------------------------------"
if [ "$fail" = 0 ]; then
  say "  HexaRouting ready."
else
  say "  $fail check(s) failed. The box is NOT ready."
fi
say "============================================================="
say ""
exit 0   # nunca derruba o boot por causa do proprio diagnostico
