#!/bin/sh
# HexaRouting boot self-test, written to the console.
#
# A racked appliance is seen through a serial console or IPMI, not through
# journalctl. If something essential did not come up, it has to be on the
# screen - with the reason next to it, not just "failed". The lack of that is
# what made every ISO diagnosis cost a full rebuild.
set -u
OUT=${HEXA_SELFTEST_OUT:-/dev/console}
fail=0

# HEXA_SELFTEST_ROOT is empty on every box and is set only by
# test/test_selftest.sh, because the states the core checks below have to be
# shown in - a worker pinned to a core the kernel is not isolating, a dataplane
# holding cores its own profile does not name - cannot be arranged on the
# machine running the tests without arranging the very thing being checked.
# hexarouting-tune takes a sysfs root for its synthetic topologies for the same
# reason. The reading with nothing set, on a box that really booted, is
# lab/install-iso.sh.
#
# It covers the kernel command line, the cpufreq governor and the records
# volume for the same reason (#222): a machine cannot be made to disagree with
# itself about isolcpus, about its own C-states or about where /var/log is
# mounted without rebooting it, and those three statements were the ones with
# nothing holding them.
ROOT=${HEXA_SELFTEST_ROOT:-}
STARTUP="$ROOT/etc/vpp/startup.conf"

say()  { echo "$*" > "$OUT" 2>/dev/null || echo "$*"; }
ok()   { say "  [ ok ] $*"; }
bad()  { say "  [FAIL] $*"; fail=$((fail+1)); }

# say, folded to the console, continuation rows aligned under the first.
#
# For a LIST of values rather than one value. A single token - a PCI address,
# an interface name - is printed whole and may run past the margin, because it
# is what the reader greps for or types back and splitting it destroys that.
# A list of cpu numbers is not one token: it can be folded between its items
# and nothing is lost. On a 32-core box the worker-pinning failure measured
# 153 columns on an 80-column console, and that is the message somebody reads
# at a serial console because the box is forwarding badly (#285).
#
# `fold -s` breaks at spaces only, so no number is ever cut in half.
say_list() {  # <indent> <text...>
  _ind=$1; shift
  printf '%s\n' "$*" | fold -s -w $((79 - ${#_ind})) | while IFS= read -r _r; do
    say "${_ind}${_r% }"
  done
}

say ""
say "================ HexaRouting: boot self-test ================"

# The first thing on the screen is the version. Whoever is at the console of a
# faulty box has to say what is running before anything else, and "unknown" is
# an answer too - worse is the line not being there at all.
ver=$(cat "$ROOT/usr/share/hexarouting/VERSION" 2>/dev/null || echo "")
if [ -n "$ver" ]; then
  ok "HexaRouting $ver"
else
  bad "no version stamp in /usr/share/hexarouting/VERSION"
fi

# --- memory ---
# A live system keeps the whole overlay in RAM. Together with VPP, 2 GB is
# not enough: the OOM killer takes VPP and brings the rest down with it. Found
# by booting the ISO with 2 GB - "Out of memory: Killed process (vpp)".
memkb=$(awk '/MemTotal/{print $2}' "$ROOT/proc/meminfo")
memmb=$((memkb / 1024))
if [ "$memmb" -lt 2600 ]; then
  bad "only ${memmb} MB of RAM: VPP will be killed by the OOM killer"
  say "        minimum recommended: 4 GB (2 GB is not enough on a live system)"
elif [ "$memmb" -lt 3600 ]; then
  say "  [warn] ${memmb} MB of RAM: enough to boot, tight under load"
else
  ok "${memmb} MB of RAM"
fi

# --- CPU instructions ---
# The VPP binary is compiled assuming SSE4.2 and uses AVX where available.
# On a CPU without them it dies with SIGILL in milliseconds, and since
# vpp.service has Restart=always the symptom becomes a restart loop that says
# nothing about the cause. That is how several hours went: the diagnosis only
# showed up in the journal's "code=killed, signal=ILL".
missing=""
for f in sse4_2; do
  grep -qw "$f" "$ROOT/proc/cpuinfo" || missing="$missing $f"
done
if [ -n "$missing" ]; then
  bad "CPU lacks:$missing - VPP requires it and will die with SIGILL"
  say "        model: $(grep -m1 "model name" "$ROOT/proc/cpuinfo" | cut -d: -f2-)"
elif grep -qw avx2 "$ROOT/proc/cpuinfo"; then
  ok "CPU has sse4_2 and avx2"
else
  say "  [warn] CPU lacks avx2: VPP works but delivers less"
fi

# --- dataplane ---
if vppctl show version >/dev/null 2>&1; then
  ok "VPP responding: $(vppctl show version 2>/dev/null | cut -d' ' -f1-2)"
else
  bad "VPP not responding"
  say "        tail of /var/log/vpp/vpp.log:"
  tail -12 /var/log/vpp/vpp.log 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
  say "        systemctl status vpp:"
  systemctl status vpp.service --no-pager -n 8 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
fi

# --- servico instavel: sobe, cai, sobe de novo ---
# A service in a restart loop can be "active" at the instant you look, and
# "systemctl status" shows it active. Only the restart counter tells the
# story - and without it the diagnosis becomes guesswork.
restarts=$(systemctl show vpp.service -p NRestarts --value 2>/dev/null)
[ -n "$restarts" ] || restarts=0
if [ "$restarts" -gt 2 ] 2>/dev/null; then
  bad "vpp.service has restarted $restarts times: it is looping"
  say "        tail of /var/log/vpp/vpp.log:"
  tail -20 /var/log/vpp/vpp.log 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
  say "        vpp.service journal:"
  journalctl -u vpp.service --no-pager -n 20 2>/dev/null | sed 's/^/          /' > "$OUT" 2>/dev/null
elif [ "$restarts" -gt 0 ] 2>/dev/null; then
  say "  [warn] vpp.service restarted $restarts time(s)"
else
  ok "vpp.service stable (0 restarts)"
fi

# --- is the dataplane out of the OOM killer's selection? ---
#
# docs/appliance.md records the event this guards against: the ISO booted with
# 2 GB and the console said "Out of memory: Killed process (vpp)" with VPP
# holding 19 MB resident. It was the chosen victim, not the glutton. The answer
# is a drop-in on vpp.service carrying OOMScoreAdjust, and until now nothing on
# an installed box ever looked at whether it took effect - a drop-in that was
# never installed, or that systemd parsed and refused, is indistinguishable
# from one that is working.
#
# What is read is /proc/<pid>/oom_score_adj, which is what the kernel will act
# on, and not the drop-in file, which is only what somebody asked for. Read and
# never written: a check that arranges the condition it is checking for cannot
# report its absence, which is #184 in one sentence.
#
# -1000 is the kernel's OOM_SCORE_ADJ_MIN, and it is the only value that takes
# the process out of the selection. Anything else merely reweights it, and a
# reweighted process is still a candidate - which is why a negative value that
# is not the minimum is reported rather than accepted.
vpid=$(systemctl show vpp.service -p MainPID --value 2>/dev/null)
[ -n "$vpid" ] || vpid=0
if [ "$vpid" = 0 ]; then
  # A VPP that is not running at all was already reported above. A VPP that IS
  # running while vpp.service owns no process is a different box: something
  # started the dataplane by hand, and no drop-in on that unit covers it.
  if vppctl show version >/dev/null 2>&1; then
    say "  [warn] VPP is running but vpp.service owns no process: the drop-in"
    say "         that takes the dataplane out of the OOM killer's selection"
    say "         does not apply to a VPP somebody started by hand"
  fi
elif adj=$(cat "/proc/$vpid/oom_score_adj" 2>/dev/null); then
  case "$adj" in
    -1000)
      ok "dataplane out of the OOM killer's selection (oom_score_adj $adj)" ;;
    -*)
      say "  [warn] vpp's oom_score_adj is $adj: lowered, not removed. The"
      say "         dataplane is still a candidate when something else on this"
      say "         box grows, which is how it was killed at 19 MB resident" ;;
    *)
      bad "vpp's oom_score_adj is $adj: the dataplane can be chosen as an"
      say "        OOM victim for somebody else's allocation. The drop-in"
      say "        /etc/systemd/system/vpp.service.d/hexarouting-oom-protect.conf"
      say "        is missing or did not take effect; check it, then"
      say "        'systemctl daemon-reload' and restart vpp.service" ;;
  esac
else
  bad "cannot read /proc/$vpid/oom_score_adj for vpp.service (pid $vpid)"
  say "        whether the dataplane is protected from the OOM killer is"
  say "        unknown on this box, which is not the same as protected"
fi

# --- plugins ---
if vppctl show plugins 2>/dev/null | grep -q bpa_plugin; then
  ok "CGNAT plugin loaded"
else
  bad "CGNAT plugin missing"
fi

# --- tuning: silence here is what costs half the throughput ---
if [ -f "$STARTUP" ] && grep -q "GENERATED by hexarouting-tune" "$STARTUP"; then
  if grep -q "FIRST BOOT MODE" "$STARTUP"; then
    say "  [warn] running in FIRST BOOT mode: no pinning and no hugepages."
    say "         reboot for isolcpus and hugepages to take effect."
  else
    ok "full tuning active: $(grep -o 'corelist-workers.*' "$STARTUP" || echo 'no workers')"
    # The || used to sit after "head -1", which succeeds on empty input: a
    # box with no num-rx-queues printed "[ ok ] rx queues:" and nothing after
    # it, which is the reporting version of an assertion that cannot fail.
    rxq=$(grep -o 'num-rx-queues.*' "$STARTUP" | head -1)
    ok "rx queues: ${rxq:-default (1 per interface, so one worker takes it all)}"
  fi
else
  bad "/etc/vpp/startup.conf was not generated by hexarouting-tune"
fi

# --- the dataplane's cores, and what is left over for the control plane ---
#
# The line above reports what /etc/vpp/startup.conf ASKS for. Nothing on an
# installed box has ever read what the dataplane GOT, and the two come apart
# quietly: hexarouting-tune.service can fail and leave a startup.conf written
# for hardware that has since changed, /etc/vpp/startup.conf is a configuration
# file an operator may edit, and a VPP that has been running since before either
# happened is pinned to whatever it read when it started. In each of those the
# box boots, forwards, answers every command, and delivers a fraction of its
# throughput - and the only outward sign is a poll-mode thread reading 100%
# busy, which it does whether or not it has a core to itself.
#
# Three places, none of them the one that made the decision:
#
#   TOLD   /etc/vpp/startup.conf             what the tuner asked for
#   HAS    /proc/<vpp pid>/task/*/status     where the kernel put those threads
#   HAS    /sys/devices/system/cpu/isolated  what the kernel is isolating
#
# Deliberately NOT "vppctl show threads", which also carries the lcore: that is
# VPP reporting on itself, and the question here is whether the kernel agrees
# with VPP. Nothing below writes anything (#184).
#
cpulist() {  # "1-3,8" -> " 1 2 3 8"; the kernel's own format, everywhere
  _out=""
  for _part in $(printf '%s' "${1:-}" | tr ',' ' '); do
    case "$_part" in
      *-*) _a=${_part%%-*}; _b=${_part##*-}
           case "$_a$_b" in *[!0-9]*) continue ;; esac
           while [ "$_a" -le "$_b" ]; do _out="$_out $_a"; _a=$((_a+1)); done ;;
      *[!0-9]*|"") ;;
      *)   _out="$_out $_part" ;;
    esac
  done
  printf '%s' "$_out"
}
norm() {  # sorted, unique, space-delimited with a leading and trailing space
  printf ' %s ' "$(printf '%s' "${1:-}" | tr ' ' '\n' | grep -v '^$' \
                   | sort -n -u | tr '\n' ' ' | sed 's/ *$//')"
}
count() { set -- $1; echo $#; }
disp() {  # the same list, fit to print
  _d=$(norm "${1:-}"); _d=${_d# }; printf '%s' "${_d% }"
}

cp_isolated=$(cpulist "$(cat "$ROOT/sys/devices/system/cpu/isolated" 2>/dev/null)")
cp_online=$(cpulist "$(cat "$ROOT/sys/devices/system/cpu/online" 2>/dev/null)")
# Not nproc: nproc counts the CPUs available to the process that asks, so a
# self-test started under an affinity would report the box as smaller than it
# is and find nothing wrong with it.
niso_set=$(norm "$cp_isolated")   # once, not once per cpu: this is the boot path
cp_left=""
for c in $cp_online; do
  case "$niso_set" in *" $c "*) ;; *) cp_left="$cp_left $c" ;; esac
done

told_wk=$(cpulist "$(sed -n 's/^[[:space:]]*corelist-workers[[:space:]]*//p' \
                     "$STARTUP" 2>/dev/null | head -1)")
has_wk=""; has_main=""
if [ "${vpid:-0}" != 0 ]; then
  for t in "$ROOT/proc/$vpid/task/"*; do
    [ -r "$t/comm" ] || continue
    tname=$(cat "$t/comm" 2>/dev/null)
    tcpus=$(cpulist "$(sed -n 's/^Cpus_allowed_list:[[:space:]]*//p' \
                       "$t/status" 2>/dev/null)")
    case "$tname" in
      vpp_wk_*) has_wk="$has_wk $tcpus" ;;
      vpp_main) has_main="$tcpus" ;;
    esac
  done
fi

if [ -z "$told_wk" ]; then
  # No corelist-workers: first boot, or a box too small for a dedicated
  # worker. Both are already reported above, and neither has cores to compare.
  :
elif [ "${vpid:-0}" = 0 ]; then
  say "  [warn] vpp.service owns no process, so where the dataplane's workers"
  say "         actually run cannot be read: the profile names"
  say "        $(disp "$told_wk") and nothing confirms it"
elif [ -z "$has_wk" ]; then
  bad "startup.conf pins workers to cores the dataplane has none of"
  say_list "        " "pinned:$told_wk"
  say "        the dataplane has no worker thread at all: it is forwarding on"
  say "        its main thread, at a"
  say "        fraction of this box's capacity. VPP was started before that"
  say "        profile was written - 'systemctl restart vpp.service'"
else
  # Does the running dataplane hold the cores its own profile names? A VPP
  # older than the file it is judged against is the ordinary way this goes
  # wrong, and "full tuning active" above reports the file, so it says yes.
  if [ "$(norm "$has_wk")" = "$(norm "$told_wk")" ]; then
    ok "dataplane workers hold the cores the profile names: $(disp "$has_wk")"
  else
    bad "startup.conf pins workers to cores the dataplane is not holding"
    say_list "        " "pinned:$told_wk"
    say_list "        " "holding: $(disp "$has_wk")"
    say "        This VPP is older than the"
    say "        profile it is being judged against; the box is running the"
    say "        previous tuning. 'systemctl restart vpp.service'"
  fi
  # And is the kernel keeping everything else off them? isolcpus is what stops
  # the scheduler putting other work on a worker's core. A worker pinned to a
  # core the kernel is not isolating shares it with everything the scheduler
  # has to place, and poll mode means it never yields: the core is contended
  # for the whole time and the loss appears as burst drops with no counter
  # behind them.
  notiso=""
  for c in $(norm "$has_wk"); do
    case "$niso_set" in *" $c "*) ;; *) notiso="$notiso $c" ;; esac
  done
  if [ -z "$notiso" ]; then
    ok "and the kernel is isolating every one of them"
  else
    bad "worker core(s)$notiso are NOT isolated by this kernel"
    say "        (isolcpus gives $(disp "$cp_isolated"))."
    say "        A poll-mode worker there shares its core with everything the"
    say "        scheduler places, and never yields. The box forwards and"
    say "        loses throughput with no counter to show for it. The command"
    say "        line is generated into /etc/default/grub.d/hexarouting.cfg:"
    say "        check it matches, run update-grub and reboot"
  fi
fi

# What the control plane is left with, reported and not capped.
#
# This product bounds the control plane where a bound can be derived and
# refuses to where it cannot - MemoryMax on hexarouting.service against a
# measured 13 MB, no MemoryMax on frr.service because one full table costs
# 1.37 GB and 37 MB is the same product with default routes (docs/appliance.md).
# The CPUs are the same shape: which cores the control plane has is decided by
# the tuner, per box, and written to the kernel command line - so the box can
# READ it back and say what it came to, which is what this line is.
#
# The warning is arithmetic, not a threshold somebody liked. One CPU left while
# more than one is isolated means every worker core but one could have been
# handed back and was not: FRR, frr-reload, vtysh, hexash, sshd and VPP's own
# main thread are all on that single CPU, and the main thread is the one that
# takes the worker barrier once a second (bpa-expire-process). A box with one
# isolated core has nothing to give back and is not warned about.
if [ -n "$cp_isolated" ] && [ -n "$cp_left" ]; then
  nleft=$(count "$cp_left"); niso=$(count "$cp_isolated")
  main_note=""
  nleft_set=$(norm "$cp_left")
  for c in $has_main; do
    case "$nleft_set" in *" $c "*) main_note=", with VPP's main thread" ;; esac
  done
  if [ "$nleft" = 1 ] && [ "$niso" -gt 1 ]; then
    say "  [warn] the control plane has ONE cpu ($(disp "$cp_left"))$main_note:"
    say "         $niso cores are isolated for workers and everything that is"
    say "         not a worker shares what is left. VPP's main thread takes the"
    say "         worker barrier once a second there, and forwarding stops for"
    say "         as long as it waits to be scheduled. Hand cores back with"
    say "         HEXA_MAX_WORKERS in /etc/hexarouting/tune.env - each one costs"
    say "         that share of forwarding, so the trade is the operator's"
  else
    ok "control plane has $nleft cpu(s): $(disp "$cp_left")$main_note"
  fi
fi

# --- latency: without this the box forwards and still loses under burst ---
#
# TWO readings, not one. /proc/cmdline is what THIS boot actually got;
# /etc/hexarouting/tune.env is what was asked for and what the next boot will
# get. The line used to read only the first and then advise "set
# HEXA_LOW_LATENCY=0" - which on a box that had already set it was the console
# telling the operator to do the thing they did, about a state they chose.
#
# And the case worth the most is the one that had no line at all: tune.env
# saying 0 while the command line still carries the parameters, or the reverse.
# That is a box running a command line older than the file that generates it,
# which is exactly "the tuning requested is not the tuning in effect".
#
# Read, never sourced: tune.env is a file an operator edits by hand, and
# sourcing it would run whatever is in it as root inside the boot self-test.
TUNEENV=${HEXA_TUNE_ENV:-$ROOT/etc/hexarouting/tune.env}
ll=$(sed -n 's/^[[:space:]]*HEXA_LOW_LATENCY[[:space:]]*=[[:space:]]*//p' \
     "$TUNEENV" 2>/dev/null | tail -1 | tr -d '"'"'"' \t')
ll=${ll:-1}
ll_refused=""
case "$ll" in
  0|1) ;;
  # apply-tuning refuses anything else and uses 1. The self-test says the same
  # thing rather than a second, different answer: two components disagreeing
  # about one file is worse than either being wrong.
  *) ll_refused=$ll; ll=1 ;;
esac
if [ -n "$ll_refused" ]; then
  say "  [warn] HEXA_LOW_LATENCY='$ll_refused' in /etc/hexarouting/tune.env is"
  say "         not a value the box accepts. Only 1 (deep C-states off,"
  say "         transparent hugepages off, cpufreq governor on performance)"
  say "         and 0 (leave all three alone). Being read as 1, the default"
fi

cst=no
grep -q "processor.max_cstate=1" "$ROOT/proc/cmdline" 2>/dev/null && cst=yes
case "$ll$cst" in
  1yes) ok "deep C-states disabled on the kernel command line" ;;
  1no)  say "  [warn] deep C-states still enabled: expect jitter on bursts."
        say "         HEXA_LOW_LATENCY=1 asks for them off, so the tuning has"
        say "         not reached this boot's command line. Reboot; if it is"
        say "         still missing after that, read the generated file"
        say "         /etc/default/grub.d/hexarouting.cfg and run update-grub" ;;
  0no)  say "  [info] deep C-states left enabled on purpose:"
        say "         HEXA_LOW_LATENCY=0 in /etc/hexarouting/tune.env. Expect"
        say "         jitter on bursts; set 1 and reboot to trade power for it" ;;
  0yes) say "  [warn] this boot's command line disables deep C-states and"
        say "         HEXA_LOW_LATENCY=0 in /etc/hexarouting/tune.env asks for"
        say "         them left alone: the box booted a command line older"
        say "         than that file. Reboot to run what it now says" ;;
esac

# And what the kernel actually exposes, which is not what it was asked for. A
# parameter the kernel IGNORED leaves /proc/cmdline saying it was requested
# and the kernel behaving as though it was not, so a green line above can be
# about nothing at all. This is the readback that says when it is.
idle=$(cat "$ROOT/sys/devices/system/cpu/cpuidle/current_driver" 2>/dev/null \
       || echo "")
if [ -z "$idle" ] || [ "$idle" = none ]; then
  say "  [info] the kernel exposes no idle-state driver, so nothing here"
  say "         enters a C-state and those parameters have nothing to act"
  say "         on either way. Usual on a virtual machine"
fi

gov=$(cat "$ROOT/sys/devices/system/cpu/cpufreq/policy0/scaling_governor" 2>/dev/null || echo "")
if [ -z "$gov" ]; then
  say "  [info] no cpufreq exposed (virtual machine): nothing to set"
elif [ "$gov" = performance ]; then
  ok "cpufreq governor: performance"
else
  say "  [warn] cpufreq governor is '$gov', not performance"
fi

# --- does the VTY open? ---
# 0.2.0 shipped a hexash that died at start for want of config.py, and this
# self-test went green: it measured the dataplane, the routing and the tuning,
# and never the front door. A boot that does not exercise the VTY does not know
# whether it is there.
if ! command -v hexash >/dev/null 2>&1; then
  bad "hexash is not installed"
else
  out=$(hexash -c "show rollback" 2>&1)
  case "$out" in
    *Traceback*|*ModuleNotFoundError*|*"No module named"*)
      bad "hexash does not start: $(printf '%s' "$out" | tail -1)" ;;
    *) ok "VTY starts: $(printf '%s' "$out" | head -1)" ;;
  esac
fi

# --- plano de controle ---
if vtysh -c "show version" >/dev/null 2>&1; then
  ok "FRR responding"
  # WHICH daemons, not merely that FRR answers. zebra, mgmtd and staticd are
  # started unconditionally by frrinit.sh, so "FRR responding" is true on a box
  # that cannot run a single routing protocol - which is what it was, before
  # the installer enabled them (#99). A box that cannot run BGP should say so
  # before somebody configures BGP on it.
  daemons=$(vtysh -c "show daemons" 2>/dev/null | tr -s ' ')
  missing=""
  # ospf6d is here for the same reason the other three are, and it was left
  # out for one release longer (#187): the VTY accepted `router ospf6` and the
  # installer enabled every daemon but that one, so OSPFv3 was the one
  # protocol a box could be configured for and never run.
  for d in bgpd ospfd ospf6d isisd; do
    case " $daemons " in *" $d "*) ;; *) missing="$missing $d" ;; esac
  done
  if [ -n "$missing" ]; then
    say "  [warn] routing daemons not running:$missing"
    say "         the VTY offers these protocols and they would commit and"
    say "         reach nothing. Enable them in /etc/frr/daemons."
  else
    ok "routing daemons up:$(printf '%s' "$daemons" | tr -d '\n')"
  fi

  # IS-IS is not carried over IP: it is OSI NLPID 0x83 straight over the link,
  # and linux_cp drops it unless told to punt it. A box with an IS-IS instance
  # and no punt commits cleanly, brings isisd up, reads back correctly, and
  # forms no adjacency ever - with the only evidence in a dataplane error
  # counter nothing surfaces. Worth its own line for that reason.
  if vtysh -c "show running-config" 2>/dev/null | grep -q "^router isis"; then
    if vppctl show lcp 2>/dev/null | grep -qi "osi.*0x83\|osi-proto.*131"; then
      ok "IS-IS frames are punted to the kernel"
    else
      say "  [warn] IS-IS is configured and its frames are NOT punted"
      say "         the adjacency will never form, and the only sign of it"
      say "         is a dataplane counter for unknown OSI protocols"
    fi
  fi

  # RPKI is a loadable module, and one that is present and not loaded is not
  # there. Worth its own line because the symptom is misleading: bgpd refuses
  # to start when told to load a module it cannot find, so a missing module
  # presents as "bgpd is not running" and sends the reader after the wrong
  # thing entirely.
  if vtysh -c "show rpki cache-connection" >/dev/null 2>&1; then
    caches=$(vtysh -c "show running-config" 2>/dev/null \
             | grep -c "^ rpki cache" || true)
    if [ "${caches:-0}" -eq 0 ]; then
      ok "RPKI module loaded (no cache configured, so nothing is validated)"
    else
      # A cache that is configured and not connected marks EVERY route
      # notfound. A policy that denies invalid keeps working; one that treats
      # notfound as suspicious degrades every route on the box, quietly, and
      # cache outages are ordinary.
      # The per-cache "(connected)" marker, not the "Connected to group N"
      # header - measured: the header still says Connected long after the
      # cache is gone.
      conn=$(vtysh -c "show rpki cache-connection" 2>/dev/null \
             | grep -c "(connected)" || true)
      if [ "${conn:-0}" -ge 1 ]; then
        ok "RPKI: $caches cache(s) configured and connected"
      else
        say "  [warn] RPKI: $caches cache(s) configured, NONE connected"
        say "         validation is running on what the caches already sent,"
        say "         which expires; after that every route is notfound and a"
        say "         policy keyed on notfound is acting on all of them"
      fi
    fi
  else
    say "  [warn] RPKI module not loaded: origin validation is unavailable"
    say "         install frr-rpki-rtrlib and add '-M rpki' to bgpd_options"
    say "         in /etc/frr/daemons"
  fi
else
  bad "FRR not responding"
fi

# --- the binary API, which is how a pool gets created ---
#
# hexash creates and changes pools over the binary API, not the CLI socket.
# Without the vat2 plugin that API is not registered and every pool operation
# fails - so the box runs, answers, routes, and cannot be configured to do the
# one thing it is for. The ISO shipped without that plugin for the life of the
# project and said so only as a warning in the build log
# (https://github.com/andrediashexa/hexarouting/issues/119).
#
# Read-only on purpose. This runs at every boot on a production box: it asks
# whether the API is registered and does not create anything to find out.
if vat2 --dump-apis 2>/dev/null | grep -q bpa_pool_add_del; then
  ok "binary API registered, so pools can be configured"
else
  bad "binary API NOT registered: no CGNAT pool can be configured here"
  say "         the vat2 plugin is missing from this install. The box will"
  say "         route and answer, and every pool commit will fail."
fi

# --- can the accounts on THIS box use that API? ---
#
# Roles (#35) bound what the VTY will do. They are decorative if every operator
# still has to be root to reach the dataplane, and worse than decorative: the
# box would report a boundary it does not have.
#
# "api-segment { gid vpp }" group-owns /dev/shm/vpe-api and NOT
# /dev/shm/global_vm, which a client maps as well. A drop-in on vpp.service
# fixes the second one after the dataplane starts. Asserted by actually making
# a call, not by reading the mode bits: the mode being right is the thing that
# was meant to make the call work, and checking the means instead of the end is
# how a permission comes to be set correctly and still not be enough.
# https://github.com/andrediashexa/hexarouting/issues/76
#
# The call used to be made by "setpriv --groups vpp", which SYNTHESISED the
# membership. That answers "would an account in group vpp work" - which was
# always yes - and never "is any account in group vpp", which for the whole
# life of the product was no: the VTY created accounts and put them in no group
# at all (#184). A self-test that manufactures the condition it is checking for
# cannot report its absence, and this one reported a working box while every
# operator account on it was inert.
#
# So: the accounts the box actually has, run as themselves. Read-only, and it
# creates nothing - --dump-apis only lists what is registered.
VPPGID=$(getent group vpp 2>/dev/null | cut -d: -f3)
# The login shell is what marks an account as this VTY's, the same marker the
# VTY itself reads. A list kept somewhere else would be a second thing to keep
# in step.
VTY_ACCOUNTS=$(getent passwd 2>/dev/null \
  | awk -F: '$7 == "/usr/bin/hexash-login" && $1 != "root" { print $1 }')
if [ -z "$VPPGID" ]; then
  bad "there is no 'vpp' group, so the API cannot be shared with anybody"
elif [ -z "$VTY_ACCOUNTS" ]; then
  # Not a failure: a freshly installed box has no operator accounts yet, and
  # the operator makes those. Said out loud so that "no accounts" is never
  # mistaken for "the accounts are fine".
  say "  [info] no operator account exists yet: only root can use this box"
  say "         create one with 'user <name>' and give it a role"
else
  prover=""
  for u in $VTY_ACCOUNTS; do
    ugroups=" $(id -nG "$u" 2>/dev/null) "
    missing=""
    for need in vpp frr frrvty; do
      case "$ugroups" in *" $need "*) ;; *) missing="$missing $need" ;; esac
    done
    urole=""
    case "$ugroups" in *" hexa-admin "*) urole=administrator ;; esac
    if [ -z "$urole" ]; then
      case "$ugroups" in *" hexa-cgnat "*) urole=cgnat-operator ;; esac
    fi
    if [ -n "$missing" ] && [ -n "$urole" ]; then
      # The exact shape of #184: a rank the box grants and an account that
      # cannot exercise it. Every command it issues fails with permission
      # denied, which reads as an authorization refusal and is not one.
      bad "$u has role $urole and is in none of:$missing"
      say "        the role cannot be exercised: VPP's sockets are group vpp"
      say "        and /etc/frr is group frr. Re-apply the role from the VTY:"
      say "        configure / user $u / role $urole / commit"
    elif [ -n "$missing" ]; then
      say "  [warn] $u is read-only and is in none of:$missing"
      say "         it cannot read the dataplane or the routing state either"
    fi
    [ -n "$prover" ] && continue
    case "$ugroups" in *" vpp "*) prover=$u ;; esac
  done
  if [ -z "$prover" ]; then
    bad "no account on this box is in group vpp: only root can use the API"
  elif runuser -u "$prover" -- vat2 --dump-apis >/dev/null 2>&1; then
    ok "the binary API works for $prover, an account that really has the group"
  else
    bad "the binary API does not work for $prover: it would have to be root"
    say "         /dev/shm/global_vm is $(stat -c '%U:%G %a' /dev/shm/global_vm \
2>/dev/null || echo 'not there'), and it must be group vpp, mode 660"
  fi
fi

# --- which NIC the dataplane was given ---
#
# Said out loud because the failure it replaces was silent. The box used to
# ship HEXA_DATAPLANE_IF=eth0, which does not exist under predictable interface
# names, and the tuner then generated a DPDK stanza with no device allowlist -
# so VPP claimed whatever NIC it found, which on a single-NIC box is the
# management one. The operator learned about it by losing the session (#123).
#
# Now nothing is claimed unless it is named, which is safe and is also easy to
# not notice: a box that forwards nothing looks like a box that is working.
if grep -q "plugin dpdk_plugin.so { disable }" "$STARTUP" 2>/dev/null
then
  # No DPDK at all, so no device can be claimed by anything. This is the
  # first-boot profile: without hugepages the EAL fails and VPP exits, so the
  # tuner turns the plugin off until a reboot has reserved them. Safe, and it
  # has to be told apart from "DPDK is on and no device is named", which is the
  # dangerous case below - the first version of this check conflated them and
  # failed every live medium.
  say "  [info] DPDK is off until hugepages exist; no NIC can be claimed yet"
elif grep -q "no-pci" "$STARTUP" 2>/dev/null; then
  # The remedy is a command in the VTY now, not a path and an editor (#283).
  # The same words the VTY's own diagnosis uses: two accounts of one fact that
  # disagree are worse than one, and this is the account an operator reads on
  # the console of a box that has just come up forwarding nothing.
  say "  [warn] no dataplane interface: VPP was given no NIC to forward on"
  say "         name it from the VTY: 'configure', then"
  say "         'dataplane interface <name>', then 'commit'. A name this box"
  say "         has not got is refused, and so is the interface carrying the"
  say "         default route, so naming the management one cannot cut it off."
elif grep -q "dev 0000:" "$STARTUP" 2>/dev/null; then
  # A NAME IN A FILE IS NOT A NIC. This said [ ok ] as soon as a device
  # appeared in startup.conf, so a box whose dataplane has no interface at all
  # passed its own self-test on the strength of a line somebody wrote (#283).
  # That is docs/context.md 1.4 one more time: the configuration is the
  # intention, and the dataplane is the fact.
  #
  # Nothing in this appliance binds a NIC to vfio-pci or loads it, so an
  # operator who did exactly what the warning above tells them - name the
  # interface - lands here, is told the NIC is fine, and still forwards
  # nothing.
  NICPCI=$(grep -o 'dev 0000:[0-9a-f:.]*' "$STARTUP" | head -1 | cut -d' ' -f2)
  # "any interface that is not local0" and not a count: local0 is VPP's own
  # loopback and is present on a box with no NIC whatever.
  if vppctl show interface 2>/dev/null \
       | awk 'NR>1 && $1 != "" && $1 != "local0" {found=1} END {exit !found}'
  then
    ok "dataplane NIC: $NICPCI"
  else
    bad "the dataplane has no interface, and one is named"
    say "        $NICPCI"
    NICDRV=$(basename "$(readlink -f "/sys/bus/pci/devices/$NICPCI/driver" \
                         2>/dev/null)" 2>/dev/null)
    case "$NICDRV" in
      vfio-pci|uio_pci_generic|igb_uio)
        say "         it is bound to $NICDRV, which DPDK can use, so the"
        say "         binding is not the problem. The VPP journal says why." ;;
      "" |.)
        say "         no driver is bound to it at all." ;;
      *)
        say "         it is bound to '$NICDRV', which DPDK cannot take it"
        say "         through." ;;
    esac
    for d in vfio-pci uio_pci_generic igb_uio; do
      [ -d "/sys/bus/pci/drivers/$d" ] && { HAVEDRV=$d; break; }
    done
    if [ -n "${HAVEDRV:-}" ]; then
      case "$NICDRV" in
        vfio-pci|uio_pci_generic|igb_uio) : ;;
        *) say "         $HAVEDRV is loaded, and nothing has bound the device to it." ;;
      esac
    else
      say "         no driver DPDK can use is loaded: none of vfio-pci,"
      say "         uio_pci_generic, igb_uio."
    fi
  fi
else
  bad "the dataplane may claim any NIC it finds, including this box's"
  say "         management interface. /etc/vpp/startup.conf names no device"
  say "         and does not say no-pci."
fi

# --- is any dataplane interface paired into the kernel? ---
#
# FRR only ever sees a linux_cp pair. VPP owns the NIC outright, so without a
# pair the port that carries traffic has no netdev at all: `ip` does not have
# it, zebra does not have it, and BGP, OSPF and IS-IS are configurable and
# completely inert (#182). For the life of the product nothing created a pair
# and every lab created one by hand, so the labs proved a box nobody received.
#
# The pair is the OPERATOR's to ask for, by name - `linux-name <name>` under
# `interface` - and that is a decision rather than an omission: the Linux-side
# name is what FRR, `ip` and the operator's own scripts act on, so a name this
# product invented would be one nobody could predict, and #161 is the standing
# rule that such a name must be read back from the box rather than remembered.
# The cost of the decision is that a box can be installed, tuned, given a NIC
# and left with no pair, which from outside looks exactly like a box that is
# working. This line is what pays that cost.
#
# Read from the box and never arranged here. A check that creates the pair it
# is checking for cannot report its absence, which is #184 in one sentence.
#
# Excluded from the count, with the reason for each:
#   local0   VPP's own null interface. On every box, never paired.
#   pg*      the packet generator, which exists in labs and not on appliances
#   tap*     the LINUX end of a pair is itself an interface in VPP's list, so
#            counting it would make every correctly paired box look half done
if vppctl show version >/dev/null 2>&1; then
  lcp_lines=$(vppctl show lcp 2>/dev/null | grep "itf-pair" || true)
  unpaired=""
  npaired=0
  # The header of `show interface` is INDENTED, and so is every continuation
  # line carrying a counter; only a name starts in column one. The $1 != "Name"
  # is the second half of the same belt, because a header that ever loses its
  # indentation would otherwise be reported as an unpaired interface.
  for iface in $(vppctl show interface 2>/dev/null \
                 | awk '/^[^ \t]/ && $1 != "Name" {print $1}'); do
    case "$iface" in local0|pg*|tap*) continue ;; esac
    # Matched as a fixed string between spaces, not as a pattern: VPP's own
    # interface names are full of "/" and "." and a pattern made of one would
    # match interfaces it does not name. Every name on an itf-pair line is
    # followed by a space, because the line ends "type tap".
    if printf '%s\n' "$lcp_lines" | grep -qF " $iface "; then
      npaired=$((npaired + 1))
    else
      unpaired="$unpaired $iface"
    fi
  done
  # Configured routing turns this from something worth knowing into a box that
  # cannot do what it has been told to do. `router bgp`, `router ospf` and
  # `router isis` are all top level in FRR's running configuration.
  routing_configured=no
  if vtysh -c "show running-config" 2>/dev/null | grep -q "^router "; then
    routing_configured=yes
  fi
  if [ -z "$unpaired" ] && [ "$npaired" -eq 0 ]; then
    # Nothing but local0. The DPDK block above already said why, in the
    # operator's terms, so this does not say it a second time as a warning.
    say "  [info] the dataplane has no interface that could be paired yet"
  elif [ "$npaired" -eq 0 ] && [ "$routing_configured" = yes ]; then
    bad "routing is configured and NO interface is paired into the kernel"
    say "        FRR has no interface for the port that carries traffic, so"
    say "        BGP, OSPF and IS-IS will never form an adjacency."
    say "        without a pair:$unpaired"
    say "        give each one a 'linux-name <name>' under 'interface' in"
    say "        hexash, and commit."
  elif [ -n "$unpaired" ]; then
    say "  [warn] no linux_cp pair on:$unpaired"
    say "         FRR and 'ip' cannot see these, so no routing protocol can"
    say "         run on them. Set 'linux-name <name>' under 'interface' in"
    say "         hexash, and commit."
  else
    ok "$npaired dataplane interface(s) paired into the kernel, so FRR sees them"
  fi
fi

# --- the statistics segment, the one resource with an abort behind it ---
#
# VPP exports every counter through a shared segment of FIXED size, and each
# dataplane interface adds seventeen directory entries to it plus one counter
# slot per thread. The segment never grows. Filling it is not a refusal:
# vnet_register_interface reaches os_panic and the process takes SIGABRT, so
# the whole dataplane goes, not the interface that was one too many.
#
# Measured on a box this product's own tuner built: the segment was VPP's
# built-in 32 MB and creating subscriber interfaces aborted it between 7,000
# and 8,000, twice, at the same step.
#
# hexarouting-tune does not size the segment, and that is a decision rather
# than an omission: nothing it reads predicts how many INTERFACES a box will
# carry. HEXA_SUBSCRIBERS counts subscribers behind a CGNAT pool, and those
# share a handful of interfaces. Sizing from it would buy 200,000 interfaces
# that never appear, on a box whose floor is 4 GB of RAM.
#
# This line is what pays for that decision. An operator stacking a
# sub-interface per customer can see the wall approaching instead of meeting
# it as a SIGABRT with no sentence in front of it.
#
# Read and never written (#184): what is reported is what the dataplane says
# its own heap holds, not what a configuration file asked for.
if vppctl show version >/dev/null 2>&1; then
  # A named counter plus `verbose` prints that one entry and then the heap,
  # instead of the whole directory - which on the box this matters for is
  # forty thousand lines. /sys/vector_rate is registered when the segment is
  # created, so it is on every box.
  seg=$(vppctl show statistics segment /sys/vector_rate verbose 2>/dev/null \
        | grep -m1 'total:.*used:')
  if [ -z "$seg" ]; then
    say "  [warn] the dataplane did not report its statistics segment, so how"
    say "         close this box is to aborting on it is unknown - which is"
    say "         not the same as being far from it"
  else
    # VPP prints "total: 31.99M, used: 4.20M, free: ..., trimmable: ...",
    # with K/M/G and two decimals, and bytes below 1 K. awk because sh has no
    # floating point, and the percentage is the whole judgement.
    segpct=$(printf '%s\n' "$seg" | awk -F'[:,]' '
      function bytes(v,  n, u) {
        gsub(/ /, "", v); u = substr(v, length(v)); n = v + 0
        if (u == "G") return n * 1073741824
        if (u == "M") return n * 1048576
        if (u == "K") return n * 1024
        return n
      }
      { t = bytes($2); u = bytes($4); if (t > 0) printf "%d", u * 100 / t }')
    segtot=$(printf '%s\n' "$seg" | sed -n 's/.*total: *\([^,]*\),.*/\1/p')
    segused=$(printf '%s\n' "$seg" | sed -n 's/.*used: *\([^,]*\),.*/\1/p')
    # Same listing, same exclusions as the pair check above, except that
    # local0 and the tap ends are COUNTED here: every interface VPP holds has
    # its entries in the segment, whoever created it.
    segif=$(vppctl show interface 2>/dev/null \
            | awk '/^[^ \t]/ && $1 != "Name"' | wc -l | tr -d ' ')
    [ -n "$segpct" ] || segpct=0
    if [ "$segpct" -ge 75 ]; then
      bad "statistics segment ${segpct}% used: $segused of $segtot, with"
      say "        $segif interface(s). VPP ABORTS when this fills - os_panic,"
      say "        SIGABRT, the whole dataplane - and it neither refuses the"
      say "        interface first nor says why afterwards. The last part of"
      say "        the segment cannot be spent either: the counter directory"
      say "        is one block that is COPIED to grow, so a growth needs the"
      say "        old and the new at the same time."
      say "        Put 'statseg { size 256M }' in"
      say "        /etc/hexarouting/vpp-base.conf and restart vpp.service."
    elif [ "$segpct" -ge 50 ]; then
      say "  [warn] statistics segment ${segpct}% used: $segused of $segtot,"
      say "         with $segif interface(s). The dataplane ABORTS when this"
      say "         fills, it does not refuse the next interface. Raise it"
      say "         with a 'statseg { size 256M }' stanza in"
      say "         /etc/hexarouting/vpp-base.conf, then restart vpp.service."
    else
      # Where the size came from, which is the sentence nobody was ever told:
      # a box carrying a statseg stanza was sized by somebody, and a box
      # without one is running on a number nobody on this project chose.
      #
      # A STANZA, not the word. The base file ships a comment block explaining
      # where statseg goes and that comment is copied into startup.conf, so a
      # plain grep would report every shipped box as one somebody had sized.
      if grep -qE '^[[:space:]]*statseg' "$STARTUP" 2>/dev/null; then
        segsrc="set in /etc/hexarouting/vpp-base.conf"
      else
        segsrc="VPP's own default, which this product does not set"
      fi
      ok "statistics segment: $segused of $segtot used, $segif interface(s)"
      say "        size: $segsrc"
    fi
  fi
fi

# --- where the connection records live ---
#
# In dynamic mode the allocation log IS the record the Marco Civil requires to
# be kept for a year. It has its own filesystem so that a full log cannot stop
# the box working (#83) - and fstab mounts it "nofail", because a box that
# will not boot because that volume is missing is a box nobody can log into to
# find out why.
#
# Which means something has to say so, or the box comes up quietly writing
# records onto the root filesystem, which is the arrangement this replaced.
if [ -d "$ROOT/var/log/hexarouting" ]; then
  rec_src=$(findmnt -no SOURCE --target "$ROOT/var/log/hexarouting" 2>/dev/null)
  root_src=$(findmnt -no SOURCE --target / 2>/dev/null)
  if [ -n "$rec_src" ] && [ "$rec_src" != "$root_src" ]; then
    ok "records on their own filesystem: $rec_src, $(df -h "$ROOT/var/log/hexarouting" 2>/dev/null | awk 'NR==2{print $4" free of "$2}')"
  elif [ -f "$ROOT/run/live/medium/live/filesystem.squashfs" ]; then
    say "  [info] live medium: records are not persisted anyway"
  else
    say "  [warn] connection records are on the ROOT filesystem"
    say "         a log that fills will stop this box writing its own"
    say "         configuration. Check that /var/log/hexarouting is mounted."
  fi

  # --- and are they still on TWO disks? (#83) ---
  #
  # A mirror nobody is told about is a mirror that silently becomes one disk,
  # and then zero. Nothing else on this box notices a disk dying under a
  # mirror: the volume stays mounted, the records keep being written, the box
  # forwards - and the SECOND failure is the one that loses the year the Marco
  # Civil requires. Downtime is recoverable by rebooting; this is not
  # recoverable at all, which is why it is a failed check and not a warning.
  #
  # A box with one disk is told NOTHING here. It has no array, so there is no
  # question to answer, and inventing one would put a line about hardware
  # nobody bought on every console in the field.
  case "${rec_src:-}" in
    /dev/md*)
      _md=${rec_src#/dev/}
      # The array's OWN block line - the one carrying [n/m]. /proc/mdstat
      # lists every array on the box, so a grep for "[2/2]" anywhere in it can
      # be answered by a different array entirely.
      _mdline=$(awk -v d="$_md" '$1 == d { f = 1 }
                                 f && /\[[0-9]+\/[0-9]+\]/ { print; exit }' \
                "$ROOT/proc/mdstat" 2>/dev/null)
      _legs=$(printf '%s' "$_mdline" | grep -o '\[[0-9]*/[0-9]*\]' | head -1 | tr -d '[]')
      # The members, taken as the fields that carry a slot number, because the
      # header is not fixed-width: an array that came up read-only reads
      # "active (auto-read-only) raid1", and counting from field 5 then names
      # the personality as a disk.
      _members=$(awk -v d="$_md" '$1 == d {
                     for (i = 3; i <= NF; i++) if ($i ~ /\[[0-9]+\]/) printf "%s ", $i
                     exit }' "$ROOT/proc/mdstat" 2>/dev/null \
                 | sed 's/\[[0-9]*\]//g; s/  *$//')
      # A rebuild in progress, from the array's own block: the lines under it
      # up to the blank line that separates arrays. It is the difference
      # between a disk that has been replaced and one that has not, and
      # reporting a rebuild as a failure trains whoever reads this console to
      # ignore the line that matters.
      _rebuild=$(awk -v d="$_md" '$1 == d { f = 1; next }
                                  f && (/^$/ || /^md/) { exit }
                                  f && /(recovery|resync|reshape) *=/ {
                                      sub(/.*(recovery|resync|reshape) *= */, "", $0)
                                      print $1; exit }' \
                 "$ROOT/proc/mdstat" 2>/dev/null)
      if [ -z "$_legs" ]; then
        bad "the records are mounted from $rec_src and the kernel has no such array"
        say "        /proc/mdstat does not describe it, so nothing here can say"
        say "        how many disks the records are on."
      else
        _want=${_legs%/*}
        _have=${_legs#*/}
        if [ "$_have" = "$_want" ] && [ -n "$_rebuild" ]; then
          ok "records mirrored on $_have disks ($_members), synchronising $_rebuild"
        elif [ "$_have" = "$_want" ]; then
          ok "records mirrored on $_have disks ($_members)"
        elif [ -n "$_rebuild" ]; then
          say "  [warn] the records mirror is REBUILDING: $_have of $_want disks, $_rebuild"
          say "         a replaced disk is being copied onto. Until it finishes"
          say "         the records are on one disk. Members: $_members"
        else
          bad "the records mirror is DEGRADED: $_have of $_want disks ($_members)"
          say "        a disk has died and the records are on one. In dynamic mode"
          say "        those records are what this box answers a court order with,"
          say "        and the next failure loses them - a reinstall does not put"
          say "        them back. Replace the disk and add it with 'mdadm --add'."
        fi
      fi ;;
    *)
      # Installed WITH a mirror and running without one. The check above cannot
      # see this: the array never assembled, so the records are not on an md
      # device and, with fstab mounting them nofail, the box came up with the
      # volume missing altogether. The box's own record of its disks is the
      # only thing that knows a mirror was ever meant to be here.
      if grep -q 'name=[^ ]*:records' "$ROOT/etc/mdadm/mdadm.conf" 2>/dev/null; then
        bad "this box was installed with a records mirror and is not using it"
        say "        /etc/mdadm/mdadm.conf names a records array and"
        say "        /var/log/hexarouting is not on it, so everything written"
        say "        since this boot is on one disk. Read /proc/mdstat: an array"
        say "        that is not there is started with 'mdadm --assemble --scan',"
        say "        and one that is there was not mounted."
      fi ;;
  esac
fi

# --- is the allocation log actually LEAVING the box? ---
#
# In dynamic mode the IPFIX export IS the connection record the Marco Civil
# requires to be kept for a year, and until #209 it could not run at all over
# UDP: VPP's own exporter needs a collector, nothing on an installed box set
# one, and no VTY statement reached it. The dataplane refused `bpa logging
# enable` and - before #76 - the VTY discarded the refusal and said "commit
# complete".
#
# Which is the shape this check exists for, and it is the OOM drop-in's shape
# exactly: a setting that was REFUSED looks, from the configuration, identical
# to one that is working. So the two are read from different places and
# compared - what the box was TOLD at boot, from the file hexarouting.service
# hands to hexash, against what the dataplane HAS. Nothing here configures
# anything: a check that arranges the condition it is checking for cannot
# report its absence (#184).
# The same variable hexash reads, so this looks at the file the box was
# actually loaded from and not at a second guess about where it lives.
LOGCONF=${HEXA_CONFIG:-/etc/hexarouting/hexarouting.conf}
if vppctl show version >/dev/null 2>&1; then
  log=$(vppctl show bpa logging 2>/dev/null)
  # The value the dataplane acts on, not the word "enabled" anywhere in the
  # output: the TCP block below carries "enabled" too.
  udp_on=no
  echo "$log" | grep -qE "^  state +enabled" && udp_on=yes
  udp_dst=$(echo "$log" | sed -n 's/^  exporter  *\(.*\)$/\1/p')
  case "$udp_dst" in none*|"") udp_dst="" ;; esac
  want_on=no; want_dst=no
  if [ -f "$LOGCONF" ]; then
    grep -q "^cgnat logging enable" "$LOGCONF" && want_on=yes
    grep -q "^cgnat logging udp " "$LOGCONF" && want_dst=yes
  fi

  if [ "$want_dst" = yes ] && [ -z "$udp_dst" ]; then
    bad "the saved configuration names an IPFIX collector and the dataplane"
    say "        has none: '$(grep -m1 "^cgnat logging udp " "$LOGCONF")' was"
    say "        refused when it was applied. 'journalctl -u hexarouting' has"
    say "        the reason."
  elif [ "$want_on" = yes ] && [ "$udp_on" = no ]; then
    # The exact failure #209 is about, and the one that used to be invisible.
    bad "the saved configuration turns UDP export ON and the dataplane has it"
    say "        OFF: the allocation log is not being exported. In dynamic"
    say "        mode that log is the connection record, so this box cannot"
    say "        say who held a public port at a given moment."
    say "        'hexash -c \"show cgnat logging\"' says what it has."
  elif [ "$udp_on" = yes ] && [ -z "$udp_dst" ]; then
    # Measured: clearing the exporter leaves the export state enabled, so
    # "state enabled" on its own is not evidence that anything is sent.
    bad "UDP export is enabled and the IPFIX exporter has no collector:"
    say "        every record is produced and none leaves this box. Set one"
    say "        with 'nat cgnat logging udp <collector> src <source>'."
  elif [ "$udp_on" = yes ]; then
    ok "UDP export running"
    say "        $udp_dst"
  fi

  # TCP, which has a state UDP does not: a collector that is named, accepted,
  # and never reached. The records are on disk in the spill file rather than
  # lost, so this is a warning and not a failure - but nothing else on the box
  # would say so.
  tcp_dst=$(echo "$log" | sed -n 's/^  collector  *\([0-9][^ ]*\)  *\([a-z]*\)$/\1 \2/p')
  case "$tcp_dst" in
    *connected) ok "TCP export ${tcp_dst% *} connected" ;;
    *disconnected|*connecting)
      say "  [warn] the TCP collector ${tcp_dst% *} is ${tcp_dst##* }:"
      say "         records are spilling to /var/log/hexarouting and will be"
      say "         replayed when it comes back" ;;
  esac

  # A dynamic pool and no transport at all. Not a failure - an operator may
  # run a collector elsewhere, or be mid-deployment - but it is the state in
  # which the box is translating traffic and keeping no record of it.
  if [ "$udp_on" = no ] && [ -z "$tcp_dst" ] \
     && vppctl show bpa config 2>/dev/null | grep -q "^ mode dynamic"; then
    say "  [warn] a pool runs in dynamic mode and NOTHING is being exported:"
    say "         block allocations are not being recorded anywhere. In"
    say "         dynamic mode that log is the connection record."
  fi
fi

# --- the unit that APPLIES the configuration ---
#
# The self-test measured the dataplane, the routing, the tuning and the VTY,
# and never the one unit whose job is to put the configuration INTO the
# dataplane. So a box whose configuration was never applied reported
# "HexaRouting ready." to the one person - standing at the console - whose job
# it is to notice (#94).
#
# When it has failed, the reason goes on the screen with it. "Failed" without
# a reason sends whoever is standing there to a journal they may not be able
# to reach yet.
state=$(systemctl is-failed hexarouting.service 2>/dev/null || true)
if [ "$state" = failed ]; then
  bad "hexarouting.service FAILED: the CGNAT configuration was not applied"
  say "        the last thing it said:"
  journalctl -u hexarouting.service -n 6 --no-pager -o cat 2>/dev/null \
    | sed 's/^/          /' > "$OUT" 2>/dev/null
fi

# --- the configuration that is applied ---
pools=$(vppctl show bpa pool 2>/dev/null | grep -c "^pool ")
[ -n "$pools" ] || pools=0
if [ "$pools" -gt 0 ]; then
  ok "$pools CGNAT pool(s) configured"
else
  say "  [info] no CGNAT pool configured yet (use 'hexash')"
fi

# And the pools the box was TOLD about, against the pools it HAS.
#
# The same comparison the IPFIX block above makes, for the object this product
# exists for. hexarouting.service hands the saved file to hexash at boot; a
# pool the dataplane refuses is applied by nobody and reported by nothing -
# the service succeeds because the rest of the file applied, and the line
# above counts what is there rather than what is missing. Every subscriber
# behind that pool is untranslated, on a box that boots, forwards other
# people's traffic and answers every command.
#
# Names only. The line above already counts, and comparing settings would mean
# re-deriving the dataplane's own normalisation here, which is the mistake
# #184 names: a check that recomputes what it is checking agrees with its own
# arithmetic rather than with the box.
if vppctl show version >/dev/null 2>&1 && [ -f "$LOGCONF" ]; then
  want_pools=$(sed -n 's/^nat cgnat pool  *\([^ ]*\).*/\1/p' "$LOGCONF" \
               | sort -u)
  have_pools=$(vppctl show bpa pool 2>/dev/null \
               | sed -n 's/^pool  *\([^ []*[^ []\).*/\1/p' | sort -u)
  missing_pools=""
  for _p in $want_pools; do
    case " $(echo $have_pools) " in *" $_p "*) ;; *) missing_pools="$missing_pools $_p" ;; esac
  done
  if [ -n "$missing_pools" ]; then
    bad "the saved configuration has pool(s)$missing_pools and the dataplane"
    say "        does not: they were refused when they were applied, so every"
    say "        subscriber behind them is untranslated. 'journalctl -u"
    say "        hexarouting' has the reason the dataplane gave."
  elif [ -n "$want_pools" ]; then
    ok "and every pool the saved configuration names is on the dataplane"
  fi

  # And uRPF, for the same reason and with more at stake.
  #
  # uRPF is the check that stops a spoofed source being translated, and
  # therefore stops a packet nobody sent being attributed to a subscriber in
  # the retention log - a record indistinguishable from a true one
  # (docs/architecture.md). A box whose saved configuration turns it on and
  # whose dataplane does not have it forwards, translates, logs and answers
  # everything: there is no counter for a protection that is simply absent.
  #
  # Interface names only, and the mode is compared with them because "strict
  # where the file says loose" is a different box from "off where the file
  # says strict", and an operator reading this line has to be able to tell.
  want_urpf=$(sed -n 's/^ *urpf  *\([a-z]*\).*/\1/p' "$LOGCONF" | sort -u)
  if [ -n "$want_urpf" ] && [ "$want_urpf" != "off" ]; then
    have_urpf=$(vppctl show bpa urpf 2>/dev/null)
    case "$have_urpf" in
      *"no interface has uRPF enabled"*|"")
        bad "the saved configuration turns uRPF on and the dataplane has it on"
        say "        no interface. A spoofed source is translated and attributed"
        say "        to a subscriber who did not send it, and nothing counts it."
        say "        'journalctl -u hexarouting' has the reason it was refused." ;;
      *)
        ok "uRPF is on in the dataplane, as the saved configuration asks"
           say "        $(printf '%s' "$have_urpf" | tr '\n' ';' | cut -c1-60)" ;;
    esac
  fi

  # And the MTU, which is the one whose mismatch this project has already paid
  # for twice.
  #
  # An interface whose saved mtu the dataplane did not take is not a box that
  # stops working: it forwards, and then an OSPF adjacency will not leave
  # Exchange because the two ends advertise different MTUs and neither logs
  # anything (docs/routing.md, Pitfall 1). That is the fault that costs an
  # afternoon rather than a minute, and until now the only thing that noticed
  # was a finding at commit time - which says nothing on a box that was
  # rebooted, or whose interface was renumbered underneath it.
  #
  # The dataplane's own column, not the TAP's: `show interface` prints
  # "<name> <idx> <state> <l3>/<ip4>/<ip6>/<mpls>", and the L3 MTU is the one
  # the saved `mtu` statement sets.
  ifaces=$(vppctl show interface 2>/dev/null)
  mtu_wrong=""
  while read -r _if _want; do
    [ -n "$_if" ] || continue
    _got=$(printf '%s' "$ifaces" \
           | awk -v n="$_if" '$1 == n { split($4, m, "/"); print m[1]; exit }')
    [ -n "$_got" ] || continue          # not on this box: the pair check says so
    [ "$_got" = "$_want" ] || mtu_wrong="$mtu_wrong $_if($_want/$_got)"
  done <<MTUS
$(awk '/^interface /{ifn=$2} /^ *mtu /{if (ifn != "") print ifn, $2}' "$LOGCONF")
MTUS
  # The addresses, which is the one that can leave the box unreachable.
  #
  # An address in the saved file that the dataplane did not take is not a
  # degraded box: it is a box that answers on one fewer address than the
  # operator believes, and if that was the management address nobody can reach
  # it to find out. Same read as everything above - what the file says against
  # what `show interface addr` reports - and the same silence otherwise.
  addrs=$(vppctl show interface addr 2>/dev/null)
  addr_missing=""
  while read -r _if _addr; do
    [ -n "$_if" ] || continue
    # The block for this interface, from its header to the next one. An L3
    # line outside it belongs to a different port, and matching the address
    # anywhere in the output would pass on a box that put it on the wrong one.
    _block=$(printf '%s' "$addrs" | awk -v n="$_if" '
      $0 ~ "^"n" \\(" {inb=1; next} /^[^ ]/ {inb=0} inb')
    printf '%s' "$_block" | grep -q "L3 $_addr" \
      || addr_missing="$addr_missing $_if:$_addr"
  done <<ADDRS
$(awk '/^interface /{ifn=$2} /^ *ipv[46] address /{if (ifn != "") print ifn, $3}' "$LOGCONF")
ADDRS
  if [ -n "$addr_missing" ]; then
    bad "the saved configuration has address(es) the dataplane does not:"
    say "       $addr_missing"
    say "        the box answers on one fewer address than whoever configured"
    say "        it believes, and if that was the management address nobody"
    say "        can reach it to find out. 'journalctl -u hexarouting' has the"
    say "        reason it was refused."
  fi

  if [ -n "$mtu_wrong" ]; then
    bad "the saved MTU is not the MTU the dataplane has:"
    say "       $mtu_wrong"
    say "        (interface(saved/actual)). An OSPF adjacency stops at Exchange"
    say "        when the two ends disagree, and neither end logs anything."
    say "        'journalctl -u hexarouting' has why it was refused."
  fi
fi

# A live system says so, and says how to stop being one. Without this the
# operator boots a working appliance, finds no install option, and concludes
# the product is broken rather than running from a live image.
if [ -d /run/live/medium ] || [ -f /run/live/overlay ]; then
  say "  [info] live system: nothing is persisted across a reboot."
  if [ -x /usr/sbin/hexarouting-install ]; then
    say "         to install: hexarouting-install /dev/sdX"
  fi
fi

say "-------------------------------------------------------------"
if [ "$fail" = 0 ]; then
  say "  HexaRouting ready."
else
  say "  $fail check(s) failed. The box is NOT ready."
fi
say "============================================================="
say ""
# The diagnostic MUST NOT bring down the boot (docs/appliance.md). It reports a
# verdict about the box; it does not answer for it. The one moment this script
# must not add a failure of its own is the moment it has just found one, since
# the box that fails a check is the box whose console somebody needs.
#
# This is half of the rule. The other half is that systemd is told not to care:
# hexarouting-selftest.service carries "ExecStart=-", so a status this line
# stopped producing, or a signal that kills the script before it gets here,
# still cannot fail the unit.
exit 0
