 #include "ap_session.h"
 #include "triton.h"
@@ -203,3 +206,93 @@ int vpp_iproute_flush(struct ap_session *ses)
 
 	return 0;
 }
+
+/*
+ * Prisma Routing (#607): what a control plane that died left in VPP.
+ *
+ * MEASURED in lab/pppoe.sh, after accel-pppd was killed with -9: the
+ * entrypoint deleted the sessions VPP still held while the /32 routes accel-
+ * ppp had added through them were still there, and the routes went after -
+ * and each session interface's midchain adjacency outlived them all, with no
+ * FIB entry left that used it (`show adj`: still there; `show ip fib`: no
+ * pppoe_session). VPP's pppoe plugin recycles a deleted session's interface
+ * for the next session and builds an adjacency's rewrite only when it is
+ * created (adj_nbr.c), so the next subscriber on that interface was sent the
+ * PREVIOUS one's PPPoE header - another CPE's MAC, VLAN and session id: every
+ * download went to the wrong subscriber. A graceful teardown does it in the
+ * other order - the session's routes, then the session (vpphooks.c) - and the
+ * adjacency goes with them, measured. So this accel-pppd does what the dead
+ * one would have, in that order, before its first session.
+ *
+ * WHAT IS STALE IS READ OFF A FILE the entrypoint wrote with vppctl
+ * ($PRISMA_BNG_STALE: `route <a.b.c.d>/<len> <sw_if_index>` and `session
+ * <client-mac> <session-id>` lines), and not dumped here: a VAPI dump from
+ * this module aborted accel-pppd (`vapi_get_swap_to_host_func: Assertion id
+ * < __vapi_metadata.count` - the control-ping reply a dump waits for is a
+ * message this client's tables do not have), measured in lab/pppoe.sh.
+ */
+#include <stdio.h>
+#include "vpppoe.h"
+
+static vapi_error_e vpp_flush_del_cb(struct vapi_ctx_s *ctx, void *cb_ctx, vapi_error_e rv,
+		bool is_last, vapi_payload_ip_route_add_del_reply *reply)
+{
+	return rv;
+}
+
+int vpp_iproute_flush_stale(void)
+{
+	const char *path = getenv("PRISMA_BNG_STALE");
+	struct vapi_ctx_s *ctx;
+	FILE *f;
+	char line[128], kind[16], a[64];
+	unsigned int len, sw, sid, m[6];
+	struct in_addr dst;
+	int routes = 0, sessions = 0, k;
+	uint8_t mac[6];
+
+	if (!path || !(f = fopen(path, "r")))
+		return 0;
+
+	vpp_get();
+	/* the routes first */
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%15s %63[0-9.]/%u %u", kind, a, &len, &sw) != 4 || strcmp(kind, "route")
+				|| len > 32 || !inet_aton(a, &dst))
+			continue;
+		vpp_lock();
+		ctx = vpp_get_vapi();
+		if (ctx) {
+			vapi_msg_ip_route_add_del *req = vapi_alloc_ip_route_add_del(ctx, 1);
+			if (req) {
+				req->payload.is_add = 0;
+				req->payload.is_multipath = 1;
+				req->payload.route.prefix.address.af = ADDRESS_IP4;
+				memcpy(req->payload.route.prefix.address.un.ip4, &dst.s_addr, 4);
+				req->payload.route.prefix.len = len;
+				req->payload.route.n_paths = 1;
+				req->payload.route.paths[0].sw_if_index = sw;
+				if (vapi_ip_route_add_del(ctx, req, vpp_flush_del_cb, NULL) == VAPI_OK)
+					routes++;
+			}
+		}
+		vpp_unlock();
+	}
+	/* then the sessions */
+	rewind(f);
+	while (fgets(line, sizeof(line), f)) {
+		if (sscanf(line, "%15s %x:%x:%x:%x:%x:%x %u", kind, &m[0], &m[1], &m[2], &m[3], &m[4], &m[5], &sid) != 8
+				|| strcmp(kind, "session") || sid > 65535)
+			continue;
+		for (k = 0; k < 6; k++)
+			mac[k] = m[k];
+		if (!vpppoe_sync_del_pppoe_interface(mac, sid))
+			sessions++;
+	}
+	fclose(f);
+	vpp_put();
+	if (routes || sessions)
+		log_warn("vpp: removed %i route(s) and %i session(s) a previous accel-pppd left\n",
+			routes, sessions);
+	return routes;
+}
