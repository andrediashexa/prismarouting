+		/* The burst is NOT Cisco's (0.155.1): its numbers are a Cisco
+		 * router's own bucket, and the same plan from Prisma's attributes
+		 * would get another. 0 here is accel-ppp's own rule, a tenth of a
+		 * second of the rate (down-/up-burst-factor), for both sources. */
+		if (pr.dir == PRISMA_RATE_UP) {
+			*up = kbit;
+			*uburst = 0;
+		} else {
