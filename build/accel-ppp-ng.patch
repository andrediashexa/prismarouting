--- /dev/null
+++ b/accel-pppd/session_hooks/vyos_vpp/vppstats.c
@@ -0,0 +1,106 @@
+/* SPDX-License-Identifier: GPL-2.0-or-later */
+/*
+ * prisma-routing #597: a VPP session's counters, read from VPP's statistics
+ * segment over its socket (/run/vpp/stats.sock).
+ *
+ * A session terminated by VPP has no kernel interface, so accel-ppp's own
+ * reader (iplink_get_stats on an ifindex) has nothing to read: it failed, and
+ * every interim accounting update then terminated the session as
+ * Lost-Carrier - measured in prisma-routing's lab/pppoe.sh at the first
+ * interim, ten seconds after the session came up. These are the session
+ * interface's combined counters, summed over VPP's threads: rx is what the
+ * subscriber sent (Acct-Input-*), tx what it was sent (Acct-Output-*).
+ */
+#include <stdint.h>
+#include <string.h>
+#include <pthread.h>
+
+#include <vpp-api/client/stat_client.h>
+
+#include "log.h"
+#include "ap_session.h"
+
+#include "vpphooks.h"
+#include "vppstats.h"
+
+static pthread_mutex_t vppstats_lock = PTHREAD_MUTEX_INITIALIZER;
+static int vppstats_connected;
+
+static int vppstats_sum(stat_segment_data_t *d, uint32_t sw_if_index,
+			uint64_t *packets, uint64_t *bytes)
+{
+	int k;
+
+	*packets = *bytes = 0;
+	if (d->type != STAT_DIR_TYPE_COUNTER_VECTOR_COMBINED)
+		return -1;
+	for (k = 0; k < stat_segment_vec_len(d->combined_counter_vec); k++) {
+		vlib_counter_t *c = d->combined_counter_vec[k];
+		if (c == NULL || sw_if_index >= (uint32_t)stat_segment_vec_len(c))
+			continue;
+		*packets += c[sw_if_index].packets;
+		*bytes += c[sw_if_index].bytes;
+	}
+	return 0;
+}
+
+int vppstats_read(struct ap_session *ses, struct rtnl_link_stats64 *stats)
+{
+	struct vpphook_private_data_t *pd = vpphook_get_pd(ses);
+	uint8_t **patterns = NULL;
+	uint32_t *dir = NULL;
+	stat_segment_data_t *res = NULL;
+	uint64_t p, b;
+	int i, ret = -1;
+
+	if (pd == NULL)
+		return -1;
+
+	pthread_mutex_lock(&vppstats_lock);
+	if (!vppstats_connected) {
+		if (stat_segment_connect(STAT_SEGMENT_SOCKET_FILE)) {
+			log_ppp_warn("vpp: stats segment not reachable\n");
+			goto out;
+		}
+		vppstats_connected = 1;
+	}
+
+	patterns = stat_segment_string_vector(patterns, "^/if/rx$");
+	patterns = stat_segment_string_vector(patterns, "^/if/tx$");
+	dir = stat_segment_ls(patterns);
+	if (dir != NULL)
+		res = stat_segment_dump(dir);
+	if (res == NULL) {
+		/* VPP restarted under us: connect again on the next read */
+		stat_segment_disconnect();
+		vppstats_connected = 0;
+		goto out;
+	}
+
+	memset(stats, 0, sizeof(*stats));
+	for (i = 0; i < stat_segment_vec_len(res); i++) {
+		if (vppstats_sum(&res[i], pd->vpp_sw_if_index, &p, &b))
+			continue;
+		if (!strcmp(res[i].name, "/if/rx")) {
+			stats->rx_packets = p;
+			stats->rx_bytes = b;
+			ret = 0;
+		} else if (!strcmp(res[i].name, "/if/tx")) {
+			stats->tx_packets = p;
+			stats->tx_bytes = b;
+		}
+	}
+
+out:
+	if (res)
+		stat_segment_data_free(res);
+	if (dir)
+		stat_segment_vec_free(dir);
+	if (patterns) {
+		for (i = 0; i < stat_segment_vec_len(patterns); i++)
+			stat_segment_vec_free(patterns[i]);
+		stat_segment_vec_free(patterns);
+	}
+	pthread_mutex_unlock(&vppstats_lock);
+	return ret;
+}
