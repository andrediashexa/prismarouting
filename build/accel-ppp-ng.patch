+++ b/accel-pppd/session_hooks/vyos_vpp/vppiputils.c
@@ -5,6 +5,9 @@
 */
 
 #include <vapi/ip.api.vapi.h>
+#include <stdlib.h>
+#include <arpa/inet.h>
