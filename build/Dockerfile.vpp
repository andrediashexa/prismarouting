# The dataplane image: VPP, DPDK and the bpa plugin, and nothing that builds
# them. It is not build/Dockerfile.dev with the compiler removed - that image
# carries vpp-dev, libvppinfra-dev, cmake, ninja and gdb, and an appliance
# ships none of those.
#
# THE PLUGIN IS NOT BUILT HERE. It is compiled in the dev image, against the
# VPP whose version is pinned in both, and copied in: a plugin compiled
# against one VPP and loaded by another is the failure this product pins
# versions to avoid, and building it twice is two chances to compile it
# against two different ones. `tools/build-images.sh` is what puts them
# together, and `test/test_image_pins.py` refuses a pin here that disagrees
# with the one appliance/build-iso.sh installs.
FROM debian:12

ARG VPP_VERSION=26.06-release
ENV DEBIAN_FRONTEND=noninteractive
# The vpp postinst runs `sysctl --system`, which a container may not do, and
# the script is `sh -e`. The package exposes this variable for exactly this.
ENV VPP_INSTALL_SKIP_SYSCTL=1

# One layer, and curl and gnupg are gone by the end of it. They are needed to
# add the fd.io repository and are a network client in a dataplane image
# afterwards; removing them in a LATER layer would leave them in this one,
# where anything with the image can still read them.
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -s https://packagecloud.io/install/repositories/fdio/release/script.deb.sh | bash \
    && apt-get install -y --no-install-recommends \
        vpp=${VPP_VERSION} \
        vpp-plugin-core=${VPP_VERSION} \
        vpp-plugin-dpdk=${VPP_VERSION} \
        libvppinfra=${VPP_VERSION} \
    && apt-get purge -y curl gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*

# Where VPP looks for plugins it did not ship with. tools/build-images.sh
# copies the plugin this repository compiled into this directory.
COPY vpp_plugins/ /usr/lib/x86_64-linux-gnu/vpp_plugins/
# And its API definitions beside VPP's own (#527): the management image is
# built FROM this one, and its VTY reaches the plugin over vpp_papi, which
# knows only the messages it has a definition for.
COPY vpp_api/bpa.api.json /usr/share/vpp/api/plugins/bpa.api.json

# THE DRAIN'S DROP-IN, in an image that has no systemd to read it. It is the
# one statement of what stopping this dataplane means, and both supervisors
# read it: systemd as an ExecStop on the box, and the entrypoint below as the
# command it runs before forwarding the signal. Copying it rather than
# retyping the command is what keeps the two from disagreeing (#396).
COPY appliance/systemd/vpp-stop-drain.conf \
     /etc/systemd/system/vpp.service.d/vpp-stop-drain.conf

# PID 1 IS A WRAPPER, and the reason is that Compose has no pre-stop hook:
# `docker stop` sends SIGTERM and waits, and there is no "run this, wait,
# then signal" - which is exactly what the ExecStop is. The wrapper traps
# SIGTERM, runs the drain, WAITS for it, and only then signals VPP. Without
# the wait the release record is written into a graph that has stopped and is
# swallowed, and the stopped box becomes indistinguishable from one that fell
# over (#217, measured in lab/ipfix-stop.sh no-wait).
COPY appliance/vpp-entrypoint /usr/local/bin/vpp-entrypoint
ENTRYPOINT ["/usr/local/bin/vpp-entrypoint"]
