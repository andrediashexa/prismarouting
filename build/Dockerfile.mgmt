# The management plane (#448, phase C): the container the VTY runs in.
#
# FROM THE DATAPLANE'S OWN IMAGE, so vppctl, vat2 and the API definitions
# (this tree's plugin's included) are the same build as the VPP they talk to:
# a VTY speaking a newer or older binary API than the dataplane is the defect
# #293 spent a release on. On top of it, FRR's clients at the pinned version -
# vtysh and frr-reload.py, never the daemons - and prismash itself. And
# python3-vpp-api at the dataplane's own version, from the fd.io repository
# the base image already carries: the VTY holds one API connection per
# session rather than starting a vat2 per message (#527).
#
# NOTHING HERE RUNS A DAEMON. The container idles (`sleep infinity`) and a
# session is a `docker exec` the login's broker starts, as the login's own
# uid, so the host's doors see who is asking (doors.py: uid 0 only, as the
# box has always had it).
ARG BASE
FROM ${BASE}
ARG FRR_VERSION
ARG VPP_VERSION
ENV DEBIAN_FRONTEND=noninteractive
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends curl ca-certificates gnupg \
    && curl -s https://deb.frrouting.org/frr/keys.gpg \
         -o /usr/share/keyrings/frrouting.gpg \
    && echo "deb [signed-by=/usr/share/keyrings/frrouting.gpg] https://deb.frrouting.org/frr bookworm frr-stable" \
       > /etc/apt/sources.list.d/frr.list \
    && apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        python3 iproute2 less \
        frr=${FRR_VERSION} frr-pythontools=${FRR_VERSION} \
        python3-vpp-api=${VPP_VERSION} \
    && apt-get purge -y curl gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
COPY src/prismash/ /usr/lib/prisma-routing/
# THE MANAGEMENT API (#532): gRPC, prisma.v1. Debian's python3-grpcio and
# python3-protobuf to run it, and - for this one step only - the protoc and
# grpc plugin of the same Debian, which generate its stubs from the contract
# here and are removed after: the stubs are built against the runtime that
# loads them, and are never committed or edited.
COPY api/ /tmp/api-src/api/
COPY tools/gen-api.sh /tmp/api-src/tools/
RUN apt-get update -qq \
    && apt-get install -y --no-install-recommends \
        python3-grpcio python3-protobuf \
        protobuf-compiler protobuf-compiler-grpc libprotobuf-dev \
    && sh /tmp/api-src/tools/gen-api.sh /usr/lib/prisma-routing/apistubs \
    && apt-get purge -y protobuf-compiler protobuf-compiler-grpc libprotobuf-dev \
    && apt-get autoremove -y && rm -rf /var/lib/apt/lists/* /tmp/api-src
COPY appliance/prismash-launcher /usr/bin/prismash
RUN chmod 0755 /usr/bin/prismash /usr/lib/prisma-routing/prismash.py
# THE ACCOUNTS ARE THE HOST'S, through a directory and not three file mounts
# (#532): a file mount pins the inode, and useradd replaces the file, so the
# container kept the accounts from before it started. The host's doors keep
# /run/prisma-routing/accounts current (doors.share_accounts), and these
# links read it.
RUN for f in passwd group shadow; do \
      ln -sf /run/prisma-routing/accounts/$f /etc/$f; done
# The VPP image's entrypoint starts VPP; this one must never.
ENTRYPOINT ["sleep", "infinity"]
